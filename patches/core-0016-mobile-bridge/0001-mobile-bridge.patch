+    async fn remove_agent(&self, user_id: &str, team_id: &str, slot_id: &str) -> Result<(), BackendError> {
+        self.team.remove_agent(user_id, team_id, slot_id).await.map_err(map_err)
+    }
+
+    async fn spawn_agent(
+        &self,
+        user_id: &str,
+        team_id: &str,
