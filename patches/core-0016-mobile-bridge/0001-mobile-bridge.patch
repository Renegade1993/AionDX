+
+    async fn app(channel: Option<AuthChannel>) -> Router {
+        let store = MobileStore::open_memory().await.unwrap();
+        let bridge = MobileBridge::new(
+            store,
+            Arc::new(HostKey::generate().unwrap()),
+            "Test PC".into(),
+            Arc::new(crate::core::NoEvents),
+        );
+        mobile_admin_routes(MobileAdminState { bridge }).layer(axum::middleware::from_fn(
+            move |mut req: Request, next: Next| {
+                let channel = channel.clone();
+                async move {
+                    req.extensions_mut().insert(CurrentUser::local_default());
+                    if let Some(channel) = channel {
+                        req.extensions_mut().insert(channel);
+                    }
+                    next.run(req).await
+                }
+            },
+        ))
+    }
+
+    async fn call(app: &Router, method: &str, uri: &str, body: &str) -> (StatusCode, serde_json::Value) {
+        let req = Request::builder()
+            .method(method)
+            .uri(uri)
+            .header("content-type", "application/json")
+            .body(Body::from(body.to_owned()))
+            .unwrap();
+        let resp = app.clone().oneshot(req).await.unwrap();
+        let status = resp.status();
+        let bytes = axum::body::to_bytes(resp.into_body(), usize::MAX).await.unwrap();
+        (
+            status,
+            serde_json::from_slice(&bytes).unwrap_or(serde_json::Value::Null),
+        )
+    }
+
+    #[tokio::test]
+    async fn session_reads_status() {
+        let app = app(Some(AuthChannel::Session)).await;
+        let (status, body) = call(&app, "GET", "/api/mobile/admin/status", "").await;
+        assert_eq!(status, StatusCode::OK);
+        assert_eq!(body["data"]["enabled"], false);
+        assert_eq!(body["data"]["port"], 47734);
+        assert_eq!(body["data"]["listening"], false);
+    }
+
+    #[tokio::test]
+    async fn runtime_token_and_unmarked_callers_are_refused_everywhere() {
+        let routes = [
+            ("GET", "/api/mobile/admin/status", ""),
+            ("PUT", "/api/mobile/admin/settings", r#"{"enabled":true}"#),
+            ("POST", "/api/mobile/admin/pairing-offers", ""),
+            ("GET", "/api/mobile/admin/pairing-offers/x", ""),
+            (
+                "POST",
+                "/api/mobile/admin/pairing-offers/x/approve",
+                r#"{"sasConfirmed":true}"#,
+            ),
+            ("POST", "/api/mobile/admin/pairing-offers/x/reject", ""),
+            ("POST", "/api/mobile/admin/recovery/dismiss", ""),
+            ("POST", "/api/mobile/admin/devices/d/rekey-offers", ""),
+            ("GET", "/api/mobile/admin/devices", ""),
+            ("PATCH", "/api/mobile/admin/devices/d", r#"{"name":"x"}"#),
+            ("DELETE", "/api/mobile/admin/devices/d", ""),
+        ];
+        for channel in [
+            Some(AuthChannel::RuntimeToken {
+                conversation_id: "c1".into(),
+            }),
+            None,
+        ] {
+            let app = app(channel.clone()).await;
+            for (method, uri, body) in routes {
+                let (status, _) = call(&app, method, uri, body).await;
+                assert_eq!(status, StatusCode::FORBIDDEN, "{channel:?} {method} {uri}");
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn invalid_settings_are_a_400_with_the_reason() {
+        let app = app(Some(AuthChannel::Local)).await;
+        let (status, body) = call(&app, "PUT", "/api/mobile/admin/settings", r#"{"port":80}"#).await;
+        assert_eq!(status, StatusCode::BAD_REQUEST);
+        assert!(body.to_string().contains("1024"), "{body}");
+        let (status, _) = call(&app, "PUT", "/api/mobile/admin/settings", r#"{"nope":1}"#).await;
+        assert_eq!(status, StatusCode::BAD_REQUEST);
+    }
+
+    #[tokio::test]
+    async fn settings_update_is_returned_as_status() {
+        let app = app(Some(AuthChannel::Session)).await;
+        let (status, body) = call(
+            &app,
+            "PUT",
+            "/api/mobile/admin/settings",
+            r#"{"hostName":"Desk","tasksWrite":false}"#,
+        )
+        .await;
+        assert_eq!(status, StatusCode::OK);
+        assert_eq!(body["data"]["hostName"], "Desk");
+        assert_eq!(body["data"]["tasksWrite"], false);
+        assert_eq!(body["data"]["enabled"], false);
+    }
+
+    #[tokio::test]
+    async fn offers_are_created_and_cannot_be_approved_before_a_request() {
+        let app = app(Some(AuthChannel::Session)).await;
+        let (status, body) = call(&app, "POST", "/api/mobile/admin/pairing-offers", "").await;
+        assert_eq!(status, StatusCode::OK);
+        let offer_id = body["data"]["offerId"].as_str().unwrap().to_owned();
+        assert!(
+            body["data"]["uri"]
+                .as_str()
+                .unwrap()
+                .starts_with("aiondx://pair?v=1&id=")
+        );
+
+        let (status, body) = call(&app, "GET", &format!("/api/mobile/admin/pairing-offers/{offer_id}"), "").await;
+        assert_eq!(status, StatusCode::OK);
+        assert_eq!(body["data"]["state"], "waiting");
+
+        let (status, _) = call(
+            &app,
+            "POST",
+            &format!("/api/mobile/admin/pairing-offers/{offer_id}/approve"),
+            r#"{"sasConfirmed":true}"#,
+        )
+        .await;
+        assert_eq!(status, StatusCode::CONFLICT, "nothing to approve yet");
+
+        let (status, _) = call(
+            &app,
+            "POST",
+            &format!("/api/mobile/admin/pairing-offers/{offer_id}/approve"),
+            r#"{"sasConfirmed":false}"#,
+        )
+        .await;
+        assert_eq!(status, StatusCode::BAD_REQUEST, "approval needs the SAS confirmation");
+
+        let (status, _) = call(&app, "GET", "/api/mobile/admin/pairing-offers/nope", "").await;
+        assert_eq!(status, StatusCode::NOT_FOUND);
+        let (status, _) = call(&app, "DELETE", "/api/mobile/admin/devices/nope", "").await;
+        assert_eq!(status, StatusCode::NOT_FOUND);
+    }
+}
