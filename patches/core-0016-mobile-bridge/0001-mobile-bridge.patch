+#[tokio::test]
+async fn message_sync_cursor_and_backward_paging() {
+    let (fake, f) = facade();
+    let (_, first) = get(&f, "/v1/conversations/c9/messages").await.unwrap();
+    assert_eq!(first["items"].as_array().unwrap().len(), 2);
+    assert_eq!(first["items"][1]["status"], "streaming");
+    assert_eq!(first["reset"], false);
+    assert_eq!(first["before"], "v1.oldest", "where backward paging starts (rev 4.1)");
+    let cursor = first["cursor"].as_str().unwrap().to_owned();
+
+    let (_, next) = get(&f, &format!("/v1/conversations/c9/messages?since={cursor}"))
+        .await
+        .unwrap();
+    assert_eq!(next["reset"], false);
+    assert!(next.get("before").is_none(), "no before on since-polls");
+    let after = fake
+        .seen_message_queries
+        .lock()
+        .unwrap()
+        .last()
+        .unwrap()
+        .0
+        .clone()
+        .unwrap();
+    // The poll re-reads from 5 s before the oldest row that was still streaming (m2 at 2000).
+    let decoded: Value = serde_json::from_slice(
+        &base64::Engine::decode(
+            &base64::engine::general_purpose::URL_SAFE_NO_PAD,
+            after.strip_prefix("v1.").unwrap(),
+        )
+        .unwrap(),
+    )
+    .unwrap();
+    assert_eq!(decoded, json!({ "created_at": 2000 - 5000 - 1, "id": "~" }));
+
+    let (_, garbage) = get(&f, "/v1/conversations/c9/messages?since=nonsense").await.unwrap();
+    assert_eq!(garbage["reset"], true);
+
+    let (_, older) = get(&f, "/v1/conversations/c9/messages?before=v1.oldest").await.unwrap();
+    assert_eq!(older["before"], "v1.oldest");
+    assert_eq!(
+        fake.seen_message_queries.lock().unwrap().last().unwrap().1.as_deref(),
+        Some("v1.oldest")
+    );
+}
