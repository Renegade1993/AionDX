+#[tokio::test]
+async fn allowing_needs_a_proof_and_a_vanished_approval_is_already_resolved() {
+    let (fake, f) = facade();
+    emit(&f, "message.stream", acp_frame("call-2")).await;
+    *fake.pending.lock().unwrap() = vec![listed("call-2")];
+    let id = approval_ids(&f).await.pop().unwrap();
+    let path = format!("/v1/approvals/{id}/answer");
+
+    let (status, body) = call(
+        &f,
+        ConfirmCheck::Missing,
+        "POST",
+        &path,
+        json!({ "decision": "allow_once" }),
+    )
+    .await;
+    assert_eq!(status, 428);
+    assert_eq!(body["error"]["code"], "confirm_required");
+    let (status, _) = call(&f, ConfirmCheck::Invalid, "POST", &path, json!({ "optionId": "ok1" })).await;
+    assert_eq!(status, 403);
+    let (status, _) = call(
+        &f,
+        ConfirmCheck::Verified,
+        "POST",
+        &path,
+        json!({ "optionId": "ok1", "message": "x" }),
+    )
+    .await;
+    assert_eq!(status, 400, "a message only goes with a refusal");
+    let (status, body) = call(&f, ConfirmCheck::Verified, "POST", &path, json!({ "optionId": "ok1" })).await;
+    assert_eq!(status, 200);
+    assert_eq!(body, json!({ "resolved": true, "messageDelivery": null }));
+    assert!(
+        fake.calls()
+            .contains(&r#"confirm c2 call-2 "ok1" always=false deny=None"#.to_owned())
+    );
+
+    // Answered on the PC in the meantime: AionCore no longer lists it by the time the phone answers.
+    emit(&f, "message.stream", acp_frame("call-3")).await;
+    *fake.pending.lock().unwrap() = vec![listed("call-3")];
+    let path3 = format!("/v1/approvals/{}/answer", approval_ids(&f).await.pop().unwrap());
+    fake.pending.lock().unwrap().clear();
+    let (status, body) = call(
+        &f,
+        ConfirmCheck::Verified,
+        "POST",
+        &path3,
+        json!({ "decision": "deny" }),
+    )
+    .await;
+    assert_eq!(status, 409);
+    assert_eq!(body["error"]["code"], "already_resolved");
+    assert!(
+        !fake.calls().iter().any(|c| c.contains("call-3")),
+        "nothing was sent for it"
+    );
+
+    let (status, _) = call(
+        &f,
+        ConfirmCheck::Verified,
+        "POST",
+        "/v1/approvals/nope/answer",
+        json!({ "decision": "deny" }),
+    )
+    .await;
+    assert_eq!(status, 404);
+}
