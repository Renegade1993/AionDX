+/// Forwards the bridge's desktop notices (`mobile.pairingRequest`,
+/// `mobile.deviceChanged`) to the user's WebSocket connections.
+struct MobileBridgeEvents(Arc<BroadcastEventBus>);
+
+impl aionui_mobile::BridgeEvents for MobileBridgeEvents {
+    fn emit(&self, user_id: &str, name: &str, mut data: serde_json::Value) {
+        use aionui_realtime::EventBroadcaster;
+        if let Some(map) = data.as_object_mut() {
+            map.insert("user_id".to_owned(), serde_json::Value::String(user_id.to_owned()));
+        }
+        self.0.broadcast(aionui_api_types::WebSocketMessage::new(name, data));
+    }
+}
