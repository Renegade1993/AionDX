+    Ok(Json(ApiResponse::ok(devices)))
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct DevicePatch {
+    name: Option<String>,
+    require_confirm: Option<bool>,
+}
+
+async fn update_device(
+    State(state): State<MobileAdminState>,
+    Extension(user): Extension<CurrentUser>,
+    channel: Option<Extension<AuthChannel>>,
+    Path(device_id): Path<String>,
+    body: Result<Json<DevicePatch>, JsonRejection>,
+) -> Result<Json<ApiResponse<()>>, ApiError> {
+    require_user_client(channel.as_deref())?;
+    let patch = parse(body)?;
+    let name = patch.name.as_deref().map(str::trim);
+    if name.is_some_and(|n| n.is_empty() || n.chars().count() > 64) {
+        return Err(ApiError::BadRequest("name must be 1 to 64 characters".into()));
+    }
+    state
+        .bridge
+        .update_device(&user.id, &device_id, name, patch.require_confirm)
+        .await
+        .map_err(admin_error)?;
+    Ok(Json(ApiResponse::success()))
+}
