@@ -0,0 +1,230 @@
+//! The LAN listener (CONTRACT §2, §4). It is separate from AionCore's own
+//! 127.0.0.1 server and serves only `/api/mobile/v1/*`. Every request from a
+//! peer outside the private ranges is refused before routing.
+
+use std::net::SocketAddr;
+use std::sync::Arc;
+
+use axum::Json;
+use axum::Router;
+use axum::extract::{ConnectInfo, Request, State};
+use axum::http::StatusCode;
+use axum::middleware::Next;
+use axum::response::{IntoResponse, Response};
+use axum::routing::{get, post};
+use serde_json::json;
+use tokio::net::TcpListener;
+use tokio::sync::oneshot;
+use tokio::task::JoinHandle;
+
+use crate::core::BridgeCore;
+use crate::error::MobileError;
+use crate::outer;
+use crate::peer_filter::is_private_peer;
+
+/// The outer routes: the only four paths the LAN ever sees.
+pub fn outer_router(core: Arc<BridgeCore>) -> Router {
+    Router::new()
+        .route("/api/mobile/v1/hello", get(hello))
+        .route("/api/mobile/v1/pair", post(outer::pair))
+        .route("/api/mobile/v1/session", post(outer::session))
+        .route("/api/mobile/v1/rpc", post(outer::rpc))
+        .fallback(not_found)
+        .with_state(core)
+        .layer(axum::middleware::from_fn(private_peers_only))
+}
+
+async fn hello(State(core): State<Arc<BridgeCore>>) -> Json<serde_json::Value> {
+    Json(json!({ "v": [1], "hostId": core.host_key.host_id }))
+}
+
+async fn not_found() -> Response {
+    (StatusCode::NOT_FOUND, Json(json!({ "error": "not_found" }))).into_response()
+}
+
+async fn private_peers_only(request: Request, next: Next) -> Response {
+    let peer = request.extensions().get::<ConnectInfo<SocketAddr>>().map(|info| info.0);
+    match peer {
+        Some(addr) if is_private_peer(addr.ip()) => next.run(request).await,
+        _ => {
+            tracing::warn!(peer = ?peer, "mobile bridge: refused a request from a non-private address");
+            (StatusCode::FORBIDDEN, Json(json!({ "error": "forbidden_peer" }))).into_response()
+        }
+    }
+}
+
+/// How long a closing listener waits for requests in flight.
+pub const STOP_GRACE: std::time::Duration = std::time::Duration::from_secs(2);
+
+/// A running listener. Dropping it does not stop it; call [`ListenerHandle::stop`].
+pub struct ListenerHandle {
+    pub addr: SocketAddr,
+    /// The IPv6 twin of a `0.0.0.0` listener (`[::]`, same port), when the PC has IPv6.
+    pub addr_v6: Option<SocketAddr>,
+    servers: Vec<(oneshot::Sender<()>, JoinHandle<()>)>,
+}
+
+impl ListenerHandle {
+    /// Stops accepting, lets requests in flight finish for up to `STOP_GRACE`, then drops whatever is left. Without
+    /// the bound, a phone's `/v1/changes` long-poll (up to 25 s) held the close that long.
+    pub async fn stop(self) {
+        let mut tasks = Vec::new();
+        for (tx, task) in self.servers {
+            let _ = tx.send(());
+            tasks.push(task);
+        }
+        for mut task in tasks {
+            if tokio::time::timeout(STOP_GRACE, &mut task).await.is_err() {
+                task.abort();
+                tracing::info!(addr = %self.addr, "mobile bridge: requests still open at close were dropped");
+            }
+        }
+        tracing::info!(addr = %self.addr, "mobile bridge: listener stopped");
+    }
+}
+
+fn serve(listener: TcpListener, router: Router) -> (oneshot::Sender<()>, JoinHandle<()>) {
+    let (tx, rx) = oneshot::channel::<()>();
+    let service = router.into_make_service_with_connect_info::<SocketAddr>();
+    let task = tokio::spawn(async move {
+        let result = axum::serve(listener, service)
+            .with_graceful_shutdown(async move {
+                let _ = rx.await;
+            })
+            .await;
+        if let Err(e) = result {
+            tracing::error!(error = %e, "mobile bridge: listener failed");
+        }
+    });
+    (tx, task)
+}
+
+/// Binds `bind_ip:port` and serves `router` until stopped.
+pub async fn start(bind_ip: std::net::IpAddr, port: u16, router: Router) -> Result<ListenerHandle, MobileError> {
+    let listener = TcpListener::bind(SocketAddr::new(bind_ip, port))
+        .await
+        .map_err(|e| MobileError::Listener(format!("could not listen on port {port}: {e}")))?;
+    let addr = listener
+        .local_addr()
+        .map_err(|e| MobileError::Listener(e.to_string()))?;
+    // IPv6 too, for ULA addresses (CONTRACT §2). Windows sockets are v6-only by default, so `[::]` and `0.0.0.0` share
+    // the port; where IPv6 is off (or the stack is dual by default), the IPv4 listener alone is fine.
+    let mut addr_v6 = None;
+    let mut servers = Vec::new();
+    if bind_ip == std::net::IpAddr::V4(std::net::Ipv4Addr::UNSPECIFIED) {
+        match TcpListener::bind(SocketAddr::new(std::net::Ipv6Addr::UNSPECIFIED.into(), addr.port())).await {
+            Ok(v6) => {
+                addr_v6 = v6.local_addr().ok();
+                servers.push(serve(v6, router.clone()));
+            }
+            Err(e) => tracing::info!(error = %e, "mobile bridge: no IPv6 listener; IPv4 only"),
+        }
+    }
+    servers.push(serve(listener, router));
+    tracing::info!(%addr, ?addr_v6, "mobile bridge: listener started");
+    Ok(ListenerHandle { addr, addr_v6, servers })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::net::{IpAddr, Ipv4Addr};
+
+    /// A request still open when the bridge is switched off (a phone's long-poll) no longer holds the close: the
+    /// listener waits `STOP_GRACE`, then drops it.
+    #[tokio::test]
+    async fn a_request_in_flight_does_not_hold_the_close() {
+        use tokio::io::AsyncWriteExt;
+        let router = Router::new().route(
+            "/hang",
+            axum::routing::get(|| async {
+                tokio::time::sleep(std::time::Duration::from_secs(60)).await;
+                "late"
+            }),
+        );
+        let handle = start(IpAddr::V4(Ipv4Addr::LOCALHOST), 0, router).await.unwrap();
+        let mut stream = tokio::net::TcpStream::connect(handle.addr).await.unwrap();
+        stream
+            .write_all(b"GET /hang HTTP/1.1\r\nHost: x\r\n\r\n")
+            .await
+            .unwrap();
+        tokio::time::sleep(std::time::Duration::from_millis(200)).await;
+        let started = std::time::Instant::now();
+        handle.stop().await;
+        let took = started.elapsed();
+        assert!(took >= STOP_GRACE - std::time::Duration::from_millis(100), "{took:?}");
+        assert!(took < STOP_GRACE + std::time::Duration::from_secs(1), "{took:?}");
+    }
+
+    async fn get_json(addr: SocketAddr, path: &str) -> (u16, serde_json::Value) {
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        let mut stream = tokio::net::TcpStream::connect(addr).await.unwrap();
+        let req = format!("GET {path} HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
+        stream.write_all(req.as_bytes()).await.unwrap();
+        let mut raw = String::new();
+        stream.read_to_string(&mut raw).await.unwrap();
+        let status: u16 = raw[9..12].parse().unwrap();
+        let body = raw.split("\r\n\r\n").nth(1).unwrap_or("");
+        // axum may answer with chunked encoding; take the JSON object out of it.
+        let start = body.find('{').unwrap();
+        let end = body.rfind('}').unwrap();
+        (status, serde_json::from_str(&body[start..=end]).unwrap())
+    }
+
+    async fn router() -> (Router, String) {
+        let store = crate::store::MobileStore::open_memory().await.unwrap();
+        let key = Arc::new(crate::host_key::HostKey::generate().unwrap());
+        let core = BridgeCore::new(key, store, "Test PC".into(), Arc::new(crate::core::NoEvents));
+        let host_id = core.host_key.host_id.clone();
+        (outer_router(core), host_id)
+    }
+
+    #[tokio::test]
+    async fn hello_answers_with_version_and_host_id_and_stops_cleanly() {
+        let (router, host_id) = router().await;
+        let handle = start(IpAddr::V4(Ipv4Addr::LOCALHOST), 0, router).await.unwrap();
+        let (status, body) = get_json(handle.addr, "/api/mobile/v1/hello").await;
+        assert_eq!(status, 200);
+        assert_eq!(body, json!({ "v": [1], "hostId": host_id }));
+        let addr = handle.addr;
+        handle.stop().await;
+        assert!(
+            tokio::net::TcpStream::connect(addr).await.is_err(),
+            "port is released after stop"
+        );
+    }
+
+    #[tokio::test]
+    async fn only_bridge_routes_are_served() {
+        let handle = start(IpAddr::V4(Ipv4Addr::LOCALHOST), 0, router().await.0)
+            .await
+            .unwrap();
+        for path in ["/api/teams", "/api/conversations", "/", "/api/mobile/admin/status"] {
+            let (status, body) = get_json(handle.addr, path).await;
+            assert_eq!(status, 404, "{path}");
+            assert_eq!(body, json!({ "error": "not_found" }));
+        }
+        handle.stop().await;
+    }
+
+    #[tokio::test]
+    async fn non_private_peers_are_refused() {
+        use tower::ServiceExt;
+        let request = axum::http::Request::get("/api/mobile/v1/hello")
+            .extension(ConnectInfo(SocketAddr::from(([8, 8, 8, 8], 5555))))
+            .body(axum::body::Body::empty())
+            .unwrap();
+        let response = router().await.0.oneshot(request).await.unwrap();
+        assert_eq!(response.status(), StatusCode::FORBIDDEN);
+    }
+
+    #[tokio::test]
+    async fn a_taken_port_is_reported_not_panicked() {
+        let first = start(IpAddr::V4(Ipv4Addr::LOCALHOST), 0, router().await.0)
+            .await
+            .unwrap();
+        let err = start(IpAddr::V4(Ipv4Addr::LOCALHOST), first.addr.port(), router().await.0).await;
+        assert!(matches!(err, Err(MobileError::Listener(_))));
+        first.stop().await;
+    }
+}
diff --git a/crates/aionui-mobile/src/mdns.rs b/crates/aionui-mobile/src/mdns.rs
new file mode 100644
index 00000000..9aa9181b
--- /dev/null
+++ b/crates/aionui-mobile/src/mdns.rs
@@ -0,0 +1,200 @@
+//! The `_aiondx._tcp` mDNS advertisement (CONTRACT §7, PHASE5-NET-SPEC §B), through the `mdns-sd` crate.
+//!
+//! Advertised only on the private interfaces `netinfo` finds, both at the daemon (every other interface, loopback
+//! included, is disabled) and on the service itself (`ServiceInfo::set_interfaces`). The record carries the
+//! instance name and TXT `v`/`hid` only: no host name, no user name. The SRV target is `aiondx-<4 hex>.local.`,
+//! derived from the host id like the instance name, so the PC's own name is never published.
+
+use std::net::IpAddr;
+use std::time::Duration;
+
+use mdns_sd::{IfKind, MDNS_PORT, ServiceDaemon, ServiceInfo};
+use sha2::{Digest, Sha256};
+
+use crate::crypto::b64u;
+use crate::netinfo::{self, LocalAddress};
+use crate::peer_filter::is_private_peer;
+
+pub const SERVICE_TYPE: &str = "_aiondx._tcp.local.";
+
+/// How long `stop` waits for the goodbye packets and the daemon's shutdown.
+const STOP_WAIT: Duration = Duration::from_secs(1);
+
+fn digest(host_id: &str) -> [u8; 32] {
+    Sha256::digest(host_id.as_bytes()).into()
+}
+
+/// `AionDX-<first 4 hex of SHA-256(hostId)>`.
+pub fn instance_name(host_id: &str) -> String {
+    let d = digest(host_id);
+    format!("AionDX-{:02x}{:02x}", d[0], d[1])
+}
+
+/// TXT `v=1` and `hid=<first 8 base64url chars of SHA-256(hostId)>`, and nothing else.
+pub fn txt_records(host_id: &str) -> Vec<(String, String)> {
+    let hid: String = b64u(&digest(host_id)).chars().take(8).collect();
+    vec![("v".to_owned(), "1".to_owned()), ("hid".to_owned(), hid)]
+}
+
+/// The addresses that may be advertised: private, not loopback, de-duplicated.
+fn advertisable(addresses: &[LocalAddress]) -> Vec<IpAddr> {
+    let mut out: Vec<IpAddr> = Vec::new();
+    for a in addresses {
+        if is_private_peer(a.ip) && !a.ip.is_loopback() && !a.ip.is_unspecified() && !out.contains(&a.ip) {
+            out.push(a.ip);
+        }
+    }
+    out
+}
+
+pub struct MdnsAdvertiser {
+    daemon: Option<ServiceDaemon>,
+    fullname: String,
+}
+
+impl MdnsAdvertiser {
+    /// Advertises `AionDX-<first 4 hex of SHA-256(hostId)>._aiondx._tcp.local` on `port` with TXT
+    /// `v=1` and `hid=<first 8 base64url chars of SHA-256(hostId)>`. Must never fail AionCore: errors are returned,
+    /// and the caller logs them.
+    pub fn start(host_id: &str, port: u16) -> Result<MdnsAdvertiser, String> {
+        Self::start_on(host_id, port, &netinfo::private_addresses(), MDNS_PORT)
+    }
+
+    /// `start` with the addresses and the mDNS port given, so the refusal paths are testable without a socket.
+    fn start_on(host_id: &str, port: u16, addresses: &[LocalAddress], mdns_port: u16) -> Result<Self, String> {
+        let ips = advertisable(addresses);
+        if ips.is_empty() {
+            return Err("mDNS: no private network interface to advertise on".to_owned());
+        }
+        let instance = instance_name(host_id);
+        let host_name = format!("{}.local.", instance.to_ascii_lowercase());
+        let txt = txt_records(host_id);
+        let txt: Vec<(&str, &str)> = txt.iter().map(|(k, v)| (k.as_str(), v.as_str())).collect();
+        let mut info = ServiceInfo::new(SERVICE_TYPE, &instance, &host_name, &ips[..], port, &txt[..])
+            .map_err(|e| format!("mDNS: invalid service record: {e}"))?;
+        let kinds = || ips.iter().map(|ip| IfKind::Addr(*ip)).collect::<Vec<_>>();
+        info.set_interfaces(kinds());
+        let fullname = info.get_fullname().to_owned();
+
+        let daemon = ServiceDaemon::new_with_port(mdns_port).map_err(|e| format!("mDNS: could not start: {e}"))?;
+        let setup = daemon
+            .disable_interface(vec![IfKind::All, IfKind::LoopbackV4, IfKind::LoopbackV6])
+            .and_then(|_| daemon.enable_interface(kinds()))
+            .and_then(|_| daemon.register(info));
+        if let Err(e) = setup {
+            let _ = daemon.shutdown();
+            return Err(format!("mDNS: could not register: {e}"));
+        }
+        Ok(Self {
+            daemon: Some(daemon),
+            fullname,
+        })
+    }
+
+    /// The full service name, `AionDX-xxxx._aiondx._tcp.local.`.
+    pub fn fullname(&self) -> &str {
+        &self.fullname
+    }
+
+    /// Sends goodbye packets for the service and shuts the daemon down, waiting up to a second for each.
+    pub fn stop(mut self) {
+        self.shut_down(true);
+    }
+
+    fn shut_down(&mut self, wait: bool) {
+        let Some(daemon) = self.daemon.take() else { return };
+        if let Ok(rx) = daemon.unregister(&self.fullname)
+            && wait
+        {
+            let _ = rx.recv_timeout(STOP_WAIT);
+        }
+        if let Ok(rx) = daemon.shutdown()
+            && wait
+        {
+            let _ = rx.recv_timeout(STOP_WAIT);
+        }
+    }
+}
+
+impl Drop for MdnsAdvertiser {
+    /// An advertiser dropped without `stop` still withdraws the service, without blocking.
+    fn drop(&mut self) {
+        self.shut_down(false);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn la(ip: &str) -> LocalAddress {
+        LocalAddress {
+            ip: ip.parse().unwrap(),
+            interface: "Ethernet".into(),
+        }
+    }
+
+    #[test]
+    fn instance_name_is_aiondx_and_four_hex_of_the_host_id_hash() {
+        // SHA-256("abc") = ba7816bf..., SHA-256("host-123") = 828f...
+        assert_eq!(instance_name("abc"), "AionDX-ba78");
+        assert_eq!(instance_name("host-123"), "AionDX-828f");
+    }
+
+    #[test]
+    fn txt_is_v1_and_hid_only() {
+        assert_eq!(
+            txt_records("abc"),
+            vec![("v".into(), "1".into()), ("hid".into(), "ungWv48B".into())]
+        );
+        let keys: Vec<String> = txt_records("host-123").into_iter().map(|(k, _)| k).collect();
+        assert_eq!(keys, ["v", "hid"], "no host name, no user name");
+        assert_eq!(txt_records("host-123")[1].1, "go9WOeTj");
+    }
+
+    #[test]
+    fn only_private_non_loopback_addresses_are_advertised() {
+        let ips = advertisable(&[
+            la("192.168.1.5"),
+            la("8.8.8.8"),
+            la("127.0.0.1"),
+            la("::1"),
+            la("2001:db8::1"),
+            la("fe80::1"),
+            la("192.168.1.5"),
+            la("100.64.0.9"),
+        ]);
+        let want: Vec<IpAddr> = ["192.168.1.5", "fe80::1", "100.64.0.9"]
+            .iter()
+            .map(|s| s.parse().unwrap())
+            .collect();
+        assert_eq!(ips, want);
+    }
+
+    #[test]
+    fn no_private_interface_is_an_error_and_starts_nothing() {
+        let err = MdnsAdvertiser::start_on("abc", 47734, &[], 0).err().unwrap();
+        assert!(err.contains("no private network interface"), "{err}");
+        let err = MdnsAdvertiser::start_on("abc", 47734, &[la("8.8.8.8"), la("127.0.0.1")], 0)
+            .err()
+            .unwrap();
+        assert!(err.contains("no private network interface"), "{err}");
+    }
+
+    /// Real multicast on this PC's private interfaces: run by hand only (`cargo test -- --ignored`).
+    #[test]
+    #[ignore]
+    fn live_start_and_stop() {
+        match MdnsAdvertiser::start("live-test-host", 47734) {
+            Ok(adv) => {
+                assert_eq!(
+                    adv.fullname(),
+                    format!("{}.{SERVICE_TYPE}", instance_name("live-test-host"))
+                );
+                std::thread::sleep(Duration::from_millis(500));
+                adv.stop();
+            }
+            Err(e) => assert!(e.starts_with("mDNS:"), "{e}"),
+        }
+    }
+}
