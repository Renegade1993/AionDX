+    #[test]
+    fn removal_turn_end_list_and_get() {
+        let t = ApprovalTracker::new();
+        t.on_frame(frame(
+            BackendKind::ClaudeSession,
+            "acp_permission",
+            claude_confirmation("x"),
+            30,
+        ));
+        t.on_frame(frame(BackendKind::Acp, "acp_permission", acp_request("y"), 10));
+        let mut solo = frame(BackendKind::Acp, "acp_permission", acp_request("s"), 20);
+        solo.origin.conversation_id = "c-solo".into();
+        solo.origin.team_id = None;
+        solo.origin.slot_id = None;
+        t.on_frame(solo);
+        let mut someone_else = frame(BackendKind::Acp, "acp_permission", acp_request("o"), 5);
+        someone_else.origin.user_id = "u2".into();
+        someone_else.origin.conversation_id = "c-u2".into();
+        t.on_frame(someone_else);
+
+        let all: Vec<String> = t.list("u1", None).into_iter().map(|a| a.approval_id).collect();
+        assert_eq!(
+            all,
+            vec![
+                approval_id("c1", "y"),
+                approval_id("c-solo", "s"),
+                approval_id("c1", "x")
+            ],
+            "oldest first, own user"
+        );
+        assert_eq!(
+            t.list("u1", Some("t1")).len(),
+            2,
+            "team filter leaves out the solo chat"
+        );
+        assert_eq!(t.list("u2", None).len(), 1);
+
+        // confirmation.remove matches on the confirmation id, not the call id.
+        assert_eq!(t.on_removed("c1", "x"), None);
+        assert_eq!(t.on_removed("c1", "conf-x"), Some(approval_id("c1", "x")));
+        assert!(t.get(&approval_id("c1", "x")).is_none());
+
+        t.on_frame(frame(BackendKind::Acp, "acp_permission", acp_request("y2"), 40));
+        assert_eq!(
+            t.on_turn_ended("c1"),
+            vec![approval_id("c1", "y"), approval_id("c1", "y2")]
+        );
+        assert_eq!(t.list("u1", None).len(), 1);
+        assert!(t.on_turn_ended("c1").is_empty());
+    }
