+// ---------------------------------------------------------------------------
+// AionDX core-0016: a declined shutdown reaches the event bus (QA SD2a)
+// ---------------------------------------------------------------------------
+
+/// The mobile bridge learns that a teammate refused a phone-sent shutdown from the `team.mailboxChanged` event of the
+/// note AionCore writes to the lead. This drives the REAL path: the teammate's `team_send_message
+/// "shutdown_rejected: ..."` over MCP, `notify_shutdown_rejected`, and a mailbox wired the way `TeamSession::new`
+/// wires it (`Mailbox::new_for_user(..).with_events(emitter)`, the same `Arc` handed to the scheduler). The event's
+/// shape is what `aionui-mobile` `facade_live.rs` `on_mailbox` / `declined_shutdown_reason` parse.
+#[tokio::test]
+async fn declined_shutdown_emits_mailbox_changed_for_the_bridge() {
+    let repo = Arc::new(MockTeamRepo::new());
+    let recorder = Arc::new(RecordingBroadcaster::new());
+    let broadcaster: Arc<dyn EventBroadcaster> = recorder.clone();
+    let emitter = Arc::new(aionui_team::TeamEventEmitter::new(
+        "team-1".into(),
+        "user-1".into(),
+        broadcaster.clone(),
+    ));
+    let mailbox = Arc::new(Mailbox::new_for_user(repo.clone(), "user-1").with_events(emitter.clone()));
+    let task_board = Arc::new(TaskBoard::new_for_user(repo.clone(), "user-1").with_events(emitter));
+    let scheduler = Arc::new(TeammateManager::new(
+        "team-1".into(),
+        "user-1".into(),
+        &make_agents(),
+        mailbox,
+        task_board,
+        broadcaster.clone(),
+    ));
+    let server = TeamMcpServer::start_with_prompt_dump(
+        "test-token-123".into(),
+        scheduler,
+        "team-1".into(),
+        broadcaster,
+        std::sync::Weak::new(),
+        None,
+    )
+    .await
+    .unwrap();
+
+    let mut stream = connect_and_init(server.port(), "test-token-123", "worker-1").await;
+    let resp = call_tool(
+        &mut stream,
+        2,
+        "team_send_message",
+        json!({"to": "lead-1", "message": "shutdown_rejected: still migrating"}),
+    )
+    .await;
+    assert!(!is_error_response(&resp));
+
+    let events = recorder.events.lock().unwrap().clone();
+    let changed: Vec<&WebSocketMessage<Value>> = events.iter().filter(|e| e.name == "team.mailboxChanged").collect();
+    assert_eq!(changed.len(), 1, "exactly one mailbox event: {events:?}");
+    let data = &changed[0].data;
+    assert_eq!(data["user_id"], "user-1");
+    assert_eq!(data["team_id"], "team-1");
+    assert_eq!(data["change"], "created");
+    assert_eq!(data["message"]["from_agent_id"], "worker-1");
+    assert_eq!(data["message"]["to_agent_id"], "lead-1");
+    assert_eq!(
+        data["message"]["content"],
+        "Teammate 'Worker' declined shutdown: still migrating"
+    );
+    assert!(data["message"]["created_at"].is_i64());
+
+    server.stop();
+}
