+    async fn start_session(&self, user_id: &str, team_id: &str) -> Result<(), BackendError> {
+        self.team.ensure_session(user_id, team_id).await.map_err(map_err)
+    }
+
+    async fn create_task(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        task: TaskCreate,
+    ) -> Result<TeamTaskResponse, BackendError> {
+        let input = aionui_team::service::UserTaskCreate {
+            subject: task.subject,
+            description: task.description,
+            owner: task.owner,
+            blocked_by: task.blocked_by,
+        };
+        self.team
+            .create_task_from_user(user_id, team_id, input)
+            .await
+            .map_err(map_err)
+    }
+
+    async fn update_task(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        task_id: &str,
+        patch: TaskPatch,
+    ) -> Result<TeamTaskResponse, BackendError> {
+        let input = aionui_team::service::UserTaskPatch {
+            subject: patch.subject,
+            description: patch.description,
+            status: patch.status,
+            owner: patch.owner,
+            blocked_by: patch.blocked_by,
+        };
+        self.team
+            .update_task_from_user(user_id, team_id, task_id, input)
+            .await
+            .map_err(map_err)
+    }
+
+    async fn get_pref(&self, user_id: &str, key: &str) -> Result<Option<String>, BackendError> {
+        let rows = self
+            .prefs
+            .get_by_keys(user_id, &[key])
+            .await
+            .map_err(|e| BackendError::Unavailable(e.to_string()))?;
+        Ok(rows.into_iter().next().map(|p| p.value))
+    }
+
+    async fn set_pref(&self, user_id: &str, key: &str, value: &str) -> Result<(), BackendError> {
+        self.prefs
+            .upsert_batch(user_id, &[(key, value)])
+            .await
+            .map_err(|e| BackendError::Unavailable(e.to_string()))
+    }
+
+    async fn approval_source(&self, user_id: &str, conversation_id: &str) -> Result<ApprovalSource, BackendError> {
+        let conv = serde_json::to_value(self.conversation.get(user_id, conversation_id).await.map_err(map_err)?)
+            .map_err(|e| BackendError::Unavailable(e.to_string()))?;
+        let extra = &conv["extra"];
+        let label = extra["backend"].as_str().unwrap_or_default();
+        // The answer mapping follows the agent that is running now; a conversation with no live agent can't hold
+        // approvals, and its kind stays undecided (Other) until one starts.
+        let backend = match self.task_manager.get_task(conversation_id) {
+            Some(aionui_ai_agent::AgentInstance::Acp(_)) => BackendKind::Acp,
+            Some(aionui_ai_agent::AgentInstance::Aionrs(_)) => BackendKind::Aionrs,
+            Some(aionui_ai_agent::AgentInstance::Session(_)) => match label {
+                "claude" => BackendKind::ClaudeSession,
+                "codex" => BackendKind::CodexSession,
+                _ => BackendKind::Other,
+            },
+            _ => BackendKind::Other,
+        };
+        let solo_name = extra["assistant_snapshot"]["name"]
+            .as_str()
+            .or(extra["agent_name"].as_str())
+            .filter(|n| !n.is_empty())
+            .unwrap_or(if label.is_empty() { "Agent" } else { label })
+            .to_owned();
+        let Some(team_id) = extra["teamId"].as_str().filter(|t| !t.is_empty()) else {
+            return Ok(ApprovalSource {
+                team_id: None,
+                slot_id: None,
+                agent_name: solo_name,
+                backend,
+            });
+        };
+        let team = self.team.get_team(user_id, team_id).await.map_err(map_err)?;
+        let member = team.assistants.iter().find(|a| a.conversation_id == conversation_id);
+        Ok(ApprovalSource {
+            team_id: Some(team_id.to_owned()),
+            slot_id: member.map(|a| a.slot_id.clone()),
+            agent_name: member.map(|a| a.name.clone()).unwrap_or(solo_name),
+            backend,
+        })
+    }
+
+    async fn live_conversations(&self, user_id: &str) -> Result<Vec<String>, BackendError> {
+        let mut out = Vec::new();
+        for cid in self.task_manager.active_conversation_ids() {
+            if self.conversation.get(user_id, &cid).await.is_ok() {
+                out.push(cid);
+            }
+        }
+        Ok(out)
+    }
+
+    async fn confirmations(
+        &self,
+        user_id: &str,
+        conversation_id: &str,
+    ) -> Result<Vec<serde_json::Value>, BackendError> {
+        let list = self
+            .conversation
+            .list_confirmations(user_id, conversation_id, &self.task_manager)
+            .await
+            .map_err(map_err)?;
+        Ok(list.iter().filter_map(|c| serde_json::to_value(c).ok()).collect())
+    }
+
+    async fn confirm(&self, user_id: &str, call: ConfirmCall) -> Result<(), BackendError> {
+        let req = from_json(serde_json::json!({
+            "msg_id": call.msg_id,
+            "data": call.data,
+            "always_allow": call.always_allow,
+        }))?;
+        self.conversation
+            .confirm_with_message(
+                user_id,
+                &call.conversation_id,
+                &call.call_id,
+                req,
+                call.deny_message,
+                &self.task_manager,
+            )
+            .await
+            .map_err(map_err)
+    }
+
+    async fn respond_now_solo(
+        &self,
+        user_id: &str,
+        conversation_id: &str,
+        content: &str,
+    ) -> Result<SendOutcome, BackendError> {
+        use aionui_conversation::RespondNow;
+        let outcome = self
+            .conversation
+            .respond_now(user_id, conversation_id, content, &self.task_manager)
+            .await
+            .map_err(map_err)?;
+        Ok(match outcome {
+            RespondNow::Delivered { .. } => SendOutcome {
+                message_id: String::new(),
+                delivery: "midturn",
+            },
+            RespondNow::Sent { msg_id, .. } => SendOutcome {
+                message_id: msg_id,
+                delivery: "started",
+            },
+            RespondNow::AfterTurn => SendOutcome {
+                message_id: String::new(),
+                delivery: "queued",
+            },
+        })
+    }
+
+    async fn answer_ask(
+        &self,
+        user_id: &str,
+        conversation_id: &str,
+        request_id: &str,
+        answers: Option<Vec<QuestionAnswer>>,
+    ) -> Result<(), BackendError> {
+        let answers = answers.map(|list| {
+            list.into_iter()
+                .map(|a| aionui_api_types::AskQuestionAnswer {
+                    question: a.question,
+                    labels: a.labels,
+                })
+                .collect()
+        });
+        self.conversation
+            .answer_ask(user_id, conversation_id, request_id, answers, &self.task_manager)
+            .await
+            .map_err(map_err)
+    }
+}
