@@ -0,0 +1,1078 @@
+//! The bridge's lifecycle: settings, the host key, whether the LAN listener
+//! runs, and the desktop's pairing and device actions. Business logic only;
+//! the HTTP surfaces live in `listener.rs`/`outer.rs` (LAN) and
+//! `admin_routes.rs` (desktop).
+
+use std::net::{IpAddr, Ipv4Addr, UdpSocket};
+use std::sync::Arc;
+
+use serde::Serialize;
+use tokio::sync::Mutex;
+
+use crate::core::{BridgeCore, BridgeEvents, InnerApi};
+use crate::crypto;
+use crate::error::MobileError;
+use crate::host_key::{HostKey, random_bytes};
+use crate::listener::{self, ListenerHandle};
+use crate::pairing::{AdminError, OfferView, pairing_uri};
+use crate::settings::{MobileSettings, MobileSettingsPatch};
+use crate::store::{DeviceRow, MobileStore, Recovery};
+
+/// What the desktop's Settings > Mobile page shows (CONTRACT §3.4).
+#[derive(Debug, Clone, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct MobileStatus {
+    pub enabled: bool,
+    pub port: u16,
+    pub urls: Vec<String>,
+    /// What the user saved under Advanced, as saved (`urls` has them merged in).
+    pub extra_urls: Vec<String>,
+    pub host_id: String,
+    pub host_name: String,
+    /// Whether the `_aiondx._tcp` advertisement is in effect: the saved setting, unless something overrides it.
+    pub mdns: bool,
+    /// The saved setting (what the desktop's switch shows).
+    pub mdns_setting: bool,
+    /// Why `mdns` differs from `mdnsSetting`: `loopback_bind` (`AIONDX_MOBILE_BIND`); `null` when they agree.
+    pub mdns_off_reason: Option<&'static str>,
+    pub tasks_write: bool,
+    pub listening: bool,
+    pub error: Option<String>,
+    /// Set after the bridge recovered from a damaged database or host key, until dismissed.
+    pub last_recovery: Option<Recovery>,
+}
+
+/// A new pairing offer for the desktop to draw as a QR code.
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PairingOffer {
+    pub offer_id: String,
+    pub uri: String,
+    pub expires_at: i64,
+}
+
+/// A paired phone as the desktop lists it (CONTRACT §3.4).
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct DeviceView {
+    pub device_id: String,
+    pub name: String,
+    pub platform: String,
+    pub app_version: String,
+    pub paired_at: i64,
+    pub last_seen_at: Option<i64>,
+    pub last_address: Option<String>,
+    pub active_sessions: usize,
+    pub require_confirm: bool,
+    pub confirm_mode: String,
+}
+
+/// Why a desktop pairing or device action failed.
+#[derive(Debug)]
+pub enum AdminFailure {
+    NotFound,
+    /// The offer isn't waiting for this action (no request yet, already decided, or expired).
+    NotReady,
+    Internal(MobileError),
+}
+
+impl From<MobileError> for AdminFailure {
+    fn from(e: MobileError) -> Self {
+        AdminFailure::Internal(e)
+    }
+}
+
+struct Running {
+    user_id: String,
+    port: u16,
+    handle: ListenerHandle,
+    /// The `_aiondx._tcp` advertisement while the listener runs (when the user left mDNS on); dropping withdraws it.
+    mdns: Option<Box<dyn crate::service_net::Advertisement>>,
+}
+
+impl Running {
+    /// Withdraws the advertisement (goodbye packets), then closes the listener.
+    async fn stop(mut self) {
+        if let Some(ad) = self.mdns.take() {
+            crate::service_net::withdraw(ad).await;
+        }
+        self.handle.stop().await;
+    }
+}
+
+pub struct MobileBridge {
+    pub(crate) core: Arc<BridgeCore>,
+    default_host_name: String,
+    pub(crate) bind_ip: IpAddr,
+    /// Reads the firewall rule (read-only `netsh show`); a fake in tests.
+    pub(crate) firewall: Arc<dyn crate::firewall::NetshRunner>,
+    /// Starts the mDNS advertisement (a fake in tests).
+    pub(crate) advertiser: crate::service_net::AdvertiseFn,
+    /// Tests only: let a fake advertiser run while the listener is on loopback.
+    pub(crate) advertise_on_loopback: bool,
+    running: Mutex<Option<Running>>,
+    last_error: Mutex<Option<String>>,
+    /// Set when this boot can't run the bridge (e.g. host.key unreadable): the
+    /// listener stays off and pairing is refused, but status still answers.
+    fault: Option<String>,
+}
+
+impl MobileBridge {
+    pub fn new(
+        store: MobileStore,
+        host_key: Arc<HostKey>,
+        default_host_name: String,
+        events: Arc<dyn BridgeEvents>,
+    ) -> Arc<Self> {
+        let bridge = Self::with_bind_ip(
+            store,
+            host_key,
+            default_host_name,
+            events,
+            crate::service_net::bind_ip_from_env(),
+        );
+        bridge.set_audit_log(crate::audit::AuditLog::default_location());
+        bridge
+    }
+
+    /// Where the audit log goes (CONTRACT §3.3); `AuditLog::disabled()` turns it off.
+    pub fn set_audit_log(&self, log: crate::audit::AuditLog) {
+        *self.core.audit.write().unwrap_or_else(|p| p.into_inner()) = Arc::new(log);
+    }
+
+    /// `bind_ip` is `0.0.0.0` in production; tests use loopback.
+    pub fn with_bind_ip(
+        store: MobileStore,
+        host_key: Arc<HostKey>,
+        default_host_name: String,
+        events: Arc<dyn BridgeEvents>,
+        bind_ip: IpAddr,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            core: BridgeCore::new(host_key, store, default_host_name.clone(), events),
+            default_host_name,
+            bind_ip,
+            firewall: Arc::new(crate::firewall::ShowOnlyRunner),
+            advertiser: crate::service_net::real_advertiser(),
+            advertise_on_loopback: false,
+            running: Mutex::new(None),
+            last_error: Mutex::new(None),
+            fault: None,
+        })
+    }
+
+    /// A bridge that can't run this boot; `status` reports `reason`.
+    pub fn faulted(
+        store: MobileStore,
+        default_host_name: String,
+        events: Arc<dyn BridgeEvents>,
+        reason: String,
+    ) -> Option<Arc<Self>> {
+        let placeholder = Arc::new(HostKey::generate().ok()?); // in memory only, never saved
+        Some(Arc::new(Self {
+            core: BridgeCore::new(placeholder, store, default_host_name.clone(), events),
+            default_host_name,
+            bind_ip: IpAddr::V4(Ipv4Addr::UNSPECIFIED),
+            firewall: Arc::new(crate::firewall::ShowOnlyRunner),
+            advertiser: crate::service_net::real_advertiser(),
+            advertise_on_loopback: false,
+            running: Mutex::new(None),
+            last_error: Mutex::new(None),
+            fault: Some(reason),
+        }))
+    }
+
+    /// The AionDX app version (from `--app-version`), shown to phones in `/v1/host`.
+    pub fn set_app_version(&self, version: &str) {
+        *self.core.app_version.write().unwrap() = version.to_owned();
+    }
+
+    /// Opens a confirm-key re-issue offer for one of this user's phones (§5.3); returns
+    /// the `aiondx://rekey` URI for the QR code.
+    pub async fn create_rekey_offer(&self, user_id: &str, device_id: &str) -> Result<PairingOffer, AdminFailure> {
+        let device = self
+            .store()
+            .device(device_id)
+            .await?
+            .filter(|d| d.user_id == user_id)
+            .ok_or(AdminFailure::NotFound)?;
+        let secret = random_bytes::<32>()?;
+        let expires_at = aionui_common::now_ms() + crate::pairing::OFFER_TTL_MS;
+        self.core.rekey_offers.lock().unwrap().insert(
+            device.device_id.clone(),
+            crate::core::RekeyOffer {
+                secret,
+                expires_at,
+                attempts: 0,
+                state: crate::core::RekeyState::Pending,
+            },
+        );
+        let uri = format!(
+            "aiondx://rekey?v=1&id={}&d={}&s={}&x={}",
+            self.core.host_key.host_id,
+            device.device_id,
+            crypto::b64u(&secret),
+            expires_at
+        );
+        tracing::info!(user_id, device_id, "mobile bridge: re-key offer created");
+        Ok(PairingOffer {
+            offer_id: device.device_id,
+            uri,
+            expires_at,
+        })
+    }
+
+    /// Clears `lastRecovery` once the user has seen it.
+    pub async fn dismiss_recovery(&self) -> Result<(), MobileError> {
+        self.store().set_last_recovery(None).await
+    }
+
+    pub fn core(&self) -> &Arc<BridgeCore> {
+        &self.core
+    }
+
+    pub fn host_key(&self) -> &Arc<HostKey> {
+        &self.core.host_key
+    }
+
+    pub fn store(&self) -> &MobileStore {
+        &self.core.store
+    }
+
+    /// Replaces the mDNS advertiser (tests use a fake; it may then run on a loopback bind, which the real one never
+    /// does).
+    pub fn set_advertiser(&mut self, advertiser: crate::service_net::AdvertiseFn) {
+        self.advertiser = advertiser;
+        self.advertise_on_loopback = true;
+    }
+
+    /// Replaces the firewall reader (tests use a fake instead of `netsh`).
+    pub fn set_firewall_runner(&mut self, runner: Arc<dyn crate::firewall::NetshRunner>) {
+        self.firewall = runner;
+    }
+
+    /// Installs the mobile facade (`/v1/...` beyond `/v1/host`).
+    pub fn set_facade(&self, facade: Arc<dyn InnerApi>) {
+        *self.core.facade.write().unwrap() = Some(facade);
+    }
+
+    pub(crate) async fn settings_for(&self, user_id: &str) -> Result<MobileSettings, MobileError> {
+        Ok(self
+            .store()
+            .load_settings(user_id)
+            .await?
+            .unwrap_or_else(|| MobileSettings::defaults(self.default_host_name.clone())))
+    }
+
+    /// Starts the listener at boot for the user who left the bridge on.
+    pub async fn start_if_enabled(&self) {
+        match self.store().enabled_users().await {
+            Ok(users) => {
+                if users.len() > 1 {
+                    tracing::warn!(
+                        count = users.len(),
+                        "mobile bridge: enabled for several users; using the most recent"
+                    );
+                }
+                if let Some((user_id, settings)) = users.into_iter().next() {
+                    self.reconcile(&user_id, &settings).await;
+                }
+            }
+            Err(e) => tracing::error!(error = %e, "mobile bridge: could not read settings at startup"),
+        }
+    }
+
+    pub async fn status(&self, user_id: &str) -> Result<MobileStatus, MobileError> {
+        let settings = self.settings_for(user_id).await?;
+        Ok(self.status_from(user_id, &settings).await)
+    }
+
+    pub async fn update_settings(
+        &self,
+        user_id: &str,
+        patch: &MobileSettingsPatch,
+    ) -> Result<MobileStatus, MobileError> {
+        let mut settings = self.settings_for(user_id).await?;
+        settings.apply(patch)?;
+        self.store().save_settings(user_id, &settings).await?;
+        self.reconcile(user_id, &settings).await;
+        Ok(self.status_from(user_id, &settings).await)
+    }
+
+    /// Stops the listener, e.g. at shutdown.
+    pub async fn stop(&self) {
+        if let Some(running) = self.running.lock().await.take() {
+            running.stop().await;
+        }
+    }
+
+    // ---- Pairing and devices (CONTRACT §3.4) -----------------------------------------------
+
+    pub async fn create_offer(&self, user_id: &str) -> Result<PairingOffer, MobileError> {
+        if let Some(fault) = &self.fault {
+            return Err(MobileError::Key(fault.clone()));
+        }
+        let settings = self.settings_for(user_id).await?;
+        let offer = self
+            .core
+            .pairing
+            .create_offer(user_id, aionui_common::now_ms())
+            .map_err(|_| MobileError::Key("could not create a pairing secret".into()))?;
+        let uri = pairing_uri(
+            &self.core.host_key,
+            &settings.host_name,
+            &offer,
+            &self.pairing_urls(&settings),
+        );
+        tracing::info!(user_id, "mobile bridge: pairing offer created");
+        Ok(PairingOffer {
+            offer_id: offer.offer_id,
+            uri,
+            expires_at: offer.expires_at,
+        })
+    }
+
+    pub fn offer(&self, user_id: &str, offer_id: &str) -> Option<OfferView> {
+        self.core.pairing.view(offer_id, user_id, aionui_common::now_ms())
+    }
+
+    /// Approves the pending request and stores the phone.
+    pub async fn approve(&self, user_id: &str, offer_id: &str) -> Result<String, AdminFailure> {
+        let device = self
+            .core
+            .pairing
+            .approve(offer_id, user_id, aionui_common::now_ms())
+            .map_err(admin_failure)?;
+        let confirm_key_sealed = match device.confirm_key {
+            Some(key) => Some(seal_confirm_key(self.core.host_key.data_key(), &key)?),
+            None => None,
+        };
+        self.store()
+            .insert_device(&DeviceRow {
+                device_id: device.device_id.clone(),
+                user_id: user_id.to_owned(),
+                device_pk: device.device_pk.to_vec(),
+                name: device.device_name,
+                platform: device.platform,
+                app_version: device.app_version,
+                confirm_mode: device.confirm_mode,
+                confirm_key_sealed,
+                require_confirm: true,
+                paired_at: aionui_common::now_ms(),
+                last_seen_at: None,
+                last_address: None,
+            })
+            .await?;
+        self.core.events.emit(
+            user_id,
+            "mobile.deviceChanged",
+            serde_json::json!({ "deviceId": device.device_id, "change": "paired" }),
+        );
+        tracing::info!(user_id, device_id = %device.device_id, "mobile bridge: phone paired");
+        self.core.audit().event(&device.device_id, "pair approved", "ok");
+        Ok(device.device_id)
+    }
+
+    pub fn reject(&self, user_id: &str, offer_id: &str) -> Result<(), AdminFailure> {
+        self.core
+            .pairing
+            .reject(offer_id, user_id, aionui_common::now_ms())
+            .map_err(admin_failure)
+    }
+
+    pub async fn devices(&self, user_id: &str) -> Result<Vec<DeviceView>, MobileError> {
+        let rows = self.store().devices_for(user_id).await?;
+        Ok(rows
+            .into_iter()
+            .map(|d| DeviceView {
+                active_sessions: self.core.sessions.count_for(&d.device_id),
+                device_id: d.device_id,
+                name: d.name,
+                platform: d.platform,
+                app_version: d.app_version,
+                paired_at: d.paired_at,
+                last_seen_at: d.last_seen_at,
+                last_address: d.last_address,
+                require_confirm: d.require_confirm,
+                confirm_mode: d.confirm_mode,
+            })
+            .collect())
+    }
+
+    pub async fn update_device(
+        &self,
+        user_id: &str,
+        device_id: &str,
+        name: Option<&str>,
+        require_confirm: Option<bool>,
+    ) -> Result<(), AdminFailure> {
+        if !self
+            .store()
+            .update_device(user_id, device_id, name, require_confirm)
+            .await?
+        {
+            return Err(AdminFailure::NotFound);
+        }
+        self.core.events.emit(
+            user_id,
+            "mobile.deviceChanged",
+            serde_json::json!({ "deviceId": device_id, "change": "updated" }),
+        );
+        Ok(())
+    }
+
+    /// Revokes a phone: its row, its confirm key and every session go (A1).
+    pub async fn revoke(&self, user_id: &str, device_id: &str) -> Result<(), AdminFailure> {
+        if !self.store().revoke_device(user_id, device_id).await? {
+            return Err(AdminFailure::NotFound);
+        }
+        self.core.sessions.drop_device(device_id);
+        self.core.events.emit(
+            user_id,
+            "mobile.deviceChanged",
+            serde_json::json!({ "deviceId": device_id, "change": "revoked" }),
+        );
+        tracing::info!(user_id, device_id, "mobile bridge: phone revoked");
+        self.core.audit().event(device_id, "device revoked", "ok");
+        Ok(())
+    }
+
+    /// Makes the listener match `settings` for `user_id`.
+    async fn reconcile(&self, user_id: &str, settings: &MobileSettings) {
+        let mut running = self.running.lock().await;
+        if running.is_none() || matches!(&*running, Some(r) if r.user_id == user_id) {
+            *self.core.host_name.write().unwrap() = settings.host_name.clone();
+        }
+        let keep = matches!(&*running, Some(r) if settings.enabled && r.user_id == user_id && r.port == settings.port);
+        if keep {
+            // The listener stays; only the advertisement follows the mDNS switch (QA M5b).
+            if let Some(r) = running.as_mut() {
+                match (r.mdns.is_some(), settings.mdns) {
+                    (true, false) => {
+                        if let Some(ad) = r.mdns.take() {
+                            crate::service_net::withdraw(ad).await;
+                            tracing::info!("mobile bridge: mDNS advertisement withdrawn");
+                        }
+                    }
+                    (false, true) => r.mdns = self.advertise(settings),
+                    _ => {}
+                }
+            }
+            return;
+        }
+        let other_user = matches!(&*running, Some(r) if r.user_id != user_id);
+        if other_user && !settings.enabled {
+            return; // someone else's bridge; this user switching off changes nothing
+        }
+        if let Some(old) = running.take() {
+            old.stop().await;
+        }
+        *self.last_error.lock().await = None;
+        if !settings.enabled {
+            return;
+        }
+        if let Some(fault) = &self.fault {
+            *self.last_error.lock().await = Some(fault.clone());
+            return;
+        }
+        let router = listener::outer_router(self.core.clone());
+        match listener::start(self.bind_ip, settings.port, router).await {
+            Ok(handle) => {
+                let mdns = self.advertise(settings);
+                *running = Some(Running {
+                    user_id: user_id.to_owned(),
+                    port: settings.port,
+                    handle,
+                    mdns,
+                });
+            }
+            Err(e) => {
+                tracing::error!(error = %e, port = settings.port, "mobile bridge: listener did not start");
+                *self.last_error.lock().await = Some(e.to_string());
+            }
+        }
+    }
+
+    async fn status_from(&self, user_id: &str, settings: &MobileSettings) -> MobileStatus {
+        let listening = matches!(&*self.running.lock().await, Some(r) if r.user_id == user_id);
+        MobileStatus {
+            enabled: settings.enabled,
+            port: settings.port,
+            urls: self.pairing_urls(settings),
+            extra_urls: settings.extra_urls.clone(),
+            host_id: self.core.host_key.host_id.clone(),
+            host_name: settings.host_name.clone(),
+            mdns: settings.mdns && !self.bind_ip.is_loopback(),
+            mdns_setting: settings.mdns,
+            mdns_off_reason: (settings.mdns && self.bind_ip.is_loopback()).then_some("loopback_bind"),
+            tasks_write: settings.tasks_write,
+            listening,
+            error: match &self.fault {
+                Some(fault) => Some(fault.clone()),
+                None => self.last_error.lock().await.clone(),
+            },
+            last_recovery: self.store().last_recovery().await.ok().flatten(),
+        }
+    }
+}
