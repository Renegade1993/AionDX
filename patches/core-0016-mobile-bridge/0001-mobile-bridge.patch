index 00000000..7e07e640
--- /dev/null
+++ b/crates/aionui-mobile/src/netinfo.rs
@@ -0,0 +1,555 @@
+//! This PC's private addresses, for the pairing QR's `u=` list and the mDNS advertisement (CONTRACT §7,
+//! PHASE5-NET-SPEC §A). Only addresses `peer_filter::is_private_peer` accepts ever leave this module, so a public
+//! address can never reach a QR or a TXT record.
+
+use std::net::IpAddr;
+
+use crate::peer_filter::is_private_peer;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct LocalAddress {
+    pub ip: IpAddr,
+    /// The adapter's name as the OS shows it ("Ethernet", "Wi-Fi"); also the zone of a link-local IPv6 URL.
+    pub interface: String,
+}
+
+// IF_TYPE values (windows-sys Win32::NetworkManagement::IpHelper), here so ordering is testable on any platform.
+const IF_TYPE_ETHERNET: u32 = 6;
+const IF_TYPE_WIFI: u32 = 71;
+const IF_TYPE_PROP_VIRTUAL: u32 = 53;
+const IF_TYPE_TUNNEL: u32 = 131;
+
+/// Adapters that report a physical type but are virtual or VPN: matched, lowercased, against the adapter's name
+/// and description. Only used for ordering; nothing is excluded for matching.
+const KNOWN_VIRTUAL: &[&str] = &[
+    "hyper-v",
+    "vethernet",
+    "wsl",
+    "virtualbox",
+    "vmware",
+    "radmin",
+    "pdanet",
+    "nordlynx",
+    "tap-windows",
+    "wintun",
+    "wireguard",
+];
+
+#[derive(Debug, Clone)]
+struct Candidate {
+    ip: IpAddr,
+    interface: String,
+    /// The adapter's IF_TYPE.
+    if_type: u32,
+    /// The adapter has a default gateway.
+    has_gateway: bool,
+    /// The adapter's TUNNEL_TYPE and description, for `is_transition_tunnel`.
+    tunnel_type: i32,
+    description: String,
+}
+
+/// The order of the spec: RFC 1918 IPv4, 100.64/10, link-local IPv4, IPv6 ULA, IPv6 link-local. None for anything
+/// that must not be listed.
+fn range_rank(ip: IpAddr) -> Option<u8> {
+    if ip.is_loopback() || ip.is_unspecified() || !is_private_peer(ip) {
+        return None;
+    }
+    match ip {
+        IpAddr::V4(v4) => {
+            let [a, b, ..] = v4.octets();
+            Some(if v4.is_private() {
+                0
+            } else if a == 100 && (64..=127).contains(&b) {
+                1
+            } else {
+                2
+            })
+        }
+        // An IPv4-mapped IPv6 address is not a real interface address.
+        IpAddr::V6(v6) if v6.to_ipv4_mapped().is_some() => None,
+        IpAddr::V6(v6) => Some(if (v6.segments()[0] & 0xfe00) == 0xfc00 { 3 } else { 4 }),
+    }
+}
+
+/// Filters, orders and de-duplicates what the OS listed. Within RFC 1918: adapters with a gateway first, then
+/// Ethernet before Wi-Fi before anything else; otherwise the OS's own order.
+/// Virtual or VPN: IF_TYPE_PROP_VIRTUAL (wintun, WireGuard, NordLynx), a tunnel, or a known-virtual name.
+fn is_virtual(c: &Candidate) -> bool {
+    if matches!(c.if_type, IF_TYPE_PROP_VIRTUAL | IF_TYPE_TUNNEL) {
+        return true;
+    }
+    let name = c.interface.to_ascii_lowercase();
+    let desc = c.description.to_ascii_lowercase();
+    KNOWN_VIRTUAL.iter().any(|v| name.contains(v) || desc.contains(v))
+}
+
+/// Within an address range: a physical Ethernet or Wi-Fi adapter with a default gateway (the LAN the phone is on)
+/// first, then other physical adapters, then virtual and VPN adapters whatever their gateway (a connected VPN such
+/// as NordLynx has one).
+fn tier(c: &Candidate) -> u8 {
+    if is_virtual(c) {
+        2
+    } else if matches!(c.if_type, IF_TYPE_ETHERNET | IF_TYPE_WIFI) && c.has_gateway {
+        0
+    } else {
+        1
+    }
+}
+
+fn kind_rank(if_type: u32) -> u8 {
+    match if_type {
+        IF_TYPE_ETHERNET => 0,
+        IF_TYPE_WIFI => 1,
+        _ => 2,
+    }
+}
+
+fn order(candidates: Vec<Candidate>) -> Vec<LocalAddress> {
+    let mut ranked: Vec<((u8, u8, u8, usize), Candidate)> = candidates
+        .into_iter()
+        .enumerate()
+        .filter(|(_, c)| !is_transition_tunnel(c.tunnel_type, &c.description))
+        .filter_map(|(i, c)| range_rank(c.ip).map(|r| ((r, tier(&c), kind_rank(c.if_type), i), c)))
+        .collect();
+    ranked.sort_by_key(|(key, _)| *key);
+    let mut out: Vec<LocalAddress> = Vec::new();
+    for (.., c) in ranked {
+        if !out.iter().any(|a| a.ip == c.ip) {
+            out.push(LocalAddress {
+                ip: c.ip,
+                interface: c.interface,
+            });
+        }
+    }
+    out
+}
+
+// TUNNEL_TYPE values (windows-sys Win32::NetworkManagement::Ndis), here so the rule is testable on any platform.
+const TUNNEL_TYPE_6TO4: i32 = 11;
+const TUNNEL_TYPE_ISATAP: i32 = 13;
+const TUNNEL_TYPE_TEREDO: i32 = 14;
+
+/// Teredo, ISATAP and 6to4: IPv6-transition tunnels no phone on the LAN can reach through. Keyed on the adapter's
+/// tunnel type, with its description as a fallback, and never on the interface type, so WireGuard and wintun
+/// adapters (IF_TYPE_PROP_VIRTUAL, tunnel type none) always stay: Private Party Net is a WireGuard tunnel.
+fn is_transition_tunnel(tunnel_type: i32, description: &str) -> bool {
+    if matches!(tunnel_type, TUNNEL_TYPE_6TO4 | TUNNEL_TYPE_ISATAP | TUNNEL_TYPE_TEREDO) {
+        return true;
+    }
+    let d = description.to_ascii_lowercase();
+    d.contains("teredo") || d.contains("isatap") || d.contains("6to4")
+}
+
+/// Every UP, non-loopback address on this PC that `peer_filter::is_private_peer` accepts, IPv6-transition tunnel
+/// adapters (Teredo, ISATAP, 6to4) excluded. Order by range: RFC 1918 IPv4, then 100.64/10 (Tailscale), then
+/// link-local IPv4, then IPv6 ULA, then IPv6 link-local; within a range by `tier` (physical with a gateway, other
+/// physical, virtual/VPN), then Ethernet before Wi-Fi, then the OS's order. Duplicates removed. Empty on other
+/// platforms than Windows.
+pub fn private_addresses() -> Vec<LocalAddress> {
+    order(os::candidates())
+}
+
+/// The QR's `u=` list for `port`: one URL per address, in the order given; IPv6 bracketed. Link-local IPv6 is never
+/// listed: its zone id is the PC's own interface, which means nothing on the phone (lead's decision, 2026-11-08);
+/// link-local IPv4 needs none and stays. An address that is not private is left out, and a repeated URL is listed
+/// once.
+pub fn pairing_urls(addresses: &[LocalAddress], port: u16) -> Vec<String> {
+    let mut out: Vec<String> = Vec::new();
+    for a in addresses {
+        if range_rank(a.ip).is_none() {
+            continue;
+        }
+        let url = match a.ip {
+            IpAddr::V4(v4) => format!("http://{v4}:{port}"),
+            IpAddr::V6(v6) if (v6.segments()[0] & 0xffc0) == 0xfe80 => continue,
+            IpAddr::V6(v6) => format!("http://[{v6}]:{port}"),
+        };
+        if !out.contains(&url) {
+            out.push(url);
+        }
+    }
+    out
+}
+
+#[cfg(windows)]
+mod os {
+    use std::net::{IpAddr, Ipv4Addr, Ipv6Addr};
+
+    use windows_sys::Win32::Foundation::ERROR_BUFFER_OVERFLOW;
+    use windows_sys::Win32::NetworkManagement::IpHelper::{
+        GAA_FLAG_INCLUDE_GATEWAYS, GAA_FLAG_SKIP_ANYCAST, GAA_FLAG_SKIP_DNS_SERVER, GAA_FLAG_SKIP_MULTICAST,
+        GetAdaptersAddresses, IF_TYPE_SOFTWARE_LOOPBACK, IP_ADAPTER_ADDRESSES_LH, IP_ADAPTER_UNICAST_ADDRESS_LH,
+    };
+    use windows_sys::Win32::NetworkManagement::Ndis::IfOperStatusUp;
+    use windows_sys::Win32::Networking::WinSock::{AF_INET, AF_INET6, AF_UNSPEC, IpDadStatePreferred, SOCKET_ADDRESS};
+
+    use super::Candidate;
+
+    /// A NUL-terminated UTF-16 string from the OS.
+    ///
+    /// # Safety
+    /// `p` is null or points at a NUL-terminated UTF-16 string that stays valid for the call.
+    unsafe fn wide(p: *const u16) -> String {
+        if p.is_null() {
+            return String::new();
+        }
+        let mut len = 0;
+        // SAFETY: the caller guarantees a NUL terminator.
+        while unsafe { *p.add(len) } != 0 {
+            len += 1;
+        }
+        // SAFETY: `len` u16s were just read from `p`.
+        String::from_utf16_lossy(unsafe { std::slice::from_raw_parts(p, len) })
+    }
+
+    /// # Safety
+    /// `sa.lpSockaddr` is null or points at `sa.iSockaddrLength` readable bytes.
+    unsafe fn ip_of(sa: &SOCKET_ADDRESS) -> Option<IpAddr> {
+        if sa.lpSockaddr.is_null() || sa.iSockaddrLength < 2 {
+            return None;
+        }
+        // SAFETY: the OS gives a buffer of iSockaddrLength bytes.
+        let bytes = unsafe { std::slice::from_raw_parts(sa.lpSockaddr as *const u8, sa.iSockaddrLength as usize) };
+        let family = u16::from_ne_bytes([bytes[0], bytes[1]]);
+        if family == AF_INET && bytes.len() >= 8 {
+            Some(IpAddr::V4(Ipv4Addr::new(bytes[4], bytes[5], bytes[6], bytes[7])))
+        } else if family == AF_INET6 && bytes.len() >= 24 {
+            let mut a = [0u8; 16];
+            a.copy_from_slice(&bytes[8..24]);
+            Some(IpAddr::V6(Ipv6Addr::from(a)))
+        } else {
+            None
+        }
+    }
+
+    pub(super) fn candidates() -> Vec<Candidate> {
+        let flags =
+            GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER | GAA_FLAG_INCLUDE_GATEWAYS;
+        let mut size: u32 = 16 * 1024;
+        for _ in 0..4 {
+            // u64 elements keep the buffer aligned for the structs the OS writes into it.
+            let mut buf: Vec<u64> = vec![0; (size as usize).div_ceil(8)];
+            let head = buf.as_mut_ptr() as *mut IP_ADAPTER_ADDRESSES_LH;
+            // SAFETY: `head` points at `size` writable bytes; the OS updates `size` when that is too small.
+            let rc = unsafe { GetAdaptersAddresses(AF_UNSPEC as u32, flags, std::ptr::null(), head, &mut size) };
+            if rc == ERROR_BUFFER_OVERFLOW {
+                continue;
+            }
+            if rc != 0 {
+                return Vec::new();
+            }
+            let mut out = Vec::new();
+            let mut adapter = head as *const IP_ADAPTER_ADDRESSES_LH;
+            while !adapter.is_null() {
+                // SAFETY: a node of the list the OS just wrote into `buf`, which is still alive.
+                let a = unsafe { &*adapter };
+                if a.OperStatus == IfOperStatusUp && a.IfType != IF_TYPE_SOFTWARE_LOOPBACK {
+                    // SAFETY: FriendlyName is a NUL-terminated string inside `buf`.
+                    let interface = unsafe { wide(a.FriendlyName) };
+                    let has_gateway = !a.FirstGatewayAddress.is_null();
+                    // SAFETY: Description is a NUL-terminated string inside `buf`.
+                    let description = unsafe { wide(a.Description) };
+                    let mut unicast: *const IP_ADAPTER_UNICAST_ADDRESS_LH = a.FirstUnicastAddress;
+                    while !unicast.is_null() {
+                        // SAFETY: as for the adapter node.
+                        let u = unsafe { &*unicast };
+                        // Tentative, duplicate or deprecated addresses are not reachable.
+                        if u.DadState == IpDadStatePreferred {
+                            // SAFETY: the sockaddr lives in `buf`.
+                            if let Some(ip) = unsafe { ip_of(&u.Address) } {
+                                out.push(Candidate {
+                                    ip,
+                                    interface: interface.clone(),
+                                    if_type: a.IfType,
+                                    has_gateway,
+                                    tunnel_type: a.TunnelType,
+                                    description: description.clone(),
+                                });
+                            }
+                        }
+                        unicast = u.Next;
+                    }
+                }
+                adapter = a.Next;
+            }
+            return out;
+        }
+        Vec::new()
+    }
+}
+
+#[cfg(not(windows))]
+mod os {
+    pub(super) fn candidates() -> Vec<super::Candidate> {
+        Vec::new()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
