+#[tokio::test]
+async fn outer_errors_are_plaintext_codes() {
+    let (bridge, router) = setup().await;
+    let offer = new_offer(&bridge).await;
+    let phone = Phone::new("dev-1");
+
+    let mut wrong_host = phone.pair_body(&offer, false, now());
+    wrong_host["hostId"] = json!("someone-else");
+    let (status, body) = post(&router, "/api/mobile/v1/pair", &wrong_host).await;
+    assert_eq!(status, StatusCode::CONFLICT);
+    assert_eq!(body["error"], "unknown_host");
+    assert_eq!(body["hostId"], offer.host_id);
+
+    let (status, body) = post(
+        &router,
+        "/api/mobile/v1/pair",
+        &phone.pair_body(&offer, false, now() - 10 * 60 * 1000),
+    )
+    .await;
+    assert_eq!(status, StatusCode::BAD_REQUEST);
+    assert_eq!(body["error"], "clock_skew");
+    assert!(body["hostTime"].as_i64().is_some());
+
+    let mut bad_secret = Offer {
+        secret: vec![0; 32],
+        ..new_offer(&bridge).await
+    };
+    bad_secret.offer_id.clear();
+    let (status, body) = post(
+        &router,
+        "/api/mobile/v1/pair",
+        &phone.pair_body(&bad_secret, false, now()),
+    )
+    .await;
+    assert_eq!(
+        (status, body),
+        (StatusCode::UNAUTHORIZED, json!({ "error": "auth_failed" })),
+        "a request that never saw the QR"
+    );
+
+    let (status, body) = post(
+        &router,
+        "/api/mobile/v1/rpc",
+        &json!({ "v": 1, "sid": b64u(&[0u8; 16]), "seq": 1, "nonce": b64u(&[0u8; 24]), "ct": "AA" }),
+    )
+    .await;
+    assert_eq!(
+        (status, body),
+        (StatusCode::UNAUTHORIZED, json!({ "error": "unknown_session" }))
+    );
+    let (status, body) = post(&router, "/api/mobile/v1/rpc", &json!({ "nope": 1 })).await;
+    assert_eq!(
+        (status, body),
+        (StatusCode::BAD_REQUEST, json!({ "error": "malformed" }))
+    );
+}
