@@ -0,0 +1,768 @@
+//! The change journal behind `GET /v1/changes` (CONTRACT §6.2, PHASE4-CORE-SPEC §1).
+//!
+//! One ordered log for the whole process; every entry carries its Core user and a revision number that only ever
+//! grows. A token is `"<epoch>.<rev>"`: the epoch is random per process, so a token from before a restart resets.
+
+use std::collections::{HashMap, VecDeque};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use serde::{Deserialize, Serialize};
+use tokio::sync::Notify;
+
+use crate::crypto::b64u;
+
+/// One change, exactly the JSON of CONTRACT §6.2 `ChangeEntry`.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+pub enum ChangeEntry {
+    Team {
+        #[serde(rename = "teamId")]
+        team_id: String,
+        what: Vec<TeamWhat>,
+    },
+    TeamRemoved {
+        #[serde(rename = "teamId")]
+        team_id: String,
+    },
+    Conversation {
+        #[serde(rename = "conversationId")]
+        conversation_id: String,
+        #[serde(rename = "teamId", default, skip_serializing_if = "Option::is_none")]
+        team_id: Option<String>,
+        #[serde(rename = "slotId", default, skip_serializing_if = "Option::is_none")]
+        slot_id: Option<String>,
+        what: Vec<ConversationWhat>,
+    },
+    ConversationRemoved {
+        #[serde(rename = "conversationId")]
+        conversation_id: String,
+    },
+    ApprovalAdded {
+        approval: serde_json::Value,
+    },
+    ApprovalRemoved {
+        #[serde(rename = "approvalId")]
+        approval_id: String,
+        #[serde(rename = "conversationId")]
+        conversation_id: String,
+        #[serde(rename = "teamId", default, skip_serializing_if = "Option::is_none")]
+        team_id: Option<String>,
+        resolution: Resolution,
+    },
+    Task {
+        #[serde(rename = "teamId")]
+        team_id: String,
+        task: serde_json::Value,
+        change: TaskChange,
+    },
+    Broadcast {
+        #[serde(rename = "teamId")]
+        team_id: String,
+        #[serde(rename = "broadcastId")]
+        broadcast_id: String,
+    },
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum TeamWhat {
+    Roster,
+    RunState,
+    Meta,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ConversationWhat {
+    Messages,
+    State,
+    Meta,
+    Read,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Resolution {
+    Answered,
+    Cancelled,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum TaskChange {
+    Created,
+    Updated,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize)]
+pub struct ChangesPage {
+    pub token: String,
+    pub reset: bool,
+    pub more: bool,
+    pub changes: Vec<ChangeEntry>,
+}
+
+/// What coalesces with what. An approval's added and removed entries share one key, so "added then removed"
+/// collapses to the removed entry (spec rule 3).
+#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+enum Key {
+    Team(String),
+    TeamRemoved(String),
+    Conversation(String),
+    ConversationRemoved(String),
+    Approval(String),
+    Task(String),
+    Broadcast(String),
+    /// An entry with no usable id (a task without `taskId`): never coalesced.
+    Unique(u64),
+}
+
+fn key_of(entry: &ChangeEntry, rev: u64) -> Key {
+    match entry {
+        ChangeEntry::Team { team_id, .. } => Key::Team(team_id.clone()),
+        ChangeEntry::TeamRemoved { team_id } => Key::TeamRemoved(team_id.clone()),
+        ChangeEntry::Conversation { conversation_id, .. } => Key::Conversation(conversation_id.clone()),
+        ChangeEntry::ConversationRemoved { conversation_id } => Key::ConversationRemoved(conversation_id.clone()),
+        ChangeEntry::ApprovalAdded { approval } => match approval.get("approvalId").and_then(|v| v.as_str()) {
+            Some(id) => Key::Approval(id.to_owned()),
+            None => Key::Unique(rev),
+        },
+        ChangeEntry::ApprovalRemoved { approval_id, .. } => Key::Approval(approval_id.clone()),
+        ChangeEntry::Task { task, .. } => match task.get("taskId").and_then(|v| v.as_str()) {
+            Some(id) => Key::Task(id.to_owned()),
+            None => Key::Unique(rev),
+        },
+        ChangeEntry::Broadcast { broadcast_id, .. } => Key::Broadcast(broadcast_id.clone()),
+    }
+}
+
+fn union<T: PartialEq + Copy>(into: &mut Vec<T>, from: &[T]) {
+    for w in from {
+        if !into.contains(w) {
+            into.push(*w);
+        }
+    }
+}
+
+/// `older` and `newer` share a key; returns what the newer state should read as.
+fn merge(older: ChangeEntry, newer: ChangeEntry) -> ChangeEntry {
+    match (older, newer) {
+        (ChangeEntry::Team { what: mut a, .. }, ChangeEntry::Team { team_id, what: b }) => {
+            union(&mut a, &b);
+            ChangeEntry::Team { team_id, what: a }
+        }
+        (
+            ChangeEntry::Conversation {
+                team_id: t0,
+                slot_id: s0,
+                what: mut a,
+                ..
+            },
+            ChangeEntry::Conversation {
+                conversation_id,
+                team_id,
+                slot_id,
+                what: b,
+            },
+        ) => {
+            union(&mut a, &b);
+            ChangeEntry::Conversation {
+                conversation_id,
+                team_id: team_id.or(t0),
+                slot_id: slot_id.or(s0),
+                what: a,
+            }
+        }
+        (_, newer) => newer,
+    }
+}
+
+struct Record {
+    rev: u64,
+    at_ms: i64,
+    user_id: String,
+    entry: ChangeEntry,
+}
+
+struct Inner {
+    log: VecDeque<Record>,
+    /// The revision of the newest entry ever recorded (0 before the first).
+    rev: u64,
+    /// The highest revision ever dropped by retention: a token below it may have missed entries.
+    dropped_through: u64,
+    waiters: HashMap<String, Arc<Notify>>,
+}
+
+pub struct ChangeJournal {
+    epoch: String,
+    max_entries: usize,
+    max_age_ms: i64,
+    inner: Mutex<Inner>,
+}
+
+fn now_ms() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_millis() as i64)
+        .unwrap_or(0)
+}
+
+fn random_epoch() -> String {
+    let mut buf = [0u8; 6];
+    if getrandom::getrandom(&mut buf).is_err() {
+        // Still distinct per process start, which is all an epoch has to be.
+        buf.copy_from_slice(&now_ms().to_le_bytes()[..6]);
+    }
+    b64u(&buf)
+}
+
+impl ChangeJournal {
+    /// `max_entries` = 50_000 and `max_age_ms` = 24 h in production; small values in tests.
+    pub fn new(max_entries: usize, max_age_ms: i64) -> Self {
+        Self::with_epoch(random_epoch(), max_entries, max_age_ms)
+    }
+
+    fn with_epoch(epoch: String, max_entries: usize, max_age_ms: i64) -> Self {
+        Self {
+            epoch,
+            max_entries: max_entries.max(1),
+            max_age_ms,
+            inner: Mutex::new(Inner {
+                log: VecDeque::new(),
+                rev: 0,
+                dropped_through: 0,
+                waiters: HashMap::new(),
+            }),
+        }
+    }
+
+    /// Random per process; a restart means a new epoch.
+    pub fn epoch(&self) -> &str {
+        &self.epoch
+    }
+
+    fn token(&self, rev: u64) -> String {
+        format!("{}.{}", self.epoch, rev)
+    }
+
+    fn prune(&self, inner: &mut Inner, now_ms: i64) {
+        while let Some(front) = inner.log.front() {
+            let too_many = inner.log.len() > self.max_entries;
+            let too_old = now_ms - front.at_ms > self.max_age_ms;
+            if !too_many && !too_old {
+                break;
+            }
+            inner.dropped_through = front.rev;
+            inner.log.pop_front();
+        }
+    }
+
+    fn lock(&self) -> std::sync::MutexGuard<'_, Inner> {
+        self.inner.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+    }
+
+    /// Records a change for one Core user.
+    pub fn record(&self, user_id: &str, entry: ChangeEntry, now_ms: i64) {
+        let waiter = {
+            let mut inner = self.lock();
+            inner.rev += 1;
+            let rev = inner.rev;
+            inner.log.push_back(Record {
+                rev,
+                at_ms: now_ms,
+                user_id: user_id.to_owned(),
+                entry,
+            });
+            self.prune(&mut inner, now_ms);
+            inner.waiters.get(user_id).cloned()
+        };
+        if let Some(w) = waiter {
+            w.notify_waiters();
+        }
+    }
+
+    /// The revision a token names, or None when it must reset (another epoch, malformed, or from the future).
+    fn parse_token(&self, token: &str, current: u64) -> Option<u64> {
+        let (epoch, rev) = token.rsplit_once('.')?;
+        if epoch != self.epoch {
+            return None;
+        }
+        let rev: u64 = rev.parse().ok()?;
+        (rev <= current).then_some(rev)
+    }
+
+    /// Non-blocking read.
+    pub fn since(&self, user_id: &str, token: Option<&str>, limit: usize, now_ms: i64) -> ChangesPage {
+        let mut inner = self.lock();
+        self.prune(&mut inner, now_ms);
+        let current = inner.rev;
+        let empty = |reset: bool| ChangesPage {
+            token: self.token(current),
+            reset,
+            more: false,
+            changes: Vec::new(),
+        };
+        let Some(token) = token else { return empty(false) };
+        let Some(from) = self.parse_token(token, current) else {
+            return empty(true);
+        };
+        if from < inner.dropped_through {
+            return empty(true);
+        }
+
+        let limit = limit.max(1);
+        let start = inner.log.partition_point(|r| r.rev <= from);
+        // Slots in the order of each key's latest change; a key seen again leaves a hole and moves to the end.
+        let mut slots: Vec<Option<ChangeEntry>> = Vec::new();
+        let mut at: HashMap<Key, usize> = HashMap::new();
+        let mut last_rev = from;
+        let mut more = false;
+        for record in inner.log.iter().skip(start) {
+            if record.user_id != user_id {
+                continue;
+            }
+            let key = key_of(&record.entry, record.rev);
+            let merged = match at.get(&key) {
+                Some(&i) => {
+                    let older = slots[i].take().expect("a live slot");
+                    merge(older, record.entry.clone())
+                }
+                None => {
+                    if at.len() == limit {
+                        more = true;
+                        break;
+                    }
+                    record.entry.clone()
+                }
+            };
+            at.insert(key, slots.len());
+            slots.push(Some(merged));
+            last_rev = record.rev;
+        }
+        // With no more of this user's entries, the token can move to the newest revision overall.
+        let next = if more { last_rev } else { current };
+        ChangesPage {
+            token: self.token(next),
+            reset: false,
+            more,
+            changes: slots.into_iter().flatten().collect(),
+        }
+    }
+
+    /// Long-poll: returns at once if `since` would return changes, or if `token` is None; otherwise waits until
+    /// something is recorded for THIS user or `wait` passes, then returns `since(...)`.
+    pub async fn wait_since(&self, user_id: &str, token: Option<&str>, wait: Duration, limit: usize) -> ChangesPage {
+        let deadline = tokio::time::Instant::now() + wait;
+        let notify = {
+            let mut inner = self.lock();
+            inner
+                .waiters
+                .entry(user_id.to_owned())
+                .or_insert_with(|| Arc::new(Notify::new()))
+                .clone()
+        };
+        loop {
+            // Armed before the check, so a record() between the check and the wait still wakes this waiter.
+            let notified = notify.notified();
+            tokio::pin!(notified);
+            notified.as_mut().enable();
+            let page = self.since(user_id, token, limit, now_ms());
+            if token.is_none() || page.reset || !page.changes.is_empty() {
+                return page;
+            }
+            if tokio::time::timeout_at(deadline, notified).await.is_err() {
+                return self.since(user_id, token, limit, now_ms());
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    const BIG: i64 = 24 * 3600 * 1000;
+
+    fn journal() -> ChangeJournal {
+        ChangeJournal::with_epoch("ep0".into(), 1000, BIG)
+    }
+    fn team(id: &str, what: &[TeamWhat]) -> ChangeEntry {
+        ChangeEntry::Team {
+            team_id: id.into(),
+            what: what.to_vec(),
+        }
+    }
+    fn conv(id: &str, what: &[ConversationWhat]) -> ChangeEntry {
+        ChangeEntry::Conversation {
+            conversation_id: id.into(),
+            team_id: None,
+            slot_id: None,
+            what: what.to_vec(),
+        }
+    }
+    fn added(id: &str) -> ChangeEntry {
+        ChangeEntry::ApprovalAdded {
+            approval: json!({ "approvalId": id, "kind": "permission" }),
+        }
+    }
+    fn removed(id: &str) -> ChangeEntry {
+        ChangeEntry::ApprovalRemoved {
+            approval_id: id.into(),
+            conversation_id: "c1".into(),
+            team_id: None,
+            resolution: Resolution::Answered,
+        }
+    }
+    fn first_token(j: &ChangeJournal, user: &str) -> String {
+        j.since(user, None, 500, 0).token
+    }
+
+    #[test]
+    fn json_matches_the_contract() {
+        let e = ChangeEntry::Conversation {
+            conversation_id: "c1".into(),
+            team_id: Some("t1".into()),
+            slot_id: None,
+            what: vec![ConversationWhat::Messages, ConversationWhat::Read],
+        };
+        assert_eq!(
+            serde_json::to_value(&e).unwrap(),
+            json!({ "kind": "conversation", "conversationId": "c1", "teamId": "t1", "what": ["messages", "read"] })
+        );
+        assert_eq!(
+            serde_json::to_value(team("t1", &[TeamWhat::RunState])).unwrap(),
+            json!({ "kind": "team", "teamId": "t1", "what": ["run_state"] })
+        );
+        assert_eq!(
+            serde_json::to_value(removed("a1")).unwrap(),
+            json!({ "kind": "approval_removed", "approvalId": "a1", "conversationId": "c1", "resolution": "answered" })
+        );
+        let page = ChangesPage {
+            token: "e.1".into(),
+            reset: false,
+            more: false,
+            changes: vec![],
+        };
+        assert_eq!(
+            serde_json::to_value(page).unwrap(),
+            json!({ "token": "e.1", "reset": false, "more": false, "changes": [] })
+        );
+    }
+
+    #[test]
+    fn rule1_no_token_gives_the_current_token_and_nothing_else() {
+        let j = journal();
+        j.record("u1", team("t1", &[TeamWhat::Meta]), 0);
+        let page = j.since("u1", None, 500, 0);
+        assert_eq!(
+            page,
+            ChangesPage {
+                token: "ep0.1".into(),
+                reset: false,
+                more: false,
+                changes: vec![]
+            }
+        );
+    }
+
+    #[tokio::test]
+    async fn rule1_no_token_never_waits() {
+        let j = journal();
+        let started = std::time::Instant::now();
+        let page = j.wait_since("u1", None, Duration::from_secs(10), 500).await;
+        assert!(started.elapsed() < Duration::from_secs(1));
+        assert!(!page.reset && page.changes.is_empty());
+    }
+
+    #[test]
+    fn rule2_other_epoch_malformed_and_future_tokens_reset() {
+        let j = journal();
+        j.record("u1", team("t1", &[TeamWhat::Meta]), 0);
+        for bad in ["other.0", "garbage", "ep0.x", "ep0.", "ep0.99", ""] {
+            let page = j.since("u1", Some(bad), 500, 0);
+            assert!(page.reset, "{bad} should reset");
+            assert!(page.changes.is_empty());
+            assert_eq!(page.token, "ep0.1");
+        }
+    }
+
+    #[test]
+    fn rule3_one_entry_per_key_in_latest_change_order_newest_wins() {
+        let j = journal();
+        let t = first_token(&j, "u1");
+        j.record("u1", conv("c1", &[ConversationWhat::Messages]), 1);
+        j.record("u1", team("t1", &[TeamWhat::Roster]), 2);
+        j.record(
+            "u1",
+            conv("c1", &[ConversationWhat::State, ConversationWhat::Messages]),
+            3,
+        );
+        j.record("u1", team("t1", &[TeamWhat::RunState]), 4);
+        j.record("u1", conv("c2", &[ConversationWhat::Read]), 5);
+        let page = j.since("u1", Some(&t), 500, 6);
+        assert_eq!(
+            page.changes,
+            vec![
+                conv("c1", &[ConversationWhat::Messages, ConversationWhat::State]),
+                team("t1", &[TeamWhat::Roster, TeamWhat::RunState]),
+                conv("c2", &[ConversationWhat::Read]),
+            ]
+        );
+        assert_eq!(page.token, "ep0.5");
+    }
+
+    #[test]
+    fn rule3_conversation_keeps_team_and_slot_from_an_earlier_entry() {
+        let j = journal();
+        let t = first_token(&j, "u1");
+        j.record(
+            "u1",
+            ChangeEntry::Conversation {
+                conversation_id: "c1".into(),
+                team_id: Some("t1".into()),
+                slot_id: Some("s1".into()),
+                what: vec![ConversationWhat::State],
+            },
+            1,
+        );
+        j.record("u1", conv("c1", &[ConversationWhat::Messages]), 2);
+        let page = j.since("u1", Some(&t), 500, 3);
+        assert_eq!(
+            page.changes,
+            vec![ChangeEntry::Conversation {
+                conversation_id: "c1".into(),
+                team_id: Some("t1".into()),
+                slot_id: Some("s1".into()),
+                what: vec![ConversationWhat::State, ConversationWhat::Messages],
+            }]
+        );
+    }
+
+    #[test]
+    fn rule3_approval_added_then_removed_is_only_removed() {
+        let j = journal();
+        let t = first_token(&j, "u1");
+        j.record("u1", added("a1"), 1);
+        j.record("u1", added("a2"), 2);
+        j.record("u1", removed("a1"), 3);
+        let page = j.since("u1", Some(&t), 500, 4);
+        assert_eq!(page.changes, vec![added("a2"), removed("a1")]);
+    }
+
+    #[test]
+    fn rule3_tasks_coalesce_by_task_id_and_broadcasts_by_id() {
+        let j = journal();
+        let t = first_token(&j, "u1");
+        let task = |id: &str, status: &str, change| ChangeEntry::Task {
+            team_id: "t1".into(),
+            task: json!({ "taskId": id, "status": status }),
+            change,
+        };
+        j.record("u1", task("k1", "pending", TaskChange::Created), 1);
+        j.record(
+            "u1",
+            ChangeEntry::Broadcast {
+                team_id: "t1".into(),
+                broadcast_id: "b1".into(),
+            },
+            2,
+        );
+        j.record("u1", task("k1", "done", TaskChange::Updated), 3);
+        j.record(
+            "u1",
+            ChangeEntry::Broadcast {
+                team_id: "t1".into(),
+                broadcast_id: "b1".into(),
+            },
+            4,
+        );
+        let page = j.since("u1", Some(&t), 500, 5);
+        assert_eq!(
+            page.changes,
+            vec![
+                task("k1", "done", TaskChange::Updated),
+                ChangeEntry::Broadcast {
+                    team_id: "t1".into(),
+                    broadcast_id: "b1".into()
+                }
+            ]
+        );
+    }
+
+    #[test]
+    fn rule4_paging_never_loses_a_change() {
+        let j = journal();
+        let mut t = first_token(&j, "u1");
+        for i in 0..7 {
+            j.record("u1", conv(&format!("c{i}"), &[ConversationWhat::Messages]), i);
+        }
+        let p1 = j.since("u1", Some(&t), 3, 10);
+        assert!(p1.more);
+        assert_eq!(p1.changes.len(), 3);
+        assert_eq!(p1.token, "ep0.3");
+        // A key already in page 1 changes again before page 2 is read: it comes again, newest state.
+        j.record("u1", conv("c0", &[ConversationWhat::Read]), 11);
+        t = p1.token;
+        let mut seen: Vec<ChangeEntry> = p1.changes;
+        loop {
+            let p = j.since("u1", Some(&t), 3, 12);
+            seen.extend(p.changes.clone());
+            t = p.token;
+            if !p.more {
+                break;
+            }
+        }
+        for i in 0..7 {
+            assert!(
+                seen.contains(&conv(&format!("c{i}"), &[ConversationWhat::Messages])),
+                "c{i} lost"
+            );
+        }
+        assert_eq!(seen.last(), Some(&conv("c0", &[ConversationWhat::Read])));
+        assert_eq!(t, "ep0.8");
+        assert!(j.since("u1", Some(&t), 3, 13).changes.is_empty());
+    }
+
+    #[test]
+    fn rule4_a_page_counts_distinct_keys_not_raw_entries() {
+        let j = journal();
+        let t = first_token(&j, "u1");
+        for i in 0..5 {
+            j.record(
+                "u1",
+                team(
+                    "t1",
+                    &[if i % 2 == 0 {
+                        TeamWhat::RunState
+                    } else {
+                        TeamWhat::Roster
+                    }],
+                ),
+                i,
+            );
+        }
+        let p = j.since("u1", Some(&t), 1, 9);
+        assert!(!p.more);
+        assert_eq!(p.changes, vec![team("t1", &[TeamWhat::RunState, TeamWhat::Roster])]);
+    }
+
+    #[test]
+    fn rule5_users_see_only_their_own_entries() {
+        let j = journal();
+        let t = first_token(&j, "u1");
+        j.record("u2", team("t9", &[TeamWhat::Meta]), 1);
+        j.record("u1", team("t1", &[TeamWhat::Meta]), 2);
+        j.record("u2", conv("c9", &[ConversationWhat::Messages]), 3);
+        let page = j.since("u1", Some(&t), 500, 4);
+        assert_eq!(page.changes, vec![team("t1", &[TeamWhat::Meta])]);
+        assert!(j.since("u3", Some(&t), 500, 4).changes.is_empty());
+    }
+
+    #[tokio::test]
+    async fn rule5_a_waiter_does_not_wake_for_another_user() {
+        let j = Arc::new(journal());
+        let t = first_token(&j, "u1");
+        let j2 = j.clone();
+        let t2 = t.clone();
+        let waiter = tokio::spawn(async move { j2.wait_since("u1", Some(&t2), Duration::from_millis(400), 500).await });
+        tokio::time::sleep(Duration::from_millis(50)).await;
+        j.record("u2", team("t9", &[TeamWhat::Meta]), now_ms());
+        let started = std::time::Instant::now();
+        let page = waiter.await.unwrap();
+        assert!(page.changes.is_empty(), "u1 must not see u2's change");
+        assert!(
+            started.elapsed() >= Duration::from_millis(250),
+            "returned early on another user's record"
+        );
+    }
+
+    #[test]
+    fn rule6_retention_by_count_resets_old_tokens() {
+        let j = ChangeJournal::with_epoch("ep0".into(), 3, BIG);
+        let t = first_token(&j, "u1");
+        for i in 0..5 {
+            j.record("u1", conv(&format!("c{i}"), &[ConversationWhat::Messages]), i);
+        }
+        let page = j.since("u1", Some(&t), 500, 10);
+        assert!(page.reset && page.changes.is_empty());
+        assert_eq!(page.token, "ep0.5");
+        // A token at or after the oldest kept entry still reads normally.
+        let page = j.since("u1", Some("ep0.2"), 500, 10);
+        assert!(!page.reset);
+        assert_eq!(page.changes.len(), 3);
+    }
+
+    #[test]
+    fn rule6_retention_by_age_resets_old_tokens() {
+        let j = ChangeJournal::with_epoch("ep0".into(), 1000, 100);
+        let t = first_token(&j, "u1");
+        j.record("u1", team("t1", &[TeamWhat::Meta]), 0);
+        j.record("u1", team("t2", &[TeamWhat::Meta]), 150);
+        assert!(j.since("u1", Some(&t), 500, 160).reset);
+        let page = j.since("u1", Some("ep0.1"), 500, 160);
+        assert!(!page.reset);
+        assert_eq!(page.changes, vec![team("t2", &[TeamWhat::Meta])]);
+    }
+
+    #[tokio::test]
+    async fn rule7_wait_returns_at_once_when_changes_are_pending() {
+        let j = journal();
+        let t = first_token(&j, "u1");
+        j.record("u1", team("t1", &[TeamWhat::Meta]), now_ms());
+        let started = std::time::Instant::now();
+        let page = j.wait_since("u1", Some(&t), Duration::from_secs(10), 500).await;
+        assert!(started.elapsed() < Duration::from_secs(1));
+        assert_eq!(page.changes.len(), 1);
+    }
+
+    #[tokio::test]
+    async fn rule7_wait_times_out_with_nothing() {
+        let j = journal();
+        let t = first_token(&j, "u1");
+        let started = std::time::Instant::now();
+        let page = j.wait_since("u1", Some(&t), Duration::from_millis(150), 500).await;
+        assert!(started.elapsed() >= Duration::from_millis(140));
+        assert!(page.changes.is_empty() && !page.reset);
+        assert_eq!(page.token, t);
+    }
+
+    #[tokio::test(flavor = "multi_thread", worker_threads = 4)]
+    async fn rule7_no_lost_wake_ups_under_concurrency() {
+        let j = Arc::new(journal());
+        for round in 0..200 {
+            let t = first_token(&j, "u1");
+            let mut waiters = Vec::new();
+            for _ in 0..8 {
+                let j = j.clone();
+                let t = t.clone();
+                waiters.push(tokio::spawn(async move {
+                    j.wait_since("u1", Some(&t), Duration::from_secs(5), 500).await
+                }));
+            }
+            // Record at varying moments, including while waiters are between their check and their wait.
+            if round % 3 == 0 {
+                tokio::task::yield_now().await;
+            }
+            let j2 = j.clone();
+            tokio::spawn(async move { j2.record("u1", team(&format!("t{round}"), &[TeamWhat::Meta]), now_ms()) });
+            for w in waiters {
+                let page = tokio::time::timeout(Duration::from_secs(4), w)
+                    .await
+                    .expect("a waiter missed the wake-up")
+                    .unwrap();
+                assert_eq!(page.changes, vec![team(&format!("t{round}"), &[TeamWhat::Meta])]);
+            }
+        }
+    }
+
+    #[test]
+    fn epochs_are_random_per_journal() {
+        let a = ChangeJournal::new(10, BIG);
+        let b = ChangeJournal::new(10, BIG);
+        assert_ne!(a.epoch(), b.epoch());
+        assert_eq!(a.epoch().len(), 8);
+        assert!(b.since("u1", Some(&format!("{}.0", a.epoch())), 500, 0).reset);
+    }
+}
