+    let (status, _) = call(&f, ConfirmCheck::Verified, "POST", "/v1/teams/t1/agents", spawn.clone()).await;
+    assert_eq!(status, 200);
+    let (status, _) = call(&f, ConfirmCheck::NotRequired, "POST", "/v1/teams/t1/agents", spawn).await;
+    assert_eq!(status, 200, "the PC relaxed requireConfirm");
+
+    for (method, path) in [
+        ("DELETE", "/v1/teams/t1/agents/s2"),
+        ("POST", "/v1/teams/t1/agents/s2/shutdown"),
+        ("POST", "/v1/teams/t1/agents/s2/clear-context"),
