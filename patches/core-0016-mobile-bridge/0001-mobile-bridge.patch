+            },
+        )
+        .unwrap();
+        assert_eq!(
+            m.call,
+            BackendCall::AskAnswer {
+                conversation_id: "c1".into(),
+                request_id: "req-1".into(),
+                answers: vec![qa("Which branch?", &["dev"]), qa("Which checks?", &["lint", "tests"])],
+            }
+        );
+        assert!(m.sensitive);
+        assert_eq!((m.deny_message, m.delivery), (None, None));
+
+        // freeText (Claude): one non-offered label per question, trimmed; combinable with offered ones on multiSelect.
+        let m = map_answer(
+            &t,
+            AnswerInput::Answers {
+                answers: vec![qa("Which checks?", &["lint", "  the e2e suite  "])],
+            },
+        )
+        .unwrap();
+        match m.call {
+            BackendCall::AskAnswer { answers, .. } => {
+                assert_eq!(answers, vec![qa("Which checks?", &["lint", "the e2e suite"])])
+            }
+            other => panic!("{other:?}"),
+        }
+        for bad in [
+            vec![qa("Which checks?", &["one", "two"])],      // two free-text strings
+            vec![qa("Which branch?", &["main", "dev"])],     // two labels on single-select
+            vec![qa("Which branch?", &[])],                  // nothing chosen
+            vec![qa("Which branch?", &["   "])],             // blank free text
+            vec![qa("Which branch?", &[&"z".repeat(2001)])], // too long
+            vec![qa("Not asked?", &["main"])],               // a question that was not asked
+            vec![qa("Which branch?", &["main"]), qa("Which branch?", &["dev"])], // answered twice
+            vec![],
+        ] {
+            assert!(
+                matches!(
+                    map_answer(&t, AnswerInput::Answers { answers: bad.clone() }),
+                    Err(AnswerError::InvalidRequest(_))
+                ),
+                "{bad:?}"
+            );
+        }
+
+        let m = map_answer(
+            &t,
+            AnswerInput::Decline {
+                message: Some(" not now ".into()),
+            },
+        )
+        .unwrap();
+        assert_eq!(
+            m.call,
+            BackendCall::AskDecline {
+                conversation_id: "c1".into(),
+                request_id: "req-1".into()
+            }
+        );
+        assert_eq!(
+            (m.deny_message.as_deref(), m.delivery, m.sensitive),
+            (Some("not now"), Some(MessageDelivery::Followup), false)
+        );
+        let m = map_answer(&t, AnswerInput::Decline { message: None }).unwrap();
+        assert_eq!((m.deny_message, m.delivery), (None, None));
+
+        assert!(matches!(
+            map_answer(&t, opt("main")),
+            Err(AnswerError::InvalidRequest(_))
+        ));
+        assert!(matches!(
+            map_answer(
+                &t,
+                AnswerInput::Decision {
+                    decision: Decision::AllowOnce,
+                    message: None
+                }
+            ),
+            Err(AnswerError::InvalidRequest(_))
+        ));
+    }
+
+    #[test]
+    fn rule5_answers_and_decline_on_a_permission_are_refused() {
+        let t = tracked(BackendKind::Acp, "acp_permission", acp_request("c"));
+        let answers = vec![QuestionAnswer {
+            question: "q".into(),
+            labels: vec!["Allow".into()],
+        }];
+        assert!(matches!(
+            map_answer(&t, AnswerInput::Answers { answers }),
+            Err(AnswerError::InvalidRequest(_))
+        ));
+        assert!(matches!(
+            map_answer(&t, AnswerInput::Decline { message: None }),
+            Err(AnswerError::InvalidRequest(_))
+        ));
+    }
+
+    #[test]
+    fn rule5_a_non_claude_question_is_answered_only_by_an_offered_option() {
+        let mut data = acp_request("call-q");
+        data["tool_call"]["raw_input"] =
+            json!({ "questions": [ { "question": "Ship it?", "options": [ { "label": "Yes" } ] } ] });
+        let t = tracked(BackendKind::Acp, "acp_permission", data);
+        assert_eq!(t.approval.kind, ApprovalKind::Permission);
+        // Answering with a question's label is never turned into an allow.
+        let answers = vec![QuestionAnswer {
+            question: "Ship it?".into(),
+            labels: vec!["Yes".into()],
+        }];
+        assert!(matches!(
+            map_answer(&t, AnswerInput::Answers { answers }),
+            Err(AnswerError::InvalidRequest(_))
+        ));
+        assert!(matches!(
+            map_answer(
+                &t,
+                AnswerInput::Decline {
+                    message: Some("no".into())
+                }
+            ),
+            Err(AnswerError::InvalidRequest(_))
+        ));
+        assert!(
+            matches!(map_answer(&t, opt("Yes")), Err(AnswerError::InvalidRequest(_))),
+            "a question label is not an option id"
+        );
+        assert_eq!(data_of(&map_answer(&t, opt("ok1")).unwrap()).0, &json!("ok1"));
+        let m = map_answer(
+            &t,
+            AnswerInput::Option {
+                option_id: "no1".into(),
+                message: Some("not yet".into()),
+            },
+        )
+        .unwrap();
+        assert_eq!((m.delivery, m.sensitive), (Some(MessageDelivery::Followup), false));
+    }
+
+    #[test]
+    fn rule6_sensitive_exactly_when_it_allows() {
+        let t = tracked(BackendKind::Aionrs, "permission", aionrs_confirmation("c"));
+        let sens = |id: &str| map_answer(&t, opt(id)).unwrap().sensitive;
+        assert!(
+            sens("proceed_once") && sens("proceed_always") && sens("modify"),
+            "allow_* and other are sensitive"
+        );
+        assert!(!sens("cancel"));
+        let dec = |d| {
+            map_answer(
+                &t,
+                AnswerInput::Decision {
+                    decision: d,
+                    message: None,
+                },
+            )
+            .unwrap()
+            .sensitive
+        };
+        assert!(dec(Decision::AllowOnce) && dec(Decision::AllowAlways) && !dec(Decision::Deny));
+        let acp = tracked(BackendKind::Acp, "acp_permission", acp_request("c"));
+        assert!(
+            !map_answer(&acp, opt("no2")).unwrap().sensitive,
+            "reject_always is not sensitive"
+        );
+    }
+}
diff --git a/crates/aionui-mobile/src/audit.rs b/crates/aionui-mobile/src/audit.rs
new file mode 100644
index 00000000..337dec79
--- /dev/null
+++ b/crates/aionui-mobile/src/audit.rs
@@ -0,0 +1,237 @@
+//! The audit log of what paired phones changed (CONTRACT §3.3): one line per mutating action in
+//! `%LOCALAPPDATA%\AionDX\logs\mobile-bridge.log`, with the time, the device, the action, the ids it touched, and the
+//! outcome. It never records message content, request bodies, or keys: only the method, the route with its ids, and
+//! the status.
+//!
+//! The file is kept small: past `MAX_BYTES` it is renamed to `mobile-bridge.log.1` (replacing the previous one), so
+//! at most two files of about 1 MiB each exist. A write that fails is logged and dropped: auditing never blocks a
+//! request.
+
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::sync::Mutex;
+
+/// Rotate past this size.
+pub const MAX_BYTES: u64 = 1024 * 1024;
+
+/// Collections whose next path segment is an id (`/v1/teams/{id}`), and the name that id gets in `targets`.
+const ID_AFTER: &[(&str, &str)] = &[
+    ("teams", "team"),
+    ("agents", "agent"),
+    ("conversations", "conversation"),
+    ("tasks", "task"),
+    ("approvals", "approval"),
+    ("devices", "device"),
+];
+
+pub struct AuditLog {
+    path: Option<PathBuf>,
+    max_bytes: u64,
+    lock: Mutex<()>,
+}
+
+impl AuditLog {
+    /// Records nothing (tests, or no `%LOCALAPPDATA%`).
+    pub fn disabled() -> Self {
+        Self {
+            path: None,
+            max_bytes: MAX_BYTES,
+            lock: Mutex::new(()),
+        }
+    }
+
+    pub fn at(path: PathBuf) -> Self {
+        Self {
+            path: Some(path),
+            max_bytes: MAX_BYTES,
+            lock: Mutex::new(()),
+        }
+    }
+
+    /// `%LOCALAPPDATA%\AionDX\logs\mobile-bridge.log`.
+    pub fn default_location() -> Self {
+        match std::env::var_os("LOCALAPPDATA")
+            .map(PathBuf::from)
+            .filter(|p| p.is_absolute())
+        {
+            Some(base) => Self::at(base.join("AionDX").join("logs").join("mobile-bridge.log")),
+            None => {
+                tracing::warn!("mobile bridge: no LOCALAPPDATA; the audit log is off");
+                Self::disabled()
+            }
+        }
+    }
+
+    #[cfg(test)]
+    fn with_max_bytes(mut self, max_bytes: u64) -> Self {
+        self.max_bytes = max_bytes;
+        self
+    }
+
+    pub fn path(&self) -> Option<&Path> {
+        self.path.as_deref()
+    }
+
+    /// One phone request: `method` and `path` (the query is dropped), how it ended (`status`, and the error code when
+    /// there is one).
+    pub fn request(&self, device_id: &str, method: &str, path: &str, status: u16, error_code: Option<&str>) {
+        let (route, targets) = route_and_targets(path);
+        let outcome = match error_code {
+            Some(code) => format!("{status} {code}"),
+            None => status.to_string(),
+        };
+        self.record(device_id, &format!("{method} {route}"), &targets, &outcome);
+    }
+
+    /// One event that isn't a phone request (a pairing approved, a phone revoked on the PC).
+    pub fn event(&self, device_id: &str, action: &str, outcome: &str) {
+        self.record(device_id, action, "", outcome);
+    }
+
+    fn record(&self, device_id: &str, action: &str, targets: &str, outcome: &str) {
+        let Some(path) = &self.path else { return };
+        let line = format!(
+            "{} device={} action={} targets={} outcome={}\n",
+            chrono::Utc::now().format("%Y-%m-%dT%H:%M:%S%.3fZ"),
+            clean(device_id),
+            clean(action),
+            clean(targets),
+            clean(outcome),
+        );
+        let _guard = self.lock.lock().unwrap_or_else(|p| p.into_inner());
+        if let Err(e) = append(path, &line, self.max_bytes) {
+            tracing::warn!(error = %e, "mobile bridge: could not write the audit log");
+        }
+    }
+}
+
+fn append(path: &Path, line: &str, max_bytes: u64) -> std::io::Result<()> {
+    if let Some(dir) = path.parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    if std::fs::metadata(path).is_ok_and(|m| m.len() + line.len() as u64 > max_bytes) {
+        let old = PathBuf::from(format!("{}.1", path.display()));
+        let _ = std::fs::remove_file(&old);
+        std::fs::rename(path, &old)?;
+    }
+    let mut file = std::fs::OpenOptions::new().create(true).append(true).open(path)?;
+    file.write_all(line.as_bytes())
+}
+
+/// Keeps a field on one line and free of anything that could forge another entry: spaces become `_`, control
+/// characters and `=` are dropped, and it is cut at 200 characters.
+fn clean(field: &str) -> String {
+    let out: String = field
+        .chars()
+        .filter(|c| !c.is_control() && *c != '=')
+        .map(|c| if c.is_whitespace() { '_' } else { c })
+        .take(200)
+        .collect();
+    if out.is_empty() { "-".to_owned() } else { out }
+}
+
+/// `/v1/teams/t1/agents/s2/stop?x=1` → (`/v1/teams/{team}/agents/{agent}/stop`, `team:t1,agent:s2`).
+fn route_and_targets(path: &str) -> (String, String) {
+    let path = path.split('?').next().unwrap_or_default();
+    let segs: Vec<&str> = path.trim_matches('/').split('/').collect();
+    let mut route = Vec::with_capacity(segs.len());
+    let mut targets = Vec::new();
+    for (i, seg) in segs.iter().enumerate() {
+        let after = i
+            .checked_sub(1)
+            .and_then(|p| ID_AFTER.iter().find(|(c, _)| *c == segs[p]));
+        match after {
+            Some((_, name)) => {
+                route.push(format!("{{{name}}}"));
+                targets.push(format!("{name}:{seg}"));
+            }
+            None => route.push((*seg).to_owned()),
+        }
+    }
+    (format!("/{}", route.join("/")), targets.join(","))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn routes_and_targets_split_ids_from_the_action() {
+        assert_eq!(
+            route_and_targets("/v1/teams/t1/agents/s2/shutdown?force=1"),
+            (
+                "/v1/teams/{team}/agents/{agent}/shutdown".to_owned(),
+                "team:t1,agent:s2".to_owned()
+            )
+        );
+        assert_eq!(
+            route_and_targets("/v1/approvals/YzI6Y2FsbC0x/answer"),
+            (
+                "/v1/approvals/{approval}/answer".to_owned(),
+                "approval:YzI6Y2FsbC0x".to_owned()
+            )
+        );
+        assert_eq!(
+            route_and_targets("/v1/host/device/confirm-key"),
+            ("/v1/host/device/confirm-key".to_owned(), String::new())
+        );
+    }
+
+    #[test]
+    fn a_line_has_the_fields_and_nothing_can_forge_another() {
+        let dir = tempfile::tempdir().unwrap();
+        let log = AuditLog::at(dir.path().join("logs").join("mobile-bridge.log"));
+        log.request("dev-1", "POST", "/v1/teams/t1/agents/s2/stop", 200, None);
+        log.request(
+            "dev\n2 outcome=200",
+            "DELETE",
+            "/v1/teams/t1/agents/s2",
+            422,
+            Some("lead_not_allowed"),
+        );
+        log.event("dev-3", "pair approved", "ok");
+        let text = std::fs::read_to_string(log.path().unwrap()).unwrap();
+        let lines: Vec<&str> = text.lines().collect();
+        assert_eq!(lines.len(), 3, "{text}");
+        assert!(lines[0].ends_with(
+            "device=dev-1 action=POST_/v1/teams/{team}/agents/{agent}/stop targets=team:t1,agent:s2 outcome=200"
+        ));
+        assert!(
+            lines[1].contains("device=dev2_outcome200 action=DELETE"),
+            "{}",
+            lines[1]
+        );
+        assert!(lines[1].ends_with("outcome=422_lead_not_allowed"));
+        assert!(lines[2].ends_with("device=dev-3 action=pair_approved targets=- outcome=ok"));
+        assert!(
+            lines[0].len() > 24 && lines[0].as_bytes()[10] == b'T',
+            "starts with an ISO time"
+        );
+    }
+
+    #[test]
+    fn the_log_rotates_and_stays_bounded() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("mobile-bridge.log");
+        let log = AuditLog::at(path.clone()).with_max_bytes(400);
+        for i in 0..40 {
+            log.request(&format!("dev-{i}"), "POST", "/v1/conversations/c1/messages", 200, None);
+        }
+        let current = std::fs::metadata(&path).unwrap().len();
+        let old = std::fs::metadata(dir.path().join("mobile-bridge.log.1")).unwrap().len();
+        assert!(current <= 400 && old <= 400, "{current} {old}");
+        assert!(std::fs::read_to_string(&path).unwrap().contains("device=dev-39"));
+        assert_eq!(
+            std::fs::read_dir(dir.path()).unwrap().count(),
+            2,
+            "never more than two files"
+        );
+    }
+
+    #[test]
+    fn disabled_writes_nothing() {
+        let log = AuditLog::disabled();
+        log.request("d", "POST", "/v1/x", 200, None);
+        assert!(log.path().is_none());
+    }
+}
diff --git a/crates/aionui-mobile/src/backend.rs b/crates/aionui-mobile/src/backend.rs
new file mode 100644
index 00000000..033ee2a2
--- /dev/null
+++ b/crates/aionui-mobile/src/backend.rs
@@ -0,0 +1,234 @@
+//! The facade's view of AionCore (CONTRACT §6). `aionui-app` implements it over
+//! the team, conversation and assistant services; this crate depends on no
+//! domain crate. Every call acts as `user_id`, the Core user the phone was
+//! paired to (the phone is the user, CONTRACT §3.3).
+
+use async_trait::async_trait;
+use serde_json::Value;
+
+use crate::approvals::{BackendKind, QuestionAnswer};
+
+use aionui_api_types::{
+    AssistantResponse, ConversationListResponse, ConversationResponse, ListMessagesQuery, MessageListResponse,
+    MessageResponse, TeamActivityPageResponse, TeamAgentResponse, TeamResponse, TeamRunStateResponse, TeamTaskResponse,
+};
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum BackendError {
+    NotFound(String),
+    Invalid(String),
+    Unavailable(String),
+}
+
+/// Which slice of team activity to read.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ActivityFilter {
+    All,
+    Messages,
+    Tasks,
+}
+
+#[derive(Debug, Clone)]
+pub struct ActivityQuery {
+    /// `(created_at, id)` of the last item already seen.
+    pub cursor: Option<(i64, String)>,
+    /// Newest first when false.
+    pub ascending: bool,
+    pub filter: ActivityFilter,
+    pub limit: i64,
+}
+
+#[async_trait]
+pub trait MobileBackend: Send + Sync {
+    async fn teams(&self, user_id: &str) -> Result<Vec<TeamResponse>, BackendError>;
+    async fn team(&self, user_id: &str, team_id: &str) -> Result<TeamResponse, BackendError>;
+    async fn run_state(&self, user_id: &str, team_id: &str) -> Result<TeamRunStateResponse, BackendError>;
+    async fn tasks(&self, user_id: &str, team_id: &str) -> Result<Vec<TeamTaskResponse>, BackendError>;
+    async fn activity(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        query: ActivityQuery,
+    ) -> Result<TeamActivityPageResponse, BackendError>;
+    async fn conversations(
+        &self,
+        user_id: &str,
+        cursor: Option<String>,
+        limit: u32,
+    ) -> Result<ConversationListResponse, BackendError>;
+    /// The detail view (with `runtime`).
+    async fn conversation(&self, user_id: &str, conversation_id: &str) -> Result<ConversationResponse, BackendError>;
+    async fn messages(
+        &self,
+        user_id: &str,
+        conversation_id: &str,
+        query: ListMessagesQuery,
+    ) -> Result<MessageListResponse, BackendError>;
+    /// The newest message, any type.
+    async fn latest_message(
+        &self,
+        user_id: &str,
+        conversation_id: &str,
+    ) -> Result<Option<MessageResponse>, BackendError>;
+    async fn assistants(&self, user_id: &str) -> Result<Vec<AssistantResponse>, BackendError>;
+
+    // ---- Write side (phase 3, CONTRACT §6.4, §6.6, §6.7) ----------------------------------
+
+    /// A new solo chat: exactly one of `assistant_id` / `agent_backend`.
+    async fn create_solo(&self, user_id: &str, spec: SoloSpec) -> Result<ConversationResponse, BackendError>;
+    async fn send_solo(&self, user_id: &str, conversation_id: &str, content: &str)
+    -> Result<SendOutcome, BackendError>;
+    /// `now`: the respond-now path (steer), CONTRACT §6.4 `priority: "now"`.
+    async fn send_to_agent(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        slot_id: &str,
+        content: &str,
+        now: bool,
+    ) -> Result<SendOutcome, BackendError>;
+    async fn wake_agent(&self, user_id: &str, team_id: &str, slot_id: &str) -> Result<(), BackendError>;
+    async fn cancel_child_turn(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        run_id: &str,
+        slot_id: &str,
+    ) -> Result<(), BackendError>;
+    async fn interrupt_agent(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        slot_id: &str,
+        message: &str,
+    ) -> Result<(), BackendError>;
+    async fn shutdown_agent(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        slot_id: &str,
+        reason: Option<&str>,
+    ) -> Result<(), BackendError>;
+    async fn remove_agent(&self, user_id: &str, team_id: &str, slot_id: &str) -> Result<(), BackendError>;
+    async fn spawn_agent(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        assistant_id: &str,
+        name: Option<&str>,
+        model: Option<&str>,
+    ) -> Result<TeamAgentResponse, BackendError>;
+    async fn rename_agent(&self, user_id: &str, team_id: &str, slot_id: &str, name: &str) -> Result<(), BackendError>;
+    /// Returns `preserved_unread`.
+    async fn clear_context(&self, user_id: &str, team_id: &str, slot_id: &str) -> Result<u64, BackendError>;
+    async fn start_session(&self, user_id: &str, team_id: &str) -> Result<(), BackendError>;
+    async fn create_task(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        task: TaskCreate,
+    ) -> Result<TeamTaskResponse, BackendError>;
+    async fn update_task(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        task_id: &str,
+        patch: TaskPatch,
+    ) -> Result<TeamTaskResponse, BackendError>;
+    /// The user's client preference store (read markers live there, CONTRACT §6.4).
+    async fn get_pref(&self, user_id: &str, key: &str) -> Result<Option<String>, BackendError>;
+    async fn set_pref(&self, user_id: &str, key: &str, value: &str) -> Result<(), BackendError>;
+
+    // ---- approvals (phase 4). Defaults say "not available" so a backend without them still serves the rest.
+
+    /// Where a conversation's approvals come from: its team slot and agent name, and the backend kind of the agent
+    /// running it right now (the answer mapping depends on it, CONTRACT §6.5).
+    async fn approval_source(&self, _user_id: &str, _conversation_id: &str) -> Result<ApprovalSource, BackendError> {
+        Err(BackendError::Unavailable("approvals are not available".into()))
+    }
+    /// The user's conversations that have a live agent (only those can hold pending approvals).
+    async fn live_conversations(&self, _user_id: &str) -> Result<Vec<String>, BackendError> {
+        Ok(Vec::new())
+    }
+    /// AionCore's pending confirmations of one conversation (`Confirmation` objects as JSON).
+    async fn confirmations(&self, _user_id: &str, _conversation_id: &str) -> Result<Vec<Value>, BackendError> {
+        Ok(Vec::new())
+    }
+    /// AionCore's confirm, with the user's refusal reason for backends that take one natively.
+    async fn confirm(&self, _user_id: &str, _call: ConfirmCall) -> Result<(), BackendError> {
+        Err(BackendError::Unavailable("approvals are not available".into()))
+    }
+    /// A message to a solo chat that must not be refused because a turn is running (the refusal follow-up,
+    /// CONTRACT §6.5): into the running turn, as a new turn, or held until the running turn ends.
+    async fn respond_now_solo(
+        &self,
+        user_id: &str,
+        conversation_id: &str,
+        content: &str,
+    ) -> Result<SendOutcome, BackendError> {
+        self.send_solo(user_id, conversation_id, content).await
+    }
+    /// AionCore's AskUserQuestion answer; `answers: None` declines.
+    async fn answer_ask(
+        &self,
+        _user_id: &str,
+        _conversation_id: &str,
+        _request_id: &str,
+        _answers: Option<Vec<QuestionAnswer>>,
+    ) -> Result<(), BackendError> {
+        Err(BackendError::Unavailable("approvals are not available".into()))
+    }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct ApprovalSource {
+    pub team_id: Option<String>,
+    pub slot_id: Option<String>,
+    pub agent_name: String,
+    pub backend: BackendKind,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct ConfirmCall {
+    pub conversation_id: String,
+    pub call_id: String,
+    pub msg_id: String,
+    pub data: Value,
+    pub always_allow: bool,
+    pub deny_message: Option<String>,
+}
+
+/// How a send was delivered (CONTRACT §6.4).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SendOutcome {
+    pub message_id: String,
+    /// `started` | `midturn` | `queued` | `queued_first`.
+    pub delivery: &'static str,
+}
+
+#[derive(Debug, Clone, Default)]
+pub struct TaskCreate {
+    pub subject: String,
+    pub description: Option<String>,
+    pub owner: Option<String>,
+    pub blocked_by: Vec<String>,
+}
+
+/// `owner: Some(None)` unassigns.
+#[derive(Debug, Clone, Default)]
+pub struct TaskPatch {
+    pub subject: Option<String>,
+    pub description: Option<String>,
+    pub status: Option<String>,
+    pub owner: Option<Option<String>>,
+    pub blocked_by: Option<Vec<String>>,
+}
+
+#[derive(Debug, Clone, Default)]
+pub struct SoloSpec {
+    pub assistant_id: Option<String>,
+    pub agent_backend: Option<String>,
+    pub name: Option<String>,
+    pub workspace: Option<String>,
+    pub model: Option<String>,
+}
diff --git a/crates/aionui-mobile/src/core.rs b/crates/aionui-mobile/src/core.rs
new file mode 100644
index 00000000..68689836
--- /dev/null
+++ b/crates/aionui-mobile/src/core.rs
@@ -0,0 +1,175 @@
+//! Shared state behind the LAN routes and the desktop admin routes.
+
+use std::collections::HashMap;
+use std::net::IpAddr;
+use std::sync::{Arc, Mutex, RwLock};
+
+use async_trait::async_trait;
+
+use crate::host_key::HostKey;
+use crate::pairing::PairingManager;
+use crate::session::SessionStore;
+use crate::store::MobileStore;
+use crate::wire::{InnerRequest, InnerResponse};
+
+/// Pushes desktop notices (AionCore's WebSocket) without this crate depending on it.
+pub trait BridgeEvents: Send + Sync {
+    fn emit(&self, user_id: &str, name: &str, data: serde_json::Value);
+}
+
+pub struct NoEvents;
+
+impl BridgeEvents for NoEvents {
+    fn emit(&self, _user_id: &str, _name: &str, _data: serde_json::Value) {}
+}
+
+/// Who is calling an inner route: the phone acting as the user (CONTRACT §3.3).
+#[derive(Debug, Clone)]
+pub struct InnerContext {
+    pub user_id: String,
+    pub device_id: String,
+    pub sid: [u8; 16],
+    pub seq: u64,
+    /// The request's confirm proof, checked before dispatch (CONTRACT §5).
+    pub confirm: ConfirmCheck,
+}
+
+/// The outcome of checking a request's `confirm` proof (CONTRACT §5). Only
+/// sensitive routes look at it: `Missing` → 428, `Invalid` → 403.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ConfirmCheck {
+    /// The PC switched `requireConfirm` off for this phone.
+    NotRequired,
+    Verified,
+    Missing,
+    Invalid,
+}
+
+/// An open confirm-key re-issue offer for one device (CONTRACT §5.3).
+#[derive(Debug, Clone)]
+pub struct RekeyOffer {
+    pub secret: [u8; 32],
+    pub expires_at: i64,
+    pub attempts: u8,
+    /// Kept after use, so the desktop can see how it ended (`GET /api/mobile/admin/rekey-offers/{id}`).
+    pub state: RekeyState,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum RekeyState {
+    Pending,
+    Completed,
+    /// Too many wrong proofs.
+    Failed,
+}
+
+/// The mobile facade (`/v1/...`, CONTRACT §6). Implemented in later phases;
+/// the bridge answers `no_such_route` for anything neither it nor the facade serves.
+#[async_trait]
+pub trait InnerApi: Send + Sync {
+    /// `None` when the facade has no such route.
+    async fn handle(&self, ctx: &InnerContext, req: &InnerRequest) -> Option<InnerResponse>;
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
+pub enum Limit {
+    Pair,
+    Session,
+    Rpc,
+}
+
+impl Limit {
+    /// A8: per peer IP, per minute.
+    fn per_minute(self) -> u32 {
+        match self {
+            Limit::Pair => 10,
+            Limit::Session => 30,
+            Limit::Rpc => 600,
+        }
+    }
+}
+
+/// Fixed one-minute windows per (peer IP, route). The IP is the socket's
+/// address, never a header.
+#[derive(Default)]
+pub struct RateLimiter {
+    windows: Mutex<HashMap<(IpAddr, Limit), (i64, u32)>>,
+}
+
+impl RateLimiter {
+    pub fn allow(&self, ip: IpAddr, limit: Limit, now: i64) -> bool {
+        let mut windows = self.windows.lock().unwrap();
+        if windows.len() > 4096 {
+            windows.retain(|_, (start, _)| now - *start < 60_000);
+        }
+        let entry = windows.entry((ip, limit)).or_insert((now, 0));
+        if now - entry.0 >= 60_000 {
+            *entry = (now, 0);
+        }
+        entry.1 += 1;
+        entry.1 <= limit.per_minute()
+    }
+}
+
+pub struct BridgeCore {
+    pub host_key: Arc<HostKey>,
+    pub store: MobileStore,
+    pub pairing: PairingManager,
+    pub sessions: SessionStore,
+    pub limiter: RateLimiter,
+    pub events: Arc<dyn BridgeEvents>,
+    pub facade: RwLock<Option<Arc<dyn InnerApi>>>,
+    /// The host name shown to phones, from the active user's settings.
+    pub host_name: RwLock<String>,
+    /// The AionDX app version (`--app-version`), shown in `/v1/host`.
+    pub app_version: RwLock<String>,
+    /// Open re-key offers, by device id.
+    pub rekey_offers: Mutex<HashMap<String, RekeyOffer>>,
+    /// What phones changed (CONTRACT §3.3). Off until the bridge sets its file (`MobileBridge::new`).
+    pub audit: RwLock<Arc<crate::audit::AuditLog>>,
+}
+
+impl BridgeCore {
+    pub fn audit(&self) -> Arc<crate::audit::AuditLog> {
+        self.audit.read().unwrap_or_else(|p| p.into_inner()).clone()
+    }
+
+    pub fn new(
+        host_key: Arc<HostKey>,
+        store: MobileStore,
+        host_name: String,
+        events: Arc<dyn BridgeEvents>,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            host_key,
+            store,
+            pairing: PairingManager::default(),
+            sessions: SessionStore::default(),
+            limiter: RateLimiter::default(),
+            events,
+            facade: RwLock::new(None),
+            host_name: RwLock::new(host_name),
+            app_version: RwLock::new(String::new()),
+            rekey_offers: Mutex::new(HashMap::new()),
+            audit: RwLock::new(Arc::new(crate::audit::AuditLog::disabled())),
+        })
+    }
+
+    pub fn host_name(&self) -> String {
+        self.host_name.read().unwrap().clone()
+    }
+
+    /// The AionDX app version for `/v1/host` (§6.1); AionCore's own version if the app didn't say.
+    pub fn app_version(&self) -> String {
+        let v = self.app_version.read().unwrap().clone();
+        if v.is_empty() {
+            env!("CARGO_PKG_VERSION").to_owned()
+        } else {
+            v
+        }
+    }
+
+    pub fn facade(&self) -> Option<Arc<dyn InnerApi>> {
+        self.facade.read().unwrap().clone()
+    }
+}
diff --git a/crates/aionui-mobile/src/crypto.rs b/crates/aionui-mobile/src/crypto.rs
new file mode 100644
index 00000000..37e04edc
--- /dev/null
+++ b/crates/aionui-mobile/src/crypto.rs
@@ -0,0 +1,308 @@
+//! Primitives and derivations of protocol v1 (CONTRACT §4, §5, Appendix A).
+//! Pure functions only: no I/O, no clocks, no state. Every derivation here is
+//! checked byte for byte against `tests/vectors.json`, the same file the
+//! phone's TypeScript implementation is tested against.
+
+use base64::Engine;
+use base64::engine::general_purpose::URL_SAFE_NO_PAD;
+use chacha20poly1305::aead::{Aead, KeyInit, Payload};
+use chacha20poly1305::{XChaCha20Poly1305, XNonce};
+use hkdf::Hkdf;
+use hmac::{Hmac, Mac};
+use sha2::{Digest, Sha256};
+
+pub const LABEL_PAIR: &str = "aiondx/v1/pair";
+pub const LABEL_PAIR_REQ: &str = "aiondx/v1/pair-req";
+pub const LABEL_PAIR_RES: &str = "aiondx/v1/pair-res";
+pub const LABEL_SAS: &str = "aiondx/v1/sas";
+pub const LABEL_HS_INIT: &str = "aiondx/v1/hs-init";
+pub const LABEL_SESSION: &str = "aiondx/v1/session";
+pub const LABEL_SESSION_KEYS: &str = "aiondx/v1/session-keys";
+pub const LABEL_RPC_REQ: &str = "aiondx/v1/rpc-req";
+pub const LABEL_RPC_RES: &str = "aiondx/v1/rpc-res";
+pub const LABEL_REVOKED: &str = "aiondx/v1/revoked";
+pub const LABEL_CONFIRM: &str = "aiondx/v1/confirm";
+pub const LABEL_REKEY: &str = "aiondx/v1/rekey";
+
+pub const KEY_LEN: usize = 32;
+pub const NONCE_LEN: usize = 24;
+pub const SID_LEN: usize = 16;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct CryptoError;
+
+pub fn b64u(bytes: &[u8]) -> String {
+    URL_SAFE_NO_PAD.encode(bytes)
+}
+
+/// Strict base64url without padding; non-canonical input is rejected.
+pub fn from_b64u(s: &str) -> Result<Vec<u8>, CryptoError> {
+    URL_SAFE_NO_PAD.decode(s).map_err(|_| CryptoError)
+}
+
+pub fn key_from_b64u(s: &str) -> Result<[u8; KEY_LEN], CryptoError> {
+    from_b64u(s)?.try_into().map_err(|_| CryptoError)
+}
+
+pub fn sha256(parts: &[&[u8]]) -> [u8; 32] {
+    let mut h = Sha256::new();
+    for p in parts {
+        h.update(p);
+    }
+    h.finalize().into()
+}
+
+/// HKDF-SHA256. An empty salt is a zero-length salt (RFC 5869 then uses 32 zero bytes).
+pub fn hkdf(ikm: &[u8], salt: &[u8], info: &[u8], out: &mut [u8]) {
+    Hkdf::<Sha256>::new(Some(salt), ikm)
+        .expand(info, out)
+        .expect("HKDF output length is within limits");
+}
+
+pub fn hkdf32(ikm: &[u8], salt: &[u8], info: &[u8]) -> [u8; 32] {
+    let mut out = [0u8; 32];
+    hkdf(ikm, salt, info, &mut out);
+    out
+}
+
+pub fn hmac_sha256(key: &[u8], data: &[u8]) -> [u8; 32] {
+    let mut mac = <Hmac<Sha256> as Mac>::new_from_slice(key).expect("HMAC takes any key length");
+    mac.update(data);
+    mac.finalize().into_bytes().into()
+}
+
+/// Constant-time comparison of two MACs.
+pub fn mac_eq(a: &[u8], b: &[u8]) -> bool {
+    a.len() == b.len() && a.iter().zip(b).fold(0u8, |acc, (x, y)| acc | (x ^ y)) == 0
+}
+
+/// XChaCha20-Poly1305 seal; returns ciphertext ‖ 16-byte tag.
+pub fn seal(key: &[u8; KEY_LEN], nonce: &[u8; NONCE_LEN], plaintext: &[u8], aad: &[u8]) -> Vec<u8> {
+    XChaCha20Poly1305::new(key.into())
+        .encrypt(XNonce::from_slice(nonce), Payload { msg: plaintext, aad })
+        .expect("XChaCha20-Poly1305 encryption cannot fail for in-memory buffers")
+}
+
+pub fn open(key: &[u8; KEY_LEN], nonce: &[u8], sealed: &[u8], aad: &[u8]) -> Result<Vec<u8>, CryptoError> {
+    if nonce.len() != NONCE_LEN {
+        return Err(CryptoError);
+    }
+    XChaCha20Poly1305::new(key.into())
+        .decrypt(XNonce::from_slice(nonce), Payload { msg: sealed, aad })
+        .map_err(|_| CryptoError)
+}
+
+pub fn x25519(secret: &[u8; 32], public: &[u8; 32]) -> [u8; 32] {
+    x25519_dalek::x25519(*secret, *public)
+}
+
+pub fn x25519_public(secret: &[u8; 32]) -> [u8; 32] {
+    x25519_dalek::x25519(*secret, x25519_dalek::X25519_BASEPOINT_BYTES)
+}
+
+pub fn u64be(n: u64) -> [u8; 8] {
+    n.to_be_bytes()
+}
+
+// ---- Pairing (CONTRACT §4.2) -----------------------------------------------------------------
+
+pub fn pairing_key(
+    dh_device_host: &[u8; 32],
+    pairing_secret: &[u8],
+    host_pk: &[u8; 32],
+    device_pk: &[u8; 32],
+) -> [u8; 32] {
+    let info = [LABEL_PAIR.as_bytes(), host_pk, device_pk].concat();
+    hkdf32(dh_device_host, pairing_secret, &info)
+}
+
+pub fn pair_req_aad(host_id: &str, device_id: &str) -> Vec<u8> {
+    format!("{LABEL_PAIR_REQ}|{host_id}|{device_id}").into_bytes()
+}
+
+pub fn pair_res_aad(host_id: &str, device_id: &str) -> Vec<u8> {
+    format!("{LABEL_PAIR_RES}|{host_id}|{device_id}").into_bytes()
+}
+
+/// The six-digit short authentication string, formatted `ddd ddd`.
+pub fn short_auth_string(pairing_key: &[u8; 32]) -> String {
+    let mut bytes = [0u8; 4];
+    hkdf(pairing_key, &[], LABEL_SAS.as_bytes(), &mut bytes);
+    let digits = format!("{:06}", u32::from_be_bytes(bytes) % 1_000_000);
+    format!("{} {}", &digits[..3], &digits[3..])
+}
+
+// ---- Session handshake (CONTRACT §4.3) -------------------------------------------------------
+
+pub fn handshake_init_key(
+    dh_eph_static: &[u8; 32],
+    dh_static_static: &[u8; 32],
+    device_id: &str,
+    device_pk: &[u8; 32],
+    host_pk: &[u8; 32],
+    client_epk: &[u8; 32],
+) -> [u8; 32] {
+    let prefix = format!("{LABEL_HS_INIT}|{device_id}|");
+    let salt = sha256(&[prefix.as_bytes(), device_pk, host_pk, client_epk]);
+    hkdf32(
+        &[dh_eph_static.as_slice(), dh_static_static].concat(),
+        &salt,
+        LABEL_HS_INIT.as_bytes(),
+    )
+}
+
+pub fn handshake_init_aad(host_id: &str, device_id: &str, client_epk: &[u8; 32]) -> Vec<u8> {
+    [format!("{LABEL_HS_INIT}|{host_id}|{device_id}|").as_bytes(), client_epk].concat()
+}
+
+pub fn session_transcript(
+    device_id: &str,
+    device_pk: &[u8; 32],
+    host_pk: &[u8; 32],
+    client_epk: &[u8; 32],
+    host_epk: &[u8; 32],
+) -> [u8; 32] {
+    let prefix = format!("{LABEL_SESSION}|{device_id}|");
+    sha256(&[prefix.as_bytes(), device_pk, host_pk, client_epk, host_epk])
+}
+
+pub struct SessionKeys {
+    pub c2s: [u8; 32],
+    pub s2c: [u8; 32],
+    pub sid: [u8; SID_LEN],
+}
+
+/// `dhs` in the order DH(e_c,S_h), DH(S_c,S_h), DH(e_c,e_h), DH(S_c,e_h).
+pub fn session_keys(dhs: [&[u8; 32]; 4], transcript: &[u8; 32]) -> SessionKeys {
+    let ikm = [dhs[0].as_slice(), dhs[1], dhs[2], dhs[3]].concat();
+    let mut okm = [0u8; 80];
+    hkdf(&ikm, transcript, LABEL_SESSION_KEYS.as_bytes(), &mut okm);
+    let mut keys = SessionKeys {
+        c2s: [0; 32],
+        s2c: [0; 32],
+        sid: [0; SID_LEN],
+    };
+    keys.c2s.copy_from_slice(&okm[..32]);
+    keys.s2c.copy_from_slice(&okm[32..64]);
+    keys.sid.copy_from_slice(&okm[64..80]);
+    keys
+}
+
+// ---- RPC (CONTRACT §4.4) ---------------------------------------------------------------------
+
+pub fn rpc_aad(response: bool, sid: &[u8; SID_LEN], seq: u64) -> Vec<u8> {
+    let label = if response { LABEL_RPC_RES } else { LABEL_RPC_REQ };
+    [label.as_bytes(), sid, &u64be(seq)].concat()
+}
+
+// ---- Revocation notice (A1) ------------------------------------------------------------------
+
+pub fn revocation_key(dh_host_eph: &[u8; 32], host_id: &str, device_id: &str, client_epk: &[u8; 32]) -> [u8; 32] {
+    let aad = revocation_aad(host_id, device_id, client_epk);
+    hkdf32(dh_host_eph, &sha256(&[&aad]), LABEL_REVOKED.as_bytes())
+}
+
+pub fn revocation_aad(host_id: &str, device_id: &str, client_epk: &[u8; 32]) -> Vec<u8> {
+    [format!("{LABEL_REVOKED}|{host_id}|{device_id}|").as_bytes(), client_epk].concat()
+}
+
+// ---- Confirm and re-key proofs (§5, §5.3, §5.4) ----------------------------------------------
+
+pub fn confirm_mac_input(
+    sid: &[u8; SID_LEN],
+    seq: u64,
+    method: &str,
+    path: &str,
+    body_jcs: &str,
+    rid: &str,
+) -> Vec<u8> {
+    let body_hash = sha256(&[body_jcs.as_bytes()]);
+    [
+        LABEL_CONFIRM.as_bytes(),
+        sid,
+        &u64be(seq),
+        method.as_bytes(),
+        &[0],
+        path.as_bytes(),
+        &[0],
+        &body_hash,
+        rid.as_bytes(),
+    ]
+    .concat()
+}
+
+pub fn rekey_mac_input(sid: &[u8; SID_LEN], device_id: &str) -> Vec<u8> {
+    [LABEL_REKEY.as_bytes(), sid, device_id.as_bytes()].concat()
+}
+
+/// RFC 8785 canonical JSON for the value types sensitive bodies use. Floats are
+/// refused: the contract keeps them off the wire.
+pub fn jcs(value: &serde_json::Value) -> Result<String, CryptoError> {
+    use serde_json::Value;
+    Ok(match value {
+        Value::Null => "null".into(),
+        Value::Bool(b) => b.to_string(),
+        Value::Number(n) => {
+            let i = n.as_i64().ok_or(CryptoError)?;
+            if i.unsigned_abs() > (1u64 << 53) - 1 {
+                return Err(CryptoError);
+            }
+            i.to_string()
+        }
+        Value::String(s) => serde_json::to_string(s).map_err(|_| CryptoError)?,
+        Value::Array(items) => {
+            let parts: Result<Vec<_>, _> = items.iter().map(jcs).collect();
+            format!("[{}]", parts?.join(","))
+        }
+        Value::Object(map) => {
+            // RFC 8785 sorts keys by UTF-16 code units.
+            let mut keys: Vec<&String> = map.keys().collect();
+            keys.sort_by(|a, b| a.encode_utf16().cmp(b.encode_utf16()));
+            let mut parts = Vec::with_capacity(keys.len());
+            for k in keys {
+                parts.push(format!(
+                    "{}:{}",
+                    serde_json::to_string(k).map_err(|_| CryptoError)?,
+                    jcs(&map[k])?
+                ));
+            }
+            format!("{{{}}}", parts.join(","))
+        }
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn b64u_rejects_non_canonical_and_padded_input() {
+        assert_eq!(from_b64u("AA").unwrap(), vec![0]);
+        assert!(from_b64u("AB").is_err(), "non-zero trailing bits");
+        assert!(from_b64u("AA==").is_err(), "padding");
+        assert!(from_b64u("A+/=").is_err(), "standard alphabet");
+    }
+
+    #[test]
+    fn open_rejects_tampering() {
+        let key = [7u8; 32];
+        let nonce = [9u8; 24];
+        let sealed = seal(&key, &nonce, b"hello", b"aad");
+        assert_eq!(open(&key, &nonce, &sealed, b"aad").unwrap(), b"hello");
+        assert!(open(&key, &nonce, &sealed, b"other").is_err());
+        let mut bad = sealed.clone();
+        bad[0] ^= 1;
+        assert!(open(&key, &nonce, &bad, b"aad").is_err());
+        assert!(open(&key, &nonce[..23], &sealed, b"aad").is_err());
+    }
+
+    #[test]
+    fn jcs_refuses_floats_and_unsafe_integers() {
+        assert!(jcs(&serde_json::json!(1.5)).is_err());
+        assert!(jcs(&serde_json::json!(9007199254740992_i64)).is_err());
+        assert_eq!(
+            jcs(&serde_json::json!({"b":1,"a":[true,null]})).unwrap(),
+            r#"{"a":[true,null],"b":1}"#
+        );
+    }
+}
