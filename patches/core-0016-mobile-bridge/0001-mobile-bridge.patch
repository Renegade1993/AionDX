+        }
+    }
+    /// An adapter as GetAdaptersAddresses describes it.
+    fn adapter(ip: &str, interface: &str, if_type: u32, tunnel_type: i32, description: &str) -> Candidate {
+        Candidate {
+            tunnel_type,
+            description: description.into(),
+            ..cand(ip, interface, if_type, false)
+        }
+    }
+    fn la(ip: &str, interface: &str) -> LocalAddress {
+        LocalAddress {
+            ip: ip.parse().unwrap(),
+            interface: interface.into(),
+        }
+    }
+    fn ips(list: &[LocalAddress]) -> Vec<String> {
+        list.iter().map(|a| a.ip.to_string()).collect()
+    }
+
+    #[test]
+    fn order_is_rfc1918_then_cgnat_then_v4_link_local_then_ula_then_v6_link_local() {
+        let got = order(vec![
+            cand("fe80::1", "Wi-Fi", IF_TYPE_WIFI, true),
+            cand("fd00::5", "Wi-Fi", IF_TYPE_WIFI, true),
+            cand("169.254.9.9", "Ethernet 3", IF_TYPE_ETHERNET, false),
+            cand("100.101.1.2", "Tailscale", IF_TYPE_PROP_VIRTUAL, false),
+            cand("192.168.1.20", "Wi-Fi", IF_TYPE_WIFI, true),
+        ]);
