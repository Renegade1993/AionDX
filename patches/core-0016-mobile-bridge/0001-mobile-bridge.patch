+-- AionDX mobile bridge state. This lives in its own SQLite file (aiondx-bridge.db
+-- in the data dir), never in aionui-backend.db: a migration in AionCore's own chain
+-- would make every core without the bridge refuse to open the user's database.
+
+CREATE TABLE IF NOT EXISTS mobile_settings (
+    user_id       TEXT PRIMARY KEY,
+    settings_json TEXT NOT NULL,
+    updated_at    INTEGER NOT NULL
+);
+
+CREATE TABLE IF NOT EXISTS mobile_devices (
+    device_id          TEXT PRIMARY KEY,
+    user_id            TEXT NOT NULL,
+    device_pk          BLOB NOT NULL,
+    name               TEXT NOT NULL,
+    platform           TEXT NOT NULL,
+    app_version        TEXT NOT NULL,
+    confirm_mode       TEXT NOT NULL,
+    confirm_key_sealed BLOB,
+    require_confirm    INTEGER NOT NULL DEFAULT 1,
+    paired_at          INTEGER NOT NULL,
+    last_seen_at       INTEGER,
+    last_address       TEXT
+);
+
+CREATE TABLE IF NOT EXISTS mobile_device_tombstones (
+    device_id  TEXT PRIMARY KEY,
+    user_id    TEXT NOT NULL,
+    revoked_at INTEGER NOT NULL
+);
