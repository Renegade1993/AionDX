+    fn rule5_claude_questions_take_answers_and_decline_only() {
+        let t = tracked(BackendKind::ClaudeSession, "ask", ask("req-1"));
+        let qa = |q: &str, labels: &[&str]| QuestionAnswer {
+            question: q.into(),
+            labels: labels.iter().map(|s| s.to_string()).collect(),
+        };
+        let m = map_answer(
+            &t,
+            AnswerInput::Answers {
