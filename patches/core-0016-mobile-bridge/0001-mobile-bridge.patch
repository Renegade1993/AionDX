diff --git a/crates/aionui-team/src/service/user_actions.rs b/crates/aionui-team/src/service/user_actions.rs
new file mode 100644
index 00000000..60bdd763
--- /dev/null
+++ b/crates/aionui-team/src/service/user_actions.rs
@@ -0,0 +1,202 @@
+//! AionDX core-0016: team actions taken by the user directly, from the desktop or a
+//! paired phone (docs/mobile-bridge/CONTRACT.md §6.6, §6.7). The phone is the user
+//! (CONTRACT §3.3), so these check team ownership, like every user route.
+
+use aionui_api_types::TeamTaskResponse;
+
+use super::TeamSessionService;
+use crate::error::TeamError;
+use crate::mcp::server::{format_task_assignment_notice, should_wake_task_owner};
+use crate::task_board::TaskUpdate;
+use crate::types::{TaskStatus, TeamTask};
+
+/// A new task from the user.
+#[derive(Debug, Clone, Default)]
+pub struct UserTaskCreate {
+    pub subject: String,
+    pub description: Option<String>,
+    pub owner: Option<String>,
+    pub blocked_by: Vec<String>,
+}
+
+/// A task edit from the user. `owner: Some(None)` unassigns.
+#[derive(Debug, Clone, Default)]
+pub struct UserTaskPatch {
+    pub subject: Option<String>,
+    pub description: Option<String>,
+    pub status: Option<String>,
+    pub owner: Option<Option<String>>,
+    pub blocked_by: Option<Vec<String>>,
+}
+
+impl TeamSessionService {
+    /// Creates a task as the user, then notifies and wakes its owner exactly as the
+    /// MCP `team_task_create` tool does (the notice comes from "user").
+    pub async fn create_task_from_user(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        input: UserTaskCreate,
+    ) -> Result<TeamTaskResponse, TeamError> {
+        self.load_owned_team(user_id, team_id).await?;
+        self.ensure_session_inner(team_id, Some(user_id)).await?;
+        let scheduler = self
+            .get_session_scheduler(team_id)
+            .ok_or_else(|| TeamError::SessionNotFound(team_id.to_owned()))?;
+        self.check_blockers(&scheduler, &input.blocked_by).await?;
+        let task = scheduler
+            .create_task(
+                &input.subject,
+                input.description.as_deref(),
+                input.owner.as_deref(),
+                &input.blocked_by,
+            )
+            .await?;
+        self.notify_owner_from_user(user_id, team_id, &task).await;
+        self.task_response(user_id, team_id, &task.id).await
+    }
+
+    /// Edits a task as the user. A changed owner is notified, and completing a task
+    /// notifies the owners of tasks it unblocks, as the MCP `team_task_update` tool does.
+    pub async fn update_task_from_user(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        task_id: &str,
+        patch: UserTaskPatch,
+    ) -> Result<TeamTaskResponse, TeamError> {
+        self.load_owned_team(user_id, team_id).await?;
+        self.ensure_session_inner(team_id, Some(user_id)).await?;
+        let scheduler = self
+            .get_session_scheduler(team_id)
+            .ok_or_else(|| TeamError::SessionNotFound(team_id.to_owned()))?;
+        if let Some(blockers) = &patch.blocked_by {
+            if blockers.iter().any(|b| b == task_id) {
+                return Err(TeamError::InvalidRequest("a task cannot block itself".into()));
+            }
+            self.check_blockers(&scheduler, blockers).await?;
+        }
+        let status = match patch.status.as_deref() {
+            None => None,
+            Some(s) => Some(
+                TaskStatus::parse(s).ok_or_else(|| TeamError::InvalidRequest(format!("unknown task status '{s}'")))?,
+            ),
+        };
+        let reassigned = patch.owner.is_some();
+        let completed = status == Some(TaskStatus::Completed);
+        let update = TaskUpdate {
+            subject: patch.subject,
+            clear_owner: matches!(patch.owner, Some(None)),
+            status,
+            description: patch.description,
+            owner: patch.owner.flatten(),
+            blocked_by: patch.blocked_by,
+            ..Default::default()
+        };
+        let task = scheduler.task_board.update_task(team_id, task_id, &update).await?;
+        if reassigned {
+            self.notify_owner_from_user(user_id, team_id, &task).await;
+        }
+        if completed
+            && !task.blocks.is_empty()
+            && let Ok(all) = scheduler.list_tasks().await
+        {
+            for downstream in all.iter().filter(|t| task.blocks.contains(&t.id)) {
+                self.notify_owner_from_user(user_id, team_id, downstream).await;
+            }
+        }
+        self.task_response(user_id, team_id, task_id).await
+    }
+
+    /// A shutdown request from the user to a teammate (never the lead).
+    pub async fn shutdown_agent_from_user(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        slot_id: &str,
+        reason: Option<&str>,
+    ) -> Result<String, TeamError> {
+        self.load_owned_team(user_id, team_id).await?;
+        self.ensure_session_inner(team_id, Some(user_id)).await?;
+        let session = self.published_session(team_id)?;
+        session.shutdown_agent_from_user(slot_id, reason).await
+    }
+
+    async fn check_blockers(
+        &self,
+        scheduler: &crate::scheduler::TeammateManager,
+        blockers: &[String],
+    ) -> Result<(), TeamError> {
+        if blockers.is_empty() {
+            return Ok(());
+        }
+        let known: Vec<String> = scheduler.list_tasks().await?.into_iter().map(|t| t.id).collect();
+        match blockers.iter().find(|b| !known.contains(b)) {
+            Some(missing) => Err(TeamError::BlockedTaskNotFound(missing.clone())),
+            None => Ok(()),
+        }
+    }
+
+    async fn task_response(&self, user_id: &str, team_id: &str, task_id: &str) -> Result<TeamTaskResponse, TeamError> {
+        self.list_team_tasks_by_ids(user_id, team_id, &[task_id.to_owned()])
+            .await?
+            .into_iter()
+            .next()
+            .ok_or_else(|| TeamError::TaskNotFound(task_id.to_owned()))
+    }
+
+    /// The owner notice, sent through the user-message path so it appears as the
+    /// user's own message in the owner's chat (CONTRACT §6.4, rev 4.1).
+    async fn notify_owner_from_user(&self, user_id: &str, team_id: &str, task: &TeamTask) {
+        let Some(owner) = task.owner.as_deref() else { return };
+        let Some(scheduler) = self.get_session_scheduler(team_id) else {
+            return;
+        };
+        let owner_role = scheduler.get_agent(owner).await.ok().map(|agent| agent.role);
+        if !should_wake_task_owner(task, "user", owner_role) {
+            return;
+        }
+        let notice = format_task_assignment_notice(task);
+        if let Err(error) = self.send_message_to_agent(user_id, team_id, owner, &notice, None).await {
+            tracing::warn!(team_id, owner_slot = owner, task_id = %task.id, error = %error, "failed to notify task owner");
+        } else {
+            tracing::info!(team_id, owner_slot = owner, task_id = %task.id, "task owner notified (from the user)");
+        }
+    }
+}
+
+impl TeamSessionService {
+    /// Adds a teammate as the user (CONTRACT §6.6). Without a `model`, it is resolved
+    /// from the assistant's own configuration, as the lead's `team_spawn_agent` does,
+    /// with the lead's backend and model as the fallback.
+    pub async fn spawn_agent_from_user(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        assistant_id: &str,
+        name: &str,
+        model: Option<&str>,
+    ) -> Result<aionui_api_types::TeamAgentResponse, TeamError> {
+        let team = self.load_owned_team(user_id, team_id).await?;
+        let lead = team
+            .agents
+            .iter()
+            .find(|a| a.role == crate::types::TeammateRole::Lead)
+            .ok_or_else(|| TeamError::InvalidRequest("the team has no lead".into()))?;
+        let (_backend, resolved_model) = self
+            .resolve_spawn_backend_and_model(user_id, Some(assistant_id), model, &lead.backend, &lead.model)
+            .await?;
+        self.add_agent(
+            user_id,
+            team_id,
+            aionui_api_types::AddAgentRequest {
+                name: name.to_owned(),
+                role: "teammate".into(),
+                backend: None,
+                model: resolved_model,
+                assistant_id: Some(assistant_id.to_owned()),
+            },
+        )
+        .await
+    }
+}
