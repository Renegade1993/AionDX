+    /// AionDX core-0016: the user (the desktop or a paired phone) asks a teammate to
+    /// shut down, through the same mailbox protocol the lead's tool uses. The agent
+    /// answers `shutdown_approved` (it is then removed) or `shutdown_rejected:<reason>`
+    /// (delivered to the lead's mailbox, as for a lead's request).
+    pub(crate) async fn shutdown_agent_from_user(
+        &self,
+        target_slot_id: &str,
+        reason: Option<&str>,
+    ) -> Result<String, TeamError> {
+        let target = self.scheduler.get_agent(target_slot_id).await?;
+        if target.role == TeammateRole::Lead {
+            return Err(TeamError::InvalidRequest("cannot shutdown the team lead".into()));
+        }
+        self.ensure_member_runtime_lazy(target_slot_id, false).await?;
+        self.publish_runtime_constraint(target_slot_id).await?;
+        let lease = self.work_coordinator.acquire_enqueue(EnqueueRequest {
+            slot_id: target_slot_id.to_owned(),
+            role: target_role_for(target.role),
+            source: WorkSource::UserMessage,
+            binding: CausalBinding::UserVisible,
+        })?;
+        let message = match self
+            .mailbox
+            .write(
+                &self.team.id,
+                target_slot_id,
+                "user",
+                MailboxMessageType::ShutdownRequest,
+                reason.unwrap_or("shutdown requested"),
+                None,
+            )
+            .await
+        {
+            Ok(message) => message,
+            Err(error) => {
+                self.work_coordinator.abort_enqueue(&lease, "mailbox_write_failed");
+                return Err(error);
+            }
+        };
+        self.commit_persisted_enqueue(&lease, message.id.clone()).await?;
+        self.event_loops.notify(target_slot_id);
+        Ok(message.id)
+    }
