+        ConfirmCheck::Missing,
+        "PATCH",
+        "/v1/teams/t1/tasks/k1",
+        json!({ "status": "deleted" }),
+    )
+    .await;
+    assert_eq!(status, 428, "deleting a task is sensitive");
+    let (status, _) = call(
+        &f,
+        ConfirmCheck::Missing,
+        "PATCH",
+        "/v1/teams/t1/tasks/k1",
+        json!({ "status": "completed" }),
