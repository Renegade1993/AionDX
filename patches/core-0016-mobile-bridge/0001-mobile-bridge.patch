+
+    async fn create_solo(&self, user_id: &str, spec: SoloSpec) -> Result<ConversationResponse, BackendError> {
+        let mut extra = serde_json::json!({});
+        if let Some(ws) = spec.workspace {
+            extra["workspace"] = ws.into();
+        }
+        if let Some(model) = spec.model {
+            extra["current_model_id"] = model.into();
+        }
+        let mut req = serde_json::json!({ "extra": extra });
+        if let Some(name) = spec.name {
+            req["name"] = name.into();
+        }
+        match (spec.assistant_id, spec.agent_backend) {
+            (Some(id), _) => req["assistant"] = serde_json::json!({ "id": id }),
+            (None, Some(backend)) => {
+                req["type"] = "acp".into();
+                req["extra"]["backend"] = backend.into();
+            }
+            (None, None) => return Err(BackendError::Invalid("assistantId or backend is required".into())),
+        }
+        self.conversation
+            .create(user_id, from_json(req)?)
+            .await
+            .map_err(map_err)
+    }
+
+    async fn send_solo(
+        &self,
+        user_id: &str,
+        conversation_id: &str,
+        content: &str,
+    ) -> Result<SendOutcome, BackendError> {
+        let req = from_json(serde_json::json!({ "content": content }))?;
+        let resp = self
+            .conversation
+            .send_message(user_id, conversation_id, req, &self.task_manager)
+            .await
+            .map_err(map_err)?;
+        Ok(SendOutcome {
+            message_id: resp.msg_id,
+            delivery: if resp.delivered_midturn { "midturn" } else { "started" },
+        })
+    }
+
+    async fn send_to_agent(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        slot_id: &str,
+        content: &str,
+        now: bool,
+    ) -> Result<SendOutcome, BackendError> {
+        if now {
+            let req = from_json(serde_json::json!({ "content": content }))?;
+            let resp = self
+                .team
+                .steer_agent(user_id, team_id, slot_id, req)
+                .await
+                .map_err(map_err)?;
+            let delivery = match wire(&resp.outcome).as_str() {
+                "delivered_midturn" => "midturn",
+                "queued_first" | "moved_to_front" => "queued_first",
+                _ => "started",
+            };
+            return Ok(SendOutcome {
+                message_id: resp.message_id.unwrap_or_default(),
+                delivery,
+            });
+        }
+        let ack = self
+            .team
+            .send_message_to_agent(user_id, team_id, slot_id, content, None)
+            .await
+            .map_err(map_err)?;
+        let delivery = match wire(&ack.enqueue_status).as_str() {
+            "accepted" => "started",
+            _ => "queued",
+        };
+        Ok(SendOutcome {
+            message_id: ack.message_id,
+            delivery,
+        })
+    }
+
+    async fn wake_agent(&self, user_id: &str, team_id: &str, slot_id: &str) -> Result<(), BackendError> {
