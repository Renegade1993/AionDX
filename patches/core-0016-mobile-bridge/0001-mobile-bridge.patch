+
+    #[test]
+    fn within_rfc1918_physical_with_gateway_then_virtual_ethernet_before_wifi() {
+        let got = order(vec![
+            cand("172.20.0.1", "vEthernet (WSL)", IF_TYPE_ETHERNET, false),
+            cand("10.0.0.7", "Wi-Fi", IF_TYPE_WIFI, true),
+            cand("192.168.50.2", "Hamachi", IF_TYPE_PROP_VIRTUAL, true),
+            cand("192.168.1.5", "Ethernet", IF_TYPE_ETHERNET, true),
+            cand("192.168.56.1", "VirtualBox", IF_TYPE_ETHERNET, false),
+        ]);
+        // Virtual adapters last whatever their gateway; among them Ethernet-typed before PROP_VIRTUAL.
+        assert_eq!(
+            ips(&got),
+            ["192.168.1.5", "10.0.0.7", "172.20.0.1", "192.168.56.1", "192.168.50.2"]
+        );
+    }
+
+    /// The adapters on the PC used for the real-phone test: a connected NordVPN must not outrank Wi-Fi.
+    #[test]
+    fn physical_wifi_beats_a_connected_vpn_and_virtual_adapters() {
+        let with_gw = |c: Candidate| Candidate { has_gateway: true, ..c };
+        let got = order(vec![
+            with_gw(adapter(
+                "10.5.0.2",
+                "NordLynx",
+                IF_TYPE_PROP_VIRTUAL,
+                0,
+                "NordLynx Tunnel",
+            )),
+            with_gw(adapter(
+                "26.119.0.5",
+                "Radmin VPN",
+                IF_TYPE_ETHERNET,
+                0,
+                "Famatech Radmin VPN Ethernet Adapter",
+            )),
+            with_gw(adapter(
+                "192.168.49.10",
+                "Ethernet 5",
+                IF_TYPE_ETHERNET,
+                0,
+                "PdaNet Broadband Adapter",
+            )),
+            adapter(
+                "10.66.0.2",
+                "Private Party Net",
+                IF_TYPE_PROP_VIRTUAL,
+                0,
+                "WireGuard Tunnel",
+            ),
+            adapter(
+                "172.28.0.1",
+                "vEthernet (Default Switch)",
+                IF_TYPE_ETHERNET,
+                0,
+                "Hyper-V Virtual Ethernet Adapter",
+            ),
+            with_gw(adapter(
+                "192.168.1.20",
+                "Wi-Fi",
+                IF_TYPE_WIFI,
+                0,
+                "Intel(R) Wi-Fi 6E AX211 160MHz",
+            )),
+        ]);
+        let got = ips(&got);
+        assert_eq!(got[0], "192.168.1.20", "physical Wi-Fi with a gateway first: {got:?}");
+        assert!(
+            !got.contains(&"26.119.0.5".to_string()),
+            "Radmin's 26.x is public, never listed"
+        );
+        for vpn in ["10.5.0.2", "192.168.49.10", "10.66.0.2", "172.28.0.1"] {
+            assert!(got.contains(&vpn.to_string()), "{vpn} is re-ordered, never excluded");
+        }
+        assert_eq!(
+            got,
+            ["192.168.1.20", "192.168.49.10", "172.28.0.1", "10.5.0.2", "10.66.0.2"]
+        );
+    }
+
+    #[test]
+    fn a_physical_adapter_without_a_gateway_sits_between() {
+        let got = order(vec![
+            cand("10.9.0.1", "NordLynx", IF_TYPE_PROP_VIRTUAL, true),
+            cand("192.168.2.1", "Ethernet 2", IF_TYPE_ETHERNET, false),
+            cand("192.168.3.1", "Cellular", 243, false),
+            cand("192.168.1.20", "Wi-Fi", IF_TYPE_WIFI, true),
+        ]);
+        assert_eq!(ips(&got), ["192.168.1.20", "192.168.2.1", "192.168.3.1", "10.9.0.1"]);
+    }
+
+    #[test]
+    fn public_loopback_unspecified_and_mapped_addresses_never_appear() {
+        let got = order(vec![
+            cand("8.8.8.8", "Ethernet", IF_TYPE_ETHERNET, true),
+            cand("2001:db8::1", "Ethernet", IF_TYPE_ETHERNET, true),
+            cand("2606:4700::1111", "Ethernet", IF_TYPE_ETHERNET, true),
+            cand("127.0.0.1", "Loopback", IF_TYPE_PROP_VIRTUAL, false),
+            cand("::1", "Loopback", IF_TYPE_PROP_VIRTUAL, false),
+            cand("0.0.0.0", "Ethernet", IF_TYPE_ETHERNET, true),
+            cand("::ffff:192.168.1.2", "Ethernet", IF_TYPE_ETHERNET, true),
+            cand("100.128.0.1", "Ethernet", IF_TYPE_ETHERNET, true),
+            cand("192.168.1.2", "Ethernet", IF_TYPE_ETHERNET, true),
+        ]);
+        assert_eq!(ips(&got), ["192.168.1.2"]);
+    }
+
+    #[test]
+    fn duplicates_are_removed_keeping_the_best_ranked() {
+        let got = order(vec![
+            cand("192.168.1.5", "Wi-Fi", IF_TYPE_WIFI, false),
+            cand("192.168.1.5", "Ethernet", IF_TYPE_ETHERNET, true),
+        ]);
+        assert_eq!(got, vec![la("192.168.1.5", "Ethernet")]);
+    }
+
+    #[test]
+    fn wireguard_stays_and_ipv6_transition_tunnels_go() {
+        let got = order(vec![
+            // WireGuard-NT / wintun: IF_TYPE_PROP_VIRTUAL, tunnel type none. Private Party Net is one.
+            adapter(
+                "10.66.0.2",
+                "Private Party Net",
+                IF_TYPE_PROP_VIRTUAL,
+                0,
+                "WireGuard Tunnel",
+            ),
+            adapter("100.64.7.9", "wg0", IF_TYPE_PROP_VIRTUAL, 0, "Wintun Userspace Tunnel"),
+            adapter(
+                "fd7a:115c:a1e0::5",
+                "Tailscale",
+                IF_TYPE_PROP_VIRTUAL,
+                0,
+                "Tailscale Tunnel",
+            ),
+            // Teredo by tunnel type, ISATAP by tunnel type, 6to4 by tunnel type, and Teredo by description alone.
+            adapter(
+                "fe80::8000:abcd:1:2",
+                "Teredo Tunneling Pseudo-Interface",
+                IF_TYPE_PROP_VIRTUAL,
+                14,
+                "Teredo Tunneling Pseudo-Interface",
+            ),
+            adapter(
+                "fe80::5efe:c0a8:15f",
+                "isatap.{1234}",
+                IF_TYPE_PROP_VIRTUAL,
+                13,
+                "Microsoft ISATAP Adapter",
+            ),
+            adapter(
+                "fe80::2002:1",
+                "6TO4 Adapter",
+                IF_TYPE_PROP_VIRTUAL,
+                11,
+                "Microsoft 6to4 Adapter",
+            ),
+            adapter(
+                "fe80::9",
+                "Tunnel 9",
+                IF_TYPE_PROP_VIRTUAL,
+                0,
+                "Microsoft Teredo Tunneling Adapter",
+            ),
+        ]);
+        assert_eq!(ips(&got), ["10.66.0.2", "100.64.7.9", "fd7a:115c:a1e0::5"]);
+        assert!(!is_transition_tunnel(0, "WireGuard Tunnel"));
+        assert!(is_transition_tunnel(14, "") && is_transition_tunnel(13, "") && is_transition_tunnel(11, ""));
+    }
+
+    #[test]
+    fn urls_for_v4_and_v6_never_link_local_v6() {
+        let urls = pairing_urls(
+            &[
+                la("192.168.1.5", "Ethernet"),
+                la("100.101.1.2", "Tailscale"),
+                la("fd12:3456::1", "Wi-Fi"),
+                la("fe80::1", "eth0"),
+                la("fe80::2", "Ethernet 2"),
+                la("fe80::3", ""),
+                la("169.254.9.9", "Ethernet 3"),
+            ],
+            47734,
+        );
+        assert_eq!(
+            urls,
+            [
+                "http://192.168.1.5:47734",
+                "http://100.101.1.2:47734",
+                "http://[fd12:3456::1]:47734",
+                "http://169.254.9.9:47734",
+            ]
+        );
+    }
+
+    #[test]
+    fn urls_keep_the_given_order_drop_repeats_and_never_list_a_public_address() {
+        let urls = pairing_urls(
+            &[
+                la("10.0.0.2", "Wi-Fi"),
+                la("8.8.8.8", "Ethernet"),
+                la("192.168.1.5", "Ethernet"),
+                la("10.0.0.2", "Ethernet"),
+                la("2001:db8::1", "Ethernet"),
+                la("127.0.0.1", "Loopback"),
+            ],
+            8080,
+        );
+        assert_eq!(urls, ["http://10.0.0.2:8080", "http://192.168.1.5:8080"]);
+        assert!(pairing_urls(&[], 1).is_empty());
+    }
+
+    #[test]
+    fn private_addresses_smoke() {
+        let got = private_addresses();
+        for a in &got {
+            assert!(is_private_peer(a.ip) && !a.ip.is_loopback(), "{a:?}");
+        }
+        let mut seen = std::collections::HashSet::new();
+        assert!(got.iter().all(|a| seen.insert(a.ip)), "no duplicates");
+    }
+}
diff --git a/crates/aionui-mobile/src/outer.rs b/crates/aionui-mobile/src/outer.rs
new file mode 100644
index 00000000..cf1fafb0
--- /dev/null
+++ b/crates/aionui-mobile/src/outer.rs
@@ -0,0 +1,405 @@
+//! The LAN routes `pair`, `session` and `rpc` (CONTRACT §4.2–4.4). Outer
+//! errors are plaintext `{"error": code, ...}` and never carry secrets.
+
+use std::net::SocketAddr;
+use std::sync::Arc;
+use std::time::Duration;
+
+use axum::Json;
+use axum::body::Bytes;
+use axum::extract::{ConnectInfo, State};
+use axum::http::StatusCode;
+use axum::response::{IntoResponse, Response};
+use serde_json::{Value, json};
+
+use crate::core::{BridgeCore, ConfirmCheck, InnerContext, Limit};
+use crate::crypto;
+use crate::host_key::random_bytes;
+use crate::pairing::PairError;
+use crate::session::{HandshakeError, HandshakeOutcome, KnownDevice, Opened, RpcError};
+use crate::wire::{
+    HandshakeInitBody, InnerRequest, InnerResponse, PROTOCOL_VERSION, PairRequestBody, PairResponsePayload,
+    RpcEnvelope, SealedResponse,
+};
+
+/// How long a `wait: true` pair request is held (§4.2).
+const PAIR_LONG_POLL: Duration = Duration::from_secs(20);
+
+fn now() -> i64 {
+    aionui_common::now_ms()
+}
+
+fn plain_error(status: StatusCode, code: &str) -> Response {
+    (status, Json(json!({ "error": code }))).into_response()
+}
+
+fn clock_skew() -> Response {
+    (
+        StatusCode::BAD_REQUEST,
+        Json(json!({ "error": "clock_skew", "hostTime": now() })),
+    )
+        .into_response()
+}
+
+fn parse<T: serde::de::DeserializeOwned>(body: &Bytes) -> Result<T, Box<Response>> {
+    serde_json::from_slice(body).map_err(|_| Box::new(plain_error(StatusCode::BAD_REQUEST, "malformed")))
+}
+
+fn unknown_host(core: &BridgeCore) -> Response {
+    (
+        StatusCode::CONFLICT,
+        Json(json!({ "error": "unknown_host", "hostId": core.host_key.host_id })),
+    )
+        .into_response()
+}
+
+pub async fn pair(
+    State(core): State<Arc<BridgeCore>>,
+    ConnectInfo(peer): ConnectInfo<SocketAddr>,
+    body: Bytes,
+) -> Response {
+    if !core.limiter.allow(peer.ip(), Limit::Pair, now()) {
+        return plain_error(StatusCode::TOO_MANY_REQUESTS, "rate_limited");
+    }
+    let req: PairRequestBody = match parse(&body) {
+        Ok(r) => r,
+        Err(resp) => return *resp,
+    };
+    let accepted = match core.pairing.handle_request(&core.host_key, &req, now()) {
+        Ok(a) => a,
+        Err(PairError::UnsupportedVersion) => return plain_error(StatusCode::BAD_REQUEST, "unsupported_version"),
+        Err(PairError::Malformed) => return plain_error(StatusCode::BAD_REQUEST, "malformed"),
+        Err(PairError::UnknownHost) => return unknown_host(&core),
+        Err(PairError::Expired) => return plain_error(StatusCode::GONE, "pairing_expired"),
+        Err(PairError::Locked) => return plain_error(StatusCode::CONFLICT, "pairing_locked"),
+        Err(PairError::AuthFailed) => return plain_error(StatusCode::UNAUTHORIZED, "auth_failed"),
+        Err(PairError::ClockSkew) => return clock_skew(),
+    };
+    if accepted.first
+        && let Some((user_id, offer_id, request)) = core.pairing.pending_request()
+    {
+        core.events.emit(
+            &user_id,
+            "mobile.pairingRequest",
+            json!({ "offerId": offer_id, "deviceName": request.device_name, "sas": request.sas }),
+        );
+    }
+
+    let (mut status, mut confirm_key) = core.pairing.status_for(&accepted.device_id, now());
+    if accepted.wait && status == "pending" {
+        let mut changes = core.pairing.subscribe();
+        let _ = tokio::time::timeout(PAIR_LONG_POLL, async {
+            loop {
+                if changes.changed().await.is_err() {
+                    return;
+                }
+                if core.pairing.status_for(&accepted.device_id, now()).0 != "pending" {
+                    return;
+                }
+            }
+        })
+        .await;
+        (status, confirm_key) = core.pairing.status_for(&accepted.device_id, now());
+    }
+
+    let payload = PairResponsePayload {
+        status,
+        host_id: core.host_key.host_id.clone(),
+        host_name: core.host_name(),
+        ts: now(),
+        req_ts: accepted.req_ts,
+        confirm_key: confirm_key.map(|k| crypto::b64u(&k)),
+    };
+    let Ok(nonce) = random_bytes::<24>() else {
+        return plain_error(StatusCode::INTERNAL_SERVER_ERROR, "internal");
+    };
+    let plain = serde_json::to_vec(&payload).unwrap_or_default();
+    let aad = crypto::pair_res_aad(&core.host_key.host_id, &accepted.device_id);
+    let ct = crypto::seal(&accepted.pairing_key, &nonce, &plain, &aad);
+    Json(SealedResponse {
+        v: PROTOCOL_VERSION,
+        nonce: crypto::b64u(&nonce),
+        ct: crypto::b64u(&ct),
+    })
+    .into_response()
+}
+
+pub async fn session(
+    State(core): State<Arc<BridgeCore>>,
+    ConnectInfo(peer): ConnectInfo<SocketAddr>,
+    body: Bytes,
+) -> Response {
+    if !core.limiter.allow(peer.ip(), Limit::Session, now()) {
+        return plain_error(StatusCode::TOO_MANY_REQUESTS, "rate_limited");
+    }
+    let req: HandshakeInitBody = match parse(&body) {
+        Ok(r) => r,
+        Err(resp) => return *resp,
+    };
+    let row = match core.store.device(&req.device_id).await {
+        Ok(row) => row,
+        Err(e) => {
+            tracing::error!(error = %e, "mobile bridge: device lookup failed");
+            return plain_error(StatusCode::SERVICE_UNAVAILABLE, "unavailable");
+        }
+    };
+    let known = row.as_ref().and_then(|d| {
+        let pk: [u8; 32] = d.device_pk.clone().try_into().ok()?;
+        Some(KnownDevice {
+            user_id: d.user_id.clone(),
+            device_pk: pk,
+        })
+    });
+    let revoked = known.is_none() && core.store.is_tombstoned(&req.device_id).await.unwrap_or(false);
+    match core
+        .sessions
+        .handshake(&core.host_key, &req, known.as_ref(), revoked, now())
+    {
+        Ok(HandshakeOutcome::Ok { response, .. }) => {
+            let _ = core.store.touch_device(&req.device_id, &peer.ip().to_string()).await;
+            tracing::info!(device_id = %req.device_id, "mobile bridge: session opened");
+            Json(response).into_response()
+        }
+        Ok(HandshakeOutcome::Revoked { notice }) => {
+            tracing::info!(device_id = %req.device_id, revoked, "mobile bridge: handshake from an untrusted device");
+            (
+                StatusCode::FORBIDDEN,
+                Json(json!({ "error": "device_revoked", "notice": notice })),
+            )
+                .into_response()
+        }
+        Err(HandshakeError::UnsupportedVersion) => plain_error(StatusCode::BAD_REQUEST, "unsupported_version"),
+        Err(HandshakeError::Malformed) => plain_error(StatusCode::BAD_REQUEST, "malformed"),
+        Err(HandshakeError::UnknownHost) => unknown_host(&core),
+        Err(HandshakeError::AuthFailed) => plain_error(StatusCode::UNAUTHORIZED, "auth_failed"),
+        Err(HandshakeError::ClockSkew) => clock_skew(),
+    }
+}
+
+pub async fn rpc(
+    State(core): State<Arc<BridgeCore>>,
+    ConnectInfo(peer): ConnectInfo<SocketAddr>,
+    body: Bytes,
+) -> Response {
+    if !core.limiter.allow(peer.ip(), Limit::Rpc, now()) {
+        return plain_error(StatusCode::TOO_MANY_REQUESTS, "rate_limited");
+    }
+    let env: RpcEnvelope = match parse(&body) {
+        Ok(r) => r,
+        Err(resp) => return *resp,
+    };
+    let opened = match core.sessions.open(&env, now()) {
+        Ok(Opened::New(o)) => o,
+        Ok(Opened::Duplicate(resp)) => return Json(resp).into_response(),
+        Err(RpcError::UnsupportedVersion) => return plain_error(StatusCode::BAD_REQUEST, "unsupported_version"),
+        Err(RpcError::Malformed) => return plain_error(StatusCode::BAD_REQUEST, "malformed"),
+        Err(RpcError::UnknownSession) => return plain_error(StatusCode::UNAUTHORIZED, "unknown_session"),
+        Err(RpcError::SessionExpired) => return plain_error(StatusCode::UNAUTHORIZED, "session_expired"),
+        Err(RpcError::AuthFailed) => return plain_error(StatusCode::UNAUTHORIZED, "auth_failed"),
+        Err(RpcError::Replayed) => return plain_error(StatusCode::BAD_REQUEST, "replayed"),
+    };
+    let inner = match serde_json::from_slice::<InnerRequest>(&opened.plaintext) {
+        Ok(req) => dispatch(&core, &opened, req).await,
+        Err(_) => InnerResponse::error(400, "invalid_request", "The request is not a valid inner request"),
+    };
+    match core.sessions.seal(&env, &opened, &inner) {
+        Some(sealed) => Json(sealed).into_response(),
+        None => plain_error(StatusCode::UNAUTHORIZED, "unknown_session"),
+    }
+}
+
+async fn dispatch(core: &BridgeCore, opened: &crate::session::OpenedRpc, req: InnerRequest) -> InnerResponse {
+    let mutating = req.method != "GET";
+    if mutating && let Some(previous) = core.sessions.rid_response(&opened.device_id, &req.rid, now()) {
+        return previous;
+    }
+    let ctx = InnerContext {
+        user_id: opened.user_id.clone(),
+        device_id: opened.device_id.clone(),
+        sid: opened.sid,
+        seq: opened.seq,
+        confirm: confirm_check(core, opened, &req).await,
+    };
+    let response = match builtin(core, &ctx, &req).await {
+        Some(r) => r,
+        None => match core.facade() {
+            Some(facade) => facade.handle(&ctx, &req).await,
+            None => None,
+        }
+        .unwrap_or_else(|| InnerResponse::error(404, "no_such_route", "No such route")),
+    };
+    if mutating {
+        core.sessions
+            .remember_rid(&opened.device_id, &req.rid, &response, now());
+        let code = response
+            .body
+            .as_ref()
+            .and_then(|b| b["error"]["code"].as_str())
+            .map(str::to_owned);
+        core.audit().request(
+            &opened.device_id,
+            &req.method,
+            &req.path,
+            response.status,
+            code.as_deref(),
+        );
+    }
+    response
+}
+
+/// Checks the request's confirm proof (CONTRACT §5, byte layout §5.4). Sensitive
+/// routes decide what to do with the result; others ignore it.
+async fn confirm_check(core: &BridgeCore, opened: &crate::session::OpenedRpc, req: &InnerRequest) -> ConfirmCheck {
+    let Ok(Some(device)) = core.store.device(&opened.device_id).await else {
+        return ConfirmCheck::Invalid;
+    };
+    if !device.require_confirm {
+        return ConfirmCheck::NotRequired;
+    }
+    let Some(proof) = req.confirm.as_deref() else {
+        return ConfirmCheck::Missing;
+    };
+    let Some(key) = device
+        .confirm_key_sealed
+        .as_deref()
+        .and_then(|sealed| crate::service::open_confirm_key(core.host_key.data_key(), sealed))
+    else {
+        return ConfirmCheck::Invalid;
+    };
+    let Ok(body) = crypto::jcs(req.body.as_ref().unwrap_or(&Value::Null)) else {
+        return ConfirmCheck::Invalid;
+    };
+    let input = crypto::confirm_mac_input(&opened.sid, opened.seq, &req.method, &req.path, &body, &req.rid);
+    let expected = crypto::hmac_sha256(&key, &input);
+    match crypto::from_b64u(proof) {
+        Ok(given) if crypto::mac_eq(&given, &expected) => ConfirmCheck::Verified,
+        _ => ConfirmCheck::Invalid,
+    }
+}
+
+/// `POST /v1/host/device/confirm-key` (CONTRACT §5.3): a new confirm key, proven by
+/// the QR's `rekeySecret` and bound to this session.
+async fn rekey(core: &BridgeCore, ctx: &InnerContext, req: &InnerRequest) -> InnerResponse {
+    const MAX_ATTEMPTS: u8 = 5;
+    let body = req.body.clone().unwrap_or(Value::Null);
+    let mode = match body.get("confirmMode").and_then(Value::as_str) {
+        Some(m @ ("biometric" | "device_passcode" | "none")) => m.to_owned(),
+        _ => {
+            return InnerResponse::error(
+                400,
+                "invalid_request",
+                "confirmMode must be biometric, device_passcode or none",
+            );
+        }
+    };
+    let Some(proof) = body
+        .get("proof")
+        .and_then(Value::as_str)
+        .and_then(|p| crypto::from_b64u(p).ok())
+    else {
+        return InnerResponse::error(400, "invalid_request", "proof is required");
+    };
+    {
+        let mut offers = core.rekey_offers.lock().unwrap();
+        let Some(offer) = offers
+            .get_mut(&ctx.device_id)
+            .filter(|o| o.state == crate::core::RekeyState::Pending)
+        else {
+            return InnerResponse::error(404, "no_rekey_offer", "No re-key offer is open for this phone");
+        };
+        if now() >= offer.expires_at {
+            return InnerResponse::error(404, "no_rekey_offer", "The re-key offer expired");
+        }
+        offer.attempts += 1;
+        let expected = crypto::hmac_sha256(&offer.secret, &crypto::rekey_mac_input(&ctx.sid, &ctx.device_id));
+        if !crypto::mac_eq(&proof, &expected) {
+            if offer.attempts >= MAX_ATTEMPTS {
+                offer.state = crate::core::RekeyState::Failed;
+            }
+            return InnerResponse::error(403, "rekey_invalid", "The re-key proof did not verify");
+        }
+        offer.state = crate::core::RekeyState::Completed;
+    }
+    let key = if mode == "none" {
+        None
+    } else {
+        match random_bytes::<32>() {
+            Ok(k) => Some(k),
+            Err(_) => return InnerResponse::error(503, "backend_unavailable", "No randomness"),
+        }
+    };
+    let sealed = match key {
+        Some(k) => match crate::service::seal_confirm_key(core.host_key.data_key(), &k) {
+            Ok(s) => Some(s),
+            Err(_) => return InnerResponse::error(503, "backend_unavailable", "Could not seal the key"),
+        },
+        None => None,
+    };
+    if let Err(e) = core
+        .store
+        .set_confirm_key(&ctx.device_id, &mode, sealed.as_deref())
+        .await
+    {
+        tracing::error!(error = %e, "mobile bridge: could not store a new confirm key");
+        return InnerResponse::error(503, "backend_unavailable", "Could not store the key");
+    }
+    core.events.emit(
+        &ctx.user_id,
+        "mobile.deviceChanged",
+        json!({ "deviceId": ctx.device_id, "change": "rekeyed" }),
+    );
+    tracing::info!(device_id = %ctx.device_id, confirm_mode = %mode, "mobile bridge: confirm key re-issued");
+    InnerResponse::ok(json!({ "confirmKey": key.map(|k| crypto::b64u(&k)) }))
+}
+
+/// Routes the bridge serves itself: `/v1/host` (§6.1).
+async fn builtin(core: &BridgeCore, ctx: &InnerContext, req: &InnerRequest) -> Option<InnerResponse> {
+    let path = req.path.split('?').next().unwrap_or("");
+    match (req.method.as_str(), path) {
+        ("GET", "/v1/host") => {
+            let device = core.store.device(&ctx.device_id).await.ok().flatten()?;
+            let settings = core.store.load_settings(&ctx.user_id).await.ok().flatten();
+            let mut capabilities = vec!["changes.longpoll", "approvals.questions"];
+            if settings.as_ref().is_none_or(|s| s.tasks_write) {
+                capabilities.push("tasks.write");
+            }
+            Some(InnerResponse::ok(json!({
+                "hostId": core.host_key.host_id,
+                "hostName": core.host_name(),
+                "appVersion": core.app_version(),
+                "coreVersion": env!("CARGO_PKG_VERSION"),
+                "bridgeVersion": 1,
+                "serverTime": now(),
+                "device": {
+                    "deviceId": device.device_id,
+                    "name": device.name,
+                    "pairedAt": device.paired_at,
+                    "requireConfirm": device.require_confirm,
+                    "confirmMode": device.confirm_mode,
+                },
+                "capabilities": capabilities,
+            })))
+        }
+        ("POST", "/v1/host/device/confirm-key") => Some(rekey(core, ctx, req).await),
+        ("DELETE", "/v1/host/device") => {
+            let ok = core
+                .store
+                .revoke_device(&ctx.user_id, &ctx.device_id)
+                .await
+                .unwrap_or(false);
+            if ok {
+                core.sessions.drop_device(&ctx.device_id);
+                core.events.emit(
+                    &ctx.user_id,
+                    "mobile.deviceChanged",
+                    json!({ "deviceId": ctx.device_id, "change": "revoked" }),
+                );
+                tracing::info!(device_id = %ctx.device_id, "mobile bridge: phone unpaired itself");
+                Some(InnerResponse::ok(Value::Object(Default::default())))
+            } else {
+                Some(InnerResponse::error(404, "not_found", "Device not found"))
+            }
+        }
+        _ => None,
+    }
+}
diff --git a/crates/aionui-mobile/src/pairing.rs b/crates/aionui-mobile/src/pairing.rs
new file mode 100644
index 00000000..ad6bd0ef
--- /dev/null
+++ b/crates/aionui-mobile/src/pairing.rs
@@ -0,0 +1,403 @@
+//! Pairing offers (CONTRACT §3.4, §4.2, A2). One offer is active at a time;
+//! the first valid request locks it to that phone; a valid request from a
+//! second phone aborts it. All of it lives in memory: an offer never outlives
+//! its five minutes or a restart.
+
+use std::sync::Mutex;
+
+use serde::Serialize;
+use tokio::sync::watch;
+
+use crate::crypto::{self, CryptoError};
+use crate::host_key::{HostKey, random_bytes};
+use crate::wire::{PROTOCOL_VERSION, PairRequestBody, PairRequestPayload, is_fresh};
+
+pub const OFFER_TTL_MS: i64 = 5 * 60 * 1000;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum OfferState {
+    Waiting,
+    RequestReceived,
+    Approved,
+    Rejected,
+    Aborted,
+    Expired,
+}
+
+impl OfferState {
+    /// The `status` a phone sees in a pair response.
+    pub fn wire_status(self) -> &'static str {
+        match self {
+            OfferState::Waiting | OfferState::RequestReceived => "pending",
+            OfferState::Approved => "approved",
+            OfferState::Rejected => "rejected",
+            OfferState::Aborted | OfferState::Expired => "aborted",
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+struct Bound {
+    device_id: String,
+    device_pk: [u8; 32],
+    sas: String,
+    device_name: String,
+    platform: String,
+    app_version: String,
+    confirm_mode: String,
+}
+
+struct Offer {
+    offer_id: String,
+    user_id: String,
+    secret: [u8; 32],
+    expires_at: i64,
+    state: OfferState,
+    bound: Option<Bound>,
+    confirm_key: Option<[u8; 32]>,
+}
+
+impl Offer {
+    fn refresh(&mut self, now: i64) {
+        if now >= self.expires_at && matches!(self.state, OfferState::Waiting | OfferState::RequestReceived) {
+            self.state = OfferState::Expired;
+        }
+    }
+}
+
+/// A freshly created offer, for the desktop to draw as a QR code.
+pub struct NewOffer {
+    pub offer_id: String,
+    pub secret: [u8; 32],
+    pub expires_at: i64,
+}
+
+#[derive(Debug, Clone, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct OfferRequestView {
+    pub device_name: String,
+    pub platform: String,
+    pub app_version: String,
+    pub sas: String,
+    pub confirm_mode: String,
+}
+
+#[derive(Debug, Clone, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct OfferView {
+    pub state: OfferState,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub request: Option<OfferRequestView>,
+}
+
+/// What the desktop's approval produces: the device to store.
+pub struct ApprovedDevice {
+    pub user_id: String,
+    pub device_id: String,
+    pub device_pk: [u8; 32],
+    pub device_name: String,
+    pub platform: String,
+    pub app_version: String,
+    pub confirm_mode: String,
+    pub confirm_key: Option<[u8; 32]>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum PairError {
+    UnsupportedVersion,
+    Malformed,
+    UnknownHost,
+    Expired,
+    Locked,
+    AuthFailed,
+    ClockSkew,
+}
+
+/// A pair request that passed every check.
+pub struct PairAccepted {
+    /// True for the request that bound the offer (the desktop shows the SAS).
+    pub first: bool,
+    pub pairing_key: [u8; 32],
+    pub device_id: String,
+    pub req_ts: i64,
+    pub wait: bool,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum AdminError {
+    NotFound,
+    NotReady,
+}
+
+pub struct PairingManager {
+    offer: Mutex<Option<Offer>>,
+    changed: watch::Sender<u64>,
+}
+
+impl Default for PairingManager {
+    fn default() -> Self {
+        Self {
+            offer: Mutex::new(None),
+            changed: watch::channel(0).0,
+        }
+    }
+}
+
+impl PairingManager {
+    fn bump(&self) {
+        self.changed.send_modify(|n| *n += 1);
+    }
+
+    /// Wakes when any offer changes state; used for the pair long-poll.
+    pub fn subscribe(&self) -> watch::Receiver<u64> {
+        self.changed.subscribe()
+    }
+
+    /// Creates the active offer, replacing any earlier one.
+    pub fn create_offer(&self, user_id: &str, now: i64) -> Result<NewOffer, CryptoError> {
+        let offer_id = crypto::b64u(&random_bytes::<12>().map_err(|_| CryptoError)?);
+        let secret = random_bytes::<32>().map_err(|_| CryptoError)?;
+        let expires_at = now + OFFER_TTL_MS;
+        let mut slot = self.offer.lock().unwrap();
+        if let Some(old) = slot.as_mut()
+            && matches!(old.state, OfferState::Waiting | OfferState::RequestReceived)
+        {
+            old.state = OfferState::Expired;
+        }
+        *slot = Some(Offer {
+            offer_id: offer_id.clone(),
+            user_id: user_id.to_owned(),
+            secret,
+            expires_at,
+            state: OfferState::Waiting,
+            bound: None,
+            confirm_key: None,
+        });
+        drop(slot);
+        self.bump();
+        Ok(NewOffer {
+            offer_id,
+            secret,
+            expires_at,
+        })
+    }
+
+    pub fn view(&self, offer_id: &str, user_id: &str, now: i64) -> Option<OfferView> {
+        let mut slot = self.offer.lock().unwrap();
+        let offer = slot
+            .as_mut()
+            .filter(|o| o.offer_id == offer_id && o.user_id == user_id)?;
+        offer.refresh(now);
+        let request = offer.bound.as_ref().map(|b| OfferRequestView {
+            device_name: b.device_name.clone(),
+            platform: b.platform.clone(),
+            app_version: b.app_version.clone(),
+            sas: b.sas.clone(),
+            confirm_mode: b.confirm_mode.clone(),
+        });
+        Some(OfferView {
+            state: offer.state,
+            request,
+        })
+    }
+
+    /// Checks and records a phone's pair request.
+    pub fn handle_request(&self, host: &HostKey, body: &PairRequestBody, now: i64) -> Result<PairAccepted, PairError> {
+        if body.v != PROTOCOL_VERSION {
+            return Err(PairError::UnsupportedVersion);
+        }
+        if body.host_id != host.host_id {
+            return Err(PairError::UnknownHost);
+        }
+        let device_pk = crypto::key_from_b64u(&body.device_pk).map_err(|_| PairError::Malformed)?;
+        let nonce = crypto::from_b64u(&body.nonce).map_err(|_| PairError::Malformed)?;
+        let ct = crypto::from_b64u(&body.ct).map_err(|_| PairError::Malformed)?;
+        if body.device_id.is_empty() || body.device_id.len() > 64 {
+            return Err(PairError::Malformed);
+        }
+
+        let mut slot = self.offer.lock().unwrap();
+        let offer = slot.as_mut().ok_or(PairError::Expired)?;
+        offer.refresh(now);
+        if matches!(offer.state, OfferState::Expired) {
+            return Err(PairError::Expired);
+        }
+
+        let dh = host.diffie_hellman(&x25519_dalek::PublicKey::from(device_pk));
+        let pairing_key = crypto::pairing_key(&dh, &offer.secret, host.public.as_bytes(), &device_pk);
+        let aad = crypto::pair_req_aad(&host.host_id, &body.device_id);
+        let plain = crypto::open(&pairing_key, &nonce, &ct, &aad).map_err(|_| PairError::AuthFailed)?;
+        let payload: PairRequestPayload = serde_json::from_slice(&plain).map_err(|_| PairError::Malformed)?;
+        if !is_fresh(payload.ts, now) {
+            return Err(PairError::ClockSkew);
+        }
+
+        let mut first = false;
+        match &offer.bound {
+            None => {
+                first = true;
+                if !matches!(offer.state, OfferState::Waiting) {
+                    return Err(PairError::Expired);
+                }
+                offer.bound = Some(Bound {
+                    device_id: body.device_id.clone(),
+                    device_pk,
+                    sas: crypto::short_auth_string(&pairing_key),
+                    device_name: clip(&payload.device_name, 64),
+                    platform: clip(&payload.platform, 32),
+                    app_version: clip(&payload.app_version, 32),
+                    confirm_mode: normalize_confirm_mode(&payload.confirm_mode).to_owned(),
+                });
+                offer.state = OfferState::RequestReceived;
+                drop(slot);
+                self.bump();
+            }
+            Some(bound) if bound.device_pk == device_pk && bound.device_id == body.device_id => {}
+            Some(_) => {
+                // A second phone holds the same QR: someone photographed or relayed it (A2).
+                if matches!(offer.state, OfferState::RequestReceived | OfferState::Waiting) {
+                    offer.state = OfferState::Aborted;
+                    drop(slot);
+                    self.bump();
+                    tracing::warn!("mobile bridge: pairing aborted, the code was used by a second device");
+                }
+                return Err(PairError::Locked);
+            }
+        }
+        Ok(PairAccepted {
+            first,
+            pairing_key,
+            device_id: body.device_id.clone(),
+            req_ts: payload.ts,
+            wait: payload.wait,
+        })
+    }
+
+    /// The current wire status for the bound phone, plus its confirm key once approved.
+    pub fn status_for(&self, device_id: &str, now: i64) -> (&'static str, Option<[u8; 32]>) {
+        let mut slot = self.offer.lock().unwrap();
+        match slot.as_mut() {
+            Some(offer) if offer.bound.as_ref().is_some_and(|b| b.device_id == device_id) => {
+                offer.refresh(now);
+                let key = if offer.state == OfferState::Approved {
+                    offer.confirm_key
+                } else {
+                    None
+                };
+                (offer.state.wire_status(), key)
+            }
+            _ => ("aborted", None),
+        }
+    }
+
+    /// The desktop approves after the user compared the codes.
+    pub fn approve(&self, offer_id: &str, user_id: &str, now: i64) -> Result<ApprovedDevice, AdminError> {
+        let mut slot = self.offer.lock().unwrap();
+        let offer = slot
+            .as_mut()
+            .filter(|o| o.offer_id == offer_id && o.user_id == user_id)
+            .ok_or(AdminError::NotFound)?;
+        offer.refresh(now);
+        if offer.state != OfferState::RequestReceived {
+            return Err(AdminError::NotReady);
+        }
+        let bound = offer.bound.clone().ok_or(AdminError::NotReady)?;
+        let confirm_key = if bound.confirm_mode == "none" {
+            None
+        } else {
+            Some(random_bytes::<32>().map_err(|_| AdminError::NotReady)?)
+        };
+        offer.state = OfferState::Approved;
+        offer.confirm_key = confirm_key;
+        drop(slot);
+        self.bump();
+        Ok(ApprovedDevice {
+            user_id: user_id.to_owned(),
+            device_id: bound.device_id,
+            device_pk: bound.device_pk,
+            device_name: bound.device_name,
+            platform: bound.platform,
+            app_version: bound.app_version,
+            confirm_mode: bound.confirm_mode,
+            confirm_key,
+        })
+    }
+
+    pub fn reject(&self, offer_id: &str, user_id: &str, now: i64) -> Result<(), AdminError> {
+        let mut slot = self.offer.lock().unwrap();
+        let offer = slot
+            .as_mut()
+            .filter(|o| o.offer_id == offer_id && o.user_id == user_id)
+            .ok_or(AdminError::NotFound)?;
+        offer.refresh(now);
+        if !matches!(offer.state, OfferState::Waiting | OfferState::RequestReceived) {
+            return Err(AdminError::NotReady);
+        }
+        offer.state = OfferState::Rejected;
+        drop(slot);
+        self.bump();
+        Ok(())
+    }
+
+    /// The SAS of the bound request, for the desktop's WebSocket notice.
+    pub fn pending_request(&self) -> Option<(String, String, OfferRequestView)> {
+        let slot = self.offer.lock().unwrap();
+        let offer = slot.as_ref()?;
+        let b = offer.bound.as_ref()?;
+        Some((
+            offer.user_id.clone(),
+            offer.offer_id.clone(),
+            OfferRequestView {
+                device_name: b.device_name.clone(),
+                platform: b.platform.clone(),
+                app_version: b.app_version.clone(),
+                sas: b.sas.clone(),
+                confirm_mode: b.confirm_mode.clone(),
+            },
+        ))
+    }
+}
+
+fn clip(s: &str, max: usize) -> String {
+    s.trim().chars().take(max).collect()
+}
+
+fn normalize_confirm_mode(mode: &str) -> &'static str {
+    match mode {
+        "biometric" => "biometric",
+        "device_passcode" => "device_passcode",
+        _ => "none",
+    }
+}
+
+/// `aiondx://pair?...` for the QR code (CONTRACT §4.2), in the parameter order
+/// of the phone's `encodePairingUri`.
+pub fn pairing_uri(host: &HostKey, host_name: &str, offer: &NewOffer, urls: &[String]) -> String {
+    let mut q = vec![
+        ("v", "1".to_owned()),
+        ("id", host.host_id.clone()),
+        ("n", host_name.to_owned()),
+        ("pk", crypto::b64u(host.public.as_bytes())),
+        ("s", crypto::b64u(&offer.secret)),
+        ("x", offer.expires_at.to_string()),
+    ];
+    for u in urls {
+        q.push(("u", u.clone()));
+    }
+    let query: Vec<String> = q.into_iter().map(|(k, v)| format!("{k}={}", form_encode(&v))).collect();
+    format!("aiondx://pair?{}", query.join("&"))
+}
+
+/// `application/x-www-form-urlencoded`, as `URLSearchParams` writes it.
+fn form_encode(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    for b in s.bytes() {
+        match b {
+            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'*' | b'-' | b'.' | b'_' => out.push(b as char),
+            b' ' => out.push('+'),
+            _ => out.push_str(&format!("%{b:02X}")),
+        }
+    }
+    out
+}
diff --git a/crates/aionui-mobile/src/peer_filter.rs b/crates/aionui-mobile/src/peer_filter.rs
new file mode 100644
index 00000000..99db5c75
--- /dev/null
+++ b/crates/aionui-mobile/src/peer_filter.rs
@@ -0,0 +1,77 @@
+//! Which peers may reach the LAN listener (CONTRACT §2): private and
+//! link-local ranges, CGNAT (Tailscale) and loopback. Everything else is
+//! refused before any protocol handling.
+
+use std::net::{IpAddr, Ipv4Addr, Ipv6Addr};
+
+pub fn is_private_peer(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(v4) => is_private_v4(v4),
+        IpAddr::V6(v6) => match v6.to_ipv4_mapped() {
+            Some(v4) => is_private_v4(v4),
+            None => is_private_v6(v6),
+        },
+    }
+}
+
+fn is_private_v4(ip: Ipv4Addr) -> bool {
+    let [a, b, ..] = ip.octets();
+    ip.is_loopback()
+        || ip.is_private() // 10/8, 172.16/12, 192.168/16
+        || ip.is_link_local() // 169.254/16
+        || (a == 100 && (64..=127).contains(&b)) // 100.64/10, CGNAT (Tailscale)
+}
+
+fn is_private_v6(ip: Ipv6Addr) -> bool {
+    let first = ip.segments()[0];
+    ip.is_loopback()
+        || (first & 0xfe00) == 0xfc00 // fc00::/7, unique local
+        || (first & 0xffc0) == 0xfe80 // fe80::/10, link-local
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn ip(s: &str) -> IpAddr {
+        s.parse().unwrap()
+    }
+
+    #[test]
+    fn private_ranges_are_accepted() {
+        for a in [
+            "127.0.0.1",
+            "10.0.0.5",
+            "172.16.0.1",
+            "172.31.255.255",
+            "192.168.1.20",
+            "169.254.3.4",
+            "100.64.0.1",
+            "100.127.255.254",
+            "::1",
+            "fd12:3456::1",
+            "fe80::1",
+            "::ffff:192.168.1.2",
+        ] {
+            assert!(is_private_peer(ip(a)), "{a}");
+        }
+    }
+
+    #[test]
+    fn public_and_edge_ranges_are_refused() {
+        for a in [
+            "8.8.8.8",
+            "172.32.0.1",
+            "172.15.255.255",
+            "100.63.255.255",
+            "100.128.0.1",
+            "192.169.0.1",
+            "1.1.1.1",
+            "2001:4860::8888",
+            "::ffff:8.8.8.8",
+            "0.0.0.0",
+        ] {
+            assert!(!is_private_peer(ip(a)), "{a}");
+        }
+    }
+}
diff --git a/crates/aionui-mobile/src/read_state.rs b/crates/aionui-mobile/src/read_state.rs
new file mode 100644
index 00000000..72e5cfa8
--- /dev/null
+++ b/crates/aionui-mobile/src/read_state.rs
@@ -0,0 +1,236 @@
+//! Phase 4: `unread`, `your_turn` and `needs_answer` (CONTRACT §6.3 attention table, `unread`).
+//!
+//! AionCore has no unread tracking. The phone's read marker is a client preference, `aiondx.read.<cid>` =
+//! `{messageId, at}` (§6.4); the counts come from the conversation's newest messages.
+
+use std::collections::HashMap;
+
+use aionui_api_types::ListMessagesQuery;
+use serde_json::Value;
+
+use crate::approvals::ApprovalKind;
+use crate::facade::{Facade, to_value};
+use crate::shape;
+
+/// How far back the counts look. `unread` is capped at 99 anyway.
+const READ_WINDOW: u32 = 100;
+const UNREAD_CAP: u32 = 99;
+/// How far back an owner's chat is searched for a task's assignment notice.
+const ASSIGNMENT_WINDOW: u32 = 200;
+
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct ReadState {
+    pub unread: u32,
+    /// The newest agent message is newer than both the user's last message and the read marker. The caller adds the
+    /// rest of the rule (solo or lead only, turn completed and idle).
+    pub agent_spoke_last: bool,
+}
+
+/// `shaped` are §6.4 `Message`s in any order. `marker` is the stored `{messageId, at}`.
+///
+/// The marker's position is its message's `createdAt` when that message is in view, else the time it was set. With no
+/// marker at all, unread counts from the user's own last message, so a freshly paired phone doesn't open on 99s.
+pub(crate) fn read_state(shaped: &[Value], marker: Option<&Value>) -> ReadState {
+    let at = |m: &Value| m["createdAt"].as_i64().unwrap_or(0);
+    let marker_at = marker.map(|mk| {
+        let id = mk["messageId"].as_str().unwrap_or_default();
+        shaped
+            .iter()
+            .find(|m| !id.is_empty() && m["messageId"] == id)
+            .map(at)
+            .unwrap_or_else(|| mk["at"].as_i64().unwrap_or(0))
+    });
+    let last_user = shaped.iter().filter(|m| m["role"] == "user").map(at).max();
+    let floor = marker_at.or(last_user).unwrap_or(i64::MIN);
+    let unread = shaped
+        .iter()
+        .filter(|m| m["role"] == "agent" && m["type"] == "text" && m["status"] == "done" && at(m) > floor)
+        .count() as u32;
+    let newest_agent = shaped.iter().filter(|m| m["role"] == "agent").map(at).max();
+    let agent_spoke_last =
+        newest_agent.is_some_and(|a| a > last_user.unwrap_or(i64::MIN) && a > marker_at.unwrap_or(i64::MIN));
+    ReadState {
+        unread: unread.min(UNREAD_CAP),
+        agent_spoke_last,
+    }
+}
+
+impl Facade {
+    /// The read state of one conversation. Errors count as nothing unread: a badge must never block a listing.
+    pub(crate) async fn read_state_of(
+        &self,
+        user: &str,
+        conversation_id: &str,
+        roster: &HashMap<String, (String, String)>,
+        agent_name: &str,
+    ) -> ReadState {
+        let query = ListMessagesQuery {
+            limit: Some(READ_WINDOW),
+            before: None,
+            after: None,
+            anchor_message_id: None,
+            content_mode: Some("compact".into()),
+        };
+        let Ok(page) = self.backend.messages(user, conversation_id, query).await else {
+            return ReadState::default();
+        };
+        let page = to_value(&page);
+        let shaped: Vec<Value> = page["items"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter_map(|m| shape::message(m, roster, agent_name))
+            .collect();
+        let marker = match self
+            .backend
+            .get_pref(user, &format!("aiondx.read.{conversation_id}"))
+            .await
+        {
+            Ok(Some(raw)) => serde_json::from_str::<Value>(&raw).ok(),
+            _ => None,
+        };
+        read_state(&shaped, marker.as_ref())
+    }
+
+    /// `Task.assignment` (§6.7) for the given tasks: the newest "📋 Task assigned to you (#id)" notice in each owner's
+    /// chat. Only owners' chats are read, one page each; a notice that has scrolled out of it counts as not found.
+    pub(crate) async fn assignments(&self, user: &str, team_id: &str, tasks: &[Value]) -> HashMap<String, Value> {
+        let mut out: HashMap<String, Value> = HashMap::new();
+        let Ok(team) = self.backend.team(user, team_id).await else {
+            return out;
+        };
+        let team = to_value(&team);
+        let roster = shape::roster_index(&team);
+        let mut owners: Vec<&str> = tasks.iter().filter_map(|t| t["owner"].as_str()).collect();
+        owners.sort_unstable();
+        owners.dedup();
+        for owner in owners {
+            let Some(member) = team["assistants"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .find(|a| a["slot_id"] == owner)
+            else {
+                continue;
+            };
+            let (Some(cid), name) = (
+                member["conversation_id"].as_str(),
+                member["name"].as_str().unwrap_or_default(),
+            ) else {
+                continue;
+            };
+            let query = ListMessagesQuery {
+                limit: Some(ASSIGNMENT_WINDOW),
+                before: None,
+                after: None,
+                anchor_message_id: None,
+                content_mode: Some("compact".into()),
+            };
+            let Ok(page) = self.backend.messages(user, cid, query).await else {
+                continue;
+            };
+            for m in to_value(&page)["items"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(|m| shape::message(m, &roster, name))
+            {
+                let Some(task_id) = m["notice"]["taskId"].as_str() else {
+                    continue;
+                };
+                let at = m["createdAt"].as_i64().unwrap_or(0);
+                let newer = out
+                    .get(task_id)
+                    .is_none_or(|prev| prev["createdAt"].as_i64().unwrap_or(0) <= at);
+                if newer {
+                    out.insert(
+                        task_id.to_owned(),
+                        serde_json::json!({ "conversationId": cid, "messageId": m["messageId"], "createdAt": at }),
+                    );
+                }
+            }
+        }
+        out
+    }
+
+    /// A pending approval of this conversation is a question (`needs_answer`).
+    pub(crate) fn question_pending(&self, user: &str, conversation_id: &str) -> bool {
+        self.live
+            .approvals
+            .list(user, None)
+            .iter()
+            .any(|a| a.conversation_id == conversation_id && a.kind == ApprovalKind::Question)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use serde_json::json;
+
+    use super::*;
+
+    fn m(id: &str, role: &str, kind: &str, at: i64) -> Value {
+        json!({ "messageId": id, "role": role, "type": kind, "status": "done", "createdAt": at })
+    }
+
+    #[test]
+    fn unread_counts_agent_text_after_the_marker() {
+        let rows = vec![
+            m("u1", "user", "text", 10),
+            m("a1", "agent", "text", 20),
+            m("a2", "agent", "tool_call", 30),
+            m("t1", "teammate", "text", 35),
+            m("a3", "agent", "text", 40),
+        ];
+        // Marker on a1, which is in view: only a3 is unread.
+        let rs = read_state(&rows, Some(&json!({ "messageId": "a1", "at": 999 })));
+        assert_eq!(
+            rs,
+            ReadState {
+                unread: 1,
+                agent_spoke_last: true
+            }
+        );
+        // Marker on a message out of view: the time it was set.
+        let rs = read_state(&rows, Some(&json!({ "messageId": "gone", "at": 25 })));
+        assert_eq!(rs.unread, 1);
+        // No marker: from the user's last message.
+        assert_eq!(read_state(&rows, None).unread, 2);
+        // Read up to the newest agent message: nothing unread, and not "your turn" any more.
+        let rs = read_state(&rows, Some(&json!({ "messageId": "a3", "at": 41 })));
+        assert_eq!(
+            rs,
+            ReadState {
+                unread: 0,
+                agent_spoke_last: false
+            }
+        );
+    }
+
+    #[test]
+    fn the_user_speaking_last_is_not_your_turn_and_streaming_rows_dont_count() {
+        let mut streaming = m("a2", "agent", "text", 30);
+        streaming["status"] = json!("streaming");
+        let rows = vec![
+            m("a1", "agent", "text", 20),
+            streaming.clone(),
+            m("u1", "user", "text", 40),
+        ];
+        assert_eq!(
+            read_state(&rows, None),
+            ReadState {
+                unread: 0,
+                agent_spoke_last: false
+            }
+        );
+        let rows = vec![m("u1", "user", "text", 10), m("a1", "agent", "text", 20), streaming];
+        assert_eq!(read_state(&rows, None).unread, 1);
+        assert_eq!(read_state(&[], None), ReadState::default());
+    }
+
+    #[test]
+    fn unread_is_capped() {
+        let rows: Vec<Value> = (0..120).map(|i| m(&format!("a{i}"), "agent", "text", i)).collect();
+        assert_eq!(read_state(&rows, None).unread, 99);
+    }
+}
