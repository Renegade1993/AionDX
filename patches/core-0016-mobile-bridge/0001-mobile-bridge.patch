index 00000000..9e6b2837
--- /dev/null
+++ b/crates/aionui-mobile/tests/facade_routes.rs
@@ -0,0 +1,1455 @@
+//! The phase 2 read routes through the real facade, over a fake AionCore
+//! whose fixtures are AionCore's own JSON forms.
+
+use std::sync::{Arc, Mutex};
+
+use aionui_api_types::*;
+use aionui_mobile::core::{ConfirmCheck, InnerApi, InnerContext};
+use aionui_mobile::{
+    ActivityQuery, ApprovalSource, BackendError, BackendKind, ConfirmCall, Facade, InnerRequest, MobileBackend,
+    QuestionAnswer, SendOutcome, SoloSpec, TaskCreate, TaskPatch,
+};
+use async_trait::async_trait;
+use serde_json::{Value, json};
+
+fn from<T: serde::de::DeserializeOwned>(v: Value) -> T {
+    serde_json::from_value(v).unwrap()
+}
+
+#[derive(Default)]
+struct Fake {
+    seen_message_queries: Mutex<Vec<(Option<String>, Option<String>)>>,
+    calls: Mutex<Vec<String>>,
+    /// AionCore's pending confirmations (any conversation), for the approvals reconcile.
+    pending: Mutex<Vec<Value>>,
+    /// The backend kind of the live agents (Acp when unset).
+    kind: Mutex<Option<BackendKind>>,
+    prefs: Mutex<std::collections::HashMap<String, String>>,
+}
+
+impl Fake {
+    fn log(&self, call: String) {
+        self.calls.lock().unwrap().push(call);
+    }
+    fn calls(&self) -> Vec<String> {
+        self.calls.lock().unwrap().clone()
+    }
+}
+
+fn team_json() -> Value {
+    json!({
+        "id": "t1", "name": "Dev", "workspace": "C:/w", "leader_assistant_id": "lead", "created_at": 1, "updated_at": 5,
+        "assistants": [
+            { "slot_id": "lead", "assistant_name": "Ann", "name": "Ann", "role": "lead", "conversation_id": "c1",
+              "assistant_backend": "claude", "backend": "claude", "model": "m", "pending_confirmations": 0,
+              "context_reset": { "supported": true, "availability": "ready" } },
+            { "slot_id": "s2", "assistant_name": "Bob", "name": "Bob", "role": "teammate", "conversation_id": "c2",
+              "assistant_backend": "claude", "backend": "claude", "model": "m", "pending_confirmations": 2,
+              "context_reset": { "supported": true, "availability": "ready" } }
+        ]
+    })
+}
+
+fn conv(id: &str, team: Option<&str>, modified: i64) -> Value {
+    let mut extra = json!({ "backend": "claude", "workspace": format!("C:/ws/{id}") });
+    if let Some(t) = team {
+        extra["teamId"] = json!(t);
+        extra["slot_id"] = json!(if id == "c2" { "s2" } else { "lead" });
+    }
+    json!({ "id": id, "name": format!("Chat {id}"), "type": "acp", "status": "finished", "pinned": false,
+            "created_at": 1, "modified_at": modified, "extra": extra })
+}
+
+fn msg(id: &str, conv: &str, at: i64, status: &str, text: &str) -> Value {
+    json!({ "id": id, "conversation_id": conv, "msg_id": id, "type": "text", "content": { "content": text },
+            "position": "left", "status": status, "hidden": false, "created_at": at })
+}
+
+#[async_trait]
+impl MobileBackend for Fake {
+    async fn teams(&self, _u: &str) -> Result<Vec<TeamResponse>, BackendError> {
+        Ok(vec![from(team_json())])
+    }
+    async fn team(&self, _u: &str, t: &str) -> Result<TeamResponse, BackendError> {
+        if t == "t1" {
+            Ok(from(team_json()))
+        } else {
+            Err(BackendError::NotFound("team".into()))
+        }
+    }
+    async fn run_state(&self, _u: &str, _t: &str) -> Result<TeamRunStateResponse, BackendError> {
+        Ok(from(
+            json!({ "session_generation": "g", "active_run": null, "slot_work": [
+            { "slot_id": "s2", "role": "teammate", "state": "running", "queued_foreground_count": 0, "queued_background_count": 0,
+              "active_turn_id": "turn_9", "active_turn_started_at_ms": 10, "active_turn_elapsed_ms": 5, "active_turn_slow": false,
+              "active_turn_slow_threshold_ms": 600000, "blocked_reason": null, "team_run_id": "r1" } ] }),
+        ))
+    }
+    async fn tasks(&self, _u: &str, _t: &str) -> Result<Vec<TeamTaskResponse>, BackendError> {
+        Ok(vec![
+            from(
+                json!({ "id": "k1", "team_id": "t1", "subject": "A", "description": null, "status": "pending", "owner": "s2", "blocked_by": [], "blocks": [], "created_at": 1, "updated_at": 2 }),
+            ),
+            from(
+                json!({ "id": "k2", "team_id": "t1", "subject": "B", "description": "d", "status": "completed", "owner": "user", "blocked_by": [], "blocks": [], "created_at": 1, "updated_at": 9 }),
+            ),
+        ])
+    }
+    async fn activity(&self, _u: &str, _t: &str, _q: ActivityQuery) -> Result<TeamActivityPageResponse, BackendError> {
+        Ok(from(json!({ "items": [], "has_more": false })))
+    }
+    async fn conversations(
+        &self,
+        _u: &str,
+        cursor: Option<String>,
+        _l: u32,
+    ) -> Result<ConversationListResponse, BackendError> {
+        Ok(match cursor.as_deref() {
+            None => {
+                from(json!({ "items": [conv("c1", Some("t1"), 9), conv("c9", None, 8)], "total": 3, "has_more": true }))
+            }
+            Some(_) => from(json!({ "items": [conv("c8", None, 7)], "total": 3, "has_more": false })),
+        })
+    }
+    async fn conversation(&self, _u: &str, id: &str) -> Result<ConversationResponse, BackendError> {
+        Ok(from(conv(id, (id == "c2").then_some("t1"), 8)))
+    }
+    async fn messages(&self, _u: &str, id: &str, q: ListMessagesQuery) -> Result<MessageListResponse, BackendError> {
+        self.seen_message_queries
+            .lock()
+            .unwrap()
+            .push((q.after.clone(), q.before.clone()));
+        let mut items = vec![
+            msg("m1", id, 1000, "finish", "hello"),
+            msg("m2", id, 2000, "work", "typing"),
+        ];
+        if id == "c8" {
+            // Two failed sends: a new turn that never started, and a mid-turn delivery.
+            for (fid, at) in [("f1", 2100), ("f2", 2200)] {
+                items.push(json!({ "id": fid, "conversation_id": id, "msg_id": null, "type": "tips", "position": "center",
+                    "status": "error", "hidden": false, "created_at": at,
+                    "content": { "content": "claude CLI not found", "code": "agent_start_failed", "source": "send_failed" } }));
+            }
+        }
+        if id == "c2" {
+            // The assignment notice, as the lead's mailbox message projected into Bob's chat.
+            let mut notice = msg("mn", id, 500, "finish", "📋 Task assigned to you (#k1): Ship it");
+            notice["content"]["teammate_message"] = json!(true);
+            notice["content"]["sender_name"] = json!("Ann");
+            notice["content"]["sender_conversation_id"] = json!("c1");
+            items.insert(0, notice);
+        }
+        Ok(from(json!({
+            "items": items,
+            "oldest_cursor": "v1.oldest", "newest_cursor": "v1.newest", "has_more_before": true, "has_more_after": false
+        })))
+    }
+    async fn latest_message(&self, _u: &str, id: &str) -> Result<Option<MessageResponse>, BackendError> {
+        Ok(Some(from(msg("mz", id, 3000, "finish", "last words"))))
+    }
+    async fn assistants(&self, _u: &str) -> Result<Vec<AssistantResponse>, BackendError> {
+        Ok(vec![from(json!({
+            "id": "a1", "source": "builtin", "name": "Helper", "enabled": true, "sort_order": 0, "agent_id": "claude",
+            "agent_status": "online", "team_selectable": true, "deletable": false
+        }))])
+    }
+
+    async fn create_solo(&self, _u: &str, spec: SoloSpec) -> Result<ConversationResponse, BackendError> {
+        self.log(format!(
+            "create_solo {:?} {:?} {:?}",
+            spec.assistant_id, spec.agent_backend, spec.workspace
+        ));
+        Ok(from(conv("c-new", None, 1)))
+    }
+    async fn send_solo(&self, _u: &str, c: &str, content: &str) -> Result<SendOutcome, BackendError> {
+        self.log(format!("send_solo {c} {content}"));
+        Ok(SendOutcome {
+            message_id: "m-solo".into(),
+            delivery: "started",
+        })
+    }
+    async fn send_to_agent(
+        &self,
+        _u: &str,
+        t: &str,
+        slot: &str,
+        content: &str,
+        now: bool,
+    ) -> Result<SendOutcome, BackendError> {
+        self.log(format!("send_to_agent {t} {slot} {content} now={now}"));
+        Ok(SendOutcome {
+            message_id: format!("m-{slot}"),
+            delivery: if now { "midturn" } else { "queued" },
+        })
+    }
+    async fn wake_agent(&self, _u: &str, t: &str, slot: &str) -> Result<(), BackendError> {
+        self.log(format!("wake {t} {slot}"));
+        Ok(())
+    }
+    async fn cancel_child_turn(&self, _u: &str, t: &str, run: &str, slot: &str) -> Result<(), BackendError> {
+        self.log(format!("cancel {t} {run} {slot}"));
+        Ok(())
+    }
+    async fn interrupt_agent(&self, _u: &str, t: &str, slot: &str, m: &str) -> Result<(), BackendError> {
+        self.log(format!("interrupt {t} {slot} {m}"));
+        Ok(())
+    }
