+/// Echoes how the bridge judged the request's confirm proof.
+struct ConfirmProbe;
+
+#[async_trait::async_trait]
+impl aionui_mobile::InnerApi for ConfirmProbe {
+    async fn handle(
+        &self,
+        ctx: &aionui_mobile::InnerContext,
+        req: &aionui_mobile::InnerRequest,
+    ) -> Option<aionui_mobile::InnerResponse> {
+        (req.path == "/v1/probe")
+            .then(|| aionui_mobile::InnerResponse::ok(json!({ "confirm": format!("{:?}", ctx.confirm) })))
+    }
+}
+
+fn proof(key: &[u8], sid: &[u8; 16], seq: u64, method: &str, path: &str, body: &Value, rid: &str) -> String {
+    let input = confirm_mac_input(sid, seq, method, path, &jcs(body).unwrap(), rid);
+    b64u(&hmac_sha256(key, &input))
+}
+
+#[tokio::test]
+async fn confirm_proofs_and_rekey_through_the_tunnel() {
+    let (bridge, router) = setup().await;
+    bridge.set_facade(std::sync::Arc::new(ConfirmProbe));
+    let phone = Phone::new("dev-1");
+    let (offer, confirm_key) = pair(&bridge, &router, &phone).await;
+    let hs = begin_handshake(&phone, &offer.host_id, &offer.host_pk, now());
+    let (_, resp) = post(&router, "/api/mobile/v1/session", &hs.body).await;
+    let (s, _) = finish_handshake(&phone, &offer.host_pk, &hs, &resp);
+
+    let mut seq = 0;
+    let probe = |confirm: Option<String>, seq: u64| {
+        let mut inner =
+            json!({ "method": "POST", "path": "/v1/probe", "body": { "b": 2, "a": 1 }, "rid": format!("r{seq}") });
+        if let Some(c) = confirm {
+            inner["confirm"] = json!(c);
+        }
+        envelope(&s, seq, &inner)
+    };
+    let body = json!({ "b": 2, "a": 1 });
+    let check = async |confirm: Option<String>, seq: u64| {
+        let (_, resp) = post(&router, "/api/mobile/v1/rpc", &probe(confirm, seq)).await;
+        open_rpc(&s, seq, &resp)["body"]["confirm"].as_str().unwrap().to_owned()
+    };
+
+    seq += 1;
+    assert_eq!(check(None, seq).await, "Missing");
+    seq += 1;
+    let good = proof(
+        &confirm_key,
+        &s.sid,
+        seq,
+        "POST",
+        "/v1/probe",
+        &body,
+        &format!("r{seq}"),
+    );
+    assert_eq!(
+        check(Some(good), seq).await,
+        "Verified",
+        "a proof built per §5.4 verifies"
+    );
+    seq += 1;
+    let wrong_seq = proof(
+        &confirm_key,
+        &s.sid,
+        seq + 100,
+        "POST",
+        "/v1/probe",
+        &body,
+        &format!("r{seq}"),
+    );
+    assert_eq!(
+        check(Some(wrong_seq), seq).await,
+        "Invalid",
+        "the proof is bound to seq"
+    );
+
+    // Re-key (§5.3): QR secret + this session → a new key; the old one stops working.
+    let offer_uri = bridge.create_rekey_offer("u1", "dev-1").await.unwrap().uri;
+    assert_eq!(bridge.rekey_offer_state("u1", "dev-1").await.unwrap().state, "pending");
+    assert!(
+        bridge.rekey_offer_state("u2", "dev-1").await.is_err(),
+        "another user's phone"
+    );
+    let secret = from_b64u(offer_uri.split("&s=").nth(1).unwrap().split('&').next().unwrap()).unwrap();
+    seq += 1;
+    let bad = json!({ "method": "POST", "path": "/v1/host/device/confirm-key", "rid": format!("r{seq}"),
+                      "body": { "proof": b64u(&[0u8; 32]), "confirmMode": "biometric" } });
+    let (_, resp) = post(&router, "/api/mobile/v1/rpc", &envelope(&s, seq, &bad)).await;
+    let inner = open_rpc(&s, seq, &resp);
+    assert_eq!(
+        (inner["status"].as_u64(), inner["body"]["error"]["code"].as_str()),
+        (Some(403), Some("rekey_invalid"))
+    );
+    seq += 1;
+    let rekey_proof = b64u(&hmac_sha256(&secret, &rekey_mac_input(&s.sid, "dev-1")));
+    let good = json!({ "method": "POST", "path": "/v1/host/device/confirm-key", "rid": format!("r{seq}"),
+                       "body": { "proof": rekey_proof, "confirmMode": "device_passcode" } });
+    let (_, resp) = post(&router, "/api/mobile/v1/rpc", &envelope(&s, seq, &good)).await;
+    let inner = open_rpc(&s, seq, &resp);
+    assert_eq!(inner["status"], 200);
+    let new_key = from_b64u(inner["body"]["confirmKey"].as_str().unwrap()).unwrap();
+    assert_ne!(new_key, confirm_key);
+    assert_eq!(bridge.devices("u1").await.unwrap()[0].confirm_mode, "device_passcode");
+    // The desktop's re-key dialog can see it finished, and the used offer can't be replayed.
+    assert_eq!(
+        bridge.rekey_offer_state("u1", "dev-1").await.unwrap().state,
+        "completed"
+    );
+    seq += 1;
+    let again = json!({ "method": "POST", "path": "/v1/host/device/confirm-key", "rid": format!("r{seq}"),
+                        "body": { "proof": rekey_proof, "confirmMode": "device_passcode" } });
+    let (_, resp) = post(&router, "/api/mobile/v1/rpc", &envelope(&s, seq, &again)).await;
+    let inner = open_rpc(&s, seq, &resp);
+    assert_eq!(inner["body"]["error"]["code"], "no_rekey_offer");
+
+    seq += 1;
+    let old = proof(
+        &confirm_key,
+        &s.sid,
+        seq,
+        "POST",
+        "/v1/probe",
+        &body,
+        &format!("r{seq}"),
+    );
+    assert_eq!(check(Some(old), seq).await, "Invalid", "the old key no longer verifies");
+    seq += 1;
+    let fresh = proof(&new_key, &s.sid, seq, "POST", "/v1/probe", &body, &format!("r{seq}"));
+    assert_eq!(check(Some(fresh), seq).await, "Verified");
+
+    // The PC relaxes the check for this phone.
+    bridge.update_device("u1", "dev-1", None, Some(false)).await.unwrap();
+    seq += 1;
+    assert_eq!(check(None, seq).await, "NotRequired");
+}
+
+/// CONTRACT §3.3: each mutating phone action is one audit line (time, device, action with its ids, outcome), and
+/// nothing of the request's content: no body, no proof, no key. A retried request id isn't logged twice, and reads
+/// aren't logged.
+#[tokio::test]
+async fn the_audit_log_records_actions_not_content() {
+    let (bridge, router) = setup().await;
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("logs").join("mobile-bridge.log");
+    bridge.set_audit_log(aionui_mobile::audit::AuditLog::at(path.clone()));
+    bridge.set_facade(std::sync::Arc::new(ConfirmProbe));
+    let phone = Phone::new("dev-1");
+    let (offer, _confirm_key) = pair(&bridge, &router, &phone).await;
+    let hs = begin_handshake(&phone, &offer.host_id, &offer.host_pk, now());
+    let (_, resp) = post(&router, "/api/mobile/v1/session", &hs.body).await;
+    let (s, _) = finish_handshake(&phone, &offer.host_pk, &hs, &resp);
+
+    let write = json!({ "method": "POST", "path": "/v1/probe", "rid": "r1",
+                        "body": { "content": "do-not-log-me" }, "confirm": "c2VjcmV0LXByb29m" });
+    let (_, resp) = post(&router, "/api/mobile/v1/rpc", &envelope(&s, 1, &write)).await;
+    assert_eq!(open_rpc(&s, 1, &resp)["status"], 200);
+    let (_, resp) = post(&router, "/api/mobile/v1/rpc", &envelope(&s, 2, &write)).await; // the same rid, retried
+    assert_eq!(open_rpc(&s, 2, &resp)["status"], 200);
+    let read = json!({ "method": "GET", "path": "/v1/host", "rid": "r3" });
+    post(&router, "/api/mobile/v1/rpc", &envelope(&s, 3, &read)).await;
+
+    let text = std::fs::read_to_string(&path).unwrap();
+    let lines: Vec<&str> = text.lines().collect();
+    assert_eq!(lines.len(), 2, "{text}");
+    assert!(
+        lines[0].ends_with("device=dev-1 action=pair_approved targets=- outcome=ok"),
+        "{text}"
+    );
+    assert!(
+        lines[1].ends_with("device=dev-1 action=POST_/v1/probe targets=- outcome=200"),
+        "{text}"
+    );
+    for secret in ["do-not-log-me", "c2VjcmV0LXByb29m", "content"] {
+        assert!(!text.contains(secret), "{secret} leaked: {text}");
+    }
+}
