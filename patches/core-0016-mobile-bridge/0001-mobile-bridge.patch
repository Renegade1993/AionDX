--- /dev/null
+++ b/crates/aionui-app/src/router/mobile_backend.rs
@@ -0,0 +1,534 @@
+#![allow(clippy::disallowed_types)] // maps domain errors through ApiError at this HTTP-facing boundary
+
+//! AionDX core-0016: the mobile facade's view of AionCore, over the team,
+//! conversation and assistant services. Every call acts as the paired user.
+
+use std::sync::Arc;
+
+use async_trait::async_trait;
+
+use aionui_api_types::{
+    AssistantResponse, ConversationListResponse, ConversationResponse, ListConversationsQuery, ListMessagesQuery,
+    MessageListResponse, MessageResponse, TeamActivityPageResponse, TeamAgentResponse, TeamResponse,
+    TeamRunStateResponse, TeamTaskResponse,
+};
+use aionui_common::ApiError;
+use aionui_conversation::ConversationService;
+use aionui_db::{ActivityCursor, PageDirection};
+use aionui_mobile::{
+    ActivityFilter, ActivityQuery, ApprovalSource, BackendError, BackendKind, ConfirmCall, MobileBackend,
+    QuestionAnswer, SendOutcome, SoloSpec, TaskCreate, TaskPatch,
+};
+use aionui_team::service::{ActivityKind, TeamSessionService};
+
+pub struct AppMobileBackend {
+    pub team: Arc<TeamSessionService>,
+    pub conversation: ConversationService,
+    pub assistant: Arc<aionui_assistant::AssistantService>,
+    pub task_manager: Arc<dyn aionui_ai_agent::IWorkerTaskManager>,
+    pub prefs: Arc<dyn aionui_db::IClientPreferenceRepository>,
+}
+
+fn from_json<T: serde::de::DeserializeOwned>(v: serde_json::Value) -> Result<T, BackendError> {
+    serde_json::from_value(v).map_err(|e| BackendError::Invalid(e.to_string()))
+}
+
+fn wire<T: serde::Serialize>(v: &T) -> String {
+    serde_json::to_value(v)
+        .ok()
+        .and_then(|v| v.as_str().map(str::to_owned))
+        .unwrap_or_default()
+}
+
+/// Feeds AionCore's event bus to the mobile facade: the change journal and the approvals tracker (CONTRACT §6.2,
+/// §6.5). Runs for the life of the process; a lag makes the facade re-sweep approvals.
+pub async fn pump_events(
+    mut rx: tokio::sync::broadcast::Receiver<aionui_api_types::WebSocketMessage<serde_json::Value>>,
+    facade: Arc<aionui_mobile::Facade>,
+) {
+    use tokio::sync::broadcast::error::RecvError;
+    let mut sweep = tokio::time::interval(std::time::Duration::from_secs(60));
+    sweep.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+    loop {
+        tokio::select! {
+            received = rx.recv() => match received {
+                Ok(event) => facade.on_event(&event.name, &event.data).await,
+                Err(RecvError::Lagged(missed)) => facade.on_lagged(missed).await,
+                Err(RecvError::Closed) => break,
+            },
+            _ = sweep.tick() => facade.expire_shutdowns(aionui_common::now_ms()),
+        }
+    }
+    tracing::info!("mobile bridge: event pump stopped (bus closed)");
+}
+
+fn map_err(e: impl Into<ApiError>) -> BackendError {
+    let e: ApiError = e.into();
+    match e.status_code().as_u16() {
+        404 => BackendError::NotFound(e.to_string()),
+        400 | 409 | 422 => BackendError::Invalid(e.to_string()),
+        _ => BackendError::Unavailable(e.to_string()),
+    }
+}
+
+#[async_trait]
+impl MobileBackend for AppMobileBackend {
+    async fn teams(&self, user_id: &str) -> Result<Vec<TeamResponse>, BackendError> {
+        self.team.list_teams(user_id).await.map_err(map_err)
+    }
+
+    async fn team(&self, user_id: &str, team_id: &str) -> Result<TeamResponse, BackendError> {
