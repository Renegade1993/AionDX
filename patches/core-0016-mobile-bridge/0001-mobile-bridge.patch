+        json!({ "assistantId": "a", "backend": "claude" }),
+    )
+    .await;
+    assert_eq!(status, 400, "exactly one of assistantId / backend");
+    let (status, r) = call(
+        &f,
+        ConfirmCheck::Missing,
+        "POST",
+        "/v1/conversations",
+        json!({ "backend": "claude", "workspace": "C:/Windows" }),
+    )
+    .await;
+    assert_eq!(status, 400, "an arbitrary PC path is refused: {r}");
+    let (status, r) = call(
+        &f,
+        ConfirmCheck::Missing,
+        "POST",
+        "/v1/conversations",
+        json!({ "assistantId": "a1", "workspace": "C:/ws/c9" }),
+    )
+    .await;
+    assert_eq!((status, r["kind"].as_str()), (200, Some("solo")));
+    assert!(fake.calls().iter().any(|c| c.starts_with("create_solo Some(\"a1\")")));
+}
