@@ -0,0 +1,435 @@
+#![allow(clippy::disallowed_types)] // ApiError at this HTTP boundary, as in AionCore's own routes modules
+
+//! Desktop-only admin routes on AionCore's own 127.0.0.1 server (CONTRACT §3.4).
+//!
+//! Mounted behind the normal auth middleware (and CSRF in aionpro mode). They
+//! also refuse the runtime-token channel: an agent subprocess authenticates as
+//! the full user, and must never be able to switch the bridge on or approve a
+//! phone.
+
+use std::sync::Arc;
+
+use axum::Router;
+use axum::extract::rejection::JsonRejection;
+use axum::extract::{Extension, Json, Path, State};
+use axum::routing::{get, post, put};
+use serde::Deserialize;
+
+use aionui_api_types::ApiResponse;
+use aionui_auth::{AuthChannel, CurrentUser};
+use aionui_common::ApiError;
+
+use crate::error::MobileError;
+use crate::pairing::OfferView;
+use crate::service::{AdminFailure, DeviceView, MobileBridge, MobileStatus, PairingOffer};
+use crate::service_net::{FirewallView, RekeyOfferView};
+use crate::settings::MobileSettingsPatch;
+
+#[derive(Clone)]
+pub struct MobileAdminState {
+    pub bridge: Arc<MobileBridge>,
+}
+
+pub fn mobile_admin_routes(state: MobileAdminState) -> Router {
+    Router::new()
+        .route("/api/mobile/admin/status", get(status))
+        .route("/api/mobile/admin/settings", put(update_settings))
+        .route("/api/mobile/admin/pairing-offers", post(create_offer))
+        .route("/api/mobile/admin/pairing-offers/{offer_id}", get(get_offer))
+        .route(
+            "/api/mobile/admin/pairing-offers/{offer_id}/approve",
+            post(approve_offer),
+        )
+        .route("/api/mobile/admin/pairing-offers/{offer_id}/reject", post(reject_offer))
+        .route("/api/mobile/admin/recovery/dismiss", post(dismiss_recovery))
+        .route(
+            "/api/mobile/admin/devices/{device_id}/rekey-offers",
+            post(create_rekey_offer),
+        )
+        .route("/api/mobile/admin/rekey-offers/{offer_id}", get(get_rekey_offer))
+        .route("/api/mobile/admin/firewall", get(firewall_status))
+        .route("/api/mobile/admin/devices", get(list_devices))
+        .route(
+            "/api/mobile/admin/devices/{device_id}",
+            axum::routing::patch(update_device).delete(revoke_device),
+        )
+        .with_state(state)
+}
+
+/// The user's own clients only: a session, or local mode.
+fn require_user_client(channel: Option<&AuthChannel>) -> Result<(), ApiError> {
+    match channel {
+        Some(AuthChannel::Session | AuthChannel::Local) => Ok(()),
+        _ => Err(ApiError::Forbidden(
+            "Mobile bridge settings are for the desktop app only".into(),
+        )),
+    }
+}
+
+fn to_api_error(err: MobileError) -> ApiError {
+    match err {
+        MobileError::InvalidSetting(msg) => ApiError::BadRequest(msg),
+        other => {
+            tracing::error!(error = %other, "mobile bridge admin request failed");
+            ApiError::Internal("Mobile bridge request failed".into())
+        }
+    }
+}
+
+fn admin_error(err: AdminFailure) -> ApiError {
+    match err {
+        AdminFailure::NotFound => ApiError::NotFound("No such pairing offer or device".into()),
+        AdminFailure::NotReady => ApiError::Conflict("The pairing offer is not waiting for this action".into()),
+        AdminFailure::Internal(e) => to_api_error(e),
+    }
+}
+
+fn parse<T>(body: Result<Json<T>, JsonRejection>) -> Result<T, ApiError> {
+    body.map(|Json(v)| v).map_err(|e| ApiError::BadRequest(e.body_text()))
+}
+
+async fn status(
+    State(state): State<MobileAdminState>,
+    Extension(user): Extension<CurrentUser>,
+    channel: Option<Extension<AuthChannel>>,
+) -> Result<Json<ApiResponse<MobileStatus>>, ApiError> {
+    require_user_client(channel.as_deref())?;
+    let status = state.bridge.status(&user.id).await.map_err(to_api_error)?;
+    Ok(Json(ApiResponse::ok(status)))
+}
+
+async fn update_settings(
+    State(state): State<MobileAdminState>,
+    Extension(user): Extension<CurrentUser>,
+    channel: Option<Extension<AuthChannel>>,
+    body: Result<Json<MobileSettingsPatch>, JsonRejection>,
+) -> Result<Json<ApiResponse<MobileStatus>>, ApiError> {
+    require_user_client(channel.as_deref())?;
+    let patch = parse(body)?;
+    let status = state
+        .bridge
+        .update_settings(&user.id, &patch)
+        .await
+        .map_err(to_api_error)?;
+    tracing::info!(user_id = %user.id, enabled = status.enabled, listening = status.listening, "mobile bridge settings changed");
+    Ok(Json(ApiResponse::ok(status)))
+}
+
+async fn create_offer(
+    State(state): State<MobileAdminState>,
+    Extension(user): Extension<CurrentUser>,
+    channel: Option<Extension<AuthChannel>>,
+) -> Result<Json<ApiResponse<PairingOffer>>, ApiError> {
+    require_user_client(channel.as_deref())?;
+    let offer = state.bridge.create_offer(&user.id).await.map_err(to_api_error)?;
+    Ok(Json(ApiResponse::ok(offer)))
+}
+
+async fn get_offer(
+    State(state): State<MobileAdminState>,
+    Extension(user): Extension<CurrentUser>,
+    channel: Option<Extension<AuthChannel>>,
+    Path(offer_id): Path<String>,
+) -> Result<Json<ApiResponse<OfferView>>, ApiError> {
+    require_user_client(channel.as_deref())?;
+    let view = state
+        .bridge
+        .offer(&user.id, &offer_id)
+        .ok_or_else(|| admin_error(AdminFailure::NotFound))?;
+    Ok(Json(ApiResponse::ok(view)))
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct ApproveBody {
+    sas_confirmed: bool,
+}
+
+async fn approve_offer(
+    State(state): State<MobileAdminState>,
+    Extension(user): Extension<CurrentUser>,
+    channel: Option<Extension<AuthChannel>>,
+    Path(offer_id): Path<String>,
+    body: Result<Json<ApproveBody>, JsonRejection>,
+) -> Result<Json<ApiResponse<serde_json::Value>>, ApiError> {
+    require_user_client(channel.as_deref())?;
+    if !parse(body)?.sas_confirmed {
+        return Err(ApiError::BadRequest(
+            "Approve only after the codes on the PC and the phone match".into(),
+        ));
+    }
+    let device_id = state.bridge.approve(&user.id, &offer_id).await.map_err(admin_error)?;
+    Ok(Json(ApiResponse::ok(serde_json::json!({ "deviceId": device_id }))))
+}
