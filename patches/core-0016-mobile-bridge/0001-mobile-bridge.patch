+            cursor,
+            limit: Some(limit),
+            source: None,
+            cron_job_id: None,
+            pinned: None,
+        };
+        self.conversation.list(user_id, query).await.map_err(map_err)
+    }
+
+    async fn conversation(&self, user_id: &str, conversation_id: &str) -> Result<ConversationResponse, BackendError> {
