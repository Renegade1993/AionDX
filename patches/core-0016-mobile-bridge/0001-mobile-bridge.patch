+fn ctx() -> InnerContext {
+    ctx_with(ConfirmCheck::Verified)
+}
+
+fn ctx_with(confirm: ConfirmCheck) -> InnerContext {
+    InnerContext {
+        user_id: "u1".into(),
+        device_id: "d1".into(),
+        sid: [0; 16],
+        seq: 1,
+        confirm,
+    }
+}
+
+async fn call(facade: &Facade, confirm: ConfirmCheck, method: &str, path: &str, body: Value) -> (u16, Value) {
+    let req = InnerRequest {
+        method: method.into(),
+        path: path.into(),
+        body: Some(body),
+        rid: "r".into(),
+        confirm: None,
+    };
+    let r = facade.handle(&ctx_with(confirm), &req).await.expect("a facade route");
+    (r.status, r.body.unwrap_or(Value::Null))
+}
+
+async fn get(facade: &Facade, path: &str) -> Option<(u16, Value)> {
+    let req = InnerRequest {
+        method: "GET".into(),
+        path: path.into(),
+        body: None,
+        rid: "r".into(),
+        confirm: None,
+    };
+    facade
+        .handle(&ctx(), &req)
+        .await
+        .map(|r| (r.status, r.body.unwrap_or(Value::Null)))
+}
