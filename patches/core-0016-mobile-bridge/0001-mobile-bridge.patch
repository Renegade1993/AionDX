index 00000000..17272b2c
--- /dev/null
+++ b/crates/aionui-mobile/src/store.rs
@@ -0,0 +1,488 @@
+//! The bridge's own SQLite database, `aiondx-bridge.db` next to the main database.
+//!
+//! Deliberately not a migration in `aionui-backend.db`: AionCore refuses to open
+//! a database that has a migration it does not know, so a shared migration would
+//! lock every core without the bridge out of the user's chats.
+
+use std::path::{Path, PathBuf};
+use std::str::FromStr;
+use std::time::Duration;
+
+use sqlx::SqlitePool;
+use sqlx::migrate::Migrator;
+use sqlx::sqlite::{SqliteConnectOptions, SqliteJournalMode, SqlitePoolOptions};
+
+use crate::error::MobileError;
+use crate::settings::MobileSettings;
+
+static MIGRATOR: Migrator = sqlx::migrate!("./migrations");
+
+#[derive(Clone, Debug)]
+pub struct MobileStore {
+    pool: SqlitePool,
+}
+
+impl MobileStore {
+    pub fn path_in(data_dir: &Path) -> PathBuf {
+        data_dir.join("aiondx-bridge.db")
+    }
+
+    pub async fn open(path: &Path) -> Result<Self, MobileError> {
+        let opts = SqliteConnectOptions::new()
+            .filename(path)
+            .create_if_missing(true)
+            .journal_mode(SqliteJournalMode::Wal)
+            .foreign_keys(true)
+            .busy_timeout(Duration::from_secs(5));
+        Self::connect(opts, 4).await
+    }
+
+    pub async fn open_memory() -> Result<Self, MobileError> {
+        let opts = SqliteConnectOptions::from_str("sqlite::memory:")?.foreign_keys(true);
+        // One connection: each in-memory connection would be a separate database.
+        Self::connect(opts, 1).await
+    }
+
+    async fn connect(opts: SqliteConnectOptions, max: u32) -> Result<Self, MobileError> {
+        let pool = SqlitePoolOptions::new().max_connections(max).connect_with(opts).await?;
+        MIGRATOR.run(&pool).await?;
+        Ok(Self { pool })
+    }
+
+    pub fn pool(&self) -> &SqlitePool {
+        &self.pool
+    }
+
+    pub async fn load_settings(&self, user_id: &str) -> Result<Option<MobileSettings>, MobileError> {
+        let row: Option<(String,)> = sqlx::query_as("SELECT settings_json FROM mobile_settings WHERE user_id = ?")
+            .bind(user_id)
+            .fetch_optional(&self.pool)
+            .await?;
+        row.map(|(json,)| serde_json::from_str(&json).map_err(MobileError::from))
+            .transpose()
+    }
+
+    pub async fn save_settings(&self, user_id: &str, settings: &MobileSettings) -> Result<(), MobileError> {
+        sqlx::query(
+            "INSERT INTO mobile_settings (user_id, settings_json, updated_at) VALUES (?, ?, ?) \
+             ON CONFLICT(user_id) DO UPDATE SET settings_json = excluded.settings_json, updated_at = excluded.updated_at",
+        )
+        .bind(user_id)
+        .bind(serde_json::to_string(settings)?)
+        .bind(aionui_common::now_ms())
+        .execute(&self.pool)
+        .await?;
+        Ok(())
+    }
+
+    /// Users whose bridge is switched on (normally zero or one).
+    pub async fn enabled_users(&self) -> Result<Vec<(String, MobileSettings)>, MobileError> {
+        let rows: Vec<(String, String)> =
+            sqlx::query_as("SELECT user_id, settings_json FROM mobile_settings ORDER BY updated_at DESC")
+                .fetch_all(&self.pool)
+                .await?;
+        let mut out = Vec::new();
+        for (user_id, json) in rows {
+            let settings: MobileSettings = serde_json::from_str(&json)?;
+            if settings.enabled {
+                out.push((user_id, settings));
+            }
+        }
+        Ok(out)
+    }
+
+    // ---- Paired devices (CONTRACT §3.1, §3.4) ---------------------------------------------
+
+    pub async fn insert_device(&self, device: &DeviceRow) -> Result<(), MobileError> {
+        sqlx::query(
+            "INSERT INTO mobile_devices (device_id, user_id, device_pk, name, platform, app_version, confirm_mode, \
+             confirm_key_sealed, require_confirm, paired_at, last_seen_at, last_address) \
+             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+        )
+        .bind(&device.device_id)
+        .bind(&device.user_id)
+        .bind(&device.device_pk[..])
+        .bind(&device.name)
+        .bind(&device.platform)
+        .bind(&device.app_version)
+        .bind(&device.confirm_mode)
+        .bind(device.confirm_key_sealed.as_deref())
+        .bind(device.require_confirm)
+        .bind(device.paired_at)
+        .bind(device.last_seen_at)
+        .bind(device.last_address.as_deref())
+        .execute(&self.pool)
+        .await?;
+        sqlx::query("DELETE FROM mobile_device_tombstones WHERE device_id = ?")
+            .bind(&device.device_id)
+            .execute(&self.pool)
+            .await?;
+        Ok(())
+    }
+
+    pub async fn device(&self, device_id: &str) -> Result<Option<DeviceRow>, MobileError> {
+        let row = sqlx::query_as::<_, DeviceRow>("SELECT * FROM mobile_devices WHERE device_id = ?")
+            .bind(device_id)
+            .fetch_optional(&self.pool)
+            .await?;
+        Ok(row)
+    }
+
+    pub async fn devices_for(&self, user_id: &str) -> Result<Vec<DeviceRow>, MobileError> {
+        let rows = sqlx::query_as::<_, DeviceRow>("SELECT * FROM mobile_devices WHERE user_id = ? ORDER BY paired_at")
+            .bind(user_id)
+            .fetch_all(&self.pool)
+            .await?;
+        Ok(rows)
+    }
+
+    pub async fn touch_device(&self, device_id: &str, address: &str) -> Result<(), MobileError> {
+        sqlx::query("UPDATE mobile_devices SET last_seen_at = ?, last_address = ? WHERE device_id = ?")
+            .bind(aionui_common::now_ms())
+            .bind(address)
+            .bind(device_id)
+            .execute(&self.pool)
+            .await?;
+        Ok(())
+    }
+
+    /// Renames or changes `requireConfirm`. `Ok(false)` when the device isn't this user's.
+    pub async fn update_device(
+        &self,
+        user_id: &str,
+        device_id: &str,
+        name: Option<&str>,
+        require_confirm: Option<bool>,
+    ) -> Result<bool, MobileError> {
+        let done = sqlx::query(
+            "UPDATE mobile_devices SET name = COALESCE(?, name), require_confirm = COALESCE(?, require_confirm) \
+             WHERE device_id = ? AND user_id = ?",
+        )
+        .bind(name)
+        .bind(require_confirm)
+        .bind(device_id)
+        .bind(user_id)
+        .execute(&self.pool)
+        .await?;
+        Ok(done.rows_affected() == 1)
+    }
+
+    /// Replaces a device's confirm key and mode (the re-key flow, §5.3).
+    pub async fn set_confirm_key(
+        &self,
+        device_id: &str,
+        confirm_mode: &str,
+        sealed: Option<&[u8]>,
+    ) -> Result<(), MobileError> {
+        sqlx::query("UPDATE mobile_devices SET confirm_mode = ?, confirm_key_sealed = ? WHERE device_id = ?")
+            .bind(confirm_mode)
+            .bind(sealed)
+            .bind(device_id)
+            .execute(&self.pool)
+            .await?;
+        Ok(())
+    }
+
+    /// Revokes: deletes the row and its sealed confirm key, and leaves a
+    /// tombstone so a later handshake can say "revoked" rather than "unknown".
+    /// `Ok(false)` when the device isn't this user's.
+    pub async fn revoke_device(&self, user_id: &str, device_id: &str) -> Result<bool, MobileError> {
+        let mut tx = self.pool.begin().await?;
+        let done = sqlx::query("DELETE FROM mobile_devices WHERE device_id = ? AND user_id = ?")
+            .bind(device_id)
+            .bind(user_id)
+            .execute(&mut *tx)
+            .await?;
+        if done.rows_affected() == 1 {
+            sqlx::query(
+                "INSERT INTO mobile_device_tombstones (device_id, user_id, revoked_at) VALUES (?, ?, ?) \
+                 ON CONFLICT(device_id) DO UPDATE SET revoked_at = excluded.revoked_at",
+            )
+            .bind(device_id)
+            .bind(user_id)
+            .bind(aionui_common::now_ms())
+            .execute(&mut *tx)
+            .await?;
+        }
+        tx.commit().await?;
+        Ok(done.rows_affected() == 1)
+    }
+
+    pub async fn last_recovery(&self) -> Result<Option<Recovery>, MobileError> {
+        let row: Option<(String,)> = sqlx::query_as("SELECT value FROM mobile_meta WHERE key = 'last_recovery'")
+            .fetch_optional(&self.pool)
+            .await?;
+        Ok(row.and_then(|(json,)| serde_json::from_str(&json).ok()))
+    }
+
+    pub async fn set_last_recovery(&self, recovery: Option<&Recovery>) -> Result<(), MobileError> {
+        match recovery {
+            Some(r) => {
+                sqlx::query(
+                    "INSERT INTO mobile_meta (key, value) VALUES ('last_recovery', ?) \
+                     ON CONFLICT(key) DO UPDATE SET value = excluded.value",
+                )
+                .bind(serde_json::to_string(r)?)
+                .execute(&self.pool)
+                .await?;
+            }
+            None => {
+                sqlx::query("DELETE FROM mobile_meta WHERE key = 'last_recovery'")
+                    .execute(&self.pool)
+                    .await?;
+            }
+        }
+        Ok(())
+    }
+
+    pub async fn insert_broadcast(&self, b: &BroadcastRow) -> Result<(), MobileError> {
+        sqlx::query(
+            "INSERT INTO mobile_broadcasts (broadcast_id, user_id, team_id, content, created_at, device_id, device_name, deliveries) \
+             VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+        )
+        .bind(&b.broadcast_id)
+        .bind(&b.user_id)
+        .bind(&b.team_id)
+        .bind(&b.content)
+        .bind(b.created_at)
+        .bind(&b.device_id)
+        .bind(&b.device_name)
+        .bind(&b.deliveries)
+        .execute(&self.pool)
+        .await?;
+        Ok(())
+    }
+
+    /// Links a send_failed row to the user message whose send failed.
+    pub async fn insert_send_failure(
+        &self,
+        failure_id: &str,
+        conversation_id: &str,
+        message_id: &str,
+        created_at: i64,
+    ) -> Result<(), MobileError> {
+        sqlx::query(
+            "INSERT OR REPLACE INTO mobile_send_failures (failure_id, conversation_id, message_id, created_at) \
+             VALUES (?, ?, ?, ?)",
+        )
+        .bind(failure_id)
+        .bind(conversation_id)
+        .bind(message_id)
+        .bind(created_at)
+        .execute(&self.pool)
+        .await?;
+        Ok(())
+    }
+
+    /// The failed message of each send_failed row of one conversation, by failure row id.
+    pub async fn send_failures(
+        &self,
+        conversation_id: &str,
+    ) -> Result<std::collections::HashMap<String, String>, MobileError> {
+        let rows: Vec<(String, String)> =
+            sqlx::query_as("SELECT failure_id, message_id FROM mobile_send_failures WHERE conversation_id = ?")
+                .bind(conversation_id)
+                .fetch_all(&self.pool)
+                .await?;
+        Ok(rows.into_iter().collect())
+    }
+
+    /// Newest first. `before`: `(created_at, broadcast_id)` of the last one already shown.
+    pub async fn broadcasts(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        before: Option<(i64, String)>,
+        limit: i64,
+    ) -> Result<Vec<BroadcastRow>, MobileError> {
+        let rows = match before {
+            None => {
+                sqlx::query_as::<_, BroadcastRow>(
+                    "SELECT * FROM mobile_broadcasts WHERE user_id = ? AND team_id = ? \
+                     ORDER BY created_at DESC, broadcast_id DESC LIMIT ?",
+                )
+                .bind(user_id)
+                .bind(team_id)
+                .bind(limit)
+                .fetch_all(&self.pool)
+                .await?
+            }
+            Some((at, id)) => {
+                sqlx::query_as::<_, BroadcastRow>(
+                    "SELECT * FROM mobile_broadcasts WHERE user_id = ? AND team_id = ? \
+                     AND (created_at < ? OR (created_at = ? AND broadcast_id < ?)) \
+                     ORDER BY created_at DESC, broadcast_id DESC LIMIT ?",
+                )
+                .bind(user_id)
+                .bind(team_id)
+                .bind(at)
+                .bind(at)
+                .bind(id)
+                .bind(limit)
+                .fetch_all(&self.pool)
+                .await?
+            }
+        };
+        Ok(rows)
+    }
+
+    /// Forgets every paired phone (used when the host identity had to be replaced).
+    pub async fn clear_devices(&self) -> Result<(), MobileError> {
+        sqlx::query("DELETE FROM mobile_devices").execute(&self.pool).await?;
+        Ok(())
+    }
+
+    pub async fn is_tombstoned(&self, device_id: &str) -> Result<bool, MobileError> {
+        let row: Option<(String,)> =
+            sqlx::query_as("SELECT device_id FROM mobile_device_tombstones WHERE device_id = ?")
+                .bind(device_id)
+                .fetch_optional(&self.pool)
+                .await?;
+        Ok(row.is_some())
+    }
+}
+
+/// The bridge recovered from damage; the settings page tells the user phones need re-pairing.
+#[derive(Debug, Clone, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Recovery {
+    /// `database` or `host_key`.
+    pub kind: String,
+    pub at: i64,
+    /// Where the damaged file was moved.
+    pub moved_to: Option<String>,
+}
+
+#[derive(Debug, Clone, sqlx::FromRow)]
+pub struct BroadcastRow {
+    pub broadcast_id: String,
+    pub user_id: String,
+    pub team_id: String,
+    pub content: String,
+    pub created_at: i64,
+    pub device_id: String,
+    pub device_name: String,
+    /// JSON array of `{slotId, messageId, delivery, error?}`.
+    pub deliveries: String,
+}
+
+#[derive(Debug, Clone, sqlx::FromRow)]
+pub struct DeviceRow {
+    pub device_id: String,
+    pub user_id: String,
+    pub device_pk: Vec<u8>,
+    pub name: String,
+    pub platform: String,
+    pub app_version: String,
+    pub confirm_mode: String,
+    pub confirm_key_sealed: Option<Vec<u8>>,
+    pub require_confirm: bool,
+    pub paired_at: i64,
+    pub last_seen_at: Option<i64>,
+    pub last_address: Option<String>,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn device(id: &str, user: &str) -> DeviceRow {
+        DeviceRow {
+            device_id: id.into(),
+            user_id: user.into(),
+            device_pk: vec![1; 32],
+            name: "Phone".into(),
+            platform: "ios".into(),
+            app_version: "1.0.0".into(),
+            confirm_mode: "biometric".into(),
+            confirm_key_sealed: Some(vec![9; 56]),
+            require_confirm: true,
+            paired_at: 1,
+            last_seen_at: None,
+            last_address: None,
+        }
+    }
+
+    #[tokio::test]
+    async fn devices_insert_update_and_revoke_with_tombstone() {
+        let store = MobileStore::open_memory().await.unwrap();
+        store.insert_device(&device("d1", "u1")).await.unwrap();
+        assert_eq!(store.devices_for("u1").await.unwrap().len(), 1);
+        assert!(store.devices_for("u2").await.unwrap().is_empty());
+
+        assert!(
+            !store.update_device("u2", "d1", Some("x"), None).await.unwrap(),
+            "another user's device"
+        );
+        assert!(
+            store
+                .update_device("u1", "d1", Some("Pixel"), Some(false))
+                .await
+                .unwrap()
+        );
+        let d = store.device("d1").await.unwrap().unwrap();
+        assert_eq!(d.name, "Pixel");
+        assert!(!d.require_confirm);
+
+        assert!(
+            !store.revoke_device("u2", "d1").await.unwrap(),
+            "another user cannot revoke"
+        );
+        assert!(store.revoke_device("u1", "d1").await.unwrap());
+        assert!(store.device("d1").await.unwrap().is_none());
+        assert!(store.is_tombstoned("d1").await.unwrap());
+        assert!(!store.is_tombstoned("never-seen").await.unwrap());
+    }
+
+    #[tokio::test]
+    async fn settings_round_trip_per_user() {
+        let store = MobileStore::open_memory().await.unwrap();
+        assert!(store.load_settings("u1").await.unwrap().is_none());
+        let mut s = MobileSettings::defaults("PC");
+        s.enabled = true;
+        store.save_settings("u1", &s).await.unwrap();
+        store
+            .save_settings("u2", &MobileSettings::defaults("PC"))
+            .await
+            .unwrap();
+        assert_eq!(store.load_settings("u1").await.unwrap(), Some(s.clone()));
+        let enabled = store.enabled_users().await.unwrap();
+        assert_eq!(enabled.len(), 1);
+        assert_eq!(enabled[0].0, "u1");
+    }
+
+    #[tokio::test]
+    async fn file_database_is_created_and_reopened() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = MobileStore::path_in(dir.path());
+        {
+            let store = MobileStore::open(&path).await.unwrap();
+            store
+                .save_settings("u1", &MobileSettings::defaults("PC"))
+                .await
+                .unwrap();
+            store.pool().close().await;
+        }
+        let store = MobileStore::open(&path).await.unwrap();
+        assert!(store.load_settings("u1").await.unwrap().is_some());
+        // The bridge's tables are present; nothing is written to AionCore's own database.
+        let tables: Vec<(String,)> = sqlx::query_as(
+            "SELECT name FROM sqlite_master WHERE type = 'table' AND name LIKE 'mobile_%' ORDER BY name",
+        )
+        .fetch_all(store.pool())
+        .await
+        .unwrap();
+        let names: Vec<_> = tables.into_iter().map(|(n,)| n).collect();
+        assert_eq!(
+            names,
+            [
+                "mobile_broadcasts",
+                "mobile_device_tombstones",
+                "mobile_devices",
+                "mobile_meta",
+                "mobile_send_failures",
+                "mobile_settings"
+            ]
+        );
+    }
+}
diff --git a/crates/aionui-mobile/src/wire.rs b/crates/aionui-mobile/src/wire.rs
new file mode 100644
index 00000000..9855cfc9
--- /dev/null
+++ b/crates/aionui-mobile/src/wire.rs
@@ -0,0 +1,130 @@
+//! Outer wire types of protocol v1 (CONTRACT §4). Plaintext JSON bodies;
+//! binary fields are base64url without padding.
+
+use serde::{Deserialize, Serialize};
+
+pub const PROTOCOL_VERSION: u8 = 1;
+/// ±2 minutes, the same window as the phone's `MAX_CLOCK_SKEW_MS`.
+pub const MAX_CLOCK_SKEW_MS: i64 = 2 * 60 * 1000;
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PairRequestBody {
+    pub v: u8,
+    pub host_id: String,
+    pub device_id: String,
+    pub device_pk: String,
+    pub nonce: String,
+    pub ct: String,
+}
+
+/// The sealed part of a pair request (§4.2).
+#[derive(Debug, Clone, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PairRequestPayload {
+    pub device_name: String,
+    pub platform: String,
+    pub app_version: String,
+    pub ts: i64,
+    #[serde(default = "default_confirm_mode")]
+    pub confirm_mode: String,
+    #[serde(default)]
+    pub wait: bool,
+}
+
+fn default_confirm_mode() -> String {
+    "none".into()
+}
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PairResponsePayload {
+    pub status: &'static str,
+    pub host_id: String,
+    pub host_name: String,
+    pub ts: i64,
+    pub req_ts: i64,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub confirm_key: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct SealedBox {
+    pub nonce: String,
+    pub ct: String,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct SealedResponse {
+    pub v: u8,
+    pub nonce: String,
+    pub ct: String,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct HandshakeInitBody {
+    pub v: u8,
+    pub host_id: String,
+    pub device_id: String,
+    pub epk: String,
+    pub nonce: String,
+    pub ct: String,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct HandshakeResponseBody {
+    pub v: u8,
+    pub epk: String,
+    pub nonce: String,
+    pub ct: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct RpcEnvelope {
+    pub v: u8,
+    pub sid: String,
+    pub seq: u64,
+    pub nonce: String,
+    pub ct: String,
+}
+
+/// The decrypted request inside an RPC envelope (§4.4).
+#[derive(Debug, Clone, Deserialize)]
+pub struct InnerRequest {
+    pub method: String,
+    pub path: String,
+    #[serde(default)]
+    pub body: Option<serde_json::Value>,
+    pub rid: String,
+    #[serde(default)]
+    pub confirm: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct InnerResponse {
+    pub status: u16,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub body: Option<serde_json::Value>,
+}
+
+impl InnerResponse {
+    pub fn ok(body: serde_json::Value) -> Self {
+        Self {
+            status: 200,
+            body: Some(body),
+        }
+    }
+
+    /// `{error: {code, message}}` (CONTRACT §6.0).
+    pub fn error(status: u16, code: &str, message: impl Into<String>) -> Self {
+        Self {
+            status,
+            body: Some(serde_json::json!({ "error": { "code": code, "message": message.into() } })),
+        }
+    }
+}
+
+pub fn is_fresh(ts: i64, now: i64) -> bool {
+    (now - ts).abs() <= MAX_CLOCK_SKEW_MS
+}
diff --git a/crates/aionui-mobile/tests/facade_routes.rs b/crates/aionui-mobile/tests/facade_routes.rs
