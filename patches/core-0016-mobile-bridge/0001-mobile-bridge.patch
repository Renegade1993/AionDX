+#[tokio::test]
+async fn the_feed_long_polls_per_user_and_resets_on_a_stranger_token() {
+    let (_fake, f) = facade();
+    let t0 = first_token(&f).await;
+
+    // Another user's change neither wakes nor reaches this one.
+    emit_as(&f, "u2", "team.renamed", json!({ "team_id": "t7" })).await;
+    let (_, changes) = changes_since(&f, &t0).await;
+    assert!(changes.is_empty());
+
+    let waiter = {
+        let f = f.clone();
+        let t0 = t0.clone();
+        tokio::spawn(async move {
+            let started = std::time::Instant::now();
+            let r = get(&f, &format!("/v1/changes?since={t0}&wait=10")).await.unwrap();
+            (started.elapsed(), r)
+        })
+    };
+    tokio::time::sleep(std::time::Duration::from_millis(50)).await;
+    emit(
+        &f,
+        "team.taskChanged",
+        json!({ "team_id": "t1", "change": "created",
+                "task": { "id": "k1", "team_id": "t1", "subject": "Ship", "description": null, "status": "pending",
+                          "owner": "s2", "blocked_by": [], "blocks": [], "created_at": 1, "updated_at": 1 } }),
+    )
+    .await;
+    let (elapsed, (status, page)) = waiter.await.unwrap();
+    assert_eq!(status, 200);
+    assert!(elapsed < std::time::Duration::from_secs(5), "{elapsed:?}");
+    let tasks = of_kind(page["changes"].as_array().unwrap(), "task");
+    assert_eq!(tasks.len(), 1);
+    assert_eq!(tasks[0]["change"], "created");
+    assert_eq!(tasks[0]["task"]["subject"], "Ship");
+    assert_eq!(tasks[0]["task"]["ownerName"], "Bob");
+
+    let (_, page) = get(&f, "/v1/changes?since=old-epoch.3").await.unwrap();
+    assert_eq!(page["reset"], true);
+    assert_eq!(page["changes"], json!([]));
+}
