+        let moved = std::fs::read_dir(key_path.parent().unwrap())
+            .unwrap()
+            .filter_map(|e| e.ok())
+            .any(|e| e.file_name().to_string_lossy().contains("corrupt"));
+        assert!(!moved);
+    }
+
+    #[tokio::test]
+    async fn a_missing_database_is_simply_created() {
+        let dir = tempfile::tempdir().unwrap();
+        let bridge = open_in(
+            dir.path(),
+            &UnprotectedForTests,
+            "PC".into(),
+            Arc::new(crate::core::NoEvents),
+        )
+        .await;
+        assert!(bridge.is_some());
+        assert!(dir.path().join("aiondx-bridge.db").exists());
+    }
+}
diff --git a/crates/aionui-mobile/src/service_net.rs b/crates/aionui-mobile/src/service_net.rs
new file mode 100644
index 00000000..8bacbce3
--- /dev/null
+++ b/crates/aionui-mobile/src/service_net.rs
@@ -0,0 +1,219 @@
+//! Phase 5: the bridge's network surface for the desktop (CONTRACT §7, PHASE5-NET-SPEC): the QR address list, the
+//! mDNS advertisement, the firewall rule's state, the listener's bind address, and how a re-key offer ended.
+
+use std::net::{IpAddr, Ipv4Addr};
+
+use serde::Serialize;
+
+use crate::error::MobileError;
+use crate::firewall::{self, FirewallPlan, RuleStatus};
+use crate::service::{AdminFailure, MobileBridge, pairing_urls_for};
+use crate::settings::MobileSettings;
+
+/// `AIONDX_MOBILE_BIND`: a loopback address to listen on instead of every interface, for test runs that must not be
+/// reachable from the LAN. Unset means `0.0.0.0` (plus `[::]`). Anything that isn't a loopback address is ignored
+/// with a warning: this switch can only make the bridge less reachable.
+pub(crate) fn bind_ip_from_env() -> IpAddr {
+    bind_ip_from(std::env::var("AIONDX_MOBILE_BIND").ok().as_deref())
+}
+
+fn bind_ip_from(value: Option<&str>) -> IpAddr {
+    let any = IpAddr::V4(Ipv4Addr::UNSPECIFIED);
+    let Some(raw) = value.map(str::trim).filter(|v| !v.is_empty()) else {
+        return any;
+    };
+    match raw.parse::<IpAddr>() {
+        Ok(ip) if ip.is_loopback() => {
+            tracing::info!(%ip, "mobile bridge: AIONDX_MOBILE_BIND set; listening on loopback only");
+            ip
+        }
+        _ => {
+            tracing::warn!(
+                value = raw,
+                "mobile bridge: AIONDX_MOBILE_BIND is not a loopback address; ignored"
+            );
+            any
+        }
+    }
+}
+
+/// A running `_aiondx._tcp` advertisement. `withdraw` sends the goodbye packets and stops it (it may block for up to
+/// a couple of seconds, so callers run it off the async threads).
+pub trait Advertisement: Send {
+    fn withdraw(self: Box<Self>);
+}
+
+impl Advertisement for crate::mdns::MdnsAdvertiser {
+    fn withdraw(self: Box<Self>) {
+        (*self).stop();
+    }
+}
+
+/// Starts an advertisement for `(host_id, port)`. The real one is `MdnsAdvertiser::start`; tests use a fake, so no
+/// test ever multicasts on the LAN.
+pub type AdvertiseFn = std::sync::Arc<dyn Fn(&str, u16) -> Result<Box<dyn Advertisement>, String> + Send + Sync>;
+
+pub(crate) fn real_advertiser() -> AdvertiseFn {
+    std::sync::Arc::new(|host_id: &str, port: u16| {
+        crate::mdns::MdnsAdvertiser::start(host_id, port).map(|a| Box::new(a) as Box<dyn Advertisement>)
+    })
+}
+
+/// Withdraws an advertisement without blocking the async threads.
+pub(crate) async fn withdraw(ad: Box<dyn Advertisement>) {
+    if let Err(e) = tokio::task::spawn_blocking(move || ad.withdraw()).await {
+        tracing::warn!(error = %e, "mobile bridge: withdrawing the mDNS advertisement failed");
+    }
+}
+
+/// `GET /api/mobile/admin/firewall`.
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct FirewallView {
+    /// `present` | `absent`. On a non-English Windows `netsh` output can't be read, which shows as `absent`.
+    pub rule: &'static str,
+    /// Windows Firewall on (`true`) or off (`false`) for the Private profile; `null` when `netsh` couldn't be read (e.g.
+    /// a non-English Windows). Off means no rule is needed.
+    pub firewall_enabled: Option<bool>,
+    pub enabled: bool,
+    pub private_only: bool,
+    pub port: Option<u16>,
+    /// The rule is there, enabled, Private-only, and opens the port the bridge uses now.
+    pub matches_settings: bool,
+    /// What adding the rule would run (elevated, by the desktop app). `null` when no plan can be built.
+    pub plan: Option<PlanView>,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct PlanView {
+    pub program: String,
+    pub args: Vec<String>,
+}
+
+impl From<FirewallPlan> for PlanView {
+    fn from(p: FirewallPlan) -> Self {
+        Self {
+            program: p.program,
+            args: p.args,
+        }
+    }
+}
+
+fn firewall_view(
+    status: RuleStatus,
+    firewall_enabled: Option<bool>,
+    port: u16,
+    plan: Option<FirewallPlan>,
+) -> FirewallView {
+    FirewallView {
+        rule: if status.present { "present" } else { "absent" },
+        firewall_enabled,
+        enabled: status.enabled,
+        private_only: status.private_only,
+        port: status.port,
+        matches_settings: status.present && status.enabled && status.private_only && status.port == Some(port),
+        plan: plan.map(PlanView::from),
+    }
+}
+
+/// `GET /api/mobile/admin/rekey-offers/{offerId}`: `pending` | `completed` | `failed` | `expired`.
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct RekeyOfferView {
+    pub state: &'static str,
+    pub expires_at: i64,
+}
+
+impl MobileBridge {
+    pub(crate) fn pairing_urls(&self, settings: &MobileSettings) -> Vec<String> {
+        pairing_urls_for(self.bind_ip, settings)
+    }
+
+    /// Starts the `_aiondx._tcp` advertisement when the user left mDNS on and the listener is on the LAN. A failure
+    /// (no private interface, a socket error) only loses discovery: phones still use their stored URLs.
+    pub(crate) fn advertise(&self, settings: &MobileSettings) -> Option<Box<dyn Advertisement>> {
+        if !settings.mdns || (self.bind_ip.is_loopback() && !self.advertise_on_loopback) {
+            return None;
+        }
+        match (self.advertiser)(&self.core.host_key.host_id, settings.port) {
+            Ok(a) => Some(a),
+            Err(e) => {
+                tracing::warn!(error = %e, "mobile bridge: mDNS advertisement did not start");
+                None
+            }
+        }
+    }
+
+    /// The firewall rule as `netsh` reports it, read-only, and the plan the desktop would run to add it for this
+    /// process and port.
+    pub async fn firewall_status(&self, user_id: &str) -> Result<FirewallView, MobileError> {
+        let settings = self.settings_for(user_id).await?;
+        let status = firewall::query_rule(self.firewall.as_ref()).await;
+        let enabled = firewall::query_firewall_enabled(self.firewall.as_ref()).await;
+        let plan = std::env::current_exe()
+            .ok()
+            .and_then(|exe| firewall::add_rule_plan(&exe, settings.port).ok());
+        Ok(firewall_view(status, enabled, settings.port, plan))
+    }
+
+    /// How a re-key offer (its id is the device's) ended, for one of this user's phones.
+    pub async fn rekey_offer_state(&self, user_id: &str, offer_id: &str) -> Result<RekeyOfferView, AdminFailure> {
+        self.store()
+            .device(offer_id)
+            .await?
+            .filter(|d| d.user_id == user_id)
+            .ok_or(AdminFailure::NotFound)?;
+        let offers = self.core.rekey_offers.lock().unwrap();
+        let offer = offers.get(offer_id).ok_or(AdminFailure::NotFound)?;
+        let state = match offer.state {
+            crate::core::RekeyState::Completed => "completed",
+            crate::core::RekeyState::Failed => "failed",
+            crate::core::RekeyState::Pending if aionui_common::now_ms() >= offer.expires_at => "expired",
+            crate::core::RekeyState::Pending => "pending",
+        };
+        Ok(RekeyOfferView {
+            state,
+            expires_at: offer.expires_at,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_bind_switch_only_accepts_loopback() {
+        let any = IpAddr::V4(Ipv4Addr::UNSPECIFIED);
+        assert_eq!(bind_ip_from(None), any);
+        assert_eq!(bind_ip_from(Some("  ")), any);
+        assert_eq!(bind_ip_from(Some("127.0.0.1")), IpAddr::from([127, 0, 0, 1]));
+        assert_eq!(bind_ip_from(Some("::1")), IpAddr::V6(std::net::Ipv6Addr::LOCALHOST));
+        assert_eq!(bind_ip_from(Some("192.168.1.5")), any, "a LAN address is refused");
+        assert_eq!(bind_ip_from(Some("0.0.0.0")), any);
+        assert_eq!(bind_ip_from(Some("nonsense")), any);
+    }
+
+    #[test]
+    fn the_firewall_view_says_whether_the_rule_fits_the_port() {
+        let good = RuleStatus {
+            present: true,
+            enabled: true,
+            private_only: true,
+            port: Some(47734),
+        };
+        assert!(firewall_view(good, Some(true), 47734, None).matches_settings);
+        assert!(
+            !firewall_view(good, Some(true), 47735, None).matches_settings,
+            "the user changed the port"
+        );
+        let public_too = RuleStatus {
+            private_only: false,
+            ..good
+        };
+        assert!(!firewall_view(public_too, Some(true), 47734, None).matches_settings);
+        let none = firewall_view(RuleStatus::default(), None, 47734, None);
+        assert_eq!(none.rule, "absent");
+        assert!(!none.matches_settings);
+    }
+}
diff --git a/crates/aionui-mobile/src/session.rs b/crates/aionui-mobile/src/session.rs
new file mode 100644
index 00000000..9428e669
--- /dev/null
+++ b/crates/aionui-mobile/src/session.rs
@@ -0,0 +1,406 @@
+//! Sessions (CONTRACT §4.3–4.5, A3, A4): the handshake, the session table,
+//! and opening and sealing RPC envelopes. All state is in memory; a restart
+//! ends every session and phones simply handshake again.
+
+use std::collections::{BTreeSet, HashMap, VecDeque};
+use std::sync::Mutex;
+
+use crate::crypto::{self, SID_LEN};
+use crate::host_key::{HostKey, random_bytes};
+use crate::wire::{
+    HandshakeInitBody, HandshakeResponseBody, InnerResponse, PROTOCOL_VERSION, RpcEnvelope, SealedBox, is_fresh,
+};
+
+/// §11 #7: 12 h absolute, 30 min idle.
+pub const SESSION_TTL_MS: i64 = 12 * 60 * 60 * 1000;
+pub const IDLE_TIMEOUT_MS: i64 = 30 * 60 * 1000;
+pub const REPLAY_WINDOW: u64 = 256;
+pub const MAX_SESSIONS_PER_DEVICE: usize = 4;
+/// A3: how long a handshake `epk` is remembered.
+const EPK_MEMORY_MS: i64 = 5 * 60 * 1000;
+/// A4: how long a mutating request's `rid` is remembered per device.
+const RID_MEMORY_MS: i64 = 10 * 60 * 1000;
+
+/// What the handshake needs to know about a device.
+pub struct KnownDevice {
+    pub user_id: String,
+    pub device_pk: [u8; 32],
+}
+
+pub enum HandshakeOutcome {
+    Ok {
+        response: HandshakeResponseBody,
+        sid: [u8; SID_LEN],
+    },
+    /// The device isn't trusted: an authenticated notice for the phone (A1).
+    Revoked { notice: SealedBox },
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum HandshakeError {
+    UnsupportedVersion,
+    Malformed,
+    UnknownHost,
+    AuthFailed,
+    ClockSkew,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum RpcError {
+    UnsupportedVersion,
+    Malformed,
+    UnknownSession,
+    SessionExpired,
+    AuthFailed,
+    Replayed,
+}
+
+/// A verified RPC request, ready to dispatch.
+pub struct OpenedRpc {
+    pub sid: [u8; SID_LEN],
+    pub seq: u64,
+    pub user_id: String,
+    pub device_id: String,
+    pub plaintext: Vec<u8>,
+}
+
+/// The result of opening an envelope.
+pub enum Opened {
+    New(OpenedRpc),
+    /// An exact repeat of an envelope already answered (multi-URL failover): send this again.
+    Duplicate(RpcEnvelope),
+}
+
+struct Session {
+    device_id: String,
+    user_id: String,
+    c2s: [u8; 32],
+    s2c: [u8; 32],
+    created_at: i64,
+    expires_at: i64,
+    last_used: i64,
+    highest: Option<u64>,
+    seen: BTreeSet<u64>,
+    /// seq → (hash of the request envelope, the sealed response), within the window.
+    answered: HashMap<u64, ([u8; 32], RpcEnvelope)>,
+}
+
+impl Session {
+    fn accept(&mut self, seq: u64) -> bool {
+        if let Some(high) = self.highest
+            && seq + REPLAY_WINDOW <= high
+        {
+            return false;
+        }
+        if !self.seen.insert(seq) {
+            return false;
+        }
+        if self.highest.is_none_or(|h| seq > h) {
+            self.highest = Some(seq);
+            let floor = seq.saturating_sub(REPLAY_WINDOW - 1);
+            self.seen = self.seen.split_off(&floor);
+            self.answered.retain(|s, _| *s >= floor);
+        }
+        true
+    }
+}
+
+#[derive(Default)]
+pub struct SessionStore {
+    sessions: Mutex<HashMap<[u8; SID_LEN], Session>>,
+    epks: Mutex<VecDeque<([u8; 32], i64)>>,
+    rids: Mutex<HashMap<(String, String), (i64, InnerResponse)>>,
+}
+
+impl SessionStore {
+    /// The handshake (CONTRACT §4.3). `device` is `None` when the device is
+    /// not trusted; `revoked` tells a tombstone from a device never seen.
+    pub fn handshake(
+        &self,
+        host: &HostKey,
+        body: &HandshakeInitBody,
+        device: Option<&KnownDevice>,
+        revoked: bool,
+        now: i64,
+    ) -> Result<HandshakeOutcome, HandshakeError> {
+        if body.v != PROTOCOL_VERSION {
+            return Err(HandshakeError::UnsupportedVersion);
+        }
+        if body.host_id != host.host_id {
+            return Err(HandshakeError::UnknownHost);
+        }
+        let client_epk = crypto::key_from_b64u(&body.epk).map_err(|_| HandshakeError::Malformed)?;
+        let nonce = crypto::from_b64u(&body.nonce).map_err(|_| HandshakeError::Malformed)?;
+        let ct = crypto::from_b64u(&body.ct).map_err(|_| HandshakeError::Malformed)?;
+        let epk_pub = x25519_dalek::PublicKey::from(client_epk);
+        let dh_eph_static = host.diffie_hellman(&epk_pub);
+
+        let Some(device) = device else {
+            let reason = if revoked { "revoked" } else { "unknown" };
+            let k_rev = crypto::revocation_key(&dh_eph_static, &host.host_id, &body.device_id, &client_epk);
+            let aad = crypto::revocation_aad(&host.host_id, &body.device_id, &client_epk);
+            let plain = serde_json::json!({ "deviceId": body.device_id, "ts": now, "reason": reason }).to_string();
+            let nonce = random_bytes::<24>().map_err(|_| HandshakeError::Malformed)?;
+            let sealed = crypto::seal(&k_rev, &nonce, plain.as_bytes(), &aad);
+            return Ok(HandshakeOutcome::Revoked {
+                notice: SealedBox {
+                    nonce: crypto::b64u(&nonce),
+                    ct: crypto::b64u(&sealed),
+                },
+            });
+        };
+
+        let dh_static_static = host.diffie_hellman(&x25519_dalek::PublicKey::from(device.device_pk));
+        let k_init = crypto::handshake_init_key(
+            &dh_eph_static,
+            &dh_static_static,
+            &body.device_id,
+            &device.device_pk,
+            host.public.as_bytes(),
+            &client_epk,
+        );
+        let aad = crypto::handshake_init_aad(&host.host_id, &body.device_id, &client_epk);
+        let plain = crypto::open(&k_init, &nonce, &ct, &aad).map_err(|_| HandshakeError::AuthFailed)?;
+        let ts = serde_json::from_slice::<serde_json::Value>(&plain)
+            .ok()
+            .and_then(|v| v["ts"].as_i64())
+            .ok_or(HandshakeError::Malformed)?;
+        if !is_fresh(ts, now) {
+            return Err(HandshakeError::ClockSkew);
+        }
+        if !self.remember_epk(client_epk, now) {
+            return Err(HandshakeError::AuthFailed); // A3: a replayed handshake
+        }
+
+        let eh_secret = random_bytes::<32>().map_err(|_| HandshakeError::Malformed)?;
+        let host_epk = crypto::x25519_public(&eh_secret);
+        let d3 = crypto::x25519(&eh_secret, &client_epk);
+        let d4 = crypto::x25519(&eh_secret, &device.device_pk);
+        let transcript = crypto::session_transcript(
+            &body.device_id,
+            &device.device_pk,
+            host.public.as_bytes(),
+            &client_epk,
+            &host_epk,
+        );
+        let keys = crypto::session_keys([&dh_eph_static, &dh_static_static, &d3, &d4], &transcript);
+        let expires_at = now + SESSION_TTL_MS;
+        let payload = serde_json::json!({ "expiresAt": expires_at, "idleTimeoutMs": IDLE_TIMEOUT_MS }).to_string();
+        let res_nonce = random_bytes::<24>().map_err(|_| HandshakeError::Malformed)?;
+        let sealed = crypto::seal(&keys.s2c, &res_nonce, payload.as_bytes(), &transcript);
+
+        self.insert(
+            keys.sid,
+            Session {
+                device_id: body.device_id.clone(),
+                user_id: device.user_id.clone(),
+                c2s: keys.c2s,
+                s2c: keys.s2c,
+                created_at: now,
+                expires_at,
+                last_used: now,
+                highest: None,
+                seen: BTreeSet::new(),
+                answered: HashMap::new(),
+            },
+        );
+        Ok(HandshakeOutcome::Ok {
+            response: HandshakeResponseBody {
+                v: PROTOCOL_VERSION,
+                epk: crypto::b64u(&host_epk),
+                nonce: crypto::b64u(&res_nonce),
+                ct: crypto::b64u(&sealed),
+            },
+            sid: keys.sid,
+        })
+    }
+
+    fn remember_epk(&self, epk: [u8; 32], now: i64) -> bool {
+        let mut epks = self.epks.lock().unwrap();
+        while epks.front().is_some_and(|(_, at)| now - at > EPK_MEMORY_MS) {
+            epks.pop_front();
+        }
+        if epks.iter().any(|(e, _)| *e == epk) {
+            return false;
+        }
+        epks.push_back((epk, now));
+        true
+    }
+
+    fn insert(&self, sid: [u8; SID_LEN], session: Session) {
+        let mut sessions = self.sessions.lock().unwrap();
+        let mut mine: Vec<([u8; SID_LEN], i64)> = sessions
+            .iter()
+            .filter(|(_, s)| s.device_id == session.device_id)
+            .map(|(sid, s)| (*sid, s.created_at))
+            .collect();
+        mine.sort_by_key(|(_, created)| *created);
+        while mine.len() >= MAX_SESSIONS_PER_DEVICE {
+            let (oldest, _) = mine.remove(0);
+            sessions.remove(&oldest);
+        }
+        sessions.insert(sid, session);
+    }
+
+    /// Opens an envelope: session lookup, expiry, decryption, then the replay window.
+    pub fn open(&self, env: &RpcEnvelope, now: i64) -> Result<Opened, RpcError> {
+        if env.v != PROTOCOL_VERSION {
+            return Err(RpcError::UnsupportedVersion);
+        }
+        let sid: [u8; SID_LEN] = crypto::from_b64u(&env.sid)
+            .ok()
+            .and_then(|b| b.try_into().ok())
+            .ok_or(RpcError::Malformed)?;
+        let mut sessions = self.sessions.lock().unwrap();
+        let session = sessions.get_mut(&sid).ok_or(RpcError::UnknownSession)?;
+        if now >= session.expires_at || now - session.last_used > IDLE_TIMEOUT_MS {
+            sessions.remove(&sid);
+            return Err(RpcError::SessionExpired);
+        }
+        let env_hash = crypto::sha256(&[env.nonce.as_bytes(), b".", env.ct.as_bytes()]);
+        if let Some((hash, response)) = session.answered.get(&env.seq)
+            && *hash == env_hash
+        {
+            return Ok(Opened::Duplicate(response.clone()));
+        }
+        let nonce = crypto::from_b64u(&env.nonce).map_err(|_| RpcError::Malformed)?;
+        let ct = crypto::from_b64u(&env.ct).map_err(|_| RpcError::Malformed)?;
+        let plaintext = crypto::open(&session.c2s, &nonce, &ct, &crypto::rpc_aad(false, &sid, env.seq))
+            .map_err(|_| RpcError::AuthFailed)?;
+        if !session.accept(env.seq) {
+            return Err(RpcError::Replayed);
+        }
+        session.last_used = now;
+        Ok(Opened::New(OpenedRpc {
+            sid,
+            seq: env.seq,
+            user_id: session.user_id.clone(),
+            device_id: session.device_id.clone(),
+            plaintext,
+        }))
+    }
+
+    /// Seals the response and remembers it for an exact duplicate of `request`.
+    pub fn seal(&self, request: &RpcEnvelope, opened: &OpenedRpc, response: &InnerResponse) -> Option<RpcEnvelope> {
+        let mut sessions = self.sessions.lock().unwrap();
+        let session = sessions.get_mut(&opened.sid)?;
+        let nonce = random_bytes::<24>().ok()?;
+        let body = serde_json::to_vec(response).ok()?;
+        let ct = crypto::seal(
+            &session.s2c,
+            &nonce,
+            &body,
+            &crypto::rpc_aad(true, &opened.sid, opened.seq),
+        );
+        let envelope = RpcEnvelope {
+            v: PROTOCOL_VERSION,
+            sid: request.sid.clone(),
+            seq: opened.seq,
+            nonce: crypto::b64u(&nonce),
+            ct: crypto::b64u(&ct),
+        };
+        let env_hash = crypto::sha256(&[request.nonce.as_bytes(), b".", request.ct.as_bytes()]);
+        session.answered.insert(opened.seq, (env_hash, envelope.clone()));
+        Some(envelope)
+    }
+
+    /// A4: the first response to a mutating `rid` on this device, if any.
+    pub fn rid_response(&self, device_id: &str, rid: &str, now: i64) -> Option<InnerResponse> {
+        let mut rids = self.rids.lock().unwrap();
+        rids.retain(|_, (at, _)| now - *at <= RID_MEMORY_MS);
+        rids.get(&(device_id.to_owned(), rid.to_owned()))
+            .map(|(_, r)| r.clone())
+    }
+
+    pub fn remember_rid(&self, device_id: &str, rid: &str, response: &InnerResponse, now: i64) {
+        self.rids
+            .lock()
+            .unwrap()
+            .insert((device_id.to_owned(), rid.to_owned()), (now, response.clone()));
+    }
+
+    /// Ends every session of a device (on revoke).
+    pub fn drop_device(&self, device_id: &str) {
+        self.sessions.lock().unwrap().retain(|_, s| s.device_id != device_id);
+    }
+
+    pub fn count_for(&self, device_id: &str) -> usize {
+        self.sessions
+            .lock()
+            .unwrap()
+            .values()
+            .filter(|s| s.device_id == device_id)
+            .count()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn session(device: &str, created_at: i64) -> Session {
+        Session {
+            device_id: device.into(),
+            user_id: "u1".into(),
+            c2s: [1; 32],
+            s2c: [2; 32],
+            created_at,
+            expires_at: created_at + SESSION_TTL_MS,
+            last_used: created_at,
+            highest: None,
+            seen: BTreeSet::new(),
+            answered: HashMap::new(),
+        }
+    }
+
+    #[test]
+    fn replay_window_accepts_out_of_order_and_refuses_repeats_and_stale() {
+        let mut s = session("d", 0);
+        assert!(s.accept(5));
+        assert!(s.accept(3), "out of order within the window");
+        assert!(!s.accept(5), "a repeat");
+        assert!(!s.accept(3), "a repeat");
+        assert!(s.accept(300));
+        assert!(!s.accept(44), "300 - 256: outside the window");
+        assert!(s.accept(45), "the oldest seq still inside the window");
+        assert!(s.seen.iter().all(|seq| *seq >= 45), "old entries are pruned");
+    }
+
+    #[test]
+    fn at_most_four_sessions_per_device_oldest_evicted() {
+        let store = SessionStore::default();
+        for i in 0..5u8 {
+            store.insert([i; SID_LEN], session("d", i as i64));
+        }
+        store.insert([9; SID_LEN], session("other", 0));
+        assert_eq!(store.count_for("d"), MAX_SESSIONS_PER_DEVICE);
+        let sessions = store.sessions.lock().unwrap();
+        assert!(!sessions.contains_key(&[0; SID_LEN]), "the oldest went");
+        assert!(sessions.contains_key(&[4; SID_LEN]));
+        drop(sessions);
+        store.drop_device("d");
+        assert_eq!(store.count_for("d"), 0);
+        assert_eq!(store.count_for("other"), 1);
+    }
+
+    #[test]
+    fn rid_responses_are_kept_per_device_for_ten_minutes() {
+        let store = SessionStore::default();
+        let resp = InnerResponse::ok(serde_json::json!({ "messageId": "m1" }));
+        store.remember_rid("d1", "rid-1", &resp, 0);
+        assert!(store.rid_response("d1", "rid-1", 60_000).is_some());
+        assert!(store.rid_response("d2", "rid-1", 60_000).is_none(), "per device");
+        assert!(
+            store.rid_response("d1", "rid-1", RID_MEMORY_MS + 1).is_none(),
+            "forgotten after 10 min"
+        );
+    }
+
+    #[test]
+    fn epks_are_remembered_for_five_minutes() {
+        let store = SessionStore::default();
+        assert!(store.remember_epk([7; 32], 0));
+        assert!(!store.remember_epk([7; 32], 1000));
+        assert!(store.remember_epk([7; 32], EPK_MEMORY_MS + 1001));
+    }
+}
diff --git a/crates/aionui-mobile/src/settings.rs b/crates/aionui-mobile/src/settings.rs
new file mode 100644
index 00000000..fe2cbc5a
--- /dev/null
+++ b/crates/aionui-mobile/src/settings.rs
@@ -0,0 +1,176 @@
+//! Bridge settings (CONTRACT §3.4, §7). Stored per Core user in the bridge's own database.
+
+use serde::{Deserialize, Serialize};
+
+use crate::error::MobileError;
+
+/// Default LAN port (CONTRACT §7, decision §11 #6).
+pub const DEFAULT_PORT: u16 = 47734;
+const MAX_EXTRA_URLS: usize = 8;
+const MAX_HOST_NAME_CHARS: usize = 64;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct MobileSettings {
+    /// The LAN listener runs only while this is on. Off by default.
+    pub enabled: bool,
+    pub port: u16,
+    /// Shown on the phone; defaults to the PC's name.
+    pub host_name: String,
+    /// Extra base URLs put into the pairing QR, e.g. a Tailscale address.
+    pub extra_urls: Vec<String>,
+    /// Advertise `_aiondx._tcp` while enabled (§11 #6: on by default).
+    pub mdns: bool,
+    /// Task writes from the phone (§11 #4: on by default).
+    pub tasks_write: bool,
+}
+
+impl MobileSettings {
+    pub fn defaults(host_name: impl Into<String>) -> Self {
+        Self {
+            enabled: false,
+            port: DEFAULT_PORT,
+            host_name: host_name.into(),
+            extra_urls: Vec::new(),
+            mdns: true,
+            tasks_write: true,
+        }
+    }
+
+    /// Applies a partial update. On any invalid field nothing changes.
+    pub fn apply(&mut self, patch: &MobileSettingsPatch) -> Result<(), MobileError> {
+        let mut next = self.clone();
+        if let Some(enabled) = patch.enabled {
+            next.enabled = enabled;
+        }
+        if let Some(port) = patch.port {
+            if port < 1024 {
+                return Err(MobileError::InvalidSetting("port must be 1024 or higher".into()));
+            }
+            next.port = port;
+        }
+        if let Some(name) = &patch.host_name {
+            let name = name.trim();
+            if name.is_empty() || name.chars().count() > MAX_HOST_NAME_CHARS {
+                return Err(MobileError::InvalidSetting(format!(
+                    "hostName must be 1 to {MAX_HOST_NAME_CHARS} characters"
+                )));
+            }
+            next.host_name = name.to_owned();
+        }
+        if let Some(urls) = &patch.extra_urls {
+            if urls.len() > MAX_EXTRA_URLS {
+                return Err(MobileError::InvalidSetting(format!(
+                    "at most {MAX_EXTRA_URLS} extraUrls"
+                )));
+            }
+            next.extra_urls = urls
+                .iter()
+                .map(|url| validate_base_url(url))
+                .collect::<Result<_, _>>()?;
+        }
+        if let Some(mdns) = patch.mdns {
+            next.mdns = mdns;
+        }
+        if let Some(tasks_write) = patch.tasks_write {
+            next.tasks_write = tasks_write;
+        }
+        *self = next;
+        Ok(())
+    }
+}
+
+/// A partial update from `PUT /api/mobile/admin/settings`.
+#[derive(Debug, Clone, Default, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct MobileSettingsPatch {
+    pub enabled: Option<bool>,
+    pub port: Option<u16>,
+    pub host_name: Option<String>,
+    pub extra_urls: Option<Vec<String>>,
+    pub mdns: Option<bool>,
+    pub tasks_write: Option<bool>,
+}
+
+/// `http://host[:port]` or `https://...`, with no path, query or credentials.
+fn validate_base_url(raw: &str) -> Result<String, MobileError> {
+    let url = raw.trim().trim_end_matches('/');
+    let invalid = || MobileError::InvalidSetting(format!("extraUrls entry is not an http(s) base URL: {raw}"));
+    let rest = url
+        .strip_prefix("http://")
+        .or_else(|| url.strip_prefix("https://"))
+        .ok_or_else(invalid)?;
+    if rest.is_empty() || rest.contains(['/', '?', '#', '@', ' ']) {
+        return Err(invalid());
+    }
+    Ok(url.to_owned())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn defaults_follow_the_decisions_record() {
+        let s = MobileSettings::defaults("PC");
+        assert!(!s.enabled, "the bridge is off until the user enables it");
+        assert_eq!(s.port, 47734);
+        assert!(s.mdns);
+        assert!(s.tasks_write);
+    }
+
+    #[test]
+    fn patch_applies_only_given_fields() {
+        let mut s = MobileSettings::defaults("PC");
+        s.apply(&MobileSettingsPatch {
+            enabled: Some(true),
+            extra_urls: Some(vec!["http://100.64.1.2:47734/".into()]),
+            ..Default::default()
+        })
+        .unwrap();
+        assert!(s.enabled);
+        assert_eq!(s.extra_urls, vec!["http://100.64.1.2:47734".to_string()]);
+        assert_eq!(s.port, 47734);
+    }
+
+    #[test]
+    fn invalid_values_are_rejected_and_leave_settings_unchanged() {
+        let mut s = MobileSettings::defaults("PC");
+        let before = s.clone();
+        for patch in [
+            MobileSettingsPatch {
+                port: Some(80),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                host_name: Some("  ".into()),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                extra_urls: Some(vec!["ftp://x".into()]),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                extra_urls: Some(vec!["http://x/path".into()]),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                extra_urls: Some(vec!["http://u:p@x".into()]),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                enabled: Some(true),
+                port: Some(1),
+                ..Default::default()
+            },
+        ] {
+            assert!(matches!(s.apply(&patch), Err(MobileError::InvalidSetting(_))));
+            assert_eq!(s, before);
+        }
+    }
+
+    #[test]
+    fn unknown_fields_are_rejected() {
+        assert!(serde_json::from_str::<MobileSettingsPatch>(r#"{"enabled":true,"bogus":1}"#).is_err());
+    }
+}
diff --git a/crates/aionui-mobile/src/shape.rs b/crates/aionui-mobile/src/shape.rs
new file mode 100644
index 00000000..f16132f0
--- /dev/null
+++ b/crates/aionui-mobile/src/shape.rs
@@ -0,0 +1,600 @@
+//! AionCore's JSON → the contract's JSON (CONTRACT §6.3, §6.4, §6.7, §6.8).
+//! Pure functions over the *serialized* AionCore types, so they depend only on
+//! the wire forms verified in AionCore v0.2.2, not on Rust enum internals.
+
+use std::collections::HashMap;
+
+use serde_json::{Map, Value, json};
+
+fn s<'a>(v: &'a Value, key: &str) -> Option<&'a str> {
+    v.get(key).and_then(Value::as_str).filter(|s| !s.is_empty())
+}
+
+// ---- Roster -----------------------------------------------------------------------------------
+
+/// conversation id → (slot id, display name), for resolving teammate senders.
+pub fn roster_index(team: &Value) -> HashMap<String, (String, String)> {
+    team["assistants"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|a| {
+            Some((
+                s(a, "conversation_id")?.to_owned(),
+                (s(a, "slot_id")?.to_owned(), s(a, "name")?.to_owned()),
+            ))
+        })
+        .collect()
+}
+
+/// `runtime` (§6.3) from AionCore's `context_reset.availability`, the only per-agent runtime view in GET team.
+fn runtime_of(agent: &Value) -> &'static str {
+    match s(&agent["context_reset"], "availability") {
+        Some("dormant") => "dormant",
+        Some("initializing") => "pending",
+        Some("failed") => "failed",
+        _ => "ready",
+    }
+}
+
+/// Live per-agent signals the facade adds on top of AionCore's views.
+#[derive(Debug, Clone, Default)]
+pub struct AgentExtras {
+    pub last_message: Option<Value>,
+    pub unread: u32,
+    pub your_turn: bool,
+    /// A pending approval is a question (needs_answer) rather than a permission.
+    pub question_pending: bool,
+    pub shutdown: Option<Value>,
+}
+
+pub fn attention(
+    pending_approvals: u64,
+    question_pending: bool,
+    runtime: &str,
+    blocked: Option<&str>,
+    your_turn: bool,
+) -> &'static str {
+    if pending_approvals > 0 && question_pending {
+        "needs_answer"
+    } else if pending_approvals > 0 {
+        "needs_approval"
+    } else if runtime == "failed" || blocked == Some("runtime_failed") {
+        "error"
+    } else if your_turn {
+        "your_turn"
+    } else {
+        "none"
+    }
+}
+
+/// One `Agent` (§6.3).
+pub fn agent(agent: &Value, slot_work: Option<&Value>, tasks: &[Value], extras: &AgentExtras) -> Value {
+    let slot_id = s(agent, "slot_id").unwrap_or_default();
+    let runtime = runtime_of(agent);
+    let work = slot_work.cloned().unwrap_or(Value::Null);
+    let blocked = s(&work, "blocked_reason");
+    let pending = agent["pending_confirmations"].as_u64().unwrap_or(0);
+    let turn = match s(&work, "active_turn_id") {
+        Some(turn_id) => json!({
+            "turnId": turn_id,
+            "startedAt": work["active_turn_started_at_ms"],
+            "elapsedMs": work["active_turn_elapsed_ms"],
+            "slow": work["active_turn_slow"].as_bool().unwrap_or(false),
+            "slowThresholdMs": work["active_turn_slow_threshold_ms"],
+        }),
+        None => Value::Null,
+    };
+    let mine: Vec<&Value> = tasks.iter().filter(|t| s(t, "owner") == Some(slot_id)).collect();
+    let current_task = mine
+        .iter()
+        .filter(|t| s(t, "status") == Some("in_progress"))
+        .max_by_key(|t| t["updated_at"].as_i64().unwrap_or(0))
+        .map(|t| json!({ "taskId": t["id"], "subject": t["subject"] }))
+        .unwrap_or(Value::Null);
+    let open_tasks = mine
+        .iter()
+        .filter(|t| matches!(s(t, "status"), Some("pending") | Some("in_progress")))
+        .count();
+    let attention = attention(pending, extras.question_pending, runtime, blocked, extras.your_turn);
+    let last_activity = extras
+        .last_message
+        .as_ref()
+        .and_then(|m| m["createdAt"].as_i64())
+        .or_else(|| work["active_turn_started_at_ms"].as_i64())
+        .unwrap_or(0);
+    json!({
+        "slotId": slot_id,
+        "name": agent["name"],
+        "role": if s(agent, "role") == Some("lead") { "lead" } else { "teammate" },
+        "conversationId": agent["conversation_id"],
+        "backend": agent["backend"],
+        "model": agent["model"],
+        "icon": agent.get("icon").cloned().unwrap_or(Value::Null),
+        "state": s(&work, "state").unwrap_or("idle"),
+        "blockedReason": blocked,
+        "runtime": runtime,
+        "turn": turn,
+        "queue": {
+            "foreground": work["queued_foreground_count"].as_u64().unwrap_or(0),
+            "background": work["queued_background_count"].as_u64().unwrap_or(0),
+            "foregroundMessageIds": work.get("queued_foreground_message_ids").cloned().unwrap_or_else(|| json!([])),
+        },
+        "pendingApprovals": pending,
+        "attention": attention,
+        "waitingOnUser": matches!(attention, "needs_answer" | "needs_approval"),
+        "unread": extras.unread.min(99),
+        "shutdown": extras.shutdown.clone().unwrap_or(Value::Null),
+        "currentTask": current_task,
+        "openTaskCount": open_tasks,
+        "lastMessage": extras.last_message.clone().unwrap_or(Value::Null),
+        "lastActivityAt": last_activity,
+    })
+}
+
+/// `RunState` (§6.3). `extras` is keyed by slot id.
+pub fn run_state(team: &Value, run: &Value, tasks: &[Value], extras: &HashMap<String, AgentExtras>) -> Value {
+    let work_by_slot: HashMap<&str, &Value> = run["slot_work"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(|w| Some((s(w, "slot_id")?, w)))
+        .collect();
+    let mut agents: Vec<&Value> = team["assistants"].as_array().into_iter().flatten().collect();
+    agents.sort_by_key(|a| if s(a, "role") == Some("lead") { 0 } else { 1 });
+    let empty = AgentExtras::default();
+    let agents: Vec<Value> = agents
+        .into_iter()
+        .map(|a| {
+            let slot = s(a, "slot_id").unwrap_or_default();
+            agent(
+                a,
+                work_by_slot.get(slot).copied(),
+                tasks,
+                extras.get(slot).unwrap_or(&empty),
+            )
+        })
+        .collect();
+    let active_run = match &run["active_run"] {
+        Value::Object(r) => json!({
+            "runId": r.get("team_run_id"),
+            "status": r.get("status"),
+            "targetSlotId": r.get("target_slot_id"),
+            "source": r.get("source"),
+        }),
+        _ => Value::Null,
+    };
+    let session_status = if run["session_generation"].is_null() && work_by_slot.is_empty() {
+        "none"
+    } else {
+        "ready"
+    };
+    json!({
+        "teamId": team["id"],
+        "sessionStatus": session_status,
+        "activeRun": active_run,
+        "agents": agents,
+    })
+}
+
+/// `TeamSummary` (§6.3), from the shaped agents of the same team.
+pub fn team_summary(team: &Value, agents: &[Value]) -> Value {
+    let rank = |a: &str| match a {
+        "needs_answer" => 4,
+        "needs_approval" => 3,
+        "error" => 2,
+        "your_turn" => 1,
+        _ => 0,
+    };
+    let attention = agents
+        .iter()
+        .filter_map(|a| a["attention"].as_str())
+        .max_by_key(|a| rank(a))
+        .unwrap_or("none");
+    let unread: u64 = agents.iter().filter_map(|a| a["unread"].as_u64()).sum();
+    json!({
+        "teamId": team["id"],
+        "name": team["name"],
+        "workspace": team["workspace"],
+        "leadSlotId": team.get("leader_assistant_id").cloned().unwrap_or(Value::Null),
+        "agentCount": team["assistants"].as_array().map_or(0, Vec::len),
+        "attention": attention,
+        "waitingOnUser": agents.iter().any(|a| a["waitingOnUser"] == true),
+        "unread": unread.min(99),
+        "updatedAt": team["updated_at"],
+    })
+}
+
+// ---- Tasks and activity -----------------------------------------------------------------------
+
+/// `Task` (§6.7). `names` maps slot ids to display names.
+pub fn task(t: &Value, names: &HashMap<String, String>, assignment: Option<Value>) -> Value {
+    let owner = s(t, "owner");
+    let owner_name = match owner {
+        Some("user") => Some("You".to_owned()),
+        Some(slot) => names.get(slot).cloned(),
+        None => None,
+    };
+    json!({
+        "taskId": t["id"],
+        "teamId": t["team_id"],
+        "subject": t["subject"],
+        "description": t.get("description").cloned().unwrap_or(Value::Null),
+        "status": t["status"],
+        "owner": owner,
+        "ownerName": owner_name,
+        "blockedBy": t.get("blocked_by").cloned().unwrap_or_else(|| json!([])),
+        "blocks": t.get("blocks").cloned().unwrap_or_else(|| json!([])),
+        "assignment": assignment.unwrap_or(Value::Null),
+        "createdAt": t["created_at"],
+        "updatedAt": t["updated_at"],
+    })
+}
+
+/// `taskId` from a "📋 Task assigned to you (#<id>): ..." notice.
+pub fn task_assigned_id(text: &str) -> Option<String> {
+    let rest = text.trim_start().strip_prefix("📋 Task assigned to you (#")?;
+    let end = rest.find(')')?;
+    let id = &rest[..end];
+    (!id.is_empty()).then(|| id.to_owned())
+}
+
+fn party(id: &str, names: &HashMap<String, String>) -> Value {
+    match id {
+        "user" => json!({ "slotId": null, "name": "You", "isUser": true }),
+        "*" => json!({ "slotId": null, "name": "everyone", "isUser": false }),
+        slot => {
+            json!({ "slotId": slot, "name": names.get(slot).cloned().unwrap_or_else(|| slot.to_owned()), "isUser": false })
+        }
+    }
+}
+
+/// `Activity` (§6.8).
+pub fn activity(item: &Value, names: &HashMap<String, String>) -> Value {
+    if let Some(m) = item.get("message").filter(|m| m.is_object()) {
+        let content = s(m, "content").unwrap_or_default();
+        let mut message = json!({
+            "messageId": m["id"],
+            "from": party(s(m, "from_agent_id").unwrap_or_default(), names),
+            "to": party(s(m, "to_agent_id").unwrap_or_default(), names),
+            "msgType": m["msg_type"],
+            "content": content,
+            "summary": m.get("summary").cloned().unwrap_or(Value::Null),
+            "read": m["read"],
+        });
+        if let Some(task_id) = task_assigned_id(content) {
+            message["notice"] = json!({ "kind": "task_assigned", "taskId": task_id });
+        }
+        json!({ "kind": "message", "activityId": item["id"], "createdAt": item["created_at"], "message": message })
+    } else {
+        let task = task(&item["task"], names, None);
+        json!({ "kind": "task", "activityId": item["id"], "createdAt": item["created_at"], "task": task })
+    }
+}
+
+// ---- Conversations and messages ---------------------------------------------------------------
+
+/// `role` and `sender` (§6.4) from an AionCore message row.
+fn role_and_sender(m: &Value, roster: &HashMap<String, (String, String)>, agent_name: &str) -> (&'static str, Value) {
+    let content = &m["content"];
+    match s(m, "position") {
+        Some("right") => ("user", json!({ "kind": "user" })),
+        Some("left") if content["teammate_message"] == true => {
+            if s(content, "sender_name") == Some("team_system") {
+                ("system", json!({ "kind": "team_system" }))
+            } else {
+                let conv = s(content, "sender_conversation_id");
+                let slot = conv.and_then(|c| roster.get(c)).map(|(slot, _)| slot.clone());
+                (
+                    "teammate",
+                    json!({ "kind": "teammate", "name": content["sender_name"], "slotId": slot, "conversationId": conv }),
+                )
+            }
+        }
+        Some("left") => ("agent", json!({ "kind": "agent", "name": agent_name })),
+        _ => ("system", json!({ "kind": "app" })),
+    }
+}
+
+fn message_type(t: &str) -> &'static str {
+    match t {
+        "text" => "text",
+        "thinking" => "thinking",
+        "tool_call" | "acp_tool_call" | "tool_group" => "tool_call",
+        "plan" => "plan",
+        "tips" => "tips",
+        "agent_status" => "agent_status",
+        _ => "other",
+    }
+}
+
+fn message_status(st: Option<&str>) -> &'static str {
+    match st {
+        Some("work") => "streaming",
+        Some("error") => "error",
+        Some("pending") => "pending",
+        _ => "done",
+    }
+}
+
+/// One `Message` (§6.4), or `None` for hidden rows.
+pub fn message(m: &Value, roster: &HashMap<String, (String, String)>, agent_name: &str) -> Option<Value> {
+    if m["hidden"] == true {
+        return None;
+    }
+    let (role, sender) = role_and_sender(m, roster, agent_name);
+    let raw_type = s(m, "type").unwrap_or("other");
+    let kind = message_type(raw_type);
+    let status = message_status(s(m, "status"));
+    let content = &m["content"];
+    let mut out = Map::new();
+    out.insert("messageId".into(), m["id"].clone());
+    out.insert("conversationId".into(), m["conversation_id"].clone());
+    if let Some(turn) = s(m, "backend_turn_id") {
+        out.insert("turnId".into(), json!(turn));
+    }
+    out.insert("role".into(), json!(role));
+    out.insert("sender".into(), sender);
+    out.insert("type".into(), json!(kind));
+    out.insert("status".into(), json!(status));
+
+    let mut text = content.get("content").and_then(Value::as_str).map(str::to_owned);
+    if s(content, "sender_name") == Some("team_system")
+        && let Some(t) = &text
+        && serde_json::from_str::<Value>(t)
+            .ok()
+            .is_some_and(|v| v["kind"] == "context_reset")
+    {
+        out.insert("notice".into(), json!({ "kind": "context_reset" }));
+        text = Some("Context cleared".into());
+    }
+    if let Some(t) = &text
+        && let Some(task_id) = task_assigned_id(t)
+    {
+        out.insert("notice".into(), json!({ "kind": "task_assigned", "taskId": task_id }));
+    }
+    if matches!(kind, "text" | "thinking" | "tips")
+        && let Some(t) = text
+    {
+        out.insert("text".into(), json!(t));
+    }
+    if kind == "tool_call" {
+        let name = s(content, "name")
+            .or_else(|| s(content, "title"))
+            .or_else(|| s(content, "toolName"))
+            .unwrap_or("tool");
+        out.insert(
+            "tool".into(),
+            json!({ "name": name, "title": content.get("title"), "status": content.get("status") }),
+        );
+    }
+    if status == "error" {
+        let source = if s(content, "source") == Some("send_failed") {
+            "send_failed"
+        } else {
+            "agent"
+        };
+        let mut error = json!({
+            "source": source,
+            "code": content.get("code").cloned().unwrap_or(Value::Null),
+            "message": s(content, "content").unwrap_or("Error"),
+        });
+        if source == "send_failed" {
+            error["messageId"] = Value::Null; // linked by the change journal (phase 4)
+        }
+        out.insert("error".into(), error);
+    }
+    out.insert("raw".into(), content.clone());
+    out.insert("createdAt".into(), m["created_at"].clone());
+    Some(Value::Object(out))
+}
+
+/// `LastMessage` (§6.3) from a shaped message.
+pub fn last_message(msg: &Value) -> Value {
+    let name = msg["sender"].get("name").cloned().unwrap_or(Value::Null);
+    let text = match msg["type"].as_str() {
+        Some("tool_call") => format!("Used {}", msg["tool"]["name"].as_str().unwrap_or("a tool")),
+        _ => msg["text"].as_str().unwrap_or_default().chars().take(200).collect(),
+    };
+    json!({ "messageId": msg["messageId"], "role": msg["role"], "senderName": name, "text": text, "createdAt": msg["createdAt"] })
+}
+
+/// `Conversation` (§6.4).
+pub fn conversation(c: &Value, team_name_of_slot: Option<(&str, &str)>, extras: &AgentExtras) -> Value {
+    let extra = &c["extra"];
+    let team_id = s(extra, "teamId");
+    let runtime = &c["runtime"];
+    let state = s(runtime, "state").unwrap_or("idle");
+    let pending = runtime["pending_confirmations"].as_u64().unwrap_or(0);
+    let attention = attention(pending, extras.question_pending, "ready", None, extras.your_turn);
+    let mut out = json!({
+        "conversationId": c["id"],
+        "name": c["name"],
+        "kind": if team_id.is_some() { "team_member" } else { "solo" },
+        "backend": s(extra, "backend").map(Value::from).unwrap_or_else(|| c["type"].clone()),
+        "state": state,
+        "attention": attention,
+        "waitingOnUser": matches!(attention, "needs_answer" | "needs_approval"),
+        "unread": extras.unread.min(99),
+        "lastMessage": extras.last_message.clone().unwrap_or(Value::Null),
+        "updatedAt": c["modified_at"],
+    });
+    if let Some(t) = team_id {
+        out["teamId"] = json!(t);
+        out["slotId"] = json!(team_name_of_slot.map(|(slot, _)| slot).or_else(|| s(extra, "slot_id")));
+    }
+    if let Some(model) = c["model"]
+        .get("use_model")
+        .and_then(Value::as_str)
+        .or_else(|| s(extra, "current_model_id"))
+    {
+        out["model"] = json!(model);
+    }
+    if let Some(ws) = s(extra, "workspace") {
+        out["workspace"] = json!(ws);
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn team() -> Value {
+        json!({
+            "id": "t1", "name": "Dev", "workspace": "C:/w", "leader_assistant_id": "lead", "updated_at": 5,
+            "assistants": [
+                { "slot_id": "s2", "name": "Bob", "role": "teammate", "conversation_id": "c2", "backend": "claude",
+                  "model": "m", "pending_confirmations": 1, "context_reset": { "supported": true, "availability": "ready" } },
+                { "slot_id": "lead", "name": "Ann", "role": "lead", "conversation_id": "c1", "backend": "claude",
+                  "model": "m", "pending_confirmations": 0, "context_reset": { "supported": true, "availability": "failed" } },
+            ]
+        })
+    }
+
+    #[test]
+    fn run_state_puts_the_lead_first_and_maps_every_field() {
+        let run = json!({
+            "session_generation": "g1", "active_run": null,
+            "slot_work": [ { "slot_id": "s2", "state": "running", "queued_foreground_count": 2, "queued_background_count": 1,
+                "active_turn_id": "turn_1", "active_turn_started_at_ms": 100, "active_turn_elapsed_ms": 50,
+                "active_turn_slow": false, "active_turn_slow_threshold_ms": 600000, "blocked_reason": null } ]
+        });
+        let tasks = vec![
+            json!({ "id": "k1", "subject": "A", "status": "in_progress", "owner": "s2", "updated_at": 3 }),
+            json!({ "id": "k2", "subject": "B", "status": "pending", "owner": "s2", "updated_at": 9 }),
+        ];
+        let rs = run_state(&team(), &run, &tasks, &HashMap::new());
+        assert_eq!(rs["sessionStatus"], "ready");
+        let agents = rs["agents"].as_array().unwrap();
+        assert_eq!(agents[0]["slotId"], "lead");
+        assert_eq!(agents[0]["runtime"], "failed");
+        assert_eq!(agents[0]["attention"], "error");
+        let bob = &agents[1];
+        assert_eq!(bob["state"], "running");
+        assert_eq!(bob["turn"]["turnId"], "turn_1");
+        assert_eq!(bob["queue"]["foreground"], 2);
+        assert_eq!(bob["attention"], "needs_approval");
+        assert_eq!(bob["waitingOnUser"], true);
+        assert_eq!(bob["currentTask"], json!({ "taskId": "k1", "subject": "A" }));
+        assert_eq!(bob["openTaskCount"], 2);
+        let summary = team_summary(&team(), agents);
+        assert_eq!(summary["attention"], "needs_approval");
+        assert_eq!(summary["waitingOnUser"], true);
+        assert_eq!(summary["leadSlotId"], "lead");
+        assert_eq!(summary["agentCount"], 2);
+    }
+
+    #[test]
+    fn no_session_is_session_status_none_and_idle_agents() {
+        let run = json!({ "session_generation": null, "active_run": null, "slot_work": [] });
+        let rs = run_state(&team(), &run, &[], &HashMap::new());
+        assert_eq!(rs["sessionStatus"], "none");
+        assert_eq!(rs["agents"][1]["state"], "idle");
+        assert_eq!(rs["agents"][1]["turn"], Value::Null);
+    }
+
+    #[test]
+    fn messages_map_roles_senders_notices_and_errors() {
+        let roster = roster_index(&team());
+        let user = json!({ "id": "m1", "conversation_id": "c2", "type": "text", "position": "right", "status": "pending",
+                           "hidden": false, "created_at": 1, "content": { "content": "hi" } });
+        let u = message(&user, &roster, "Bob").unwrap();
+        assert_eq!(
+            (u["role"].as_str(), u["status"].as_str(), u["text"].as_str()),
+            (Some("user"), Some("pending"), Some("hi"))
+        );
+
+        let notice = json!({ "id": "m2", "conversation_id": "c2", "type": "text", "position": "left", "status": "finish",
+            "hidden": false, "created_at": 2,
+            "content": { "content": "📋 Task assigned to you (#k1): A", "teammate_message": true, "sender_name": "Ann", "sender_conversation_id": "c1" } });
+        let n = message(&notice, &roster, "Bob").unwrap();
+        assert_eq!(n["role"], "teammate");
+        assert_eq!(
+            n["sender"],
+            json!({ "kind": "teammate", "name": "Ann", "slotId": "lead", "conversationId": "c1" })
+        );
+        assert_eq!(n["notice"], json!({ "kind": "task_assigned", "taskId": "k1" }));
+
+        let reset = json!({ "id": "m3", "conversation_id": "c2", "type": "text", "position": "left", "status": "finish",
+            "hidden": false, "created_at": 3,
+            "content": { "content": "{\"kind\":\"context_reset\",\"member_name\":\"Bob\"}", "teammate_message": true, "sender_name": "team_system" } });
+        let r = message(&reset, &roster, "Bob").unwrap();
+        assert_eq!(
+            (r["role"].as_str(), r["text"].as_str()),
+            (Some("system"), Some("Context cleared"))
+        );
+        assert_eq!(r["notice"]["kind"], "context_reset");
+
+        let failed = json!({ "id": "m4", "conversation_id": "c2", "type": "tips", "position": "center", "status": "error",
+            "hidden": false, "created_at": 4, "content": { "content": "CLI missing", "type": "error", "source": "send_failed", "code": "X" } });
+        let f = message(&failed, &roster, "Bob").unwrap();
+        assert_eq!(f["role"], "system");
+        assert_eq!(
+            f["error"],
+            json!({ "source": "send_failed", "code": "X", "message": "CLI missing", "messageId": null })
+        );
+
+        let agent_err = json!({ "id": "m5", "conversation_id": "c2", "type": "tips", "position": "left", "status": "error",
+            "hidden": false, "created_at": 5, "content": { "content": "boom", "type": "error" } });
+        assert_eq!(message(&agent_err, &roster, "Bob").unwrap()["error"]["source"], "agent");
+
+        let streaming = json!({ "id": "m6", "conversation_id": "c2", "type": "text", "position": "left", "status": "work",
+            "hidden": false, "created_at": 6, "content": { "content": "partial" } });
+        let st = message(&streaming, &roster, "Bob").unwrap();
+        assert_eq!(
+            (st["role"].as_str(), st["status"].as_str()),
+            (Some("agent"), Some("streaming"))
+        );
+        assert_eq!(last_message(&st)["text"], "partial");
+
+        let hidden = json!({ "id": "m7", "hidden": true });
+        assert!(message(&hidden, &roster, "Bob").is_none());
+    }
+
+    #[test]
+    fn task_assigned_prefix_parsing() {
+        assert_eq!(
+            task_assigned_id("📋 Task assigned to you (#01ab): Do it"),
+            Some("01ab".into())
+        );
+        assert_eq!(task_assigned_id("Task assigned to you (#01ab)"), None);
+        assert_eq!(task_assigned_id("📋 Task assigned to you (#)"), None);
+    }
+
+    #[test]
+    fn conversations_know_solo_from_team_member() {
+        let solo = json!({ "id": "c9", "name": "Chat", "type": "acp", "modified_at": 7, "model": null,
+            "runtime": { "state": "waiting_confirmation", "pending_confirmations": 1 }, "extra": { "backend": "claude", "workspace": "C:/x" } });
+        let c = conversation(&solo, None, &AgentExtras::default());
+        assert_eq!(c["kind"], "solo");
+        assert_eq!(c["state"], "waiting_confirmation");
+        assert_eq!(c["attention"], "needs_approval");
+        assert_eq!(c["workspace"], "C:/x");
+        assert!(c.get("teamId").is_none());
+        let member = json!({ "id": "c2", "name": "Bob", "type": "acp", "modified_at": 7, "extra": { "teamId": "t1", "slot_id": "s2" } });
+        let m = conversation(&member, None, &AgentExtras::default());
+        assert_eq!(
+            (m["kind"].as_str(), m["teamId"].as_str(), m["slotId"].as_str()),
+            (Some("team_member"), Some("t1"), Some("s2"))
+        );
+    }
+
+    #[test]
+    fn activity_maps_parties_and_notices() {
+        let names: HashMap<String, String> = [("s2".to_owned(), "Bob".to_owned())].into();
+        let item = json!({ "kind": "message", "id": "a1", "created_at": 9, "message": {
+            "id": "mb1", "from_agent_id": "user", "to_agent_id": "s2", "msg_type": "message",
+            "content": "📋 Task assigned to you (#k9): X", "summary": null, "read": false } });
+        let a = activity(&item, &names);
+        assert_eq!(
+            a["message"]["from"],
+            json!({ "slotId": null, "name": "You", "isUser": true })
+        );
+        assert_eq!(a["message"]["to"]["name"], "Bob");
+        assert_eq!(a["message"]["notice"]["taskId"], "k9");
+        let t = json!({ "kind": "task", "id": "a2", "created_at": 9, "task": { "id": "k1", "team_id": "t1", "subject": "S",
+            "status": "pending", "owner": "user", "blocked_by": [], "blocks": [], "created_at": 1, "updated_at": 2 } });
+        assert_eq!(activity(&t, &names)["task"]["ownerName"], "You");
+    }
+}
diff --git a/crates/aionui-mobile/src/store.rs b/crates/aionui-mobile/src/store.rs
