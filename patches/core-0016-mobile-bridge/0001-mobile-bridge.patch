--- /dev/null
+++ b/crates/aionui-mobile/src/approvals.rs
@@ -0,0 +1,1715 @@
+//! The approvals tracker and the per-backend answer mapping behind `/v1/approvals` (CONTRACT §6.5,
+//! PHASE4-CORE-SPEC §2).
+//!
+//! Pure: no AionCore calls. The bridge feeds stream frames, removals, turn ends and recovery listings in, and turns
+//! a phone's answer into exactly one AionCore call with `map_answer`.
+//!
+//! Kind: an approval is a "question" only when it can be answered through the free-text answer channel, which is
+//! Claude's AskUserQuestion (ClaudeSession). Any other approval that carries questions, such as an ACP agent's
+//! AskUserQuestion sent through the permission channel, is a "permission": its options stay, its questions are
+//! attached for display only, and it is answered by picking one of those options (lead's decision, 2026-11-07).
+
+use std::collections::{HashMap, HashSet};
+use std::sync::Mutex;
+
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+
+use crate::crypto::b64u;
+
+/// The longest refusal message or free-text answer accepted, in characters.
+const MAX_TEXT: usize = 2000;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum BackendKind {
+    Acp,
+    ClaudeSession,
+    CodexSession,
+    Aionrs,
+    Other,
+}
+
+/// Where an approval lives (filled from AionCore's conversation and team data).
+#[derive(Debug, Clone, PartialEq)]
+pub struct ApprovalOrigin {
+    pub user_id: String,
+    pub conversation_id: String,
+    pub team_id: Option<String>,
+    pub slot_id: Option<String>,
+    pub agent_name: String,
+    pub backend: BackendKind,
+}
+
+/// A `message.stream` frame whose `type` is "acp_permission", "permission" or "ask".
+#[derive(Debug, Clone)]
+pub struct PermissionFrame {
+    pub origin: ApprovalOrigin,
+    pub frame_type: String,
+    pub msg_id: String,
+    pub data: Value,
+    pub at_ms: i64,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum ApprovalKind {
+    Permission,
+    Question,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum OptionKind {
+    AllowOnce,
+    AllowAlways,
+    RejectOnce,
+    RejectAlways,
+    Other,
+}
+
+impl OptionKind {
+    fn is_reject(self) -> bool {
+        matches!(self, Self::RejectOnce | Self::RejectAlways)
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum AlwaysScope {
+    Rule,
+    BackendDefined,
+    SameAsOnce,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ApprovalOption {
+    pub option_id: String,
+    pub label: String,
+    pub kind: OptionKind,
+    pub rule: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub always_scope: Option<AlwaysScope>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Question {
+    pub question: String,
+    pub header: Option<String>,
+    pub multi_select: bool,
+    pub options: Vec<QuestionOption>,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize)]
+pub struct QuestionOption {
+    pub label: String,
+    pub description: Option<String>,
+}
+
+/// CONTRACT §6.5 `Approval`. `questions` is also present (display only) on a permission that carries questions;
+/// that is an additive change to the contract (rev 4.4).
+#[derive(Debug, Clone, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Approval {
+    pub approval_id: String,
+    pub kind: ApprovalKind,
+    pub conversation_id: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub team_id: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub slot_id: Option<String>,
+    pub agent_name: String,
+    pub title: Option<String>,
+    pub description: String,
+    pub command_type: Option<String>,
+    pub tool_name: Option<String>,
+    pub input: Option<Value>,
+    pub input_summary: Option<String>,
+    pub options: Vec<ApprovalOption>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub questions: Option<Vec<Question>>,
+    pub free_text: bool,
+    pub first_seen_at: i64,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct TrackedApproval {
+    pub approval: Approval,
+    pub origin: ApprovalOrigin,
+    pub call_id: String,
+    pub confirmation_id: String,
+    pub msg_id: String,
+    /// Each option's raw `value` as AionCore sent it, parallel to `approval.options`. A confirmation-form option's
+    /// value is what goes back for an option of kind `other`.
+    pub option_values: Vec<Value>,
+}
+
+// ---------------------------------------------------------------- reading frames
+
+/// What one frame or listed confirmation says, before it becomes an `Approval`.
+struct Parsed {
+    call_id: String,
+    confirmation_id: String,
+    title: Option<String>,
+    description: String,
+    command_type: Option<String>,
+    tool_name: Option<String>,
+    input: Option<Value>,
+    options: Vec<(String, String, OptionKind, Value)>, // option id, label, kind, raw value
+    questions: Vec<Question>,
+    from_ask: bool,
+}
+
+fn str_of(v: &Value, key: &str) -> Option<String> {
+    v.get(key).and_then(Value::as_str).map(ToOwned::to_owned)
+}
+
+/// AionCore's i18n keys are replaced with English; anything else is shown as sent.
+fn display_label(label: &str) -> String {
+    match label {
+        "messages.confirmation.yesAllowOnce" => "Allow once".to_owned(),
+        "messages.confirmation.yesAllowAlways" => "Always allow".to_owned(),
+        "messages.confirmation.no" => "Deny".to_owned(),
+        other => other.to_owned(),
+    }
+}
+
+/// A confirmation-form option's kind, from its value.
+fn kind_from_value(value: &Value) -> OptionKind {
+    match value.as_str() {
+        Some("allow" | "proceed_once") => OptionKind::AllowOnce,
+        Some("allow_always" | "proceed_always") => OptionKind::AllowAlways,
+        Some("reject" | "cancel") => OptionKind::RejectOnce,
+        _ => OptionKind::Other,
+    }
+}
+
+fn kind_from_acp(kind: Option<&str>) -> OptionKind {
+    match kind {
+        Some("allow_once") => OptionKind::AllowOnce,
+        Some("allow_always") => OptionKind::AllowAlways,
+        Some("reject_once") => OptionKind::RejectOnce,
+        Some("reject_always") => OptionKind::RejectAlways,
+        _ => OptionKind::Other,
+    }
+}
+
+/// A value's text form, used as an option id: a string as is, anything else as its JSON.
+fn value_id(value: &Value) -> String {
+    match value {
+        Value::String(s) => s.clone(),
+        other => other.to_string(),
+    }
+}
+
+/// Normalizes Claude's AskUserQuestion shape; unknown fields are dropped, and an entry with no question text is
+/// skipped.
+fn normalize_questions(raw: Option<&Value>) -> Vec<Question> {
+    let Some(items) = raw.and_then(Value::as_array) else {
+        return Vec::new();
+    };
+    items
+        .iter()
+        .filter_map(|q| {
+            let question = q.get("question").and_then(Value::as_str)?.to_owned();
+            let options = q
+                .get("options")
+                .and_then(Value::as_array)
+                .map(|opts| {
+                    opts.iter()
+                        .filter_map(|o| {
+                            Some(QuestionOption {
+                                label: o.get("label").and_then(Value::as_str)?.to_owned(),
+                                description: str_of(o, "description"),
+                            })
+                        })
+                        .collect()
+                })
+                .unwrap_or_default();
+            Some(Question {
+                question,
+                header: str_of(q, "header"),
+                multi_select: q.get("multiSelect").and_then(Value::as_bool).unwrap_or(false),
+                options,
+            })
+        })
+        .collect()
+}
+
+/// The request form's questions, lifted from the tool input exactly as AionCore's `to_confirmation` does: only when
+/// it is a non-empty array whose every item has a question and options.
+fn request_questions(raw_input: Option<&Value>) -> Vec<Question> {
+    let qs = raw_input.and_then(|r| r.get("questions"));
+    let valid = qs.and_then(Value::as_array).is_some_and(|arr| {
+        !arr.is_empty()
+            && arr
+                .iter()
+                .all(|q| q.get("question").is_some() && q.get("options").is_some())
+    });
+    if valid { normalize_questions(qs) } else { Vec::new() }
+}
+
+fn parse_request(data: &Value) -> Option<Parsed> {
+    let tool_call = data.get("tool_call")?;
+    let call_id = str_of(tool_call, "tool_call_id")?;
+    let raw_input = tool_call.get("raw_input").filter(|v| !v.is_null()).cloned();
+    let title = str_of(tool_call, "title");
+    let options = data
+        .get("options")
+        .and_then(Value::as_array)
+        .map(|opts| {
+            opts.iter()
+                .filter_map(|o| {
+                    let id = str_of(o, "option_id")?;
+                    let label = display_label(&str_of(o, "name").unwrap_or_else(|| id.clone()));
+                    let kind = kind_from_acp(o.get("kind").and_then(Value::as_str));
+                    Some((id.clone(), label, kind, Value::String(id)))
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    Some(Parsed {
+        confirmation_id: call_id.clone(),
+        call_id,
+        description: raw_input
+            .as_ref()
+            .and_then(|r| str_of(r, "description"))
+            .unwrap_or_default(),
+        command_type: str_of(tool_call, "kind"),
+        tool_name: title.clone(),
+        title,
+        questions: request_questions(raw_input.as_ref()),
+        input: raw_input,
+        options,
+        from_ask: false,
+    })
+}
+
+/// The confirmation form (`acp_permission` confirmation, legacy `permission`, and the recovery listing's items).
+fn parse_confirmation(data: &Value) -> Option<Parsed> {
+    let call_id = str_of(data, "call_id")?;
+    let confirmation_id = str_of(data, "id").unwrap_or_else(|| call_id.clone());
+    let title = str_of(data, "title");
+    let options = data
+        .get("options")
+        .and_then(Value::as_array)
+        .map(|opts| {
+            opts.iter()
+                .filter_map(|o| {
+                    let value = o.get("value").cloned().filter(|v| !v.is_null())?;
+                    let id = value_id(&value);
+                    let label = display_label(&str_of(o, "label").unwrap_or_else(|| id.clone()));
+                    Some((id, label, kind_from_value(&value), value))
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    Some(Parsed {
+        call_id,
+        confirmation_id,
+        description: str_of(data, "description").unwrap_or_default(),
+        command_type: str_of(data, "command_type"),
+        tool_name: title.clone(),
+        title,
+        input: None,
+        options,
+        questions: normalize_questions(data.get("questions")),
+        from_ask: false,
+    })
+}
+
+fn parse_ask(data: &Value) -> Option<Parsed> {
+    let request_id = str_of(data, "request_id")?;
+    Some(Parsed {
+        confirmation_id: request_id.clone(),
+        call_id: request_id,
+        title: None,
+        description: String::new(),
+        command_type: None,
+        tool_name: None,
+        input: None,
+        options: Vec::new(),
+        questions: normalize_questions(data.get("questions")),
+        from_ask: true,
+    })
+}
+
+fn parse_frame(frame_type: &str, data: &Value) -> Option<Parsed> {
+    match frame_type {
+        "ask" => parse_ask(data),
+        "acp_permission" | "permission" => parse_request(data).or_else(|| parse_confirmation(data)),
+        _ => None,
+    }
+}
+
+/// The single most important input field for display, untruncated (CONTRACT §6.5 `inputSummary`).
+fn input_summary(input: Option<&Value>, command_type: Option<&str>, tool_name: Option<&str>) -> Option<String> {
+    let input = input?;
+    let field = if command_type == Some("execute") || tool_name == Some("Bash") {
+        "command"
+    } else if matches!(command_type, Some("edit" | "read")) || matches!(tool_name, Some("Edit" | "Write" | "Read")) {
+        "file_path"
+    } else if tool_name == Some("WebFetch") {
+        "url"
+    } else {
+        return None;
+    };
+    str_of(input, field)
+}
+
+fn always_scope(backend: BackendKind) -> AlwaysScope {
+    match backend {
+        BackendKind::ClaudeSession => AlwaysScope::SameAsOnce,
+        BackendKind::Acp | BackendKind::Aionrs | BackendKind::CodexSession | BackendKind::Other => {
+            AlwaysScope::BackendDefined
+        }
+    }
+}
+
+pub fn approval_id(conversation_id: &str, call_id: &str) -> String {
+    b64u(format!("{conversation_id}:{call_id}").as_bytes())
+}
+
+fn build(origin: &ApprovalOrigin, msg_id: &str, p: Parsed, first_seen_at: i64) -> TrackedApproval {
+    // "question" means the free-text answer channel, which only Claude's AskUserQuestion has.
+    let is_question = origin.backend == BackendKind::ClaudeSession && (p.from_ask || !p.questions.is_empty());
+    let (options, option_values): (Vec<ApprovalOption>, Vec<Value>) = if is_question {
+        (Vec::new(), Vec::new())
+    } else {
+        p.options
+            .into_iter()
+            .map(|(option_id, label, kind, value)| {
+                let opt = ApprovalOption {
+                    option_id,
+                    label,
+                    kind,
+                    rule: None,
+                    always_scope: (kind == OptionKind::AllowAlways).then(|| always_scope(origin.backend)),
+                };
+                (opt, value)
+            })
+            .unzip()
+    };
+    let questions = if is_question || !p.questions.is_empty() {
+        Some(p.questions)
+    } else {
+        None
+    };
+    let approval = Approval {
+        approval_id: approval_id(&origin.conversation_id, &p.call_id),
+        kind: if is_question {
+            ApprovalKind::Question
+        } else {
+            ApprovalKind::Permission
+        },
+        conversation_id: origin.conversation_id.clone(),
+        team_id: origin.team_id.clone(),
+        slot_id: origin.slot_id.clone(),
+        agent_name: origin.agent_name.clone(),
+        input_summary: input_summary(p.input.as_ref(), p.command_type.as_deref(), p.tool_name.as_deref()),
+        title: p.title,
+        description: p.description,
+        command_type: p.command_type,
+        tool_name: p.tool_name,
+        input: p.input,
+        options,
+        questions,
+        free_text: is_question,
+        first_seen_at,
+    };
+    TrackedApproval {
+        approval,
+        origin: origin.clone(),
+        call_id: p.call_id,
+        confirmation_id: p.confirmation_id,
+        msg_id: msg_id.to_owned(),
+        option_values,
+    }
+}
+
+// ---------------------------------------------------------------- the tracker
+
+struct Entry {
+    tracked: TrackedApproval,
+    seq: u64,
+}
+
+#[derive(Default)]
+struct State {
+    by_id: HashMap<String, Entry>,
+    next_seq: u64,
+}
+
+#[derive(Default)]
+pub struct ApprovalTracker {
+    state: Mutex<State>,
+}
+
+impl ApprovalTracker {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    fn lock(&self) -> std::sync::MutexGuard<'_, State> {
+        self.state.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+    }
+
+    /// Adds, or refreshes an approval already tracked (keeping its `firstSeenAt`, and keeping its `input` when the
+    /// frame has none). A recovery listing never refreshes one already tracked: its options carry only labels and
+    /// values, and would replace the option kinds a live frame gave. Returns the Approval only when it is new.
+    fn upsert(&self, fresh: TrackedApproval, from_recovery: bool) -> Option<Approval> {
+        let mut state = self.lock();
+        let id = fresh.approval.approval_id.clone();
+        if let Some(entry) = state.by_id.get_mut(&id) {
+            if from_recovery {
+                return None;
+            }
+            let mut next = fresh;
+            next.approval.first_seen_at = entry.tracked.approval.first_seen_at;
+            if next.approval.input.is_none() {
+                next.approval.input = entry.tracked.approval.input.take();
+                next.approval.input_summary = entry.tracked.approval.input_summary.take();
+            }
+            if next.msg_id.is_empty() {
+                next.msg_id = std::mem::take(&mut entry.tracked.msg_id);
+            }
+            entry.tracked = next;
+            return None;
+        }
+        let seq = state.next_seq;
+        state.next_seq += 1;
+        let approval = fresh.approval.clone();
+        state.by_id.insert(id, Entry { tracked: fresh, seq });
+        Some(approval)
+    }
+
+    /// Adds or refreshes. Returns the Approval only when it is NEW (for an `approval_added` change).
+    pub fn on_frame(&self, frame: PermissionFrame) -> Option<Approval> {
+        let parsed = parse_frame(&frame.frame_type, &frame.data)?;
+        self.upsert(build(&frame.origin, &frame.msg_id, parsed, frame.at_ms), false)
+    }
+
+    /// `confirmation.remove {conversation_id, id}`: the approval was answered.
+    pub fn on_removed(&self, conversation_id: &str, confirmation_id: &str) -> Option<String> {
+        let mut state = self.lock();
+        let id = state
+            .by_id
+            .iter()
+            .find(|(_, e)| {
+                e.tracked.origin.conversation_id == conversation_id && e.tracked.confirmation_id == confirmation_id
+            })
+            .map(|(id, _)| id.clone())?;
+        state.by_id.remove(&id);
+        Some(id)
+    }
+
+    /// A turn ended or the agent stopped: every approval of that conversation is gone ("cancelled").
+    pub fn on_turn_ended(&self, conversation_id: &str) -> Vec<String> {
+        let mut state = self.lock();
+        let mut gone: Vec<(u64, String)> = state
+            .by_id
+            .iter()
+            .filter(|(_, e)| e.tracked.origin.conversation_id == conversation_id)
+            .map(|(id, e)| (e.seq, id.clone()))
+            .collect();
+        gone.sort();
+        for (_, id) in &gone {
+            state.by_id.remove(id);
+        }
+        gone.into_iter().map(|(_, id)| id).collect()
+    }
+
+    /// Reconcile one conversation with AionCore's `GET .../confirmations` list (`Confirmation` objects as JSON).
+    /// Adds missing ones with `input: null`; removes tracked ones absent from the list.
+    pub fn reconcile(&self, origin: &ApprovalOrigin, listed: &[Value], now_ms: i64) -> (Vec<Approval>, Vec<String>) {
+        let mut added = Vec::new();
+        let mut present = HashSet::new();
+        for item in listed {
+            let Some(parsed) = parse_confirmation(item) else {
+                continue;
+            };
+            let tracked = build(origin, "", parsed, now_ms);
+            present.insert(tracked.approval.approval_id.clone());
+            if let Some(a) = self.upsert(tracked, true) {
+                added.push(a);
+            }
+        }
+        let mut state = self.lock();
+        let mut gone: Vec<(u64, String)> = state
+            .by_id
+            .iter()
+            .filter(|(id, e)| e.tracked.origin.conversation_id == origin.conversation_id && !present.contains(*id))
+            .map(|(id, e)| (e.seq, id.clone()))
+            .collect();
+        gone.sort();
+        for (_, id) in &gone {
+            state.by_id.remove(id);
+        }
+        (added, gone.into_iter().map(|(_, id)| id).collect())
+    }
+
+    /// Oldest first.
+    pub fn list(&self, user_id: &str, team_id: Option<&str>) -> Vec<Approval> {
+        let state = self.lock();
+        let mut items: Vec<&Entry> = state
+            .by_id
+            .values()
+            .filter(|e| e.tracked.origin.user_id == user_id)
+            .filter(|e| team_id.is_none_or(|t| e.tracked.origin.team_id.as_deref() == Some(t)))
+            .collect();
+        items.sort_by_key(|e| (e.tracked.approval.first_seen_at, e.seq));
+        items.into_iter().map(|e| e.tracked.approval.clone()).collect()
+    }
+
+    pub fn get(&self, approval_id: &str) -> Option<TrackedApproval> {
+        self.lock().by_id.get(approval_id).map(|e| e.tracked.clone())
+    }
+
+    /// Drops one approval (answered from the phone, or found resolved elsewhere). Returns its id if it was tracked.
+    pub fn take(&self, approval_id: &str) -> Option<String> {
+        self.lock().by_id.remove(approval_id).map(|_| approval_id.to_owned())
+    }
+}
+
+// ---------------------------------------------------------------- the answer mapping
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Decision {
+    AllowOnce,
+    AllowAlways,
+    Deny,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct QuestionAnswer {
+    pub question: String,
+    pub labels: Vec<String>,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum AnswerInput {
+    Option {
+        option_id: String,
+        message: Option<String>,
+    },
+    Decision {
+        decision: Decision,
+        message: Option<String>,
+    },
+    Answers {
+        answers: Vec<QuestionAnswer>,
+    },
+    Decline {
+        message: Option<String>,
+    },
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum BackendCall {
+    /// AionCore `POST /api/conversations/{id}/confirmations/{callId}/confirm` semantics.
+    Confirm {
+        conversation_id: String,
+        msg_id: String,
+        call_id: String,
+        data: Value,
+        always_allow: bool,
+    },
+    /// AionCore `POST /api/conversations/{id}/asks/{requestId}/answer`.
+    AskAnswer {
+        conversation_id: String,
+        request_id: String,
+        answers: Vec<QuestionAnswer>,
+    },
+    AskDecline {
+        conversation_id: String,
+        request_id: String,
+    },
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum MessageDelivery {
+    Native,
+    Followup,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct MappedAnswer {
+    pub call: BackendCall,
+    pub deny_message: Option<String>,
+    /// Some iff `deny_message` is Some.
+    pub delivery: Option<MessageDelivery>,
+    /// §5.1: true for any answer that allows.
+    pub sensitive: bool,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum AnswerError {
+    InvalidRequest(String),
+    Ambiguous(Vec<ApprovalOption>),
+}
+
+fn invalid(why: &str) -> AnswerError {
+    AnswerError::InvalidRequest(why.to_owned())
+}
+
+/// Trimmed, non-blank, at most `MAX_TEXT` characters.
+fn checked_text(text: &str, what: &str) -> Result<String, AnswerError> {
+    let t = text.trim();
+    if t.is_empty() {
+        return Err(AnswerError::InvalidRequest(format!("{what} is blank")));
+    }
+    if t.chars().count() > MAX_TEXT {
+        return Err(AnswerError::InvalidRequest(format!(
+            "{what} is longer than {MAX_TEXT} characters"
+        )));
+    }
+    Ok(t.to_owned())
+}
+
+/// What AionCore's confirm gets for one option, per backend (spec rule 2). None for a backend with no known mapping.
+fn confirm_data(backend: BackendKind, option: &ApprovalOption, value: &Value) -> Option<(Value, bool)> {
+    match backend {
+        BackendKind::Acp => Some((Value::String(option.option_id.clone()), false)),
+        BackendKind::ClaudeSession | BackendKind::CodexSession => Some((
+            match option.kind {
+                OptionKind::AllowOnce => json!("allow"),
+                OptionKind::AllowAlways => json!("allow_always"),
+                OptionKind::RejectOnce | OptionKind::RejectAlways => json!("reject"),
+                OptionKind::Other => value.clone(),
+            },
+            false,
+        )),
+        // aionrs reads a bare string as `cancel`, i.e. deny: always an object.
+        BackendKind::Aionrs => Some(match option.kind {
+            OptionKind::AllowOnce => (json!({ "value": "proceed_once" }), false),
+            OptionKind::AllowAlways => (json!({ "value": "proceed_always" }), true),
+            OptionKind::RejectOnce | OptionKind::RejectAlways => (json!({ "value": "cancel" }), false),
+            OptionKind::Other => (json!({ "value": value }), false),
+        }),
+        BackendKind::Other => None,
+    }
+}
+
+fn pick_for_decision(options: &[ApprovalOption], decision: Decision) -> Result<usize, AnswerError> {
+    let with = |kind: OptionKind| {
+        options
+            .iter()
+            .enumerate()
+            .filter(|(_, o)| o.kind == kind)
+            .map(|(i, _)| i)
+            .collect::<Vec<_>>()
+    };
+    let found = match decision {
+        Decision::AllowOnce => with(OptionKind::AllowOnce),
+        Decision::AllowAlways => with(OptionKind::AllowAlways),
+        Decision::Deny => {
+            let once = with(OptionKind::RejectOnce);
+            if once.is_empty() {
+                with(OptionKind::RejectAlways)
+            } else {
+                once
+            }
+        }
+    };
+    match found.as_slice() {
+        [one] => Ok(*one),
+        _ => Err(AnswerError::Ambiguous(options.to_vec())),
+    }
+}
+
+fn map_permission(t: &TrackedApproval, index: usize, message: Option<String>) -> Result<MappedAnswer, AnswerError> {
+    let option = &t.approval.options[index];
+    let value = t
+        .option_values
+        .get(index)
+        .cloned()
+        .unwrap_or_else(|| Value::String(option.option_id.clone()));
+    let backend = t.origin.backend;
+    let Some((data, always_allow)) = confirm_data(backend, option, &value) else {
+        return Err(invalid(
+            "this agent's backend has no known answer mapping; answer on the PC",
+        ));
+    };
+    let refusal = option.kind.is_reject();
+    let deny_message = match message {
+        None => None,
+        Some(_) if !refusal => return Err(invalid("a message is only accepted on a refusal")),
+        Some(m) => Some(checked_text(&m, "message")?),
+    };
+    let delivery = deny_message.as_ref().map(|_| match backend {
+        BackendKind::ClaudeSession | BackendKind::Aionrs => MessageDelivery::Native,
+        _ => MessageDelivery::Followup,
+    });
+    Ok(MappedAnswer {
+        call: BackendCall::Confirm {
+            conversation_id: t.origin.conversation_id.clone(),
+            msg_id: t.msg_id.clone(),
+            call_id: t.call_id.clone(),
+            data,
+            always_allow,
+        },
+        deny_message,
+        delivery,
+        sensitive: !refusal,
+    })
+}
+
+fn map_answers(t: &TrackedApproval, answers: Vec<QuestionAnswer>) -> Result<MappedAnswer, AnswerError> {
+    let questions = t.approval.questions.as_deref().unwrap_or(&[]);
+    if answers.is_empty() {
+        return Err(invalid("no answers"));
+    }
+    let mut seen = HashSet::new();
+    let mut out = Vec::with_capacity(answers.len());
+    for answer in answers {
+        let Some(q) = questions.iter().find(|q| q.question == answer.question) else {
+            return Err(invalid("an answer names a question that was not asked"));
+        };
+        if !seen.insert(q.question.clone()) {
+            return Err(invalid("a question is answered twice"));
+        }
+        if answer.labels.is_empty() || (!q.multi_select && answer.labels.len() > 1) {
+            return Err(invalid("wrong number of labels for this question"));
+        }
+        let mut free = 0;
+        let mut labels = Vec::with_capacity(answer.labels.len());
+        for label in answer.labels {
+            if q.options.iter().any(|o| o.label == label) {
+                labels.push(label);
+                continue;
+            }
+            if !t.approval.free_text {
+                return Err(invalid("a label that was not offered"));
+            }
+            free += 1;
+            if free > 1 {
+                return Err(invalid("more than one free-text answer for a question"));
+            }
+            labels.push(checked_text(&label, "free-text answer")?);
+        }
+        out.push(QuestionAnswer {
+            question: answer.question,
+            labels,
+        });
+    }
+    Ok(MappedAnswer {
+        call: BackendCall::AskAnswer {
+            conversation_id: t.origin.conversation_id.clone(),
+            request_id: t.call_id.clone(),
+            answers: out,
+        },
+        deny_message: None,
+        delivery: None,
+        sensitive: true,
+    })
+}
+
+pub fn map_answer(tracked: &TrackedApproval, input: AnswerInput) -> Result<MappedAnswer, AnswerError> {
+    match (tracked.approval.kind, input) {
+        (ApprovalKind::Permission, AnswerInput::Option { option_id, message }) => {
+            // Only an offered option id: the Claude session backend reads any other string as an
+            // AskUserQuestion answer, which approves.
+            let Some(index) = tracked.approval.options.iter().position(|o| o.option_id == option_id) else {
+                return Err(invalid("optionId is not one of this approval's options"));
+            };
+            map_permission(tracked, index, message)
+        }
+        (ApprovalKind::Permission, AnswerInput::Decision { decision, message }) => {
+            let index = pick_for_decision(&tracked.approval.options, decision)?;
+            map_permission(tracked, index, message)
+        }
+        (ApprovalKind::Permission, AnswerInput::Answers { .. } | AnswerInput::Decline { .. }) => {
+            Err(invalid("a permission is answered with optionId or decision"))
+        }
+        (ApprovalKind::Question, AnswerInput::Answers { answers }) => map_answers(tracked, answers),
+        (ApprovalKind::Question, AnswerInput::Decline { message }) => {
+            let deny_message = message.map(|m| checked_text(&m, "message")).transpose()?;
+            Ok(MappedAnswer {
+                call: BackendCall::AskDecline {
+                    conversation_id: tracked.origin.conversation_id.clone(),
+                    request_id: tracked.call_id.clone(),
+                },
+                delivery: deny_message.as_ref().map(|_| MessageDelivery::Followup),
+                deny_message,
+                sensitive: false,
+            })
+        }
+        (ApprovalKind::Question, AnswerInput::Option { .. } | AnswerInput::Decision { .. }) => {
+            Err(invalid("a question is answered with answers or decline"))
+        }
+    }
+}
