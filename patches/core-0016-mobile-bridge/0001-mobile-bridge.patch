+#[tokio::test]
+async fn claude_takes_the_reason_natively_and_turn_end_cancels() {
+    let (fake, f) = facade();
+    *fake.kind.lock().unwrap() = Some(BackendKind::ClaudeSession);
+    let t0 = first_token(&f).await;
+    emit(&f, "message.stream", claude_frame("call-5")).await;
+    *fake.pending.lock().unwrap() = vec![claude_frame("call-5")["data"].clone()];
+    let id = approval_ids(&f).await.pop().unwrap();
+    let (status, body) = call(
+        &f,
+        ConfirmCheck::Missing,
+        "POST",
+        &format!("/v1/approvals/{id}/answer"),
+        json!({ "decision": "deny", "message": "not on main" }),
+    )
+    .await;
+    assert_eq!(status, 200, "{body}");
+    assert_eq!(body["messageDelivery"], "native");
+    let calls = fake.calls();
+    assert!(
+        calls.contains(&r#"confirm c2 call-5 "reject" always=false deny=Some("not on main")"#.to_owned()),
+        "{calls:?}"
+    );
+    assert!(
+        !calls.iter().any(|c| c.starts_with("send_to_agent")),
+        "no follow-up message"
+    );
+
+    // A turn that ends takes its approvals with it; confirmation.remove means answered on the PC.
+    emit(&f, "message.stream", claude_frame("call-6")).await;
+    emit(&f, "message.stream", claude_frame("call-7")).await;
+    emit(
+        &f,
+        "confirmation.remove",
+        json!({ "conversation_id": "c2", "id": "conf-call-7" }),
+    )
+    .await;
+    emit(
+        &f,
+        "turn.completed",
+        json!({ "conversation_id": "c2", "turn_id": "t", "status": "finished" }),
+    )
+    .await;
+    let (_, changes) = changes_since(&f, &t0).await;
+    let removed: Vec<(String, String)> = of_kind(&changes, "approval_removed")
+        .iter()
+        .map(|r| {
+            (
+                r["approvalId"].as_str().unwrap().to_owned(),
+                r["resolution"].as_str().unwrap().to_owned(),
+            )
+        })
+        .collect();
+    assert_eq!(removed.len(), 3, "{removed:?}");
+    assert!(removed.iter().any(|(i, r)| i.as_str() == id && r == "answered"));
+    assert_eq!(removed.iter().filter(|(_, r)| r == "cancelled").count(), 1);
+    assert_eq!(removed.iter().filter(|(_, r)| r == "answered").count(), 2);
+    assert!(
+        of_kind(&changes, "approval_added").is_empty(),
+        "added then removed collapses to removed"
+    );
+}
