+// ---------------------------------------------------------------- phase 4: the change feed and approvals
+
+async fn emit_as(facade: &Facade, user: &str, name: &str, mut data: Value) {
+    data["user_id"] = json!(user);
+    facade.on_event(name, &data).await;
+}
+
+async fn emit(facade: &Facade, name: &str, data: Value) {
+    emit_as(facade, "u1", name, data).await;
+}
+
+/// An ACP agent's permission request, as `message.stream` carries it.
+fn acp_frame(call: &str) -> Value {
+    json!({
+        "conversation_id": "c2", "msg_id": "m7", "turn_id": "t", "type": "acp_permission",
+        "data": {
+            "session_id": "s",
+            "tool_call": { "tool_call_id": call, "title": "Bash", "kind": "execute",
+                           "raw_input": { "command": "npx expo install x" } },
+            "options": [
+                { "option_id": "ok1", "name": "Allow", "kind": "allow_once" },
+                { "option_id": "ok2", "name": "Always", "kind": "allow_always" },
+                { "option_id": "no1", "name": "Reject", "kind": "reject_once" },
+                { "option_id": "no2", "name": "Never", "kind": "reject_always" }
+            ]
+        }
+    })
+}
+
+/// The same call as AionCore's `GET .../confirmations` lists it.
+fn listed(call: &str) -> Value {
+    json!({ "id": format!("conf-{call}"), "call_id": call, "title": "Bash", "description": "", "command_type": "execute",
+            "options": [ { "label": "Allow", "value": "ok1" }, { "label": "Reject", "value": "no1" } ] })
+}
+
+/// A Claude (session) agent's permission, confirmation form.
+fn claude_frame(call: &str) -> Value {
+    json!({
+        "conversation_id": "c2", "msg_id": "m8", "turn_id": "t", "type": "permission",
+        "data": { "id": format!("conf-{call}"), "call_id": call, "title": "Bash", "description": "", "command_type": "execute",
+                  "options": [
+                      { "label": "messages.confirmation.yesAllowOnce", "value": "allow" },
+                      { "label": "messages.confirmation.yesAllowAlways", "value": "allow_always" },
+                      { "label": "messages.confirmation.no", "value": "reject" } ] }
+    })
+}
+
+async fn changes_since(facade: &Facade, token: &str) -> (String, Vec<Value>) {
+    let (status, page) = get(facade, &format!("/v1/changes?since={token}")).await.unwrap();
+    assert_eq!(status, 200);
+    (
+        page["token"].as_str().unwrap().to_owned(),
+        page["changes"].as_array().unwrap().clone(),
+    )
+}
+
+/// The first call never holds, even with `wait`.
+async fn first_token(facade: &Facade) -> String {
+    let (_, page) = get(facade, "/v1/changes?wait=5").await.unwrap();
+    assert_eq!(page["changes"], json!([]));
+    assert_eq!(page["reset"], false);
+    page["token"].as_str().unwrap().to_owned()
+}
+
+fn of_kind<'a>(changes: &'a [Value], kind: &str) -> Vec<&'a Value> {
+    changes.iter().filter(|c| c["kind"] == kind).collect()
+}
+
+async fn approval_ids(f: &Facade) -> Vec<String> {
+    let (_, list) = get(f, "/v1/approvals").await.unwrap();
+    list["items"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|a| a["approvalId"].as_str().unwrap().to_owned())
+        .collect()
+}
+
+#[tokio::test]
+async fn approvals_flow_through_the_change_feed() {
+    let (fake, f) = facade();
+    let t0 = first_token(&f).await;
+
+    emit(&f, "message.stream", acp_frame("call-1")).await;
+    let (t1, changes) = changes_since(&f, &t0).await;
+    let added = of_kind(&changes, "approval_added");
+    assert_eq!(added.len(), 1);
+    let approval = &added[0]["approval"];
+    assert_eq!(approval["teamId"], "t1");
+    assert_eq!(approval["slotId"], "s2");
+    assert_eq!(approval["agentName"], "Bob");
+    assert_eq!(approval["inputSummary"], "npx expo install x");
+    assert_eq!(approval["options"].as_array().unwrap().len(), 4);
+    let conv = of_kind(&changes, "conversation");
+    assert_eq!(conv[0]["conversationId"], "c2");
+    assert_eq!(conv[0]["teamId"], "t1");
+    assert!(conv[0]["what"].as_array().unwrap().contains(&json!("state")));
+    assert!(
+        of_kind(&changes, "team")
+            .iter()
+            .any(|t| t["what"].as_array().unwrap().contains(&json!("run_state")))
+    );
+
+    *fake.pending.lock().unwrap() = vec![listed("call-1")];
+    let (_, list) = get(&f, "/v1/approvals").await.unwrap();
+    assert_eq!(list["items"].as_array().unwrap().len(), 1);
+    let id = list["items"][0]["approvalId"].as_str().unwrap().to_owned();
+    assert_eq!(
+        list["items"][0]["input"]["command"], "npx expo install x",
+        "the live frame's input is kept"
+    );
+    let (_, other) = get(&f, "/v1/approvals?teamId=t9").await.unwrap();
+    assert_eq!(other["items"], json!([]));
+
+    // A refusal is never gated; an ACP agent gets the reason as a follow-up message.
+    let (status, body) = call(
+        &f,
+        ConfirmCheck::Missing,
+        "POST",
+        &format!("/v1/approvals/{id}/answer"),
+        json!({ "decision": "deny", "message": "use pnpm" }),
+    )
+    .await;
+    assert_eq!(status, 200, "{body}");
+    assert_eq!(body, json!({ "resolved": true, "messageDelivery": "followup" }));
+    let calls = fake.calls();
+    assert!(
+        calls.contains(&r#"confirm c2 call-1 "no1" always=false deny=None"#.to_owned()),
+        "{calls:?}"
+    );
+    assert!(
+        calls.contains(&"send_to_agent t1 s2 Denied Bash: use pnpm now=true".to_owned()),
+        "{calls:?}"
+    );
+
+    let (_, changes) = changes_since(&f, &t1).await;
+    let removed = of_kind(&changes, "approval_removed");
+    assert_eq!(removed.len(), 1);
+    assert_eq!(removed[0]["approvalId"], id.as_str());
+    assert_eq!(removed[0]["resolution"], "answered");
+    assert!(approval_ids(&f).await.is_empty());
+
+    // A retry (say, after a lost response) learns it is resolved, and how; nothing is sent twice (QA AP5).
+    let before = fake.calls().len();
+    let (status, body) = call(
+        &f,
+        ConfirmCheck::Verified,
+        "POST",
+        &format!("/v1/approvals/{id}/answer"),
+        json!({ "decision": "deny" }),
+    )
+    .await;
+    assert_eq!(status, 409, "{body}");
+    assert_eq!(body["error"]["code"], "already_resolved");
+    assert_eq!(body["error"]["details"]["resolution"], "answered");
+    assert!(body["error"]["details"]["resolvedAt"].is_i64());
+    assert_eq!(fake.calls().len(), before);
+}
