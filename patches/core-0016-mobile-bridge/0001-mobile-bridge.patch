+            ),
+            (
+                BackendKind::Acp,
+                "acp_permission",
+                acp_request("c"),
+                MessageDelivery::Followup,
+            ),
+            (
+                BackendKind::CodexSession,
+                "permission",
+                claude_confirmation("c"),
+                MessageDelivery::Followup,
+            ),
+        ] {
+            let t = tracked(backend, ft, data);
+            let m = map_answer(
+                &t,
+                AnswerInput::Decision {
+                    decision: Decision::Deny,
+                    message: msg("  use the staging branch  "),
+                },
+            )
+            .unwrap();
+            assert_eq!(m.deny_message.as_deref(), Some("use the staging branch"), "{backend:?}");
+            assert_eq!(m.delivery, Some(delivery), "{backend:?}");
+            let reject = option_id_for(&t, OptionKind::RejectOnce);
+            assert!(
+                map_answer(
+                    &t,
+                    AnswerInput::Option {
+                        option_id: reject,
+                        message: msg("why")
+                    }
+                )
+                .unwrap()
+                .deny_message
+                .is_some()
+            );
+            let allow = option_id_for(&t, OptionKind::AllowOnce);
+            assert!(matches!(
+                map_answer(
+                    &t,
+                    AnswerInput::Option {
+                        option_id: allow,
+                        message: msg("x")
+                    }
+                ),
+                Err(AnswerError::InvalidRequest(_))
+            ));
+            assert!(matches!(
+                map_answer(
+                    &t,
+                    AnswerInput::Decision {
+                        decision: Decision::AllowOnce,
+                        message: msg("x")
+                    }
+                ),
+                Err(AnswerError::InvalidRequest(_))
+            ));
+            for bad in ["", "   ", &"y".repeat(2001)] {
+                assert!(matches!(
+                    map_answer(
+                        &t,
+                        AnswerInput::Decision {
+                            decision: Decision::Deny,
+                            message: msg(bad)
+                        }
+                    ),
+                    Err(AnswerError::InvalidRequest(_))
+                ));
+            }
+            let m = map_answer(
+                &t,
+                AnswerInput::Decision {
+                    decision: Decision::Deny,
+                    message: msg(&"é".repeat(2000)),
+                },
+            )
+            .unwrap();
+            assert_eq!(
+                m.deny_message.unwrap().chars().count(),
+                2000,
+                "2,000 characters, not bytes"
+            );
+            let m = map_answer(
+                &t,
+                AnswerInput::Decision {
+                    decision: Decision::Deny,
+                    message: None,
+                },
+            )
+            .unwrap();
+            assert_eq!((m.deny_message, m.delivery), (None, None));
+        }
+    }
