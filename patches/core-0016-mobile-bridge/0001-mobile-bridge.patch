+    async fn activity(
+        &self,
+        user_id: &str,
+        team_id: &str,
+        query: ActivityQuery,
+    ) -> Result<TeamActivityPageResponse, BackendError> {
+        let cursor = query.cursor.map(|(created_at, id)| ActivityCursor { created_at, id });
+        let direction = if query.ascending {
+            PageDirection::Asc
+        } else {
+            PageDirection::Desc
+        };
+        let kind = match query.filter {
+            ActivityFilter::All => ActivityKind::All,
+            ActivityFilter::Messages => ActivityKind::Message,
+            ActivityFilter::Tasks => ActivityKind::Task,
+        };
+        self.team
+            .list_team_activity(user_id, team_id, cursor, direction, kind, query.limit)
+            .await
+            .map_err(map_err)
+    }
