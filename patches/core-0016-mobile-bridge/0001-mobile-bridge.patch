+    #[error("mobile bridge serialization error: {0}")]
+    Json(#[from] serde_json::Error),
+}
diff --git a/crates/aionui-mobile/src/facade.rs b/crates/aionui-mobile/src/facade.rs
new file mode 100644
index 00000000..49f728ba
--- /dev/null
+++ b/crates/aionui-mobile/src/facade.rs
@@ -0,0 +1,706 @@
+//! The mobile facade (CONTRACT §6): the `/v1/...` routes inside the RPC tunnel.
+//! An allowlist by construction (§11 #1): anything not matched here is
+//! `no_such_route`. This file routes and pages; `shape.rs` builds the JSON.
+
+use std::collections::HashMap;
+use std::sync::Arc;
+
+use async_trait::async_trait;
+use base64::Engine;
+use base64::engine::general_purpose::URL_SAFE_NO_PAD;
+use serde_json::{Value, json};
+
+use aionui_api_types::ListMessagesQuery;
+
+use crate::backend::{ActivityFilter, ActivityQuery, BackendError, MobileBackend};
+use crate::core::{InnerApi, InnerContext};
+use crate::shape::{self, AgentExtras};
+use crate::wire::{InnerRequest, InnerResponse};
+
+/// How far behind the oldest still-streaming row a sync cursor starts (§6.4).
+const SYNC_FLOOR_MARGIN_MS: i64 = 5_000;
+const DEFAULT_PAGE: u32 = 50;
+const MAX_PAGE: u32 = 200;
+
+pub struct Facade {
+    pub(crate) backend: Arc<dyn MobileBackend>,
+    /// The bridge's own store: settings (tasks.write), devices, broadcasts.
+    pub(crate) store: Option<crate::store::MobileStore>,
+    /// Shutdown requests sent from a phone, by (team, slot): `Agent.shutdown` (§6.3).
+    pub(crate) shutdowns: std::sync::Mutex<HashMap<(String, String), crate::facade_live::PendingShutdown>>,
+    /// Phase 4: the change journal and the approvals tracker, fed by `on_event`.
+    pub(crate) live: crate::facade_live::Live,
+}
+
+impl Facade {
+    pub fn new(backend: Arc<dyn MobileBackend>) -> Arc<Self> {
+        Arc::new(Self {
+            backend,
+            store: None,
+            shutdowns: Default::default(),
+            live: Default::default(),
+        })
+    }
+
+    pub fn with_store(backend: Arc<dyn MobileBackend>, store: crate::store::MobileStore) -> Arc<Self> {
+        Arc::new(Self {
+            backend,
+            store: Some(store),
+            shutdowns: Default::default(),
+            live: Default::default(),
+        })
+    }
+}
+
+pub(crate) fn backend_error(e: BackendError) -> InnerResponse {
+    match e {
+        BackendError::NotFound(m) => InnerResponse::error(404, "not_found", m),
+        BackendError::Invalid(m) => InnerResponse::error(400, "invalid_request", m),
+        BackendError::Unavailable(m) => InnerResponse::error(503, "backend_unavailable", m),
+    }
+}
+
+pub(crate) fn to_value<T: serde::Serialize>(v: &T) -> Value {
+    serde_json::to_value(v).unwrap_or(Value::Null)
+}
+
+/// `path?a=1&b=2` → segments and decoded query pairs.
+fn split(path: &str) -> (Vec<String>, HashMap<String, String>) {
+    let (p, q) = path.split_once('?').unwrap_or((path, ""));
+    let segs = p.trim_matches('/').split('/').map(percent_decode).collect();
+    let query = q
+        .split('&')
+        .filter(|kv| !kv.is_empty())
+        .map(|kv| {
+            let (k, v) = kv.split_once('=').unwrap_or((kv, ""));
+            (percent_decode(k), percent_decode(&v.replace('+', " ")))
+        })
+        .collect();
+    (segs, query)
+}
+
+fn percent_decode(s: &str) -> String {
+    let bytes = s.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        if bytes[i] == b'%'
+            && i + 2 < bytes.len()
+            && let Ok(b) = u8::from_str_radix(std::str::from_utf8(&bytes[i + 1..i + 3]).unwrap_or(""), 16)
+        {
+            out.push(b);
+            i += 3;
+            continue;
+        }
+        out.push(bytes[i]);
+        i += 1;
+    }
+    String::from_utf8_lossy(&out).into_owned()
+}
+
+pub(crate) fn page_limit(q: &HashMap<String, String>) -> u32 {
+    q.get("limit")
+        .and_then(|l| l.parse().ok())
+        .filter(|l| *l > 0)
+        .unwrap_or(DEFAULT_PAGE)
+        .min(MAX_PAGE)
+}
+
+pub(crate) fn opaque(v: &Value) -> String {
+    URL_SAFE_NO_PAD.encode(v.to_string())
+}
+
+pub(crate) fn from_opaque(s: &str) -> Option<Value> {
+    serde_json::from_slice(&URL_SAFE_NO_PAD.decode(s).ok()?).ok()
+}
+
+/// A sync cursor: `s1.` + b64u({"f": floor}).
+fn sync_cursor(floor: i64) -> String {
+    format!("s1.{}", opaque(&json!({ "f": floor })))
+}
+
+fn parse_sync_cursor(s: &str) -> Option<i64> {
+    from_opaque(s.strip_prefix("s1.")?)?.get("f")?.as_i64()
+}
+
+/// AionCore's own `after` cursor, positioned just before `floor`.
+fn aioncore_after(floor: i64) -> String {
+    // id "~" sorts after every real id, so `after (floor-1, "~")` means `created_at >= floor`.
+    format!(
+        "v1.{}",
+        URL_SAFE_NO_PAD.encode(json!({ "created_at": floor - 1, "id": "~" }).to_string())
+    )
+}
+
+/// The floor for the next sync: the oldest row still being written, else the newest row.
+fn next_floor(rows: &[Value], fallback: i64) -> i64 {
+    let streaming = rows
+        .iter()
+        .filter(|m| matches!(m["status"].as_str(), Some("work") | Some("pending")))
+        .filter_map(|m| m["created_at"].as_i64())
+        .min();
+    let newest = rows.iter().filter_map(|m| m["created_at"].as_i64()).max();
+    streaming
+        .or(newest)
+        .map(|t| t - SYNC_FLOOR_MARGIN_MS)
+        .unwrap_or(fallback)
+}
+
+#[async_trait]
+impl InnerApi for Facade {
+    async fn handle(&self, ctx: &InnerContext, req: &InnerRequest) -> Option<InnerResponse> {
+        let (segs, q) = split(&req.path);
+        let segs: Vec<&str> = segs.iter().map(String::as_str).collect();
+        let user = ctx.user_id.as_str();
+        if let Some(resp) = self.handle_write(ctx, req, &segs, &q).await {
+            return Some(resp);
+        }
+        let body = req.body.clone().unwrap_or(Value::Null);
+        if let Some(resp) = self.handle_live(ctx, &req.method, &segs, &q, &body).await {
+            return Some(resp);
+        }
+        let resp = match (req.method.as_str(), segs.as_slice()) {
+            ("GET", ["v1", "teams"]) => self.teams(user).await,
+            ("GET", ["v1", "teams", t, "run-state"]) => self.run_state(user, t).await,
+            ("GET", ["v1", "teams", t, "agents", slot]) => self.agent(user, t, slot).await,
+            ("GET", ["v1", "teams", t, "tasks"]) => self.tasks(user, t, &q).await,
+            ("GET", ["v1", "teams", t, "tasks", id]) => self.task(user, t, id).await,
+            ("GET", ["v1", "teams", t, "activity"]) => self.activity(user, t, &q).await,
+            ("GET", ["v1", "conversations"]) => self.conversations(user, &q).await,
+            ("GET", ["v1", "conversations", c]) => self.conversation(user, c).await,
+            ("GET", ["v1", "conversations", c, "messages"]) => self.messages(user, c, &q).await,
+            ("GET", ["v1", "workspaces"]) => self.workspaces(user).await,
+            ("GET", ["v1", "assistants"]) => self.assistants(user).await,
+            _ => return None,
+        };
+        Some(resp.unwrap_or_else(backend_error))
+    }
+}
+
+impl Facade {
+    async fn extras_for(&self, user: &str, team: &Value, run: &Value) -> HashMap<String, AgentExtras> {
+        let roster = shape::roster_index(team);
+        let mut out = HashMap::new();
+        for a in team["assistants"].as_array().into_iter().flatten() {
+            let (Some(slot), Some(conv)) = (a["slot_id"].as_str(), a["conversation_id"].as_str()) else {
+                continue;
+            };
+            let name = a["name"].as_str().unwrap_or_default();
+            let last = match self.backend.latest_message(user, conv).await {
+                Ok(Some(m)) => shape::message(&to_value(&m), &roster, name).map(|m| shape::last_message(&m)),
+                _ => None,
+            };
+            let team_id = team["id"].as_str().unwrap_or_default().to_owned();
+            self.expire_shutdowns(aionui_common::now_ms());
+            let shutdown = self
+                .shutdowns
+                .lock()
+                .unwrap()
+                .get(&(team_id, slot.to_owned()))
+                .map(|p| p.state.clone());
+            self.heal(user, conv, a["pending_confirmations"].as_u64().unwrap_or(0))
+                .await;
+            let read = self.read_state_of(user, conv, &roster, name).await;
+            // your_turn is for the lead only, once its turn is over (teammates report to the lead).
+            let idle = run["slot_work"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .find(|w| w["slot_id"] == slot)
+                .is_none_or(|w| w["state"] == "idle");
+            let your_turn = a["role"] == "lead" && idle && read.agent_spoke_last;
+            out.insert(
+                slot.to_owned(),
+                AgentExtras {
+                    last_message: last,
+                    shutdown,
+                    unread: read.unread,
+                    your_turn,
+                    question_pending: self.question_pending(user, conv),
+                },
+            );
+        }
+        out
+    }
+
+    async fn team_view(&self, user: &str, team_id: &str) -> Result<(Value, Value, Vec<Value>), BackendError> {
+        let team = to_value(&self.backend.team(user, team_id).await?);
+        let run = to_value(&self.backend.run_state(user, team_id).await?);
+        let tasks = self.backend.tasks(user, team_id).await?.iter().map(to_value).collect();
+        Ok((team, run, tasks))
+    }
+
+    async fn teams(&self, user: &str) -> Result<InnerResponse, BackendError> {
+        let mut out = Vec::new();
+        for t in self.backend.teams(user).await? {
+            let team = to_value(&t);
+            let team_id = team["id"].as_str().unwrap_or_default().to_owned();
+            let run = self
+                .backend
+                .run_state(user, &team_id)
+                .await
+                .map(|r| to_value(&r))
+                .unwrap_or(Value::Null);
+            let rs = shape::run_state(&team, &run, &[], &HashMap::new());
+            out.push(shape::team_summary(
+                &team,
+                rs["agents"].as_array().map(Vec::as_slice).unwrap_or(&[]),
+            ));
+        }
+        Ok(InnerResponse::ok(Value::Array(out)))
+    }
+
+    pub(crate) async fn run_state(&self, user: &str, team_id: &str) -> Result<InnerResponse, BackendError> {
+        let (team, run, tasks) = self.team_view(user, team_id).await?;
+        let extras = self.extras_for(user, &team, &run).await;
+        let mut rs = shape::run_state(&team, &run, &tasks, &extras);
+        self.apply_session_status(team_id, &mut rs);
+        Ok(InnerResponse::ok(rs))
+    }
+
+    pub(crate) async fn agent(&self, user: &str, team_id: &str, slot: &str) -> Result<InnerResponse, BackendError> {
+        let (team, run, tasks) = self.team_view(user, team_id).await?;
+        let extras = self.extras_for(user, &team, &run).await;
+        let rs = shape::run_state(&team, &run, &tasks, &extras);
+        rs["agents"]
+            .as_array()
+            .and_then(|agents| agents.iter().find(|a| a["slotId"] == slot))
+            .map(|a| InnerResponse::ok(a.clone()))
+            .ok_or_else(|| BackendError::NotFound(format!("No agent {slot} in this team")))
+    }
+
+    async fn names(&self, user: &str, team_id: &str) -> Result<HashMap<String, String>, BackendError> {
+        let team = to_value(&self.backend.team(user, team_id).await?);
+        Ok(team["assistants"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter_map(|a| Some((a["slot_id"].as_str()?.to_owned(), a["name"].as_str()?.to_owned())))
+            .collect())
+    }
+
+    async fn tasks(
+        &self,
+        user: &str,
+        team_id: &str,
+        q: &HashMap<String, String>,
+    ) -> Result<InnerResponse, BackendError> {
+        let names = self.names(user, team_id).await?;
+        let statuses: Option<Vec<&str>> = q.get("status").map(|s| s.split(',').map(str::trim).collect());
+        let mut tasks: Vec<Value> = self
+            .backend
+            .tasks(user, team_id)
+            .await?
+            .iter()
+            .map(to_value)
+            .filter(|t| {
+                statuses
+                    .as_ref()
+                    .is_none_or(|st| st.contains(&t["status"].as_str().unwrap_or_default()))
+            })
+            .filter(|t| q.get("owner").is_none_or(|o| t["owner"].as_str() == Some(o)))
+            .collect();
+        tasks.sort_by_key(|t| std::cmp::Reverse(t["updated_at"].as_i64().unwrap_or(0)));
+        let assigned = self.assignments(user, team_id, &tasks).await;
+        Ok(InnerResponse::ok(Value::Array(
+            tasks
+                .iter()
+                .map(|t| shape::task(t, &names, t["id"].as_str().and_then(|id| assigned.get(id)).cloned()))
+                .collect(),
+        )))
+    }
+
+    async fn task(&self, user: &str, team_id: &str, task_id: &str) -> Result<InnerResponse, BackendError> {
+        let names = self.names(user, team_id).await?;
+        let task = self
+            .backend
+            .tasks(user, team_id)
+            .await?
+            .iter()
+            .map(to_value)
+            .find(|t| t["id"] == task_id)
+            .ok_or_else(|| BackendError::NotFound(format!("No task {task_id}")))?;
+        let assigned = self.assignments(user, team_id, std::slice::from_ref(&task)).await;
+        Ok(InnerResponse::ok(shape::task(
+            &task,
+            &names,
+            assigned.get(task_id).cloned(),
+        )))
+    }
+
+    async fn activity(
+        &self,
+        user: &str,
+        team_id: &str,
+        q: &HashMap<String, String>,
+    ) -> Result<InnerResponse, BackendError> {
+        let names = self.names(user, team_id).await?;
+        let filter = match q.get("kind").map(String::as_str) {
+            Some("message") => ActivityFilter::Messages,
+            Some("task") => ActivityFilter::Tasks,
+            _ => ActivityFilter::All,
+        };
+        let limit = page_limit(q) as i64;
+        let slot = q.get("slotId").cloned();
+        let keep = |item: &Value| match &slot {
+            None => true,
+            Some(slot) => {
+                let m = &item["message"];
+                m["from_agent_id"].as_str() == Some(slot) || m["to_agent_id"].as_str() == Some(slot)
+            }
+        };
+
+        if let Some(task_id) = q.get("aroundTask") {
+            let task = self
+                .backend
+                .tasks(user, team_id)
+                .await?
+                .iter()
+                .map(to_value)
+                .find(|t| t["id"] == task_id.as_str())
+                .ok_or_else(|| BackendError::NotFound(format!("No task {task_id}")))?;
+            let at = task["created_at"].as_i64().unwrap_or(0);
+            let around = |ascending| ActivityQuery {
+                cursor: Some((at, if ascending { String::new() } else { "~".into() })),
+                ascending,
+                filter,
+                limit: 10,
+            };
+            let mut items: Vec<Value> = Vec::new();
+            for ascending in [false, true] {
+                let page = to_value(&self.backend.activity(user, team_id, around(ascending)).await?);
+                items.extend(page["items"].as_array().cloned().unwrap_or_default());
+            }
+            items.sort_by_key(|i| std::cmp::Reverse(i["created_at"].as_i64().unwrap_or(0)));
+            items.dedup_by(|a, b| a["id"] == b["id"]);
+            let shaped: Vec<Value> = items
+                .iter()
+                .filter(|i| keep(i))
+                .map(|i| shape::activity(i, &names))
+                .collect();
+            return Ok(InnerResponse::ok(
+                json!({ "items": shaped, "nextCursor": null, "hasMore": false }),
+            ));
+        }
+
+        let cursor = q
+            .get("cursor")
+            .and_then(|c| from_opaque(c))
+            .and_then(|v| Some((v["ts"].as_i64()?, v["id"].as_str()?.to_owned())));
+        let page = to_value(
+            &self
+                .backend
+                .activity(
+                    user,
+                    team_id,
+                    ActivityQuery {
+                        cursor,
+                        ascending: false,
+                        filter,
+                        limit,
+                    },
+                )
+                .await?,
+        );
+        let items: Vec<Value> = page["items"].as_array().cloned().unwrap_or_default();
+        let shaped: Vec<Value> = items
+            .iter()
+            .filter(|i| keep(i))
+            .map(|i| shape::activity(i, &names))
+            .collect();
+        let next = page["next_cursor"]
+            .as_object()
+            .map(|c| opaque(&json!({ "ts": c.get("ts"), "id": c.get("id") })));
+        Ok(InnerResponse::ok(
+            json!({ "items": shaped, "nextCursor": next, "hasMore": page["has_more"] }),
+        ))
+    }
+
+    async fn conversations(&self, user: &str, q: &HashMap<String, String>) -> Result<InnerResponse, BackendError> {
+        if q.get("kind").is_some_and(|k| k != "solo") {
+            return Err(BackendError::Invalid(
+                "kind must be solo; team chats come from the roster".into(),
+            ));
+        }
+        let limit = page_limit(q);
+        let mut cursor = q.get("cursor").cloned();
+        let mut items = Vec::new();
+        let mut next = None;
+        // Team chats are filtered out, so keep reading until a page is full or the list ends.
+        for _ in 0..5 {
+            let page = to_value(&self.backend.conversations(user, cursor.clone(), limit).await?);
+            let rows = page["items"].as_array().cloned().unwrap_or_default();
+            let last_id = rows.last().and_then(|c| c["id"].as_str()).map(str::to_owned);
+            for c in rows
+                .iter()
+                .filter(|c| c["extra"]["teamId"].as_str().is_none_or(str::is_empty))
+            {
+                let extras = self.conversation_extras(user, c).await;
+                items.push(shape::conversation(c, None, &extras));
+            }
+            next = if page["has_more"] == true { last_id } else { None };
+            if items.len() >= limit as usize || next.is_none() {
+                break;
+            }
+            cursor = next.clone();
+        }
+        Ok(InnerResponse::ok(json!({ "items": items, "nextCursor": next })))
+    }
+
+    async fn conversation(&self, user: &str, id: &str) -> Result<InnerResponse, BackendError> {
+        let c = to_value(&self.backend.conversation(user, id).await?);
+        let extras = self.conversation_extras(user, &c).await;
+        Ok(InnerResponse::ok(shape::conversation(&c, None, &extras)))
+    }
+
+    /// A conversation's last message, unread count and attention inputs.
+    async fn conversation_extras(&self, user: &str, c: &Value) -> AgentExtras {
+        let id = c["id"].as_str().unwrap_or_default();
+        let (roster, agent) = self.message_context(user, c).await;
+        let last = match self.backend.latest_message(user, id).await {
+            Ok(Some(m)) => shape::message(&to_value(&m), &roster, &agent).map(|m| shape::last_message(&m)),
+            _ => None,
+        };
+        self.heal(user, id, c["runtime"]["pending_confirmations"].as_u64().unwrap_or(0))
+            .await;
+        let read = self.read_state_of(user, id, &roster, &agent).await;
+        let idle = c["runtime"]["state"].as_str().is_none_or(|s| s == "idle");
+        // your_turn: solo chats and a team's lead (teammates report to the lead, not to the user).
+        let eligible = match c["extra"]["teamId"].as_str().filter(|t| !t.is_empty()) {
+            None => true,
+            Some(team_id) => match self.backend.team(user, team_id).await {
+                Ok(team) => to_value(&team)["assistants"]
+                    .as_array()
+                    .into_iter()
+                    .flatten()
+                    .any(|a| a["conversation_id"] == id && a["role"] == "lead"),
+                Err(_) => false,
+            },
+        };
+        AgentExtras {
+            last_message: last,
+            unread: read.unread,
+            your_turn: eligible && idle && read.agent_spoke_last,
+            question_pending: self.question_pending(user, id),
+            shutdown: None,
+        }
+    }
+
+    /// `error.messageId` on send_failed rows, from the links the event pump recorded.
+    async fn link_failures(&self, conversation_id: &str, items: &mut [Value]) {
+        if !items.iter().any(|m| m["error"]["source"] == "send_failed") {
+            return;
+        }
+        let Some(store) = &self.store else { return };
+        let Ok(links) = store.send_failures(conversation_id).await else {
+            return;
+        };
+        for m in items.iter_mut().filter(|m| m["error"]["source"] == "send_failed") {
+            if let Some(id) = m["messageId"].as_str().and_then(|id| links.get(id)) {
+                m["error"]["messageId"] = json!(id);
+            }
+        }
+    }
+
+    /// Roster and agent name for shaping one conversation's messages.
+    async fn message_context(&self, user: &str, conversation: &Value) -> (HashMap<String, (String, String)>, String) {
+        let name = conversation["name"].as_str().unwrap_or_default().to_owned();
+        match conversation["extra"]["teamId"].as_str().filter(|t| !t.is_empty()) {
+            Some(team_id) => match self.backend.team(user, team_id).await {
+                Ok(team) => {
+                    let team = to_value(&team);
+                    let roster = shape::roster_index(&team);
+                    let agent = conversation["id"]
+                        .as_str()
+                        .and_then(|c| roster.get(c))
+                        .map(|(_, n)| n.clone())
+                        .unwrap_or(name);
+                    (roster, agent)
+                }
+                Err(_) => (HashMap::new(), name),
+            },
+            None => (HashMap::new(), name),
+        }
+    }
+
+    async fn messages(&self, user: &str, id: &str, q: &HashMap<String, String>) -> Result<InnerResponse, BackendError> {
+        let conversation = to_value(&self.backend.conversation(user, id).await?);
+        let (roster, agent) = self.message_context(user, &conversation).await;
+        let limit = page_limit(q);
+        let shape_all = |rows: &[Value]| {
+            rows.iter()
+                .filter_map(|m| shape::message(m, &roster, &agent))
+                .collect::<Vec<_>>()
+        };
+
+        if let Some(before) = q.get("before") {
+            let page = to_value(
+                &self
+                    .backend
+                    .messages(
+                        user,
+                        id,
+                        ListMessagesQuery {
+                            limit: Some(limit),
+                            before: Some(before.clone()),
+                            after: None,
+                            anchor_message_id: None,
+                            content_mode: Some("compact".into()),
+                        },
+                    )
+                    .await?,
+            );
+            let rows = page["items"].as_array().cloned().unwrap_or_default();
+            let before = if page["has_more_before"] == true {
+                page["oldest_cursor"].clone()
+            } else {
+                Value::Null
+            };
+            let mut items = shape_all(&rows);
+            self.link_failures(id, &mut items).await;
+            return Ok(InnerResponse::ok(json!({ "items": items, "before": before })));
+        }
+
+        let since = q.get("since");
+        let floor = since.and_then(|c| parse_sync_cursor(c));
+        let reset = since.is_some() && floor.is_none();
+        let query = match floor {
+            Some(f) => ListMessagesQuery {
+                limit: Some(MAX_PAGE),
+                before: None,
+                after: Some(aioncore_after(f)),
+                anchor_message_id: None,
+                content_mode: Some("compact".into()),
+            },
+            None => ListMessagesQuery {
+                limit: Some(limit),
+                before: None,
+                after: None,
+                anchor_message_id: None,
+                content_mode: Some("compact".into()),
+            },
+        };
+        let page = to_value(&self.backend.messages(user, id, query).await?);
+        let rows = page["items"].as_array().cloned().unwrap_or_default();
+        let has_more = floor.is_some() && page["has_more_after"] == true;
+        let next = if has_more {
+            rows.last()
+                .and_then(|m| m["created_at"].as_i64())
+                .unwrap_or(floor.unwrap_or(0))
+        } else {
+            next_floor(&rows, floor.unwrap_or_else(aionui_common::now_ms))
+        };
+        let mut items = shape_all(&rows);
+        self.link_failures(id, &mut items).await;
+        let mut body = json!({ "items": items, "cursor": sync_cursor(next), "reset": reset, "hasMore": has_more });
+        if floor.is_none() {
+            body["before"] = if page["has_more_before"] == true {
+                page["oldest_cursor"].clone()
+            } else {
+                Value::Null
+            };
+        }
+        Ok(InnerResponse::ok(body))
+    }
+
+    pub(crate) async fn workspaces(&self, user: &str) -> Result<InnerResponse, BackendError> {
+        let mut seen: HashMap<String, (String, i64)> = HashMap::new();
+        let mut note = |path: Option<&str>, label: &str, at: i64| {
+            if let Some(p) = path.filter(|p| !p.is_empty()) {
+                let e = seen.entry(p.to_owned()).or_insert((label.to_owned(), at));
+                if at > e.1 {
+                    *e = (label.to_owned(), at);
+                }
+            }
+        };
+        for t in self.backend.teams(user).await? {
+            let t = to_value(&t);
+            note(
+                t["workspace"].as_str(),
+                t["name"].as_str().unwrap_or_default(),
+                t["updated_at"].as_i64().unwrap_or(0),
+            );
+        }
+        let page = to_value(&self.backend.conversations(user, None, MAX_PAGE).await?);
+        for c in page["items"].as_array().into_iter().flatten() {
+            note(
+                c["extra"]["workspace"].as_str(),
+                c["name"].as_str().unwrap_or_default(),
+                c["modified_at"].as_i64().unwrap_or(0),
+            );
+        }
+        let mut list: Vec<(String, (String, i64))> = seen.into_iter().collect();
+        list.sort_by_key(|(_, (_, at))| std::cmp::Reverse(*at));
+        let out: Vec<Value> = list
+            .into_iter()
+            .map(|(path, (label, at))| json!({ "path": path, "label": label, "lastUsedAt": at }))
+            .collect();
+        Ok(InnerResponse::ok(Value::Array(out)))
+    }
+
+    async fn assistants(&self, user: &str) -> Result<InnerResponse, BackendError> {
+        let out: Vec<Value> = self
+            .backend
+            .assistants(user)
+            .await?
+            .iter()
+            .map(to_value)
+            .filter(|a| a["enabled"] != false)
+            .map(|a| {
+                json!({
+                    "assistantId": a["id"],
+                    "name": a["name"],
+                    "backend": a["agent"].get("backend").cloned().or_else(|| a.get("agent_id").cloned()).unwrap_or(Value::Null),
+                    "icon": a.get("avatar").cloned().unwrap_or(Value::Null),
+                    "description": a.get("description").cloned().unwrap_or(Value::Null),
+                })
+            })
+            .collect();
+        Ok(InnerResponse::ok(Value::Array(out)))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn paths_and_queries_split_and_decode() {
+        let (segs, q) = split("/v1/teams/t%201/tasks?status=pending,in_progress&owner=s%202&x=a+b");
+        assert_eq!(segs, ["v1", "teams", "t 1", "tasks"]);
+        assert_eq!(q["status"], "pending,in_progress");
+        assert_eq!(q["owner"], "s 2");
+        assert_eq!(q["x"], "a b");
+    }
+
+    #[test]
+    fn sync_cursor_round_trips_and_rejects_garbage() {
+        assert_eq!(parse_sync_cursor(&sync_cursor(12345)), Some(12345));
+        assert_eq!(parse_sync_cursor("v1.abc"), None);
+        assert_eq!(parse_sync_cursor("s1.%%%"), None);
+    }
+
+    #[test]
+    fn the_floor_follows_the_oldest_streaming_row() {
+        let rows = vec![
+            json!({ "created_at": 1000, "status": "finish" }),
+            json!({ "created_at": 2000, "status": "work" }),
+            json!({ "created_at": 3000, "status": "finish" }),
+        ];
+        assert_eq!(next_floor(&rows, 0), 2000 - SYNC_FLOOR_MARGIN_MS);
+        let done = vec![
+            json!({ "created_at": 1000, "status": "finish" }),
+            json!({ "created_at": 3000, "status": "finish" }),
+        ];
+        assert_eq!(next_floor(&done, 0), 3000 - SYNC_FLOOR_MARGIN_MS);
+        assert_eq!(next_floor(&[], 777), 777);
+    }
+
+    #[test]
+    fn the_aioncore_after_cursor_is_in_its_v1_format() {
+        let c = aioncore_after(5000);
+        let body = URL_SAFE_NO_PAD.decode(c.strip_prefix("v1.").unwrap()).unwrap();
+        let v: Value = serde_json::from_slice(&body).unwrap();
+        assert_eq!(v, json!({ "created_at": 4999, "id": "~" }));
+    }
+}
diff --git a/crates/aionui-mobile/src/facade_live.rs b/crates/aionui-mobile/src/facade_live.rs
new file mode 100644
index 00000000..38a82bed
--- /dev/null
+++ b/crates/aionui-mobile/src/facade_live.rs
@@ -0,0 +1,882 @@
+//! Phase 4: the live side of the facade (CONTRACT §6.2, §6.5).
+//!
+//! AionCore's event bus feeds `Facade::on_event`, which turns bus events into change-journal entries and keeps the
+//! approvals tracker current. The phone reads them through `GET /v1/changes` (long-poll), `GET /v1/approvals` and
+//! `POST /v1/approvals/{id}/answer`.
+
+use std::collections::{HashMap, HashSet};
+use std::sync::Mutex;
+use std::time::Duration;
+
+use serde_json::{Value, json};
+
+use crate::approvals::{
+    AnswerError, AnswerInput, ApprovalOrigin, ApprovalTracker, BackendCall, Decision, MessageDelivery, PermissionFrame,
+    QuestionAnswer, TrackedApproval, map_answer,
+};
+use crate::backend::{BackendError, ConfirmCall};
+use crate::core::InnerContext;
+use crate::facade::{Facade, backend_error, to_value};
+use crate::facade_write::confirm_gate;
+use crate::journal::{ChangeEntry, ChangeJournal, ConversationWhat, Resolution, TaskChange, TeamWhat};
+use crate::shape;
+use crate::wire::InnerResponse;
+
+/// CONTRACT §6.2: 24 h or 50,000 entries, whichever is smaller.
+const JOURNAL_MAX_ENTRIES: usize = 50_000;
+const JOURNAL_MAX_AGE_MS: i64 = 24 * 60 * 60 * 1000;
+/// CONTRACT §6.2: `wait` is 0..25 s; `more` past 500 entries.
+const MAX_WAIT_SECS: u64 = 25;
+const CHANGES_LIMIT: usize = 500;
+/// How many recent new-turn sends are remembered for linking a send failure to its message.
+const TURN_MEMORY: usize = 1000;
+
+/// A phone-sent shutdown and the user who sent it (`Agent.shutdown`, §6.3).
+pub(crate) struct PendingShutdown {
+    pub(crate) user_id: String,
+    /// The `Agent.shutdown` JSON.
+    pub(crate) state: Value,
+}
+
+/// A request with neither a removal nor a refusal after this long becomes `expired` (CONTRACT rev 4.5).
+pub const SHUTDOWN_TIMEOUT_MS: i64 = 10 * 60 * 1000;
+
+/// How long a resolved approval's id is remembered, so a retried or late answer gets `409` with the outcome
+/// instead of `404` (QA AP5).
+const RESOLVED_MEMORY_MS: i64 = 10 * 60 * 1000;
+
+/// A resolved approval: who it belonged to, how it ended, and when.
+struct Resolved {
+    user_id: String,
+    resolution: Resolution,
+    at: i64,
+}
+
+/// What `on_event` learns and keeps between events.
+pub(crate) struct Live {
+    pub(crate) journal: ChangeJournal,
+    pub(crate) approvals: ApprovalTracker,
+    /// The user message each new-turn send created, by turn id (bounded; see `remember_turn`).
+    turn_messages: Mutex<std::collections::VecDeque<(String, String)>>,
+    /// Per conversation: the user message a failed mid-turn delivery just marked `error`.
+    errored: Mutex<HashMap<String, String>>,
+    /// The latest `team.sessionStatusChanged` status per team (`starting|ready|failed|stopped`).
+    session_status: Mutex<HashMap<String, String>>,
+    /// Per conversation: where its approvals come from, or None when it can't be resolved (not a live agent).
+    origins: Mutex<HashMap<String, Option<ApprovalOrigin>>>,
+    /// Recently resolved approvals by id (`RESOLVED_MEMORY_MS`).
+    resolved: Mutex<HashMap<String, Resolved>>,
+    /// Every Core user an event was seen for: the ones to re-sweep when the bus lags.
+    users_seen: Mutex<HashSet<String>>,
+}
+
+impl Default for Live {
+    fn default() -> Self {
+        Self {
+            journal: ChangeJournal::new(JOURNAL_MAX_ENTRIES, JOURNAL_MAX_AGE_MS),
+            approvals: ApprovalTracker::new(),
+            resolved: Mutex::new(HashMap::new()),
+            session_status: Mutex::new(HashMap::new()),
+            turn_messages: Mutex::new(std::collections::VecDeque::new()),
+            errored: Mutex::new(HashMap::new()),
+            origins: Mutex::new(HashMap::new()),
+            users_seen: Mutex::new(HashSet::new()),
+        }
+    }
+}
+
+fn s<'a>(v: &'a Value, key: &str) -> Option<&'a str> {
+    v.get(key).and_then(Value::as_str).filter(|x| !x.is_empty())
+}
+
+fn now_ms() -> i64 {
+    aionui_common::now_ms()
+}
+
+/// Bus events that change a team's run state (slot work, turns, runtime, session).
+const RUN_STATE_EVENTS: &[&str] = &[
+    "team.agentStatusChanged",
+    "team.agentRuntimeStatusChanged",
+    "team.slotWorkChanged",
+    "team.sessionStatusChanged",
+    "team.sessionChanged",
+    "team.runAccepted",
+    "team.runStarted",
+    "team.runUpdated",
+    "team.runCompleted",
+    "team.runCancelled",
+    "team.runFailed",
+    "team.childTurnStarted",
+    "team.childTurnCompleted",
+    "team.childTurnCancelled",
+];
+
+/// The mailbox note AionCore writes to the lead when a teammate refuses a shutdown
+/// (`scheduler/crash_recovery.rs` `notify_shutdown_rejected`): `Teammate '<name>' declined shutdown: <reason>`.
+fn declined_shutdown_reason(content: &str) -> Option<&str> {
+    let rest = content.strip_prefix("Teammate '")?;
+    let (_, reason) = rest.split_once("' declined shutdown: ")?;
+    Some(reason.trim())
+}
+
+impl Facade {
+    fn record(&self, user: &str, entry: ChangeEntry) {
+        self.live.journal.record(user, entry, now_ms());
+    }
+
+    fn record_team(&self, user: &str, team_id: &str, what: &[TeamWhat]) {
+        self.record(
+            user,
+            ChangeEntry::Team {
+                team_id: team_id.to_owned(),
+                what: what.to_vec(),
+            },
+        );
+    }
+
+    /// The approval origin of a conversation, cached. None when AionCore can't say (no live agent, or gone).
+    async fn origin(&self, user: &str, conversation_id: &str) -> Option<ApprovalOrigin> {
+        if let Some(hit) = self.live.origins.lock().unwrap().get(conversation_id)
+            && (hit.is_none() || hit.as_ref().is_some_and(|o| o.user_id == user))
+        {
+            return hit.clone();
+        }
+        let found = match self.backend.approval_source(user, conversation_id).await {
+            Ok(src) => Some(ApprovalOrigin {
+                user_id: user.to_owned(),
+                conversation_id: conversation_id.to_owned(),
+                team_id: src.team_id,
+                slot_id: src.slot_id,
+                agent_name: src.agent_name,
+                backend: src.backend,
+            }),
+            Err(BackendError::NotFound(_)) => None,
+            // Not cached: a transient failure shouldn't hide a conversation's approvals for good.
+            Err(_) => return None,
+        };
+        // Nor an undecided backend (no live agent yet): the first permission frame must see the real one.
+        if found
+            .as_ref()
+            .is_some_and(|o| o.backend == crate::approvals::BackendKind::Other)
+        {
+            return found;
+        }
+        self.live
+            .origins
+            .lock()
+            .unwrap()
+            .insert(conversation_id.to_owned(), found.clone());
+        found
+    }
+
+    fn forget_origins_of_team(&self, team_id: &str) {
+        self.live
+            .origins
+            .lock()
+            .unwrap()
+            .retain(|_, o| o.as_ref().is_none_or(|o| o.team_id.as_deref() != Some(team_id)));
+    }
+
+    /// `RunState.sessionStatus` (§6.3): what `team.sessionStatusChanged` last said; until then, AionCore's own view
+    /// ("none" when no session has started).
+    pub(crate) fn apply_session_status(&self, team_id: &str, rs: &mut Value) {
+        if let Some(status) = self.live.session_status.lock().unwrap().get(team_id) {
+            rs["sessionStatus"] = json!(status);
+        }
+    }
+
+    /// Turns every `requested` shutdown older than `SHUTDOWN_TIMEOUT_MS` into `expired`, and announces it on the
+    /// change feed. Called when an agent is read, and every minute by the app's event pump.
+    pub fn expire_shutdowns(&self, now: i64) {
+        let mut announce = Vec::new();
+        for ((team_id, _), pending) in self.shutdowns.lock().unwrap().iter_mut() {
+            let requested_at = pending.state["requestedAt"].as_i64().unwrap_or(now);
+            if pending.state["state"] == "requested" && now - requested_at >= SHUTDOWN_TIMEOUT_MS {
+                pending.state = json!({
+                    "state": "expired",
+                    "requestedAt": requested_at,
+                    "expiredAt": requested_at + SHUTDOWN_TIMEOUT_MS,
+                    "reason": pending.state["reason"],
+                });
+                announce.push((pending.user_id.clone(), team_id.clone()));
+            }
+        }
+        for (user, team_id) in announce {
+            self.record_team(&user, &team_id, &[TeamWhat::RunState]);
+        }
+    }
+
+    /// The bus dropped events: anything cached may be stale, and approvals must be re-swept.
+    ///
+    /// Dropped events may include permission frames (QA AP1), so every known user's live conversations are swept
+    /// against AionCore's confirmations right away; what was missed shows up as `approval_added` on the feed.
+    pub async fn on_lagged(&self, missed: u64) {
+        tracing::warn!(missed, "mobile bridge: event bus lagged; re-sweeping approvals");
+        self.live.origins.lock().unwrap().clear();
+        let users: Vec<String> = self.live.users_seen.lock().unwrap().iter().cloned().collect();
+        for user in users {
+            self.sweep(&user).await;
+        }
+    }
+
+    /// One AionCore bus event (`WebSocketMessage { name, data }`).
+    pub async fn on_event(&self, name: &str, data: &Value) {
+        let Some(user) = s(data, "user_id") else { return };
+        if !self.live.users_seen.lock().unwrap().contains(user) {
+            self.live.users_seen.lock().unwrap().insert(user.to_owned());
+        }
+        let team_id = s(data, "team_id");
+        match name {
+            "message.stream" => self.on_stream(user, data).await,
+            "message.statusChanged" => {
+                if s(data, "status") == Some("error")
+                    && let (Some(cid), Some(msg)) = (s(data, "conversation_id"), s(data, "msg_id"))
+                {
+                    self.live.errored.lock().unwrap().insert(cid.to_owned(), msg.to_owned());
+                }
+                self.on_conversation(user, data, &[ConversationWhat::Messages]).await
+            }
+            "message.userCreated" => {
+                if let (Some(turn), Some(msg)) = (s(data, "turn_id"), s(data, "msg_id")) {
+                    self.remember_turn(turn, msg);
+                }
+                self.on_conversation(user, data, &[ConversationWhat::Messages]).await
+            }
+            "conversation.nameUpdated" => self.on_conversation(user, data, &[ConversationWhat::Meta]).await,
+            "conversation.listChanged" => match s(data, "action") {
+                Some("deleted") => {
+                    if let Some(cid) = s(data, "conversation_id") {
+                        self.live.origins.lock().unwrap().remove(cid);
+                        self.record(
+                            user,
+                            ChangeEntry::ConversationRemoved {
+                                conversation_id: cid.to_owned(),
+                            },
+                        );
+                    }
+                }
+                _ => self.on_conversation(user, data, &[ConversationWhat::Meta]).await,
+            },
+            "confirmation.remove" => {
+                let (Some(cid), Some(id)) = (s(data, "conversation_id"), s(data, "id")) else {
+                    return;
+                };
+                if let Some(approval_id) = self.live.approvals.on_removed(cid, id) {
+                    self.approval_gone(user, cid, approval_id, Resolution::Answered).await;
+                }
+            }
+            "turn.completed" => {
+                let Some(cid) = s(data, "conversation_id") else { return };
+                for approval_id in self.live.approvals.on_turn_ended(cid) {
+                    self.approval_gone(user, cid, approval_id, Resolution::Cancelled).await;
+                }
+                self.on_conversation(user, data, &[ConversationWhat::Messages, ConversationWhat::State])
+                    .await;
+            }
+            "team.created" => {
+                if let Some(t) = team_id {
+                    self.record_team(user, t, &[TeamWhat::Meta, TeamWhat::Roster]);
+                }
+            }
+            "team.renamed" => {
+                if let Some(t) = team_id {
+                    self.record_team(user, t, &[TeamWhat::Meta]);
+                }
+            }
+            "team.removed" => {
+                if let Some(t) = team_id {
+                    self.forget_origins_of_team(t);
+                    self.shutdowns.lock().unwrap().retain(|(team, _), _| team != t);
+                    self.record(user, ChangeEntry::TeamRemoved { team_id: t.to_owned() });
+                }
+            }
+            "team.agentSpawned" | "team.agentRenamed" => {
+                if let Some(t) = team_id {
+                    self.forget_origins_of_team(t);
+                    self.record_team(user, t, &[TeamWhat::Roster]);
+                }
+            }
+            "team.agentRemoved" => {
+                if let Some(t) = team_id {
+                    self.forget_origins_of_team(t);
+                    if let Some(slot) = s(data, "slot_id") {
+                        self.shutdowns.lock().unwrap().remove(&(t.to_owned(), slot.to_owned()));
+                    }
+                    self.record_team(user, t, &[TeamWhat::Roster, TeamWhat::RunState]);
+                }
+            }
+            "team.sessionStatusChanged" => {
+                if let (Some(t), Some(status)) = (team_id, s(data, "status")) {
+                    self.live
+                        .session_status
+                        .lock()
+                        .unwrap()
+                        .insert(t.to_owned(), status.to_owned());
+                    self.record_team(user, t, &[TeamWhat::RunState]);
+                }
+            }
+            "team.taskChanged" => {
+                if let Some(t) = team_id {
+                    self.on_task(user, t, data).await;
+                }
+            }
+            "team.mailboxChanged" => {
+                if let Some(t) = team_id {
+                    self.on_mailbox(user, t, data);
+                }
+            }
+            n if RUN_STATE_EVENTS.contains(&n) => {
+                if let Some(t) = team_id {
+                    self.record_team(user, t, &[TeamWhat::RunState]);
+                }
+            }
+            _ => {}
+        }
+    }
+
+    async fn on_conversation(&self, user: &str, data: &Value, what: &[ConversationWhat]) {
+        let Some(cid) = s(data, "conversation_id") else { return };
+        let origin = self.origin(user, cid).await;
+        let (team_id, slot_id) = origin.map(|o| (o.team_id, o.slot_id)).unwrap_or_default();
+        if let Some(t) = &team_id
+            && what.contains(&ConversationWhat::State)
+        {
+            self.record_team(user, t, &[TeamWhat::RunState]);
+        }
+        self.record(
+            user,
+            ChangeEntry::Conversation {
+                conversation_id: cid.to_owned(),
+                team_id,
+                slot_id,
+                what: what.to_vec(),
+            },
+        );
+    }
+
+    async fn on_stream(&self, user: &str, data: &Value) {
+        let Some(cid) = s(data, "conversation_id") else { return };
+        let frame_type = s(data, "type").unwrap_or_default();
+        if frame_type == "tips" && data["data"]["source"] == "send_failed" {
+            self.link_send_failure(cid, data).await;
+        }
+        let mut what = vec![ConversationWhat::Messages];
+        if matches!(frame_type, "start" | "finish" | "error") {
+            what.push(ConversationWhat::State);
+        }
+        let is_approval = matches!(frame_type, "acp_permission" | "permission" | "ask");
+        let origin = if is_approval {
+            self.origin(user, cid).await
+        } else {
+            None
+        };
+        if is_approval && origin.is_none() {
+            tracing::warn!(
+                conversation_id = cid,
+                "mobile bridge: a permission frame's conversation could not be resolved; it will be recovered by a sweep"
+            );
+        }
+        if let Some(origin) = origin {
+            let frame = PermissionFrame {
+                origin,
+                frame_type: frame_type.to_owned(),
+                msg_id: s(data, "msg_id").unwrap_or_default().to_owned(),
+                data: data.get("data").cloned().unwrap_or(Value::Null),
+                at_ms: now_ms(),
+            };
+            if let Some(approval) = self.live.approvals.on_frame(frame) {
+                self.record(
+                    user,
+                    ChangeEntry::ApprovalAdded {
+                        approval: to_value(&approval),
+                    },
+                );
+            }
+            what.push(ConversationWhat::State);
+        }
+        self.on_conversation(user, data, &what).await;
+    }
+
+    fn remember_turn(&self, turn_id: &str, message_id: &str) {
+        let mut turns = self.live.turn_messages.lock().unwrap();
+        turns.push_back((turn_id.to_owned(), message_id.to_owned()));
+        while turns.len() > TURN_MEMORY {
+            turns.pop_front();
+        }
+    }
+
+    /// CONTRACT §6.4 rev 3.1: a failed mid-turn delivery marked its own message `error` just before; otherwise the
+    /// failure frame's turn names the message that started it. Team chats have neither and stay unlinked.
+    async fn link_send_failure(&self, conversation_id: &str, frame: &Value) {
+        let Some(failure_id) = s(frame, "msg_id") else { return };
+        let mid_turn = self.live.errored.lock().unwrap().remove(conversation_id);
+        let message_id = mid_turn.or_else(|| {
+            let turn = s(frame, "turn_id")?;
+            let turns = self.live.turn_messages.lock().unwrap();
+            turns.iter().rev().find(|(t, _)| t == turn).map(|(_, m)| m.clone())
+        });
+        let (Some(message_id), Some(store)) = (message_id, &self.store) else {
+            return;
+        };
+        if let Err(e) = store
+            .insert_send_failure(failure_id, conversation_id, &message_id, now_ms())
+            .await
+        {
+            tracing::warn!(error = %e, "mobile bridge: could not record a send failure link");
+        }
+    }
+
+    async fn approval_gone(&self, user: &str, conversation_id: &str, approval_id: String, resolution: Resolution) {
+        {
+            let now = now_ms();
+            let mut resolved = self.live.resolved.lock().unwrap();
+            resolved.retain(|_, r| now - r.at < RESOLVED_MEMORY_MS);
+            resolved.insert(
+                approval_id.clone(),
+                Resolved {
+                    user_id: user.to_owned(),
+                    resolution,
+                    at: now,
+                },
+            );
+        }
+        let team_id = self.origin(user, conversation_id).await.and_then(|o| o.team_id);
+        if let Some(t) = &team_id {
+            self.record_team(user, t, &[TeamWhat::RunState]);
+        }
+        self.record(
+            user,
+            ChangeEntry::ApprovalRemoved {
+                approval_id,
+                conversation_id: conversation_id.to_owned(),
+                team_id,
+                resolution,
+            },
+        );
+    }
+
+    async fn on_task(&self, user: &str, team_id: &str, data: &Value) {
+        let task = &data["task"];
+        let change = match s(data, "change") {
+            Some("created") => TaskChange::Created,
+            _ => TaskChange::Updated,
+        };
+        let names = self.slot_names(user, team_id).await;
+        self.record(
+            user,
+            ChangeEntry::Task {
+                team_id: team_id.to_owned(),
+                task: shape::task(task, &names, None),
+                change,
+            },
+        );
+        // currentTask and openTaskCount derive from the board.
+        self.record_team(user, team_id, &[TeamWhat::RunState]);
+    }
+
+    /// A teammate's refusal of a phone-sent shutdown arrives as a mailbox note to the lead.
+    fn on_mailbox(&self, user: &str, team_id: &str, data: &Value) {
+        let msg = &data["message"];
+        if s(data, "change") != Some("created") {
+            return;
+        }
+        let (Some(from), Some(reason)) = (
+            s(msg, "from_agent_id"),
+            s(msg, "content").and_then(declined_shutdown_reason),
+        ) else {
+            return;
+        };
+        let key = (team_id.to_owned(), from.to_owned());
+        let mut shutdowns = self.shutdowns.lock().unwrap();
+        let Some(state) = shutdowns.get_mut(&key).map(|p| &mut p.state) else {
+            return;
+        };
+        if state["state"] != "requested" {
+            return;
+        }
+        *state = json!({
+            "state": "rejected",
+            "requestedAt": state["requestedAt"],
+            "respondedAt": msg["created_at"].as_i64().unwrap_or_else(now_ms),
+            "rejectReason": reason,
+        });
+        drop(shutdowns);
+        self.record_team(user, team_id, &[TeamWhat::RunState]);
+    }
+
+    // ------------------------------------------------------------------ routes
+
+    pub(crate) async fn handle_live(
+        &self,
+        ctx: &InnerContext,
+        method: &str,
+        segs: &[&str],
+        q: &HashMap<String, String>,
+        body: &Value,
+    ) -> Option<InnerResponse> {
+        let user = ctx.user_id.as_str();
+        Some(match (method, segs) {
+            ("GET", ["v1", "changes"]) => self.changes(user, q).await,
+            ("GET", ["v1", "approvals"]) => self.approvals_list(user, q).await,
+            ("POST", ["v1", "approvals", id, "answer"]) => self.answer(ctx, id, body).await,
+            _ => return None,
+        })
+    }
+
+    async fn changes(&self, user: &str, q: &HashMap<String, String>) -> InnerResponse {
+        let wait = q
+            .get("wait")
+            .and_then(|w| w.parse::<u64>().ok())
+            .unwrap_or(0)
+            .min(MAX_WAIT_SECS);
+        let since = q.get("since").map(String::as_str).filter(|t| !t.is_empty());
+        let page = if wait == 0 {
+            self.live.journal.since(user, since, CHANGES_LIMIT, now_ms())
+        } else {
+            self.live
+                .journal
+                .wait_since(user, since, Duration::from_secs(wait), CHANGES_LIMIT)
+                .await
+        };
+        InnerResponse::ok(to_value(&page))
+    }
+
+    /// Reconciles one conversation against AionCore's pending confirmations.
+    async fn reconcile(&self, user: &str, conversation_id: &str) {
+        let Some(origin) = self.origin(user, conversation_id).await else {
+            return;
+        };
+        let listed = match self.backend.confirmations(user, conversation_id).await {
+            Ok(l) => l,
+            Err(e) => {
+                tracing::warn!(conversation_id, error = ?e, "mobile bridge: could not list confirmations");
+                return;
+            }
+        };
+        let (added, gone) = self.live.approvals.reconcile(&origin, &listed, now_ms());
+        for approval in added {
+            self.record(
+                user,
+                ChangeEntry::ApprovalAdded {
+                    approval: to_value(&approval),
+                },
+            );
+        }
+        for approval_id in gone {
+            self.approval_gone(user, conversation_id, approval_id, Resolution::Cancelled)
+                .await;
+        }
+    }
+
+    /// Reconciles every conversation that holds a tracked approval or has a live agent. The listing is the
+    /// recovery path for anything the event stream missed, so it sweeps every time (in-process calls, cheap).
+    pub(crate) async fn sweep(&self, user: &str) {
+        let mut convs: Vec<String> = self
+            .live
+            .approvals
+            .list(user, None)
+            .into_iter()
+            .map(|a| a.conversation_id)
+            .collect();
+        match self.backend.live_conversations(user).await {
+            Ok(live) => convs.extend(live),
+            Err(e) => tracing::warn!(error = ?e, "mobile bridge: approvals sweep could not list live conversations"),
+        }
+        convs.sort();
+        convs.dedup();
+        for cid in convs {
+            self.reconcile(user, &cid).await;
+        }
+    }
+
+    /// Self-healing for derived state: AionCore says this conversation has pending confirmations but nothing is
+    /// tracked for it (a frame was missed), so it is reconciled now, which also puts it on the feed.
+    pub(crate) async fn heal(&self, user: &str, conversation_id: &str, pending: u64) {
+        if pending == 0
+            || self
+                .live
+                .approvals
+                .list(user, None)
+                .iter()
+                .any(|a| a.conversation_id == conversation_id)
+        {
+            return;
+        }
+        tracing::info!(
+            conversation_id,
+            pending,
+            "mobile bridge: untracked pending confirmations; reconciling"
+        );
+        self.reconcile(user, conversation_id).await;
+    }
+
+    async fn approvals_list(&self, user: &str, q: &HashMap<String, String>) -> InnerResponse {
+        self.sweep(user).await;
+        let team = q.get("teamId").map(String::as_str).filter(|t| !t.is_empty());
+        let items: Vec<Value> = self.live.approvals.list(user, team).iter().map(to_value).collect();
+        InnerResponse::ok(json!({ "items": items }))
+    }
+
+    async fn answer(&self, ctx: &InnerContext, approval_id: &str, body: &Value) -> InnerResponse {
+        let user = ctx.user_id.as_str();
+        let Some(tracked) = self
+            .live
+            .approvals
+            .get(approval_id)
+            .filter(|t| t.origin.user_id == user)
+        else {
+            return self.not_pending(user, approval_id);
+        };
+        let input = match answer_input(body) {
+            Ok(i) => i,
+            Err(r) => return r,
+        };
+        let mapped = match map_answer(&tracked, input) {
+            Ok(m) => m,
+            Err(AnswerError::InvalidRequest(why)) => return InnerResponse::error(400, "invalid_request", why),
+            Err(AnswerError::Ambiguous(options)) => {
+                let mut r = InnerResponse::error(
+                    422,
+                    "ambiguous_decision",
+                    "The decision doesn't map to exactly one option; pick one",
+                );
+                if let Some(b) = r.body.as_mut() {
+                    b["error"]["details"] = json!({ "options": options });
+                }
+                return r;
+            }
+        };
+        if mapped.sensitive
+            && let Some(denied) = confirm_gate(ctx)
+        {
+            return denied;
+        }
+        // Still pending in AionCore? (It may have been answered on the PC a moment ago.)
+        if let BackendCall::Confirm { call_id, .. } = &mapped.call
+            && let Ok(listed) = self.backend.confirmations(user, &tracked.origin.conversation_id).await
+            && !listed.iter().any(|c| c["call_id"] == call_id.as_str())
+        {
+            self.resolved_elsewhere(user, &tracked).await;
+            return already_resolved();
+        }
+        let native = mapped.delivery == Some(MessageDelivery::Native);
+        let result = match mapped.call.clone() {
+            BackendCall::Confirm {
+                conversation_id,
+                msg_id,
+                call_id,
+                data,
+                always_allow,
+            } => {
+                let call = ConfirmCall {
+                    conversation_id,
+                    call_id,
+                    msg_id,
+                    data,
+                    always_allow,
+                    deny_message: if native { mapped.deny_message.clone() } else { None },
+                };
+                self.backend.confirm(user, call).await
+            }
+            BackendCall::AskAnswer {
+                conversation_id,
+                request_id,
+                answers,
+            } => {
+                self.backend
+                    .answer_ask(user, &conversation_id, &request_id, Some(answers))
+                    .await
+            }
+            BackendCall::AskDecline {
+                conversation_id,
+                request_id,
+            } => self.backend.answer_ask(user, &conversation_id, &request_id, None).await,
+        };
+        match result {
+            Ok(()) => {}
+            Err(BackendError::NotFound(_)) => {
+                self.resolved_elsewhere(user, &tracked).await;
+                return already_resolved();
+            }
+            Err(e) => return backend_error(e),
+        }
+        // A question has no confirmation.remove of its own unless it was also listed as a confirmation; drop it here
+        // so the tracker doesn't wait for a turn end.
+        if let Some(id) = self
+            .live
+            .approvals
+            .on_removed(&tracked.origin.conversation_id, &tracked.confirmation_id)
+            .or_else(|| self.live.approvals.take(approval_id))
+        {
+            self.approval_gone(user, &tracked.origin.conversation_id, id, Resolution::Answered)
+                .await;
+        }
+        let (delivery, message_error) = match (mapped.delivery, mapped.deny_message) {
+            (Some(MessageDelivery::Native), Some(_)) => (json!("native"), None),
+            (Some(MessageDelivery::Followup), Some(message)) => match self.follow_up(user, &tracked, &message).await {
+                Ok(()) => (json!("followup"), None),
+                Err(e) => (Value::Null, Some(format!("{e:?}"))),
+            },
+            _ => (Value::Null, None),
+        };
+        let mut out = json!({ "resolved": true, "messageDelivery": delivery });
+        if let Some(err) = message_error {
+            out["details"] = json!({ "messageError": err });
+        }
+        InnerResponse::ok(out)
+    }
+
+    async fn resolved_elsewhere(&self, user: &str, tracked: &TrackedApproval) {
+        if let Some(id) = self.live.approvals.take(&tracked.approval.approval_id) {
+            self.approval_gone(user, &tracked.origin.conversation_id, id, Resolution::Answered)
+                .await;
+        }
+    }
+
+    /// CONTRACT §6.5 follow-up: `Denied <title or toolName>: <message>`, sent respond-now to the same conversation.
+    async fn follow_up(&self, user: &str, tracked: &TrackedApproval, message: &str) -> Result<(), BackendError> {
+        let what = tracked
+            .approval
+            .title
+            .as_deref()
+            .or(tracked.approval.tool_name.as_deref())
+            .unwrap_or("the request");
+        let text = format!("Denied {what}: {message}");
+        let o = &tracked.origin;
+        match (&o.team_id, &o.slot_id) {
+            (Some(team), Some(slot)) => self
+                .backend
+                .send_to_agent(user, team, slot, &text, true)
+                .await
+                .map(|_| ()),
+            _ => self
+                .backend
+                .respond_now_solo(user, &o.conversation_id, &text)
+                .await
+                .map(|_| ()),
+        }
+    }
+}
+
+impl Facade {
+    /// An answer for an approval that isn't pending: `409` with how it ended when it was resolved in the last
+    /// `RESOLVED_MEMORY_MS` (answered elsewhere, a retry after a lost response, or the turn ended), else `404`.
+    fn not_pending(&self, user: &str, approval_id: &str) -> InnerResponse {
+        let resolved = self.live.resolved.lock().unwrap();
+        match resolved
+            .get(approval_id)
+            .filter(|r| r.user_id == user && now_ms() - r.at < RESOLVED_MEMORY_MS)
+        {
+            Some(r) => {
+                let mut resp = already_resolved();
+                if let Some(b) = resp.body.as_mut() {
+                    b["error"]["details"] = json!({ "resolution": r.resolution, "resolvedAt": r.at });
+                }
+                resp
+            }
+            None => InnerResponse::error(404, "not_found", "No such pending approval"),
+        }
+    }
+}
+
+fn already_resolved() -> InnerResponse {
+    InnerResponse::error(
+        409,
+        "already_resolved",
+        "This was already answered on the PC or by another device",
+    )
+}
+
+/// The answer body (CONTRACT §6.5): exactly one of `optionId`, `decision`, `answers`, `decline`.
+fn answer_input(body: &Value) -> Result<AnswerInput, InnerResponse> {
+    let bad = |m: &str| InnerResponse::error(400, "invalid_request", m);
+    let message = match body.get("message") {
+        None | Some(Value::Null) => None,
+        Some(Value::String(m)) => Some(m.clone()),
+        Some(_) => return Err(bad("message must be a string")),
+    };
+    let present = ["optionId", "decision", "answers", "decline"]
+        .iter()
+        .filter(|k| body.get(**k).is_some_and(|v| !v.is_null()))
+        .count();
+    if present != 1 {
+        return Err(bad("exactly one of optionId, decision, answers or decline is required"));
+    }
+    if let Some(id) = body.get("optionId") {
+        let id = id.as_str().ok_or_else(|| bad("optionId must be a string"))?;
+        return Ok(AnswerInput::Option {
+            option_id: id.to_owned(),
+            message,
+        });
+    }
+    if let Some(d) = body.get("decision") {
+        let decision = match d.as_str() {
+            Some("allow_once") => Decision::AllowOnce,
+            Some("allow_always") => Decision::AllowAlways,
+            Some("deny") => Decision::Deny,
+            _ => return Err(bad("decision must be allow_once, allow_always or deny")),
+        };
+        return Ok(AnswerInput::Decision { decision, message });
+    }
+    if let Some(a) = body.get("answers") {
+        if message.is_some() {
+            return Err(bad("a message is only accepted on a refusal"));
+        }
+        let answers: Vec<QuestionAnswer> =
+            serde_json::from_value(a.clone()).map_err(|e| bad(&format!("Invalid answers: {e}")))?;
+        return Ok(AnswerInput::Answers { answers });
+    }
+    match body.get("decline") {
+        Some(Value::Bool(true)) => Ok(AnswerInput::Decline { message }),
+        _ => Err(bad("decline must be true")),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn reads_the_declined_shutdown_note() {
+        assert_eq!(
+            declined_shutdown_reason("Teammate 'Bob' declined shutdown: still running the migration"),
+            Some("still running the migration")
+        );
+        assert_eq!(declined_shutdown_reason("Teammate 'Bob' said hi"), None);
+        assert_eq!(declined_shutdown_reason("hello"), None);
+    }
+
+    #[test]
+    fn answer_bodies() {
+        assert!(matches!(
+            answer_input(&json!({ "optionId": "o1" })),
+            Ok(AnswerInput::Option { .. })
+        ));
+        assert!(matches!(
+            answer_input(&json!({ "decision": "deny", "message": "no" })),
+            Ok(AnswerInput::Decision {
+                decision: Decision::Deny,
+                message: Some(_)
+            })
+        ));
+        assert!(matches!(
+            answer_input(&json!({ "answers": [{ "question": "Q", "labels": ["A"] }] })),
+            Ok(AnswerInput::Answers { .. })
+        ));
+        assert!(matches!(
+            answer_input(&json!({ "decline": true })),
+            Ok(AnswerInput::Decline { message: None })
+        ));
+        for bad in [
+            json!({}),
+            json!({ "optionId": "o1", "decision": "deny" }),
+            json!({ "decision": "maybe" }),
+            json!({ "decline": false }),
+            json!({ "answers": [], "message": "x" }),
+            json!({ "optionId": 3 }),
+        ] {
+            let r = answer_input(&bad).expect_err("rejected");
+            assert_eq!(r.status, 400, "{bad}");
+        }
+    }
+}
diff --git a/crates/aionui-mobile/src/facade_write.rs b/crates/aionui-mobile/src/facade_write.rs
new file mode 100644
index 00000000..75284f3e
--- /dev/null
+++ b/crates/aionui-mobile/src/facade_write.rs
@@ -0,0 +1,590 @@
+//! The facade's write side (CONTRACT §6.4, §6.6, §6.7): sends, read markers,
+//! broadcasts, agent controls, session start, task writes. Sensitive actions
+//! (§5.1) need a verified confirm proof unless the PC relaxed it for the phone.
+
+use std::collections::HashMap;
+
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+use crate::backend::{SoloSpec, TaskCreate, TaskPatch};
+use crate::core::{ConfirmCheck, InnerContext};
+use crate::facade::{Facade, backend_error, from_opaque, opaque, page_limit, to_value};
+use crate::shape::{self, AgentExtras};
+use crate::store::BroadcastRow;
+use crate::wire::{InnerRequest, InnerResponse};
+
+const MAX_CONTENT: usize = 100_000;
+
+/// §5: 428 without a proof, 403 with a wrong one.
+pub(crate) fn confirm_gate(ctx: &InnerContext) -> Option<InnerResponse> {
+    match ctx.confirm {
+        ConfirmCheck::NotRequired | ConfirmCheck::Verified => None,
+        ConfirmCheck::Missing => Some(InnerResponse::error(
+            428,
+            "confirm_required",
+            "This action needs confirmation on the phone",
+        )),
+        ConfirmCheck::Invalid => Some(InnerResponse::error(
+            403,
+            "confirm_invalid",
+            "The confirmation proof did not verify",
+        )),
+    }
+}
+
+fn invalid(msg: impl Into<String>) -> InnerResponse {
+    InnerResponse::error(400, "invalid_request", msg)
+}
+
+fn parse<T: for<'de> Deserialize<'de>>(body: &Value) -> Result<T, InnerResponse> {
+    serde_json::from_value(body.clone()).map_err(|e| invalid(format!("Invalid body: {e}")))
+}
+
+fn content_of(body: &Value) -> Result<String, InnerResponse> {
+    match body.get("content").and_then(Value::as_str).map(str::trim) {
+        Some(c) if !c.is_empty() && c.len() <= MAX_CONTENT => Ok(c.to_owned()),
+        Some(c) if c.len() > MAX_CONTENT => Err(invalid("content is too long")),
+        _ => Err(invalid("content must be a non-empty string")),
+    }
+}
+
+fn ok_or_error<T>(r: Result<T, crate::backend::BackendError>, f: impl FnOnce(T) -> InnerResponse) -> InnerResponse {
+    match r {
+        Ok(v) => f(v),
+        Err(e) => backend_error(e),
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct SendBody {
+    #[allow(dead_code)]
+    content: String,
+    #[serde(default)]
+    priority: Option<String>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct CreateSoloBody {
+    assistant_id: Option<String>,
+    backend: Option<String>,
+    name: Option<String>,
+    workspace: Option<String>,
+    model: Option<String>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct SpawnBody {
+    assistant_id: String,
+    name: Option<String>,
+    model: Option<String>,
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct TaskCreateBody {
+    subject: String,
+    description: Option<String>,
+    owner: Option<String>,
+    #[serde(default)]
+    blocked_by: Vec<String>,
+}
+
+impl Facade {
+    pub(crate) async fn handle_write(
+        &self,
+        ctx: &InnerContext,
+        req: &InnerRequest,
+        segs: &[&str],
+        q: &HashMap<String, String>,
+    ) -> Option<InnerResponse> {
+        let body = req.body.clone().unwrap_or(Value::Null);
+        let user = ctx.user_id.as_str();
+        Some(match (req.method.as_str(), segs) {
+            ("POST", ["v1", "conversations"]) => self.create_solo(user, &body).await,
+            ("POST", ["v1", "conversations", c, "messages"]) => self.send(user, c, &body).await,
+            ("POST", ["v1", "conversations", c, "read"]) => self.mark_read(user, c, &body).await,
+            ("POST", ["v1", "teams", t, "broadcast"]) => self.broadcast(ctx, t, &body).await,
+            ("GET", ["v1", "teams", t, "broadcasts"]) => self.broadcasts(user, t, q).await,
+            ("POST", ["v1", "teams", t, "session"]) => match self.backend.start_session(user, t).await {
+                Ok(()) => self.run_state(user, t).await.unwrap_or_else(backend_error),
+                Err(e) => backend_error(e),
+            },
+            ("POST", ["v1", "teams", t, "agents"]) => self.spawn(ctx, t, &body).await,
+            ("PATCH", ["v1", "teams", t, "agents", slot]) => self.rename(user, t, slot, &body).await,
+            ("DELETE", ["v1", "teams", t, "agents", slot]) => self.force_remove(ctx, t, slot).await,
+            ("POST", ["v1", "teams", t, "agents", slot, "wake"]) => self.wake(user, t, slot, &body).await,
+            ("POST", ["v1", "teams", t, "agents", slot, "stop"]) => self.stop(user, t, slot, &body).await,
+            ("POST", ["v1", "teams", t, "agents", slot, "shutdown"]) => self.shutdown(ctx, t, slot, &body).await,
+            ("POST", ["v1", "teams", t, "agents", slot, "clear-context"]) => {
+                if let Some(denied) = confirm_gate(ctx) {
+                    return Some(denied);
+                }
+                ok_or_error(self.backend.clear_context(user, t, slot).await, |n| {
+                    InnerResponse::ok(json!({ "preservedUnread": n }))
+                })
+            }
+            ("POST", ["v1", "teams", t, "tasks"]) => self.create_task(user, t, &body).await,
+            ("PATCH", ["v1", "teams", t, "tasks", id]) => self.update_task(ctx, t, id, &body).await,
+            _ => return None,
+        })
+    }
+
+    async fn create_solo(&self, user: &str, body: &Value) -> InnerResponse {
+        let b: CreateSoloBody = match parse(body) {
+            Ok(b) => b,
+            Err(e) => return e,
+        };
+        if b.assistant_id.is_some() == b.backend.is_some() {
+            return invalid("Give exactly one of assistantId or backend");
+        }
+        if let Some(ws) = &b.workspace {
+            // The phone may only pick a workspace the user already uses (CONTRACT §6.4).
+            let known = match self.workspaces(user).await {
+                Ok(r) => r.body.unwrap_or(Value::Null),
+                Err(e) => return backend_error(e),
+            };
+            let allowed = known
+                .as_array()
+                .into_iter()
+                .flatten()
+                .any(|w| w["path"].as_str() == Some(ws.as_str()));
+            if !allowed {
+                return invalid("workspace must be one of GET /v1/workspaces");
+            }
+        }
+        let spec = SoloSpec {
+            assistant_id: b.assistant_id,
+            agent_backend: b.backend,
+            name: b.name,
+            workspace: b.workspace,
+            model: b.model,
+        };
+        ok_or_error(self.backend.create_solo(user, spec).await, |c| {
+            InnerResponse::ok(shape::conversation(&to_value(&c), None, &AgentExtras::default()))
+        })
+    }
+
+    async fn send(&self, user: &str, conversation_id: &str, body: &Value) -> InnerResponse {
+        let content = match content_of(body) {
+            Ok(c) => c,
+            Err(e) => return e,
+        };
+        let b: SendBody = match parse(body) {
+            Ok(b) => b,
+            Err(e) => return e,
+        };
+        let now = match b.priority.as_deref() {
+            None | Some("normal") => false,
+            Some("now") => true,
+            Some(_) => return invalid("priority must be normal or now"),
+        };
+        let conv = match self.backend.conversation(user, conversation_id).await {
+            Ok(c) => to_value(&c),
+            Err(e) => return backend_error(e),
+        };
+        let extra = &conv["extra"];
+        let result = match (
+            extra["teamId"].as_str().filter(|t| !t.is_empty()),
+            extra["slot_id"].as_str(),
+        ) {
+            (Some(team), Some(slot)) => self.backend.send_to_agent(user, team, slot, &content, now).await,
+            (Some(_), None) => return InnerResponse::error(409, "conflict", "This team chat has no slot"),
+            _ => self.backend.send_solo(user, conversation_id, &content).await,
+        };
+        ok_or_error(result, |o| {
+            InnerResponse::ok(json!({ "messageId": o.message_id, "delivery": o.delivery }))
+        })
+    }
+
+    async fn mark_read(&self, user: &str, conversation_id: &str, body: &Value) -> InnerResponse {
+        let Some(up_to) = body
+            .get("upToMessageId")
+            .and_then(Value::as_str)
+            .filter(|s| !s.is_empty())
+        else {
+            return invalid("upToMessageId is required");
+        };
+        let value = json!({ "messageId": up_to, "at": aionui_common::now_ms() }).to_string();
+        let key = format!("aiondx.read.{conversation_id}");
+        if let Err(e) = self.backend.set_pref(user, &key, &value).await {
+            return backend_error(e);
+        }
+        self.live.journal.record(
+            user,
+            crate::journal::ChangeEntry::Conversation {
+                conversation_id: conversation_id.to_owned(),
+                team_id: None,
+                slot_id: None,
+                what: vec![crate::journal::ConversationWhat::Read],
+            },
+            aionui_common::now_ms(),
+        );
+        InnerResponse::ok(json!({}))
+    }
+
+    async fn broadcast(&self, ctx: &InnerContext, team_id: &str, body: &Value) -> InnerResponse {
+        let user = ctx.user_id.as_str();
+        let content = match content_of(body) {
+            Ok(c) => c,
+            Err(e) => return e,
+        };
+        let team = match self.backend.team(user, team_id).await {
+            Ok(t) => to_value(&t),
+            Err(e) => return backend_error(e),
+        };
+        let mut deliveries = Vec::new();
+        for a in team["assistants"].as_array().into_iter().flatten() {
+            let Some(slot) = a["slot_id"].as_str() else { continue };
+            deliveries.push(
+                match self.backend.send_to_agent(user, team_id, slot, &content, false).await {
+                    Ok(o) => json!({ "slotId": slot, "messageId": o.message_id, "delivery": o.delivery }),
+                    Err(e) => {
+                        json!({ "slotId": slot, "messageId": null, "delivery": "failed", "error": format!("{e:?}") })
+                    }
+                },
+            );
+        }
+        let device_name = match &self.store {
+            Some(store) => store
+                .device(&ctx.device_id)
+                .await
+                .ok()
+                .flatten()
+                .map(|d| d.name)
+                .unwrap_or_default(),
+            None => String::new(),
+        };
+        let row = BroadcastRow {
+            broadcast_id: crate::crypto::b64u(&crate::host_key::random_bytes::<12>().unwrap_or_default()),
+            user_id: user.to_owned(),
+            team_id: team_id.to_owned(),
+            content,
+            created_at: aionui_common::now_ms(),
+            device_id: ctx.device_id.clone(),
+            device_name,
+            deliveries: Value::Array(deliveries).to_string(),
+        };
+        if let Some(store) = &self.store
+            && let Err(e) = store.insert_broadcast(&row).await
+        {
+            tracing::error!(error = %e, "mobile bridge: could not record a broadcast");
+        }
+        self.live.journal.record(
+            user,
+            crate::journal::ChangeEntry::Broadcast {
+                team_id: team_id.to_owned(),
+                broadcast_id: row.broadcast_id.clone(),
+            },
+            row.created_at,
+        );
+        InnerResponse::ok(broadcast_json(&row))
+    }
+
+    async fn broadcasts(&self, user: &str, team_id: &str, q: &HashMap<String, String>) -> InnerResponse {
+        let Some(store) = &self.store else {
+            return InnerResponse::ok(json!({ "items": [], "nextCursor": null }));
+        };
+        if let Err(e) = self.backend.team(user, team_id).await {
+            return backend_error(e);
+        }
+        let limit = page_limit(q) as i64;
+        let before = q
+            .get("cursor")
+            .and_then(|c| from_opaque(c))
+            .and_then(|v| Some((v["at"].as_i64()?, v["id"].as_str()?.to_owned())));
+        match store.broadcasts(user, team_id, before, limit).await {
+            Ok(rows) => {
+                let next = (rows.len() as i64 == limit)
+                    .then(|| {
+                        rows.last()
+                            .map(|r| opaque(&json!({ "at": r.created_at, "id": r.broadcast_id })))
+                    })
+                    .flatten();
+                InnerResponse::ok(
+                    json!({ "items": rows.iter().map(broadcast_json).collect::<Vec<_>>(), "nextCursor": next }),
+                )
+            }
+            Err(e) => InnerResponse::error(503, "backend_unavailable", e.to_string()),
+        }
+    }
+
+    async fn role_of(&self, user: &str, team_id: &str, slot: &str) -> Result<String, InnerResponse> {
+        let team = self.backend.team(user, team_id).await.map_err(backend_error)?;
+        to_value(&team)["assistants"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .find(|a| a["slot_id"] == slot)
+            .and_then(|a| a["role"].as_str().map(str::to_owned))
+            .ok_or_else(|| InnerResponse::error(404, "not_found", format!("No agent {slot} in this team")))
+    }
+
+    async fn spawn(&self, ctx: &InnerContext, team_id: &str, body: &Value) -> InnerResponse {
+        if let Some(denied) = confirm_gate(ctx) {
+            return denied;
+        }
+        let b: SpawnBody = match parse(body) {
+            Ok(b) => b,
+            Err(e) => return e,
+        };
+        let name = match b.name.as_deref().map(str::trim).filter(|n| !n.is_empty()) {
+            Some(n) => n.to_owned(),
+            None => match self.backend.assistants(&ctx.user_id).await {
+                Ok(list) => match list.iter().map(to_value).find(|a| a["id"] == b.assistant_id.as_str()) {
+                    Some(a) => a["name"].as_str().unwrap_or("Agent").to_owned(),
+                    None => return InnerResponse::error(404, "not_found", "No such assistant"),
+                },
+                Err(e) => return backend_error(e),
+            },
+        };
+        let spawned = self
+            .backend
+            .spawn_agent(&ctx.user_id, team_id, &b.assistant_id, Some(&name), b.model.as_deref())
+            .await;
+        ok_or_error(spawned, |a| {
+            InnerResponse::ok(shape::agent(&to_value(&a), None, &[], &AgentExtras::default()))
+        })
+    }
+
+    async fn rename(&self, user: &str, team_id: &str, slot: &str, body: &Value) -> InnerResponse {
+        let Some(name) = body
+            .get("name")
+            .and_then(Value::as_str)
+            .map(str::trim)
+            .filter(|n| !n.is_empty())
+        else {
+            return invalid("name is required");
+        };
+        if let Err(e) = self.backend.rename_agent(user, team_id, slot, name).await {
+            return backend_error(e);
+        }
+        self.agent(user, team_id, slot).await.unwrap_or_else(backend_error)
+    }
+
+    async fn force_remove(&self, ctx: &InnerContext, team_id: &str, slot: &str) -> InnerResponse {
+        if let Some(denied) = confirm_gate(ctx) {
+            return denied;
+        }
+        match self.role_of(&ctx.user_id, team_id, slot).await {
+            Ok(role) if role == "lead" => {
+                return InnerResponse::error(422, "lead_not_allowed", "The team lead can't be removed");
+            }
+            Ok(_) => {}
+            Err(e) => return e,
+        }
+        ok_or_error(self.backend.remove_agent(&ctx.user_id, team_id, slot).await, |()| {
+            self.shutdowns
+                .lock()
+                .unwrap()
+                .remove(&(team_id.to_owned(), slot.to_owned()));
+            InnerResponse::ok(json!({ "removed": true }))
+        })
+    }
+
+    async fn wake(&self, user: &str, team_id: &str, slot: &str, body: &Value) -> InnerResponse {
+        if let Err(e) = self.backend.wake_agent(user, team_id, slot).await {
+            return backend_error(e);
+        }
+        if let Some(nudge) = body
+            .get("nudge")
+            .and_then(Value::as_str)
+            .map(str::trim)
+            .filter(|n| !n.is_empty())
+            && let Err(e) = self.backend.send_to_agent(user, team_id, slot, nudge, false).await
+        {
+            return backend_error(e);
+        }
+        match self.agent(user, team_id, slot).await {
+            Ok(r) => InnerResponse::ok(json!({ "runtime": r.body.as_ref().map(|a| a["runtime"].clone()) })),
+            Err(e) => backend_error(e),
+        }
+    }
+
+    async fn stop(&self, user: &str, team_id: &str, slot: &str, body: &Value) -> InnerResponse {
+        let replacement = body
+            .get("replacementMessage")
+            .and_then(Value::as_str)
+            .map(str::trim)
+            .filter(|m| !m.is_empty());
+        let role = match self.role_of(user, team_id, slot).await {
+            Ok(r) => r,
+            Err(e) => return e,
+        };
+        if let Some(message) = replacement {
+            if role == "lead" {
+                return InnerResponse::error(
+                    422,
+                    "lead_not_allowed",
+                    "The team lead can't be interrupted with a replacement",
+                );
+            }
+            return ok_or_error(self.backend.interrupt_agent(user, team_id, slot, message).await, |()| {
+                InnerResponse::ok(json!({ "outcome": "interrupted" }))
+            });
+        }
+        let run = match self.backend.run_state(user, team_id).await {
+            Ok(r) => to_value(&r),
+            Err(e) => return backend_error(e),
+        };
+        let work = run["slot_work"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .find(|w| w["slot_id"] == slot);
+        let active = work.and_then(|w| Some((w["active_turn_id"].as_str()?, w["team_run_id"].as_str()?)));
+        match active {
+            Some((_, run_id)) => ok_or_error(
+                self.backend.cancel_child_turn(user, team_id, run_id, slot).await,
+                |()| InnerResponse::ok(json!({ "outcome": "cancelled" })),
+            ),
+            None => InnerResponse::ok(json!({ "outcome": "no_active_turn" })),
+        }
+    }
+
+    async fn shutdown(&self, ctx: &InnerContext, team_id: &str, slot: &str, body: &Value) -> InnerResponse {
+        if let Some(denied) = confirm_gate(ctx) {
+            return denied;
+        }
+        match self.role_of(&ctx.user_id, team_id, slot).await {
+            Ok(role) if role == "lead" => {
+                return InnerResponse::error(422, "lead_not_allowed", "The team lead can't be shut down");
+            }
+            Ok(_) => {}
+            Err(e) => return e,
+        }
+        let reason = body
+            .get("reason")
+            .and_then(Value::as_str)
+            .map(str::trim)
+            .filter(|r| !r.is_empty());
+        ok_or_error(
+            self.backend.shutdown_agent(&ctx.user_id, team_id, slot, reason).await,
+            |()| {
+                self.shutdowns.lock().unwrap().insert(
+                    (team_id.to_owned(), slot.to_owned()),
+                    crate::facade_live::PendingShutdown {
+                        user_id: ctx.user_id.clone(),
+                        state: json!({ "state": "requested", "requestedAt": aionui_common::now_ms(), "reason": reason }),
+                    },
+                );
+                InnerResponse::ok(json!({ "outcome": "requested" }))
+            },
+        )
+    }
+
+    async fn tasks_write_enabled(&self, user: &str) -> bool {
+        match &self.store {
+            Some(store) => store
+                .load_settings(user)
+                .await
+                .ok()
+                .flatten()
+                .is_none_or(|s| s.tasks_write),
+            None => true,
+        }
+    }
+
+    pub(crate) async fn slot_names(&self, user: &str, team_id: &str) -> HashMap<String, String> {
+        match self.backend.team(user, team_id).await {
+            Ok(t) => to_value(&t)["assistants"]
+                .as_array()
+                .into_iter()
+                .flatten()
+                .filter_map(|a| Some((a["slot_id"].as_str()?.to_owned(), a["name"].as_str()?.to_owned())))
+                .collect(),
+            Err(_) => HashMap::new(),
+        }
+    }
+
+    async fn create_task(&self, user: &str, team_id: &str, body: &Value) -> InnerResponse {
+        if !self.tasks_write_enabled(user).await {
+            return InnerResponse::error(403, "capability_disabled", "Task writes are switched off on the PC");
+        }
+        let b: TaskCreateBody = match parse(body) {
+            Ok(b) => b,
+            Err(e) => return e,
+        };
+        if b.subject.trim().is_empty() {
+            return invalid("subject is required");
+        }
+        let task = TaskCreate {
+            subject: b.subject.trim().to_owned(),
+            description: b.description,
+            owner: b.owner,
+            blocked_by: b.blocked_by,
+        };
+        let names = self.slot_names(user, team_id).await;
+        ok_or_error(self.backend.create_task(user, team_id, task).await, |t| {
+            InnerResponse::ok(shape::task(&to_value(&t), &names, None))
+        })
+    }
+
+    async fn update_task(&self, ctx: &InnerContext, team_id: &str, task_id: &str, body: &Value) -> InnerResponse {
+        let user = ctx.user_id.as_str();
+        if !self.tasks_write_enabled(user).await {
+            return InnerResponse::error(403, "capability_disabled", "Task writes are switched off on the PC");
+        }
+        let Some(obj) = body.as_object() else {
+            return invalid("body must be an object");
+        };
+        let allowed = ["subject", "description", "status", "owner", "blockedBy"];
+        if let Some(bad) = obj.keys().find(|k| !allowed.contains(&k.as_str())) {
+            return invalid(format!("unknown field {bad}"));
+        }
+        let str_field = |k: &str| obj.get(k).and_then(Value::as_str).map(str::to_owned);
+        let status = str_field("status");
+        if status.as_deref() == Some("deleted")
+            && let Some(denied) = confirm_gate(ctx)
+        {
+            return denied;
+        }
+        if let Some(s) = &status
+            && !["pending", "in_progress", "completed", "deleted"].contains(&s.as_str())
+        {
+            return invalid("unknown status");
+        }
+        let owner = match obj.get("owner") {
+            None => None,
+            Some(Value::Null) => Some(None),
+            Some(Value::String(s)) => Some(Some(s.clone())),
+            Some(_) => return invalid("owner must be a slot id, \"user\" or null"),
+        };
+        let blocked_by = match obj.get("blockedBy") {
+            None => None,
+            Some(v) => match serde_json::from_value::<Vec<String>>(v.clone()) {
+                Ok(list) => Some(list),
+                Err(_) => return invalid("blockedBy must be a list of task ids"),
+            },
+        };
+        let subject = str_field("subject").map(|s| s.trim().to_owned());
+        if subject.as_deref() == Some("") {
+            return invalid("subject can't be empty");
+        }
+        let patch = TaskPatch {
+            subject,
+            description: str_field("description"),
+            status,
+            owner,
+            blocked_by,
+        };
+        let names = self.slot_names(user, team_id).await;
+        ok_or_error(self.backend.update_task(user, team_id, task_id, patch).await, |t| {
+            InnerResponse::ok(shape::task(&to_value(&t), &names, None))
+        })
+    }
+}
+
+fn broadcast_json(r: &BroadcastRow) -> Value {
+    json!({
+        "broadcastId": r.broadcast_id,
+        "teamId": r.team_id,
+        "content": r.content,
+        "createdAt": r.created_at,
+        "sentFrom": { "kind": "mobile", "deviceId": r.device_id, "deviceName": r.device_name },
+        "deliveries": serde_json::from_str::<Value>(&r.deliveries).unwrap_or_else(|_| json!([])),
+    })
+}
diff --git a/crates/aionui-mobile/src/firewall.rs b/crates/aionui-mobile/src/firewall.rs
new file mode 100644
index 00000000..9da969f5
--- /dev/null
+++ b/crates/aionui-mobile/src/firewall.rs
@@ -0,0 +1,590 @@
+//! The Windows Firewall rule that lets phones on the LAN reach the bridge (CONTRACT §2, PHASE5-NET-SPEC part C).
+//!
+//! This module only builds and parses `netsh` command plans. It never adds or deletes a rule itself: adding needs
+//! elevation and the user's switch, and the desktop side runs the add plan through the app's own `elevate.exe`.
+//! The one executor here, [`ShowOnlyRunner`], refuses every plan except the read-only `show rule` one.
+//!
+//! The rule is scoped as the spec says: inbound TCP on the bridge's port, the Private profile only, and only for the
+//! given program. Which remote addresses may connect is the listener's job (`peer_filter`), not the rule's.
+//!
+//! Plans are argument vectors handed to the program directly, never a shell string, so a path cannot add arguments.
+//! A path `netsh` could misread (a `"`, a control character, an `=`) is refused instead of quoted around.
+//!
+//! `netsh` output is localized. [`parse_show_rule`] reads the English labels; on a Windows in another language it
+//! finds no rule and reports `present: false`, never a panic. Callers should treat that as "unknown".
+
+use std::path::Path;
+
+/// The rule's display name. `show` and `delete` find the rule by it.
+pub const RULE_NAME: &str = "AionDX mobile bridge";
+
+/// What would be executed: `program` with `args`, each argument passed as is (no shell, no joining).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct FirewallPlan {
+    pub program: String,
+    pub args: Vec<String>,
+}
+
+/// What `show rule` said about the rule. `Default` is "not there".
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub struct RuleStatus {
+    /// At least one rule with [`RULE_NAME`] exists.
+    pub present: bool,
+    /// Every rule with that name is enabled.
+    pub enabled: bool,
+    /// Every rule with that name applies to the Private profile and to no other profile.
+    pub private_only: bool,
+    /// The one local port every rule with that name opens; `None` for "Any", a range, a list, or rules that differ.
+    pub port: Option<u16>,
+}
+
+/// Why an add plan was not built.
+#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
+pub enum PlanError {
+    #[error("the program path is not valid Unicode")]
+    NotUnicode,
+    #[error("the program path must be an absolute path to a file: {0}")]
+    NotAbsoluteFile(String),
+    #[error("the program path contains a character netsh cannot take safely: {0}")]
+    UnsafePath(String),
+    #[error("port 0 cannot be opened")]
+    ZeroPort,
+}
+
+/// `%SystemRoot%\System32\netsh.exe`, by absolute path so nothing on `PATH` or in the working directory stands in
+/// for it. Falls back to `C:\Windows` when `SystemRoot` is missing or not an absolute path.
+pub fn netsh_program() -> String {
+    let root = std::env::var("SystemRoot")
+        .ok()
+        .filter(|r| Path::new(r).is_absolute())
+        .unwrap_or_else(|| String::from(r"C:\Windows"));
+    let root = root.trim_end_matches(['\\', '/']);
+    format!(r"{root}\System32\netsh.exe")
+}
+
+fn rule_name_arg() -> String {
+    format!("name={RULE_NAME}")
+}
+
+/// `netsh advfirewall firewall add rule name="AionDX mobile bridge" dir=in action=allow protocol=TCP
+///  localport=<port> profile=private program="<exe>" enable=yes`
+///
+/// Needs elevation to run; this only builds it.
+pub fn add_rule_plan(exe_path: &Path, port: u16) -> Result<FirewallPlan, PlanError> {
+    if port == 0 {
+        return Err(PlanError::ZeroPort);
+    }
+    let exe = exe_path.to_str().ok_or(PlanError::NotUnicode)?;
+    if !exe_path.is_absolute() || exe.ends_with(['\\', '/']) {
+        return Err(PlanError::NotAbsoluteFile(exe.to_string()));
+    }
+    // A `"` would end netsh's own quoting early, and a control character could end the line; `=` makes the
+    // `program=<value>` token ambiguous to netsh's key=value reader. None of them is in a normal install path.
+    if exe.chars().any(|c| c == '"' || c == '=' || c.is_control()) {
+        return Err(PlanError::UnsafePath(exe.to_string()));
+    }
+    Ok(FirewallPlan {
+        program: netsh_program(),
+        args: vec![
+            "advfirewall".into(),
+            "firewall".into(),
+            "add".into(),
+            "rule".into(),
+            rule_name_arg(),
+            "dir=in".into(),
+            "action=allow".into(),
+            "protocol=TCP".into(),
+            format!("localport={port}"),
+            "profile=private".into(),
+            format!("program={exe}"),
+            "enable=yes".into(),
+        ],
+    })
+}
+
+/// `netsh advfirewall firewall delete rule name="AionDX mobile bridge"`. Needs elevation to run; this only builds it.
+pub fn remove_rule_plan() -> FirewallPlan {
+    FirewallPlan {
+        program: netsh_program(),
+        args: vec![
+            "advfirewall".into(),
+            "firewall".into(),
+            "delete".into(),
+            "rule".into(),
+            rule_name_arg(),
+        ],
+    }
+}
+
+/// Read-only, needs no admin: `netsh advfirewall firewall show rule name="AionDX mobile bridge" verbose`.
+pub fn show_rule_plan() -> FirewallPlan {
+    FirewallPlan {
+        program: netsh_program(),
+        args: vec![
+            "advfirewall".into(),
+            "firewall".into(),
+            "show".into(),
+            "rule".into(),
+            rule_name_arg(),
+            "verbose".into(),
+        ],
+    }
+}
+
+/// Read-only, needs no admin: `netsh advfirewall show privateprofile state`, whether Windows Firewall is on for the
+/// Private profile (the only profile the rule is for).
+pub fn profile_state_plan() -> FirewallPlan {
+    FirewallPlan {
+        program: netsh_program(),
+        args: vec![
+            "advfirewall".into(),
+            "show".into(),
+            "privateprofile".into(),
+            "state".into(),
+        ],
+    }
+}
+
+/// `State  ON` / `State  OFF` from `show privateprofile state` (English labels). `None` when it can't be read, e.g. a
+/// non-English Windows.
+pub fn parse_profile_state(output: &str) -> Option<bool> {
+    output.lines().find_map(|line| {
+        let rest = line.trim().strip_prefix("State")?;
+        match rest.trim() {
+            "ON" => Some(true),
+            "OFF" => Some(false),
+            _ => None,
+        }
+    })
+}
+
+/// Whether Windows Firewall is on for the Private profile, read-only; `None` when unknown.
+pub async fn query_firewall_enabled(runner: &dyn NetshRunner) -> Option<bool> {
+    runner
+        .run(&profile_state_plan())
+        .await
+        .ok()
+        .and_then(|out| parse_profile_state(&out))
+}
+
+/// Parses `show rule ... verbose` output (English labels): one block per rule, each starting with `Rule Name:`.
+/// Anything it cannot read, including localized output, comes out as `present: false`.
+pub fn parse_show_rule(output: &str) -> RuleStatus {
+    struct Block {
+        enabled: bool,
+        profiles: Vec<String>,
+        port: Option<u16>,
+    }
+    let mut blocks: Vec<Block> = Vec::new();
+    let mut current: Option<Block> = None;
+
+    for line in output.lines() {
+        let Some((key, value)) = line.split_once(':') else {
+            continue;
+        };
+        let key = key.trim();
+        let value = value.trim();
+        if key.eq_ignore_ascii_case("Rule Name") {
+            if let Some(b) = current.take() {
+                blocks.push(b);
+            }
+            if value.eq_ignore_ascii_case(RULE_NAME) {
+                current = Some(Block {
+                    enabled: false,
+                    profiles: Vec::new(),
+                    port: None,
+                });
+            }
+            continue;
+        }
+        let Some(b) = current.as_mut() else { continue };
+        if key.eq_ignore_ascii_case("Enabled") {
+            b.enabled = value.eq_ignore_ascii_case("Yes");
+        } else if key.eq_ignore_ascii_case("Profiles") {
+            b.profiles = value
+                .split(',')
+                .map(|p| p.trim().to_ascii_lowercase())
+                .filter(|p| !p.is_empty())
+                .collect();
+        } else if key.eq_ignore_ascii_case("LocalPort") {
+            b.port = value.parse::<u16>().ok().filter(|p| *p != 0);
+        }
+    }
+    if let Some(b) = current.take() {
+        blocks.push(b);
+    }
+
+    if blocks.is_empty() {
+        return RuleStatus::default();
+    }
+    let first_port = blocks[0].port;
+    RuleStatus {
+        present: true,
+        enabled: blocks.iter().all(|b| b.enabled),
+        private_only: blocks.iter().all(|b| b.profiles == ["private"]),
+        port: if blocks.iter().all(|b| b.port == first_port) {
+            first_port
+        } else {
+            None
+        },
+    }
+}
+
+/// Runs a plan and returns its standard output. Injectable, so callers and tests never need a live `netsh`.
+#[async_trait::async_trait]
+pub trait NetshRunner: Send + Sync {
+    async fn run(&self, plan: &FirewallPlan) -> std::io::Result<String>;
+}
+
+/// The rule's current state through `runner`, read-only. A failed run reads as "not there".
+pub async fn query_rule(runner: &dyn NetshRunner) -> RuleStatus {
+    runner
+        .run(&show_rule_plan())
+        .await
+        .map(|out| parse_show_rule(&out))
+        .unwrap_or_default()
+}
+
+/// The real executor, limited to the read-only `show rule` plan: anything else is refused before a process starts,
+/// so this module cannot add or delete a rule even by mistake. Spawned through `aionui_runtime::Builder::clean_cli`
+/// (piped output, no window, killed on drop), the workspace's one place for subprocess policy. `netsh` exits 1 for
+/// "No rules match", so the exit code is not treated as an error; its output decides.
+pub struct ShowOnlyRunner;
+
+#[async_trait::async_trait]
+impl NetshRunner for ShowOnlyRunner {
+    async fn run(&self, plan: &FirewallPlan) -> std::io::Result<String> {
+        if *plan != show_rule_plan() && *plan != profile_state_plan() {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                "firewall: only the read-only show plans may be run from here",
+            ));
+        }
+        let mut builder = aionui_runtime::Builder::clean_cli(&plan.program);
+        builder.args(&plan.args);
+        let out = builder.spawn()?.wait_with_output().await?;
+        Ok(String::from_utf8_lossy(&out.stdout).into_owned())
+    }
+}
