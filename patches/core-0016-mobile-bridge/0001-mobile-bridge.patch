+/// AionDX core-0016: put the user's refusal reason in a deny response's `message`, the field
+/// `build_control_response` otherwise fills with a fixed "User rejected the request.".
+/// An allow response, or a blank reason, is left alone.
+fn with_deny_message(response: &mut serde_json::Value, deny_message: Option<&str>) {
+    let Some(reason) = deny_message.map(str::trim).filter(|m| !m.is_empty()) else {
+        return;
+    };
+    let result = &mut response["response"]["response"];
+    if result["behavior"] == "deny" {
+        result["message"] = serde_json::Value::String(reason.to_owned());
+    }
+}
