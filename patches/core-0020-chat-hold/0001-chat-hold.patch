+/// AionDX core-0020: body of `POST /api/conversations/{id}/runtime/hold`.
+#[derive(serde::Deserialize)]
+struct HoldRuntimeRequest {
+    hold: bool,
+    #[serde(default)]
+    stop: bool,
+}
+
+#[derive(serde::Serialize)]
+struct HoldRuntimeResponse {
+    held: bool,
+    stopped: bool,
+}
+
+async fn hold_runtime(
+    State(state): State<ConversationRouterState>,
+    Extension(user): Extension<CurrentUser>,
+    Path(id): Path<String>,
+    body: Result<Json<HoldRuntimeRequest>, JsonRejection>,
+) -> Result<Json<ApiResponse<HoldRuntimeResponse>>, ApiError> {
+    let Json(req) = body.map_err(ApiError::from)?;
+    let (held, stopped) = state
+        .service
+        .hold_runtime(&user.id, &id, req.hold, req.stop, &state.task_manager)
+        .await
+        .map_err(ApiError::from)?;
+    Ok(Json(ApiResponse::ok(HoldRuntimeResponse { held, stopped })))
+}
