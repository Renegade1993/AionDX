@@ -5029,6 +5029,49 @@ impl ConversationService {
     /// are intentionally left untouched so the rebuilt runtime can resume the
     /// existing backend session.
     #[tracing::instrument(skip_all, fields(user_id = %user_id, conversation_id = %conversation_id))]
+    /// AionDX core-0020: hold a conversation's agent stopped while its working folder is moved, or release it. Holding one whose turn
+    /// is running is refused (a `WORKING:` conflict) unless `stop` is set, which ends the turn as the Stop button does. Held, its agent
+    /// process is ended and none is started for it (by a send, its team or a schedule) until it is released. Returns whether it is held
+    /// now and whether a turn was stopped.
+    pub async fn hold_runtime(
+        &self,
+        user_id: &str,
+        conversation_id: &str,
+        hold: bool,
+        stop: bool,
+        task_manager: &Arc<dyn IWorkerTaskManager>,
+    ) -> Result<(bool, bool), ConversationError> {
+        self.conversation_repo
+            .get(user_id, conversation_id)
+            .await?
+            .ok_or_else(|| ConversationError::NotFound {
+                id: conversation_id.to_owned(),
+            })?;
+        if !hold {
+            task_manager.set_held(conversation_id, false);
+            info!(conversation_id, "Released conversation runtime after a move");
+            return Ok((false, false));
+        }
+        let mut stopped = false;
+        if let Some(turn_id) = self.runtime_state.active_turn_id_for(conversation_id) {
+            if !stop {
+                return Err(ConversationError::Busy {
+                    reason: format!("WORKING: conversation {conversation_id} is working on a turn"),
+                });
+            }
+            self.cancel_with_cause(user_id, conversation_id, &turn_id, task_manager, TurnCancelCause::UserRequested)
+                .await?;
+            stopped = true;
+        }
+        task_manager.set_held(conversation_id, true);
+        task_manager
+            .kill_and_wait(conversation_id, Some(AgentKillReason::RuntimeRestart))
+            .await;
+        self.runtime_state.clear_turn_state_for_restart(conversation_id);
+        info!(conversation_id, stopped, "Holding conversation runtime for a move");
+        Ok((true, stopped))
+    }
