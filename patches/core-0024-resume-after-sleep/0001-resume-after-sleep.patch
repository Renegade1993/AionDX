+// AionDX core-0024: the desktop shell's wake call, exactly as it sends it
+// (only `x-aionui-internal: 1`, no cookie, no token), is served.
+#[tokio::test]
+async fn system_resume_from_the_shell_is_served() {
+    let (app, _services) = build_app().await;
+    let req = axum::http::Request::builder()
+        .method("POST")
+        .uri("/api/cron/internal/system-resume")
+        .header("x-aionui-internal", "1")
+        .body(axum::body::Body::empty())
+        .unwrap();
+    let resp = app.clone().oneshot(req).await.unwrap();
+    assert_eq!(resp.status(), StatusCode::OK);
+    let json = body_json(resp).await;
+    assert_eq!(json["success"], true, "{json}");
+}
+
+#[tokio::test]
+async fn system_resume_without_the_internal_header_is_refused() {
+    let (app, _services) = build_app().await;
+    let req = axum::http::Request::builder()
+        .method("POST")
+        .uri("/api/cron/internal/system-resume")
+        .body(axum::body::Body::empty())
+        .unwrap();
+    let resp = app.clone().oneshot(req).await.unwrap();
+    assert_eq!(resp.status(), StatusCode::FORBIDDEN);
+}
