+}
+
+#[cfg(windows)]
+fn is_reparse(meta: &std::fs::Metadata) -> bool {
+    use std::os::windows::fs::MetadataExt;
+    meta.file_attributes() & 0x400 != 0 // FILE_ATTRIBUTE_REPARSE_POINT
+}
+
+#[cfg(windows)]
+fn skipped(name: &std::ffi::OsStr) -> bool {
+    VIEW_SKIP.iter().any(|s| name.eq_ignore_ascii_case(s))
+}
+
+/// `dst` as a real folder holding `src`'s files: each a hard link, else a copy with the source's modified time.
+#[cfg(windows)]
+fn mirror_dir(src: &Path, dst: &Path, depth: usize) -> std::io::Result<()> {
+    std::fs::create_dir_all(dst)?;
+    if depth > VIEW_MAX_DEPTH {
+        return Ok(());
+    }
+    for entry in std::fs::read_dir(src)? {
+        let entry = entry?;
+        let name = entry.file_name();
+        if skipped(&name) {
+            continue;
+        }
+        let (from, to) = (entry.path(), dst.join(&name));
+        let meta = std::fs::metadata(&from)?;
+        if meta.is_dir() {
+            mirror_dir(&from, &to, depth + 1)?;
+        } else if meta.is_file() && std::fs::hard_link(&from, &to).is_err() {
+            std::fs::copy(&from, &to)?;
+            if let Ok(when) = meta.modified() {
+                if let Ok(f) = std::fs::OpenOptions::new().write(true).open(&to) {
+                    let _ = f.set_modified(when);
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Every file under `dir` (relative path, lower case) with its size and modified time; `None` when `dir` is not a
+/// real folder (a junction left by an earlier view) or cannot be read.
+#[cfg(windows)]
+fn file_list(dir: &Path) -> Option<HashMap<String, (u64, Option<std::time::SystemTime>)>> {
+    fn walk(
+        root: &Path,
+        dir: &Path,
+        depth: usize,
+        out: &mut HashMap<String, (u64, Option<std::time::SystemTime>)>,
+    ) -> std::io::Result<()> {
+        if depth > VIEW_MAX_DEPTH {
+            return Ok(());
+        }
+        for entry in std::fs::read_dir(dir)? {
+            let entry = entry?;
+            if skipped(&entry.file_name()) {
+                continue;
+            }
+            let path = entry.path();
+            let meta = std::fs::metadata(&path)?;
+            if meta.is_dir() {
+                walk(root, &path, depth + 1, out)?;
+            } else if meta.is_file() {
+                let rel = path.strip_prefix(root).unwrap_or(&path).to_string_lossy().to_lowercase();
+                out.insert(rel, (meta.len(), meta.modified().ok()));
+            }
+        }
+        Ok(())
+    }
+    let top = std::fs::symlink_metadata(dir).ok()?;
+    if !top.is_dir() || is_reparse(&top) {
+        return None;
+    }
+    let mut out = HashMap::new();
+    walk(dir, dir, 0, &mut out).ok()?;
+    Some(out)
+}
+
+/// Whether every skill's view folder still holds exactly its source's files (same sizes and modified times).
+#[cfg(windows)]
+async fn view_is_current(skills: &[&ResolvedAgentSkill], skills_dir: &Path) -> bool {
+    let pairs: Vec<(PathBuf, PathBuf)> = skills
+        .iter()
+        .map(|s| (s.source_path.clone(), skills_dir.join(&s.name)))
+        .collect();
+    tokio::task::spawn_blocking(move || {
+        pairs.iter().all(|(src, dst)| match (file_list(src), file_list(dst)) {
+            (Some(a), Some(b)) => a == b,
+            _ => false,
+        })
+    })
+    .await
+    .unwrap_or(false)
+}
+#[cfg(not(windows))]
+async fn view_is_current(_skills: &[&ResolvedAgentSkill], _skills_dir: &Path) -> bool {
+    true
+}
 
