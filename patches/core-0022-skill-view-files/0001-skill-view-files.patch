+/// Folders a skill may carry that an agent never reads as part of it, left out of a file view.
+#[cfg(windows)]
+const VIEW_SKIP: &[&str] = &["node_modules", ".git", "__pycache__", ".venv", "venv"];
+/// How deep a skill's folders are followed into, so a loop of links in a source cannot run away.
+#[cfg(windows)]
+const VIEW_MAX_DEPTH: usize = 16;
+
+/// Put one skill into the view: its files (Windows) or a link to its folder (elsewhere).
+#[cfg(windows)]
+async fn place_skill(src: &Path, dst: &Path) -> Result<(), ExtensionError> {
+    let (src, dst) = (src.to_path_buf(), dst.to_path_buf());
+    tokio::task::spawn_blocking(move || {
+        let r = mirror_dir(&src, &dst, 0);
+        if r.is_err() {
+            let _ = std::fs::remove_dir_all(&dst);
+        }
+        r
+    })
+    .await
+    .map_err(|e| ExtensionError::Io(std::io::Error::other(format!("skill view join error: {e}"))))?
+    .map_err(ExtensionError::Io)
+}
+#[cfg(not(windows))]
