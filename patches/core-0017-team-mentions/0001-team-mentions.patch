+    assert!(!is_team_lead(r#"{"role":"lead"}"#));
+    assert!(reject_unusable_target("conv_a", "conv_b", r#"{"teamId":"team_1","role":"lead"}"#).is_ok());
+    assert!(matches!(
+        reject_unusable_target("conv_a", "conv_b", r#"{"teamId":"team_1","role":"teammate"}"#),
+        Err(ConversationError::Forbidden { .. })
