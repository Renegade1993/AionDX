+    /// AionDX core-0004: the user takes back one of their messages that is still waiting in a member's queue. It leaves
+    /// the queue and is marked read, so no later turn of the member opens with it. A message the member already took
+    /// (delivered into a running turn, or read) is not waiting any more: `NotQueued`.
+    pub async fn unsend_queued_message_from_user(
+        &self,
+        slot_id: &str,
+        message_id: &str,
+    ) -> Result<TeamSteerAgentResponse, TeamError> {
+        self.scheduler.get_agent(slot_id).await?;
+        let rows = self
+            .mailbox
+            .peek_unread_by_ids(&self.team.id, slot_id, &[message_id.to_owned()])
+            .await?;
+        let Some(row) = rows.into_iter().next() else {
+            return Ok(TeamSteerAgentResponse {
+                outcome: TeamSteerOutcome::NotQueued,
+                message_id: Some(message_id.to_owned()),
+            });
+        };
+        if row.from_agent_id != "user" {
+            return Err(TeamError::InvalidRequest(
+                "only a message from the user can be unsent".into(),
+            ));
+        }
+        if !self.work_coordinator.take_queued_message(slot_id, message_id) {
+            return Ok(TeamSteerAgentResponse {
+                outcome: TeamSteerOutcome::NotQueued,
+                message_id: Some(message_id.to_owned()),
+            });
+        }
+        self.mailbox.mark_read_batch(&self.team.id, &[message_id.to_owned()]).await?;
+        info!(team_id = %self.team.id, slot_id, message_id, "queued user message unsent");
+        Ok(TeamSteerAgentResponse {
+            outcome: TeamSteerOutcome::Unsent,
+            message_id: Some(message_id.to_owned()),
+        })
+    }
