+/// AionDX core-0018: how a teammate's message reads when it arrives inside a running turn. It names the sender as the wake
+/// payload does (`From \`slot\` [message]`) and says it came mid-turn, so the agent folds it into what it is doing.
+pub(crate) fn midturn_teammate_text(from_name: &str, from_slot_id: &str, content: &str) -> String {
+    format!(
+        "## New Messages\n\n(Arrived while you were working. Read it and carry on; nothing was stopped.)\n- From `{from_slot_id}` ({from_name}) [message]: {content}\n"
+    )
+}
