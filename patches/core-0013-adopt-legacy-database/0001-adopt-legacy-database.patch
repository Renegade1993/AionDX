 //! Application configuration parsed from CLI arguments + key derivation.
 
-use std::path::PathBuf;
+use std::path::{Path, PathBuf};
 
 use sha2::{Digest, Sha256};
 
@@ -68,7 +68,35 @@ impl AppConfig {
 
     /// Path to the SQLite database file.
     pub fn database_path(&self) -> PathBuf {
-        self.data_dir.join("aionui-backend.db")
+        Self::database_path_in(&self.data_dir)
+    }
+
+    /// AionDX core-0013: the database path for a data folder. A database an earlier version wrote under its old file name is
+    /// renamed to the current name first (with its -wal and -shm files), so existing chats carry over.
+    pub fn database_path_in(data_dir: &Path) -> PathBuf {
+        let target = data_dir.join("aionui-backend.db");
+        adopt_legacy_database(&target);
+        target
+    }
+}
+
+/// Renames the database file an earlier version wrote to the current name, when only the old one exists.
+fn adopt_legacy_database(target: &Path) {
+    if target.exists() {
+        return;
+    }
+    let legacy = target.with_file_name("aionui-backend.db"); // legacy-name
+    if !legacy.exists() {
+        return;
+    }
+    for suffix in ["", "-wal", "-shm"] {
+        let from = PathBuf::from(format!("{}{suffix}", legacy.display()));
+        let to = PathBuf::from(format!("{}{suffix}", target.display()));
+        if from.exists() {
+            if let Err(error) = std::fs::rename(&from, &to) {
+                tracing::warn!(from = %from.display(), to = %to.display(), error = %error, "could not move the earlier database file");
+            }
+        }
     }
 }
 
