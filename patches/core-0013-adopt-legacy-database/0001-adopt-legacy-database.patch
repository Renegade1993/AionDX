         };
         assert_eq!(config.database_path(), PathBuf::from("/tmp/aionui/aionui-backend.db"));
     }
+
+    #[test]
+    fn an_earlier_versions_database_is_renamed_with_its_wal_files() {
+        let dir = tempfile::tempdir().unwrap();
+        let old = dir.path().join("aionui-backend.db"); // legacy-name
+        std::fs::write(&old, b"data").unwrap();
+        std::fs::write(dir.path().join("aionui-backend.db-wal"), b"wal").unwrap(); // legacy-name
+        let target = AppConfig::database_path_in(dir.path());
+        assert!(target.exists() && std::fs::read(&target).unwrap() == b"data");
+        assert!(!old.exists());
+        assert!(dir.path().join(format!("{}-wal", target.file_name().unwrap().to_string_lossy())).exists());
+    }
+
+    #[test]
+    fn a_current_database_is_left_alone_when_the_old_file_is_also_there() {
+        let dir = tempfile::tempdir().unwrap();
+        let target = AppConfig::database_path_in(dir.path());
+        std::fs::write(&target, b"current").unwrap();
+        let old = dir.path().join("aionui-backend.db"); // legacy-name
+        std::fs::write(&old, b"old").unwrap();
+        let again = AppConfig::database_path_in(dir.path());
+        assert_eq!(std::fs::read(&again).unwrap(), b"current");
+        assert!(old.exists());
+    }
 }
