+    enqueue(&coordinator, WorkSource::UserMessage, "first");
+    enqueue(&coordinator, WorkSource::McpSendMessage, "from-a-teammate");
+
+    assert!(!coordinator.promote_queued_message("lead-1", "nobody"));
+    // Teammates' messages are not the user's to move up: the foreground queue holds only the user's.
+    assert!(!coordinator.promote_queued_message("lead-1", "from-a-teammate"));
+    assert!(!coordinator.promote_queued_message("other-slot", "first"));
+
+    let ReconcileDecision::Claim(batch) = coordinator.next("lead-1") else {
+        panic!("queued messages must be claimable");
+    };
+    assert_eq!(batch.mailbox_message_ids, vec!["first"]);
+}
