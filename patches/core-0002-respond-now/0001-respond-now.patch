+    /// AionDX core-0002: hand a message to the conversation's RUNNING turn without stopping it, the delivery a
+    /// solo chat's own send takes while its agent works (see `send_message`, "Mid-turn delivery"). A team
+    /// member's conversation cannot be sent to through the ordinary route, so the team layer asks for it here.
+    ///
+    /// `record_message` true writes the user's message into the chat first (a new message from the user);
+    /// false leaves the chat as it is (a message already shown there, moved up from the team's queue).
+    /// Whatever is not possible is reported as `NotAvailable` before anything is written.
+    pub async fn steer_active_turn(
+        &self,
+        user_id: &str,
+        conversation_id: &str,
+        content: &str,
+        files: Vec<String>,
+        record_message: bool,
+        task_manager: &Arc<dyn IWorkerTaskManager>,
+    ) -> Result<SteerActiveTurn, ConversationError> {
+        if content.trim().is_empty() {
+            return Err(ConversationError::BadRequest {
+                reason: "Message content must not be empty".into(),
+            });
+        }
+        self.conversation_repo
+            .get(user_id, conversation_id)
+            .await?
+            .ok_or_else(|| ConversationError::NotFound {
+                id: conversation_id.to_owned(),
+            })?;
+        let Some(active_turn_id) = self.runtime_state.active_turn_id_for(conversation_id) else {
+            return Ok(SteerActiveTurn::NotAvailable {
+                reason: "no running turn",
+            });
+        };
+        let Some(agent) = task_manager.get_task(conversation_id) else {
+            return Ok(SteerActiveTurn::NotAvailable {
+                reason: "agent not running",
+            });
+        };
+        if !agent.supports_midturn_delivery() {
+            return Ok(SteerActiveTurn::NotAvailable {
+                reason: "agent cannot take a message mid-turn",
+            });
+        }
+        // §4.6, as in `send_message`: a turn blocked on a permission card is answered through the card.
+        if !agent.get_confirmations().is_empty() {
+            return Ok(SteerActiveTurn::NotAvailable {
+                reason: "turn is waiting for a permission answer",
+            });
+        }
+        if record_message {
+            let resolved = ResolvedChatMessage {
+                content: content.to_owned(),
+                files,
+            };
+            return match self
+                .deliver_midturn_message(
+                    user_id,
+                    conversation_id,
+                    &resolved,
+                    false,
+                    agent,
+                    active_turn_id.clone(),
+                    Vec::new(),
+                )
+                .await?
+            {
+                MidturnOutcome::Delivered(response) if response.delivered_midturn => Ok(SteerActiveTurn::Delivered {
+                    turn_id: active_turn_id,
+                }),
+                MidturnOutcome::Delivered(_) => Err(ConversationError::BadRequest {
+                    reason: "the message could not be delivered into the running turn".into(),
+                }),
+                MidturnOutcome::TurnEnded { .. } => Ok(SteerActiveTurn::NotAvailable {
+                    reason: "the turn ended first",
+                }),
+            };
+        }
+        let data = aionui_ai_agent::types::SendMessageData {
+            content: content.to_owned(),
+            msg_id: Self::mint_msg_id(),
+            turn_id: Some(active_turn_id.clone()),
+            files,
+            inject_skills: Vec::new(),
+        };
+        match agent.deliver_midturn(data).await {
+            Ok(()) => {
+                info!(
+                    conversation_id = %conversation_id,
+                    route = "midturn_delivery",
+                    active_turn_id = %active_turn_id,
+                    "queued message delivered into the active turn"
+                );
+                Ok(SteerActiveTurn::Delivered {
+                    turn_id: active_turn_id,
+                })
+            }
+            Err(e) if steer_rejection_is_turn_ended(&e) => Ok(SteerActiveTurn::NotAvailable {
+                reason: "the turn ended first",
+            }),
+            Err(e) => Err(ConversationError::BadRequest {
+                reason: format!("mid-turn delivery failed: {e}"),
+            }),
+        }
+    }
