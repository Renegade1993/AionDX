+    /// AionDX core-0002: a message from the user that goes ahead of everything the member has queued, without
+    /// stopping what it is doing.
+    ///
+    /// A running turn that can take a message mid-turn (Claude, Codex) gets it at its next step, as a solo chat
+    /// does; the message is written into the chat and never queued. Otherwise it is queued like any message of
+    /// the user's, at the front: the member's next turn opens with it.
+    pub async fn steer_agent_from_user(
+        &self,
+        slot_id: &str,
+        content: &str,
+        files: Option<Vec<String>>,
+    ) -> Result<TeamSteerAgentResponse, TeamError> {
+        if content.trim().is_empty() {
+            return Err(TeamError::InvalidRequest("message must not be empty".into()));
+        }
+        if slot_id == "*" {
+            return Err(TeamError::InvalidRequest("a message cannot be steered to every agent".into()));
+        }
+        let agent = self.scheduler.get_agent(slot_id).await?;
+        match self
+            .cancellation_port
+            .steer_agent_turn(
+                &self.user_id,
+                &agent.conversation_id,
+                content,
+                files.clone().unwrap_or_default(),
+                true,
+            )
+            .await
+        {
+            Ok(AgentTurnSteerOutcome::Delivered { turn_id }) => {
+                info!(
+                    team_id = %self.team.id,
+                    slot_id,
+                    turn_id = %turn_id,
+                    "user message delivered into the running turn"
+                );
+                return Ok(TeamSteerAgentResponse {
+                    outcome: TeamSteerOutcome::DeliveredMidturn,
+                    message_id: None,
+                });
+            }
+            Ok(AgentTurnSteerOutcome::NotAvailable { reason }) => {
+                debug!(team_id = %self.team.id, slot_id, reason, "no mid-turn delivery; queuing the message first");
+            }
+            Err(error) => return Err(TeamError::InvalidRequest(error.to_string())),
+        }
+        let ack = self
+            .enqueue_user_message(slot_id, target_role_for(agent.role), content, files)
+            .await?;
+        self.work_coordinator.promote_queued_message(slot_id, &ack.message_id);
+        Ok(TeamSteerAgentResponse {
+            outcome: TeamSteerOutcome::QueuedFirst,
+            message_id: Some(ack.message_id),
+        })
+    }
+
+    /// AionDX core-0002: one of the user's messages already waiting in a member's queue goes to the front, and
+    /// when the member's running turn can take a message mid-turn it is handed over now and leaves the queue.
+    /// Nothing is stopped.
+    pub async fn promote_queued_message_from_user(
+        &self,
+        slot_id: &str,
+        message_id: &str,
+    ) -> Result<TeamSteerAgentResponse, TeamError> {
+        let agent = self.scheduler.get_agent(slot_id).await?;
+        let rows = self
+            .mailbox
+            .peek_unread_by_ids(&self.team.id, slot_id, &[message_id.to_owned()])
+            .await?;
+        let Some(row) = rows.into_iter().next() else {
+            return Ok(TeamSteerAgentResponse {
+                outcome: TeamSteerOutcome::NotQueued,
+                message_id: Some(message_id.to_owned()),
+            });
+        };
+        if row.from_agent_id != "user" {
+            return Err(TeamError::InvalidRequest(
+                "only a message from the user can be moved to the front".into(),
+            ));
+        }
+        let steered = self
+            .cancellation_port
+            .steer_agent_turn(
+                &self.user_id,
+                &agent.conversation_id,
+                &row.content,
+                row.files.clone().unwrap_or_default(),
+                false,
+            )
+            .await
+            .map_err(|error| TeamError::InvalidRequest(error.to_string()))?;
+        if let AgentTurnSteerOutcome::Delivered { turn_id } = steered {
+            // Handed to the running turn: it leaves the queue so the next turn does not read it again.
+            if self.work_coordinator.take_queued_message(slot_id, message_id) {
+                self.mailbox.mark_read_batch(&self.team.id, &[message_id.to_owned()]).await?;
+            }
+            info!(
+                team_id = %self.team.id,
+                slot_id,
+                turn_id = %turn_id,
+                message_id,
+                "queued user message delivered into the running turn"
+            );
+            return Ok(TeamSteerAgentResponse {
+                outcome: TeamSteerOutcome::DeliveredMidturn,
+                message_id: Some(message_id.to_owned()),
+            });
+        }
+        let moved = self.work_coordinator.promote_queued_message(slot_id, message_id);
+        Ok(TeamSteerAgentResponse {
+            outcome: if moved {
+                TeamSteerOutcome::MovedToFront
+            } else {
+                TeamSteerOutcome::NotQueued
+            },
+            message_id: Some(message_id.to_owned()),
+        })
+    }
