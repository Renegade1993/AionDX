+/// AionDX core-0002: a team hands a message to a member's running turn. A new message is written into the chat
+/// (pending receipt) and delivered into the active turn, whose claim is not touched.
+#[tokio::test]
+async fn steer_active_turn_records_and_delivers_a_new_message() {
+    let (svc, broadcaster, repo, _d) = make_service();
+    let conv = svc.create("user_1", make_create_req()).await.unwrap();
+    let _claim = svc
+        .runtime_state()
+        .try_claim_turn(&conv.id, "turn_active")
+        .expect("claim the active turn");
+    let agent = Arc::new(MidturnMockAgent::new(&conv.id));
+    let task_mgr = Arc::new(MockTaskManager::new());
+    task_mgr.insert_agent(&conv.id, AgentInstance::Mock(agent.clone()));
+    let task_mgr_dyn: Arc<dyn IWorkerTaskManager> = task_mgr;
+    broadcaster.take_events();
+
+    let outcome = svc
+        .steer_active_turn("user_1", &conv.id, "look at the build first", Vec::new(), true, &task_mgr_dyn)
+        .await
+        .expect("steer must not fail");
+
+    assert_eq!(
+        outcome,
+        crate::SteerActiveTurn::Delivered {
+            turn_id: "turn_active".into()
+        }
+    );
+    let delivered = agent.delivered.lock().unwrap().clone();
+    assert_eq!(delivered.len(), 1);
+    assert_eq!(delivered[0].content, "look at the build first");
+    assert_eq!(delivered[0].turn_id.as_deref(), Some("turn_active"));
+    assert_eq!(
+        svc.runtime_state().active_turn_id_for(&conv.id).as_deref(),
+        Some("turn_active"),
+        "the running turn is neither stopped nor replaced"
+    );
+    assert!(broadcaster.take_events().iter().any(|e| e.name == "message.userCreated"));
+    let rows: Vec<_> = repo
+        .messages
+        .lock()
+        .unwrap()
+        .iter()
+        .filter(|m| m.msg_id.as_deref() == Some(delivered[0].msg_id.as_str()))
+        .cloned()
+        .collect();
+    assert_eq!(rows.len(), 1);
+    assert_eq!(rows[0].status.as_deref(), Some("pending"));
+}
