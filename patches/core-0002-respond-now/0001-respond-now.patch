+    /// The queued foreground intent that carries this mailbox message, if it is still waiting.
+    fn queued_foreground_intent(state: &CoordinatorState, slot_id: &str, mailbox_message_id: &str) -> Option<String> {
+        let slot = state.slots.get(slot_id)?;
+        slot.foreground
+            .iter()
+            .find(|intent_id| {
+                state
+                    .intents
+                    .get(*intent_id)
+                    .is_some_and(|intent| intent.mailbox_message_id.as_deref() == Some(mailbox_message_id))
+            })
+            .cloned()
+    }
+
+    /// AionDX core-0002: put one of the user's queued messages at the front of the slot's foreground queue, so
+    /// the slot's next turn opens with it. The turn running now is not touched. False when no such message is
+    /// waiting in the queue (it was already claimed, or never queued here).
+    pub(crate) fn promote_queued_message(&self, slot_id: &str, mailbox_message_id: &str) -> bool {
+        let mut state = self.lock_state();
+        let Some(intent_id) = Self::queued_foreground_intent(&state, slot_id, mailbox_message_id) else {
+            return false;
+        };
+        let Some(slot) = state.slots.get_mut(slot_id) else {
+            return false;
+        };
+        slot.foreground.retain(|candidate| candidate != &intent_id);
+        slot.foreground.push_front(intent_id);
+        let slot_snapshot = Self::slot_snapshot_locked(&state, slot_id);
+        drop(state);
+        self.publish_slot_work_snapshot(slot_snapshot);
+        true
+    }
+
+    /// AionDX core-0002: take one of the user's queued messages out of the queue because it was handed to the
+    /// running turn instead. True when it was queued: the caller marks its mailbox row read.
+    pub(crate) fn take_queued_message(&self, slot_id: &str, mailbox_message_id: &str) -> bool {
+        let mut state = self.lock_state();
+        let Some(intent_id) = Self::queued_foreground_intent(&state, slot_id, mailbox_message_id) else {
+            return false;
+        };
+        if let Some(intent) = state.intents.get_mut(&intent_id) {
+            intent.state = WorkIntentState::Cancelled {
+                classification: "delivered_midturn",
+            };
+        }
+        if let Some(slot) = state.slots.get_mut(slot_id) {
+            slot.remove_queued(&intent_id);
+        }
+        let slot_snapshot = Self::slot_snapshot_locked(&state, slot_id);
+        drop(state);
+        self.publish_slot_work_snapshot(slot_snapshot);
+        true
+    }
