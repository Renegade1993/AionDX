+#[test]
+fn a_taken_message_leaves_the_queue_and_is_not_claimed() {
+    let coordinator = coordinator();
+    coordinator.set_runtime_constraint("lead-1", RuntimeConstraint::Ready);
+    enqueue(&coordinator, WorkSource::UserMessage, "first");
+    enqueue(&coordinator, WorkSource::UserMessage, "second");
+
+    assert!(coordinator.take_queued_message("lead-1", "first"));
+    assert!(!coordinator.take_queued_message("lead-1", "first"), "a message can only be taken once");
+
+    let ReconcileDecision::Claim(batch) = coordinator.next("lead-1") else {
+        panic!("the remaining message must be claimable");
+    };
+    assert_eq!(batch.mailbox_message_ids, vec!["second"]);
+}
