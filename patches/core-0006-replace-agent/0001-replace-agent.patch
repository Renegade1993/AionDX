+        index: usize,
+        req: ReplaceAgentRequest,
+    ) -> Result<TeamAgent, TeamError> {
+        let old = team.agents[index].clone();
+        let workspace = self.workspace_resolver().resolve_for_new_agent(row, team).await?;
+        let assistant_id = Self::effective_assistant_id(Some(req.assistant_id.as_str()));
+        if assistant_id.is_none() {
+            return Err(TeamError::InvalidRequest("assistant_id is required".into()));
+        }
+        let backend = self
+            .resolve_requested_backend(user_id, None, assistant_id.as_deref())
+            .await?;
+        let mcp_selection = self
+            .resolve_assistant_mcp_selection(user_id, assistant_id.as_deref())
+            .await?;
+        let name = req
+            .name
+            .as_deref()
+            .map(str::trim)
+            .filter(|value| !value.is_empty())
+            .map(str::to_owned)
+            .unwrap_or_else(|| old.name.clone());
+        let agent = self
+            .provision_new_agent(
+                NewAgentProvisioning {
+                    user_id: user_id.to_owned(),
+                    team_id: team.id.clone(),
+                    slot_id: old.slot_id.clone(),
+                    name,
+                    role: old.role,
+                    backend,
+                    model: req.model.unwrap_or_default(),
+                    assistant_id,
+                    workspace: Some(workspace),
+                    session_mode: row.session_mode.clone(),
+                },
+                Some(&mcp_selection),
+            )
+            .await?;
+        team.agents[index] = agent.clone();
+        self.persist_agents(&team.id, &team.agents).await?;
+        Ok(agent)
+    }
