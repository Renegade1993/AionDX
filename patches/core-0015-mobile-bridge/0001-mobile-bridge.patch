new file mode 100644
index 00000000..1eab6520
--- /dev/null
+++ b/crates/aionui-mobile/src/listener.rs
@@ -0,0 +1,177 @@
+//! The LAN listener (CONTRACT §2, §4). It is separate from AionCore's own
+//! 127.0.0.1 server and serves only `/api/mobile/v1/*`. Every request from a
+//! peer outside the private ranges is refused before routing.
+
+use std::net::SocketAddr;
+use std::sync::Arc;
+
+use axum::Json;
+use axum::Router;
+use axum::extract::{ConnectInfo, Request, State};
+use axum::http::StatusCode;
+use axum::middleware::Next;
+use axum::response::{IntoResponse, Response};
+use axum::routing::{get, post};
+use serde_json::json;
+use tokio::net::TcpListener;
+use tokio::sync::oneshot;
+use tokio::task::JoinHandle;
+
+use crate::core::BridgeCore;
+use crate::error::MobileError;
+use crate::outer;
+use crate::peer_filter::is_private_peer;
+
+/// The outer routes: the only four paths the LAN ever sees.
+pub fn outer_router(core: Arc<BridgeCore>) -> Router {
+    Router::new()
+        .route("/api/mobile/v1/hello", get(hello))
+        .route("/api/mobile/v1/pair", post(outer::pair))
+        .route("/api/mobile/v1/session", post(outer::session))
+        .route("/api/mobile/v1/rpc", post(outer::rpc))
+        .fallback(not_found)
+        .with_state(core)
+        .layer(axum::middleware::from_fn(private_peers_only))
+}
+
+async fn hello(State(core): State<Arc<BridgeCore>>) -> Json<serde_json::Value> {
+    Json(json!({ "v": [1], "hostId": core.host_key.host_id }))
+}
+
+async fn not_found() -> Response {
+    (StatusCode::NOT_FOUND, Json(json!({ "error": "not_found" }))).into_response()
+}
+
+async fn private_peers_only(request: Request, next: Next) -> Response {
+    let peer = request.extensions().get::<ConnectInfo<SocketAddr>>().map(|info| info.0);
+    match peer {
+        Some(addr) if is_private_peer(addr.ip()) => next.run(request).await,
+        _ => {
+            tracing::warn!(peer = ?peer, "mobile bridge: refused a request from a non-private address");
+            (StatusCode::FORBIDDEN, Json(json!({ "error": "forbidden_peer" }))).into_response()
+        }
+    }
+}
+
+/// A running listener. Dropping it does not stop it; call [`ListenerHandle::stop`].
+pub struct ListenerHandle {
+    pub addr: SocketAddr,
+    shutdown: Option<oneshot::Sender<()>>,
+    task: JoinHandle<()>,
+}
+
+impl ListenerHandle {
+    pub async fn stop(mut self) {
+        if let Some(tx) = self.shutdown.take() {
+            let _ = tx.send(());
+        }
+        let _ = self.task.await;
+        tracing::info!(addr = %self.addr, "mobile bridge: listener stopped");
+    }
+}
+
+/// Binds `bind_ip:port` and serves `router` until stopped.
+pub async fn start(bind_ip: std::net::IpAddr, port: u16, router: Router) -> Result<ListenerHandle, MobileError> {
+    let listener = TcpListener::bind(SocketAddr::new(bind_ip, port))
+        .await
+        .map_err(|e| MobileError::Listener(format!("could not listen on port {port}: {e}")))?;
+    let addr = listener
+        .local_addr()
+        .map_err(|e| MobileError::Listener(e.to_string()))?;
+    let (tx, rx) = oneshot::channel::<()>();
+    let service = router.into_make_service_with_connect_info::<SocketAddr>();
+    let task = tokio::spawn(async move {
+        let result = axum::serve(listener, service)
+            .with_graceful_shutdown(async move {
+                let _ = rx.await;
+            })
+            .await;
+        if let Err(e) = result {
+            tracing::error!(error = %e, "mobile bridge: listener failed");
+        }
+    });
+    tracing::info!(%addr, "mobile bridge: listener started");
+    Ok(ListenerHandle {
+        addr,
+        shutdown: Some(tx),
+        task,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::net::{IpAddr, Ipv4Addr};
+
+    async fn get_json(addr: SocketAddr, path: &str) -> (u16, serde_json::Value) {
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        let mut stream = tokio::net::TcpStream::connect(addr).await.unwrap();
+        let req = format!("GET {path} HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
+        stream.write_all(req.as_bytes()).await.unwrap();
+        let mut raw = String::new();
+        stream.read_to_string(&mut raw).await.unwrap();
+        let status: u16 = raw[9..12].parse().unwrap();
+        let body = raw.split("\r\n\r\n").nth(1).unwrap_or("");
+        // axum may answer with chunked encoding; take the JSON object out of it.
+        let start = body.find('{').unwrap();
+        let end = body.rfind('}').unwrap();
+        (status, serde_json::from_str(&body[start..=end]).unwrap())
+    }
+
+    async fn router() -> (Router, String) {
+        let store = crate::store::MobileStore::open_memory().await.unwrap();
+        let key = Arc::new(crate::host_key::HostKey::generate().unwrap());
+        let core = BridgeCore::new(key, store, "Test PC".into(), Arc::new(crate::core::NoEvents));
+        let host_id = core.host_key.host_id.clone();
+        (outer_router(core), host_id)
+    }
+
+    #[tokio::test]
+    async fn hello_answers_with_version_and_host_id_and_stops_cleanly() {
+        let (router, host_id) = router().await;
+        let handle = start(IpAddr::V4(Ipv4Addr::LOCALHOST), 0, router).await.unwrap();
+        let (status, body) = get_json(handle.addr, "/api/mobile/v1/hello").await;
+        assert_eq!(status, 200);
+        assert_eq!(body, json!({ "v": [1], "hostId": host_id }));
+        let addr = handle.addr;
+        handle.stop().await;
+        assert!(
+            tokio::net::TcpStream::connect(addr).await.is_err(),
+            "port is released after stop"
+        );
+    }
+
+    #[tokio::test]
+    async fn only_bridge_routes_are_served() {
+        let handle = start(IpAddr::V4(Ipv4Addr::LOCALHOST), 0, router().await.0)
+            .await
+            .unwrap();
+        for path in ["/api/teams", "/api/conversations", "/", "/api/mobile/admin/status"] {
+            let (status, body) = get_json(handle.addr, path).await;
+            assert_eq!(status, 404, "{path}");
+            assert_eq!(body, json!({ "error": "not_found" }));
+        }
+        handle.stop().await;
+    }
+
+    #[tokio::test]
+    async fn non_private_peers_are_refused() {
+        use tower::ServiceExt;
+        let request = axum::http::Request::get("/api/mobile/v1/hello")
+            .extension(ConnectInfo(SocketAddr::from(([8, 8, 8, 8], 5555))))
+            .body(axum::body::Body::empty())
+            .unwrap();
+        let response = router().await.0.oneshot(request).await.unwrap();
+        assert_eq!(response.status(), StatusCode::FORBIDDEN);
+    }
+
+    #[tokio::test]
+    async fn a_taken_port_is_reported_not_panicked() {
+        let first = start(IpAddr::V4(Ipv4Addr::LOCALHOST), 0, router().await.0)
+            .await
+            .unwrap();
+        let err = start(IpAddr::V4(Ipv4Addr::LOCALHOST), first.addr.port(), router().await.0).await;
+        assert!(matches!(err, Err(MobileError::Listener(_))));
+        first.stop().await;
+    }
+}
diff --git a/crates/aionui-mobile/src/outer.rs b/crates/aionui-mobile/src/outer.rs
new file mode 100644
index 00000000..4314dcbb
--- /dev/null
+++ b/crates/aionui-mobile/src/outer.rs
@@ -0,0 +1,286 @@
+//! The LAN routes `pair`, `session` and `rpc` (CONTRACT §4.2–4.4). Outer
+//! errors are plaintext `{"error": code, ...}` and never carry secrets.
+
+use std::net::SocketAddr;
+use std::sync::Arc;
+use std::time::Duration;
+
+use axum::Json;
+use axum::body::Bytes;
+use axum::extract::{ConnectInfo, State};
+use axum::http::StatusCode;
+use axum::response::{IntoResponse, Response};
+use serde_json::{Value, json};
+
+use crate::core::{BridgeCore, InnerContext, Limit};
+use crate::crypto;
+use crate::host_key::random_bytes;
+use crate::pairing::PairError;
+use crate::session::{HandshakeError, HandshakeOutcome, KnownDevice, Opened, RpcError};
+use crate::wire::{
+    HandshakeInitBody, InnerRequest, InnerResponse, PROTOCOL_VERSION, PairRequestBody, PairResponsePayload,
+    RpcEnvelope, SealedResponse,
+};
+
+/// How long a `wait: true` pair request is held (§4.2).
+const PAIR_LONG_POLL: Duration = Duration::from_secs(20);
+
+fn now() -> i64 {
+    aionui_common::now_ms()
+}
+
+fn plain_error(status: StatusCode, code: &str) -> Response {
+    (status, Json(json!({ "error": code }))).into_response()
+}
+
+fn clock_skew() -> Response {
+    (
+        StatusCode::BAD_REQUEST,
+        Json(json!({ "error": "clock_skew", "hostTime": now() })),
+    )
+        .into_response()
+}
+
+fn parse<T: serde::de::DeserializeOwned>(body: &Bytes) -> Result<T, Response> {
+    serde_json::from_slice(body).map_err(|_| plain_error(StatusCode::BAD_REQUEST, "malformed"))
+}
+
+fn unknown_host(core: &BridgeCore) -> Response {
+    (
+        StatusCode::CONFLICT,
+        Json(json!({ "error": "unknown_host", "hostId": core.host_key.host_id })),
+    )
+        .into_response()
+}
+
+pub async fn pair(
+    State(core): State<Arc<BridgeCore>>,
+    ConnectInfo(peer): ConnectInfo<SocketAddr>,
+    body: Bytes,
+) -> Response {
+    if !core.limiter.allow(peer.ip(), Limit::Pair, now()) {
+        return plain_error(StatusCode::TOO_MANY_REQUESTS, "rate_limited");
+    }
+    let req: PairRequestBody = match parse(&body) {
+        Ok(r) => r,
+        Err(resp) => return resp,
+    };
+    let accepted = match core.pairing.handle_request(&core.host_key, &req, now()) {
+        Ok(a) => a,
+        Err(PairError::UnsupportedVersion) => return plain_error(StatusCode::BAD_REQUEST, "unsupported_version"),
+        Err(PairError::Malformed) => return plain_error(StatusCode::BAD_REQUEST, "malformed"),
+        Err(PairError::UnknownHost) => return unknown_host(&core),
+        Err(PairError::Expired) => return plain_error(StatusCode::GONE, "pairing_expired"),
+        Err(PairError::Locked) => return plain_error(StatusCode::CONFLICT, "pairing_locked"),
+        Err(PairError::AuthFailed) => return plain_error(StatusCode::UNAUTHORIZED, "auth_failed"),
+        Err(PairError::ClockSkew) => return clock_skew(),
+    };
+    if accepted.first
+        && let Some((user_id, offer_id, request)) = core.pairing.pending_request()
+    {
+        core.events.emit(
+            &user_id,
+            "mobile.pairingRequest",
+            json!({ "offerId": offer_id, "deviceName": request.device_name, "sas": request.sas }),
+        );
+    }
+
+    let (mut status, mut confirm_key) = core.pairing.status_for(&accepted.device_id, now());
+    if accepted.wait && status == "pending" {
+        let mut changes = core.pairing.subscribe();
+        let _ = tokio::time::timeout(PAIR_LONG_POLL, async {
+            loop {
+                if changes.changed().await.is_err() {
+                    return;
+                }
+                if core.pairing.status_for(&accepted.device_id, now()).0 != "pending" {
+                    return;
+                }
+            }
+        })
+        .await;
+        (status, confirm_key) = core.pairing.status_for(&accepted.device_id, now());
+    }
+
+    let payload = PairResponsePayload {
+        status,
+        host_id: core.host_key.host_id.clone(),
+        host_name: core.host_name(),
+        ts: now(),
+        req_ts: accepted.req_ts,
+        confirm_key: confirm_key.map(|k| crypto::b64u(&k)),
+    };
+    let Ok(nonce) = random_bytes::<24>() else {
+        return plain_error(StatusCode::INTERNAL_SERVER_ERROR, "internal");
+    };
+    let plain = serde_json::to_vec(&payload).unwrap_or_default();
+    let aad = crypto::pair_res_aad(&core.host_key.host_id, &accepted.device_id);
+    let ct = crypto::seal(&accepted.pairing_key, &nonce, &plain, &aad);
+    Json(SealedResponse {
+        v: PROTOCOL_VERSION,
+        nonce: crypto::b64u(&nonce),
+        ct: crypto::b64u(&ct),
+    })
+    .into_response()
+}
+
+pub async fn session(
+    State(core): State<Arc<BridgeCore>>,
+    ConnectInfo(peer): ConnectInfo<SocketAddr>,
+    body: Bytes,
+) -> Response {
+    if !core.limiter.allow(peer.ip(), Limit::Session, now()) {
+        return plain_error(StatusCode::TOO_MANY_REQUESTS, "rate_limited");
+    }
+    let req: HandshakeInitBody = match parse(&body) {
+        Ok(r) => r,
+        Err(resp) => return resp,
+    };
+    let row = match core.store.device(&req.device_id).await {
+        Ok(row) => row,
+        Err(e) => {
+            tracing::error!(error = %e, "mobile bridge: device lookup failed");
+            return plain_error(StatusCode::SERVICE_UNAVAILABLE, "unavailable");
+        }
+    };
+    let known = row.as_ref().and_then(|d| {
+        let pk: [u8; 32] = d.device_pk.clone().try_into().ok()?;
+        Some(KnownDevice {
+            user_id: d.user_id.clone(),
+            device_pk: pk,
+        })
+    });
+    let revoked = known.is_none() && core.store.is_tombstoned(&req.device_id).await.unwrap_or(false);
+    match core
+        .sessions
+        .handshake(&core.host_key, &req, known.as_ref(), revoked, now())
+    {
+        Ok(HandshakeOutcome::Ok { response, .. }) => {
+            let _ = core.store.touch_device(&req.device_id, &peer.ip().to_string()).await;
+            tracing::info!(device_id = %req.device_id, "mobile bridge: session opened");
+            Json(response).into_response()
+        }
+        Ok(HandshakeOutcome::Revoked { notice }) => {
+            tracing::info!(device_id = %req.device_id, revoked, "mobile bridge: handshake from an untrusted device");
+            (
+                StatusCode::FORBIDDEN,
+                Json(json!({ "error": "device_revoked", "notice": notice })),
+            )
+                .into_response()
+        }
+        Err(HandshakeError::UnsupportedVersion) => plain_error(StatusCode::BAD_REQUEST, "unsupported_version"),
+        Err(HandshakeError::Malformed) => plain_error(StatusCode::BAD_REQUEST, "malformed"),
+        Err(HandshakeError::UnknownHost) => unknown_host(&core),
+        Err(HandshakeError::AuthFailed) => plain_error(StatusCode::UNAUTHORIZED, "auth_failed"),
+        Err(HandshakeError::ClockSkew) => clock_skew(),
+    }
+}
+
+pub async fn rpc(
+    State(core): State<Arc<BridgeCore>>,
+    ConnectInfo(peer): ConnectInfo<SocketAddr>,
+    body: Bytes,
+) -> Response {
+    if !core.limiter.allow(peer.ip(), Limit::Rpc, now()) {
+        return plain_error(StatusCode::TOO_MANY_REQUESTS, "rate_limited");
+    }
+    let env: RpcEnvelope = match parse(&body) {
+        Ok(r) => r,
+        Err(resp) => return resp,
+    };
+    let opened = match core.sessions.open(&env, now()) {
+        Ok(Opened::New(o)) => o,
+        Ok(Opened::Duplicate(resp)) => return Json(resp).into_response(),
+        Err(RpcError::UnsupportedVersion) => return plain_error(StatusCode::BAD_REQUEST, "unsupported_version"),
+        Err(RpcError::Malformed) => return plain_error(StatusCode::BAD_REQUEST, "malformed"),
+        Err(RpcError::UnknownSession) => return plain_error(StatusCode::UNAUTHORIZED, "unknown_session"),
+        Err(RpcError::SessionExpired) => return plain_error(StatusCode::UNAUTHORIZED, "session_expired"),
+        Err(RpcError::AuthFailed) => return plain_error(StatusCode::UNAUTHORIZED, "auth_failed"),
+        Err(RpcError::Replayed) => return plain_error(StatusCode::BAD_REQUEST, "replayed"),
+    };
+    let inner = match serde_json::from_slice::<InnerRequest>(&opened.plaintext) {
+        Ok(req) => dispatch(&core, &opened, req).await,
+        Err(_) => InnerResponse::error(400, "invalid_request", "The request is not a valid inner request"),
+    };
+    match core.sessions.seal(&env, &opened, &inner) {
+        Some(sealed) => Json(sealed).into_response(),
+        None => plain_error(StatusCode::UNAUTHORIZED, "unknown_session"),
+    }
+}
+
+async fn dispatch(core: &BridgeCore, opened: &crate::session::OpenedRpc, req: InnerRequest) -> InnerResponse {
+    let mutating = req.method != "GET";
+    if mutating && let Some(previous) = core.sessions.rid_response(&opened.device_id, &req.rid, now()) {
+        return previous;
+    }
+    let ctx = InnerContext {
+        user_id: opened.user_id.clone(),
+        device_id: opened.device_id.clone(),
+        sid: opened.sid,
+        seq: opened.seq,
+    };
+    let response = match builtin(core, &ctx, &req).await {
+        Some(r) => r,
+        None => match core.facade() {
+            Some(facade) => facade.handle(&ctx, &req).await,
+            None => None,
+        }
+        .unwrap_or_else(|| InnerResponse::error(404, "no_such_route", "No such route")),
+    };
+    if mutating {
+        core.sessions
+            .remember_rid(&opened.device_id, &req.rid, &response, now());
+    }
+    response
+}
+
+/// Routes the bridge serves itself: `/v1/host` (§6.1).
+async fn builtin(core: &BridgeCore, ctx: &InnerContext, req: &InnerRequest) -> Option<InnerResponse> {
+    let path = req.path.split('?').next().unwrap_or("");
+    match (req.method.as_str(), path) {
+        ("GET", "/v1/host") => {
+            let device = core.store.device(&ctx.device_id).await.ok().flatten()?;
+            let settings = core.store.load_settings(&ctx.user_id).await.ok().flatten();
+            let mut capabilities = vec!["changes.longpoll", "approvals.questions"];
+            if settings.as_ref().is_none_or(|s| s.tasks_write) {
+                capabilities.push("tasks.write");
+            }
+            Some(InnerResponse::ok(json!({
+                "hostId": core.host_key.host_id,
+                "hostName": core.host_name(),
+                "appVersion": env!("CARGO_PKG_VERSION"),
+                "coreVersion": env!("CARGO_PKG_VERSION"),
+                "bridgeVersion": 1,
+                "serverTime": now(),
+                "device": {
+                    "deviceId": device.device_id,
+                    "name": device.name,
+                    "pairedAt": device.paired_at,
+                    "requireConfirm": device.require_confirm,
+                    "confirmMode": device.confirm_mode,
+                },
+                "capabilities": capabilities,
+            })))
+        }
+        ("DELETE", "/v1/host/device") => {
+            let ok = core
+                .store
+                .revoke_device(&ctx.user_id, &ctx.device_id)
+                .await
+                .unwrap_or(false);
+            if ok {
+                core.sessions.drop_device(&ctx.device_id);
+                core.events.emit(
+                    &ctx.user_id,
+                    "mobile.deviceChanged",
+                    json!({ "deviceId": ctx.device_id, "change": "revoked" }),
+                );
+                tracing::info!(device_id = %ctx.device_id, "mobile bridge: phone unpaired itself");
+                Some(InnerResponse::ok(Value::Object(Default::default())))
+            } else {
+                Some(InnerResponse::error(404, "not_found", "Device not found"))
+            }
+        }
+        _ => None,
+    }
+}
diff --git a/crates/aionui-mobile/src/pairing.rs b/crates/aionui-mobile/src/pairing.rs
new file mode 100644
index 00000000..ad6bd0ef
--- /dev/null
+++ b/crates/aionui-mobile/src/pairing.rs
@@ -0,0 +1,403 @@
+//! Pairing offers (CONTRACT §3.4, §4.2, A2). One offer is active at a time;
+//! the first valid request locks it to that phone; a valid request from a
+//! second phone aborts it. All of it lives in memory: an offer never outlives
+//! its five minutes or a restart.
+
+use std::sync::Mutex;
+
+use serde::Serialize;
+use tokio::sync::watch;
+
+use crate::crypto::{self, CryptoError};
+use crate::host_key::{HostKey, random_bytes};
+use crate::wire::{PROTOCOL_VERSION, PairRequestBody, PairRequestPayload, is_fresh};
+
+pub const OFFER_TTL_MS: i64 = 5 * 60 * 1000;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum OfferState {
+    Waiting,
+    RequestReceived,
+    Approved,
+    Rejected,
+    Aborted,
+    Expired,
+}
+
+impl OfferState {
+    /// The `status` a phone sees in a pair response.
+    pub fn wire_status(self) -> &'static str {
+        match self {
+            OfferState::Waiting | OfferState::RequestReceived => "pending",
+            OfferState::Approved => "approved",
+            OfferState::Rejected => "rejected",
+            OfferState::Aborted | OfferState::Expired => "aborted",
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+struct Bound {
+    device_id: String,
+    device_pk: [u8; 32],
+    sas: String,
+    device_name: String,
+    platform: String,
+    app_version: String,
+    confirm_mode: String,
+}
+
+struct Offer {
+    offer_id: String,
+    user_id: String,
+    secret: [u8; 32],
+    expires_at: i64,
+    state: OfferState,
+    bound: Option<Bound>,
+    confirm_key: Option<[u8; 32]>,
+}
+
+impl Offer {
+    fn refresh(&mut self, now: i64) {
+        if now >= self.expires_at && matches!(self.state, OfferState::Waiting | OfferState::RequestReceived) {
+            self.state = OfferState::Expired;
+        }
+    }
+}
+
+/// A freshly created offer, for the desktop to draw as a QR code.
+pub struct NewOffer {
+    pub offer_id: String,
+    pub secret: [u8; 32],
+    pub expires_at: i64,
+}
+
+#[derive(Debug, Clone, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct OfferRequestView {
+    pub device_name: String,
+    pub platform: String,
+    pub app_version: String,
+    pub sas: String,
+    pub confirm_mode: String,
+}
+
+#[derive(Debug, Clone, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct OfferView {
+    pub state: OfferState,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub request: Option<OfferRequestView>,
+}
+
+/// What the desktop's approval produces: the device to store.
+pub struct ApprovedDevice {
+    pub user_id: String,
+    pub device_id: String,
+    pub device_pk: [u8; 32],
+    pub device_name: String,
+    pub platform: String,
+    pub app_version: String,
+    pub confirm_mode: String,
+    pub confirm_key: Option<[u8; 32]>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum PairError {
+    UnsupportedVersion,
+    Malformed,
+    UnknownHost,
+    Expired,
+    Locked,
+    AuthFailed,
+    ClockSkew,
+}
+
+/// A pair request that passed every check.
+pub struct PairAccepted {
+    /// True for the request that bound the offer (the desktop shows the SAS).
+    pub first: bool,
+    pub pairing_key: [u8; 32],
+    pub device_id: String,
+    pub req_ts: i64,
+    pub wait: bool,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum AdminError {
+    NotFound,
+    NotReady,
+}
+
+pub struct PairingManager {
+    offer: Mutex<Option<Offer>>,
+    changed: watch::Sender<u64>,
+}
+
+impl Default for PairingManager {
+    fn default() -> Self {
+        Self {
+            offer: Mutex::new(None),
+            changed: watch::channel(0).0,
+        }
+    }
+}
+
+impl PairingManager {
+    fn bump(&self) {
+        self.changed.send_modify(|n| *n += 1);
+    }
+
+    /// Wakes when any offer changes state; used for the pair long-poll.
+    pub fn subscribe(&self) -> watch::Receiver<u64> {
+        self.changed.subscribe()
+    }
+
+    /// Creates the active offer, replacing any earlier one.
+    pub fn create_offer(&self, user_id: &str, now: i64) -> Result<NewOffer, CryptoError> {
+        let offer_id = crypto::b64u(&random_bytes::<12>().map_err(|_| CryptoError)?);
+        let secret = random_bytes::<32>().map_err(|_| CryptoError)?;
+        let expires_at = now + OFFER_TTL_MS;
+        let mut slot = self.offer.lock().unwrap();
+        if let Some(old) = slot.as_mut()
+            && matches!(old.state, OfferState::Waiting | OfferState::RequestReceived)
+        {
+            old.state = OfferState::Expired;
+        }
+        *slot = Some(Offer {
+            offer_id: offer_id.clone(),
+            user_id: user_id.to_owned(),
+            secret,
+            expires_at,
+            state: OfferState::Waiting,
+            bound: None,
+            confirm_key: None,
+        });
+        drop(slot);
+        self.bump();
+        Ok(NewOffer {
+            offer_id,
+            secret,
+            expires_at,
+        })
+    }
+
+    pub fn view(&self, offer_id: &str, user_id: &str, now: i64) -> Option<OfferView> {
+        let mut slot = self.offer.lock().unwrap();
+        let offer = slot
+            .as_mut()
+            .filter(|o| o.offer_id == offer_id && o.user_id == user_id)?;
+        offer.refresh(now);
+        let request = offer.bound.as_ref().map(|b| OfferRequestView {
+            device_name: b.device_name.clone(),
+            platform: b.platform.clone(),
+            app_version: b.app_version.clone(),
+            sas: b.sas.clone(),
+            confirm_mode: b.confirm_mode.clone(),
+        });
+        Some(OfferView {
+            state: offer.state,
+            request,
+        })
+    }
+
+    /// Checks and records a phone's pair request.
+    pub fn handle_request(&self, host: &HostKey, body: &PairRequestBody, now: i64) -> Result<PairAccepted, PairError> {
+        if body.v != PROTOCOL_VERSION {
+            return Err(PairError::UnsupportedVersion);
+        }
+        if body.host_id != host.host_id {
+            return Err(PairError::UnknownHost);
+        }
+        let device_pk = crypto::key_from_b64u(&body.device_pk).map_err(|_| PairError::Malformed)?;
+        let nonce = crypto::from_b64u(&body.nonce).map_err(|_| PairError::Malformed)?;
+        let ct = crypto::from_b64u(&body.ct).map_err(|_| PairError::Malformed)?;
+        if body.device_id.is_empty() || body.device_id.len() > 64 {
+            return Err(PairError::Malformed);
+        }
+
+        let mut slot = self.offer.lock().unwrap();
+        let offer = slot.as_mut().ok_or(PairError::Expired)?;
+        offer.refresh(now);
+        if matches!(offer.state, OfferState::Expired) {
+            return Err(PairError::Expired);
+        }
+
+        let dh = host.diffie_hellman(&x25519_dalek::PublicKey::from(device_pk));
+        let pairing_key = crypto::pairing_key(&dh, &offer.secret, host.public.as_bytes(), &device_pk);
+        let aad = crypto::pair_req_aad(&host.host_id, &body.device_id);
+        let plain = crypto::open(&pairing_key, &nonce, &ct, &aad).map_err(|_| PairError::AuthFailed)?;
+        let payload: PairRequestPayload = serde_json::from_slice(&plain).map_err(|_| PairError::Malformed)?;
+        if !is_fresh(payload.ts, now) {
+            return Err(PairError::ClockSkew);
+        }
+
+        let mut first = false;
+        match &offer.bound {
+            None => {
+                first = true;
+                if !matches!(offer.state, OfferState::Waiting) {
+                    return Err(PairError::Expired);
+                }
+                offer.bound = Some(Bound {
+                    device_id: body.device_id.clone(),
+                    device_pk,
+                    sas: crypto::short_auth_string(&pairing_key),
+                    device_name: clip(&payload.device_name, 64),
+                    platform: clip(&payload.platform, 32),
+                    app_version: clip(&payload.app_version, 32),
+                    confirm_mode: normalize_confirm_mode(&payload.confirm_mode).to_owned(),
+                });
+                offer.state = OfferState::RequestReceived;
+                drop(slot);
+                self.bump();
+            }
+            Some(bound) if bound.device_pk == device_pk && bound.device_id == body.device_id => {}
+            Some(_) => {
+                // A second phone holds the same QR: someone photographed or relayed it (A2).
+                if matches!(offer.state, OfferState::RequestReceived | OfferState::Waiting) {
+                    offer.state = OfferState::Aborted;
+                    drop(slot);
+                    self.bump();
+                    tracing::warn!("mobile bridge: pairing aborted, the code was used by a second device");
+                }
+                return Err(PairError::Locked);
+            }
+        }
+        Ok(PairAccepted {
+            first,
+            pairing_key,
+            device_id: body.device_id.clone(),
+            req_ts: payload.ts,
+            wait: payload.wait,
+        })
+    }
+
+    /// The current wire status for the bound phone, plus its confirm key once approved.
+    pub fn status_for(&self, device_id: &str, now: i64) -> (&'static str, Option<[u8; 32]>) {
+        let mut slot = self.offer.lock().unwrap();
+        match slot.as_mut() {
+            Some(offer) if offer.bound.as_ref().is_some_and(|b| b.device_id == device_id) => {
+                offer.refresh(now);
+                let key = if offer.state == OfferState::Approved {
+                    offer.confirm_key
+                } else {
+                    None
+                };
+                (offer.state.wire_status(), key)
+            }
+            _ => ("aborted", None),
+        }
+    }
+
+    /// The desktop approves after the user compared the codes.
+    pub fn approve(&self, offer_id: &str, user_id: &str, now: i64) -> Result<ApprovedDevice, AdminError> {
+        let mut slot = self.offer.lock().unwrap();
+        let offer = slot
+            .as_mut()
+            .filter(|o| o.offer_id == offer_id && o.user_id == user_id)
+            .ok_or(AdminError::NotFound)?;
+        offer.refresh(now);
+        if offer.state != OfferState::RequestReceived {
+            return Err(AdminError::NotReady);
+        }
+        let bound = offer.bound.clone().ok_or(AdminError::NotReady)?;
+        let confirm_key = if bound.confirm_mode == "none" {
+            None
+        } else {
+            Some(random_bytes::<32>().map_err(|_| AdminError::NotReady)?)
+        };
+        offer.state = OfferState::Approved;
+        offer.confirm_key = confirm_key;
+        drop(slot);
+        self.bump();
+        Ok(ApprovedDevice {
+            user_id: user_id.to_owned(),
+            device_id: bound.device_id,
+            device_pk: bound.device_pk,
+            device_name: bound.device_name,
+            platform: bound.platform,
+            app_version: bound.app_version,
+            confirm_mode: bound.confirm_mode,
+            confirm_key,
+        })
+    }
+
+    pub fn reject(&self, offer_id: &str, user_id: &str, now: i64) -> Result<(), AdminError> {
+        let mut slot = self.offer.lock().unwrap();
+        let offer = slot
+            .as_mut()
+            .filter(|o| o.offer_id == offer_id && o.user_id == user_id)
+            .ok_or(AdminError::NotFound)?;
+        offer.refresh(now);
+        if !matches!(offer.state, OfferState::Waiting | OfferState::RequestReceived) {
+            return Err(AdminError::NotReady);
+        }
+        offer.state = OfferState::Rejected;
+        drop(slot);
+        self.bump();
+        Ok(())
+    }
+
+    /// The SAS of the bound request, for the desktop's WebSocket notice.
+    pub fn pending_request(&self) -> Option<(String, String, OfferRequestView)> {
+        let slot = self.offer.lock().unwrap();
+        let offer = slot.as_ref()?;
+        let b = offer.bound.as_ref()?;
+        Some((
+            offer.user_id.clone(),
+            offer.offer_id.clone(),
+            OfferRequestView {
+                device_name: b.device_name.clone(),
+                platform: b.platform.clone(),
+                app_version: b.app_version.clone(),
+                sas: b.sas.clone(),
+                confirm_mode: b.confirm_mode.clone(),
+            },
+        ))
+    }
+}
+
+fn clip(s: &str, max: usize) -> String {
+    s.trim().chars().take(max).collect()
+}
+
+fn normalize_confirm_mode(mode: &str) -> &'static str {
+    match mode {
+        "biometric" => "biometric",
+        "device_passcode" => "device_passcode",
+        _ => "none",
+    }
+}
+
+/// `aiondx://pair?...` for the QR code (CONTRACT §4.2), in the parameter order
+/// of the phone's `encodePairingUri`.
+pub fn pairing_uri(host: &HostKey, host_name: &str, offer: &NewOffer, urls: &[String]) -> String {
+    let mut q = vec![
+        ("v", "1".to_owned()),
+        ("id", host.host_id.clone()),
+        ("n", host_name.to_owned()),
+        ("pk", crypto::b64u(host.public.as_bytes())),
+        ("s", crypto::b64u(&offer.secret)),
+        ("x", offer.expires_at.to_string()),
+    ];
+    for u in urls {
+        q.push(("u", u.clone()));
+    }
+    let query: Vec<String> = q.into_iter().map(|(k, v)| format!("{k}={}", form_encode(&v))).collect();
+    format!("aiondx://pair?{}", query.join("&"))
+}
+
+/// `application/x-www-form-urlencoded`, as `URLSearchParams` writes it.
+fn form_encode(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    for b in s.bytes() {
+        match b {
+            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'*' | b'-' | b'.' | b'_' => out.push(b as char),
+            b' ' => out.push('+'),
+            _ => out.push_str(&format!("%{b:02X}")),
+        }
+    }
+    out
+}
diff --git a/crates/aionui-mobile/src/peer_filter.rs b/crates/aionui-mobile/src/peer_filter.rs
new file mode 100644
index 00000000..99db5c75
--- /dev/null
+++ b/crates/aionui-mobile/src/peer_filter.rs
@@ -0,0 +1,77 @@
+//! Which peers may reach the LAN listener (CONTRACT §2): private and
+//! link-local ranges, CGNAT (Tailscale) and loopback. Everything else is
+//! refused before any protocol handling.
+
+use std::net::{IpAddr, Ipv4Addr, Ipv6Addr};
+
+pub fn is_private_peer(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(v4) => is_private_v4(v4),
+        IpAddr::V6(v6) => match v6.to_ipv4_mapped() {
+            Some(v4) => is_private_v4(v4),
+            None => is_private_v6(v6),
+        },
+    }
+}
+
+fn is_private_v4(ip: Ipv4Addr) -> bool {
+    let [a, b, ..] = ip.octets();
+    ip.is_loopback()
+        || ip.is_private() // 10/8, 172.16/12, 192.168/16
+        || ip.is_link_local() // 169.254/16
+        || (a == 100 && (64..=127).contains(&b)) // 100.64/10, CGNAT (Tailscale)
+}
+
+fn is_private_v6(ip: Ipv6Addr) -> bool {
+    let first = ip.segments()[0];
+    ip.is_loopback()
+        || (first & 0xfe00) == 0xfc00 // fc00::/7, unique local
+        || (first & 0xffc0) == 0xfe80 // fe80::/10, link-local
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn ip(s: &str) -> IpAddr {
+        s.parse().unwrap()
+    }
+
+    #[test]
+    fn private_ranges_are_accepted() {
+        for a in [
+            "127.0.0.1",
+            "10.0.0.5",
+            "172.16.0.1",
+            "172.31.255.255",
+            "192.168.1.20",
+            "169.254.3.4",
+            "100.64.0.1",
+            "100.127.255.254",
+            "::1",
+            "fd12:3456::1",
+            "fe80::1",
+            "::ffff:192.168.1.2",
+        ] {
+            assert!(is_private_peer(ip(a)), "{a}");
+        }
+    }
+
+    #[test]
+    fn public_and_edge_ranges_are_refused() {
+        for a in [
+            "8.8.8.8",
+            "172.32.0.1",
+            "172.15.255.255",
+            "100.63.255.255",
+            "100.128.0.1",
+            "192.169.0.1",
+            "1.1.1.1",
+            "2001:4860::8888",
+            "::ffff:8.8.8.8",
+            "0.0.0.0",
+        ] {
+            assert!(!is_private_peer(ip(a)), "{a}");
+        }
+    }
+}
diff --git a/crates/aionui-mobile/src/service.rs b/crates/aionui-mobile/src/service.rs
new file mode 100644
index 00000000..2528a155
--- /dev/null
+++ b/crates/aionui-mobile/src/service.rs
@@ -0,0 +1,838 @@
+//! The bridge's lifecycle: settings, the host key, whether the LAN listener
+//! runs, and the desktop's pairing and device actions. Business logic only;
+//! the HTTP surfaces live in `listener.rs`/`outer.rs` (LAN) and
+//! `admin_routes.rs` (desktop).
+
+use std::net::{IpAddr, Ipv4Addr, UdpSocket};
+use std::sync::Arc;
+
+use serde::Serialize;
+use tokio::sync::Mutex;
+
+use crate::core::{BridgeCore, BridgeEvents, InnerApi};
+use crate::crypto;
+use crate::error::MobileError;
+use crate::host_key::{HostKey, random_bytes};
+use crate::listener::{self, ListenerHandle};
+use crate::pairing::{AdminError, OfferView, pairing_uri};
+use crate::settings::{MobileSettings, MobileSettingsPatch};
+use crate::store::{DeviceRow, MobileStore, Recovery};
+
+/// What the desktop's Settings > Mobile page shows (CONTRACT §3.4).
+#[derive(Debug, Clone, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct MobileStatus {
+    pub enabled: bool,
+    pub port: u16,
+    pub urls: Vec<String>,
+    pub host_id: String,
+    pub host_name: String,
+    pub mdns: bool,
+    pub tasks_write: bool,
+    pub listening: bool,
+    pub error: Option<String>,
+    /// Set after the bridge recovered from a damaged database or host key, until dismissed.
+    pub last_recovery: Option<Recovery>,
+}
+
+/// A new pairing offer for the desktop to draw as a QR code.
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PairingOffer {
+    pub offer_id: String,
+    pub uri: String,
+    pub expires_at: i64,
+}
+
+/// A paired phone as the desktop lists it (CONTRACT §3.4).
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct DeviceView {
+    pub device_id: String,
+    pub name: String,
+    pub platform: String,
+    pub app_version: String,
+    pub paired_at: i64,
+    pub last_seen_at: Option<i64>,
+    pub last_address: Option<String>,
+    pub active_sessions: usize,
+    pub require_confirm: bool,
+    pub confirm_mode: String,
+}
+
+/// Why a desktop pairing or device action failed.
+#[derive(Debug)]
+pub enum AdminFailure {
+    NotFound,
+    /// The offer isn't waiting for this action (no request yet, already decided, or expired).
+    NotReady,
+    Internal(MobileError),
+}
+
+impl From<MobileError> for AdminFailure {
+    fn from(e: MobileError) -> Self {
+        AdminFailure::Internal(e)
+    }
+}
+
+struct Running {
+    user_id: String,
+    port: u16,
+    handle: ListenerHandle,
+}
+
+pub struct MobileBridge {
+    core: Arc<BridgeCore>,
+    default_host_name: String,
+    bind_ip: IpAddr,
+    running: Mutex<Option<Running>>,
+    last_error: Mutex<Option<String>>,
+    /// Set when this boot can't run the bridge (e.g. host.key unreadable): the
+    /// listener stays off and pairing is refused, but status still answers.
+    fault: Option<String>,
+}
+
+impl MobileBridge {
+    pub fn new(
+        store: MobileStore,
+        host_key: Arc<HostKey>,
+        default_host_name: String,
+        events: Arc<dyn BridgeEvents>,
+    ) -> Arc<Self> {
+        Self::with_bind_ip(
+            store,
+            host_key,
+            default_host_name,
+            events,
+            IpAddr::V4(Ipv4Addr::UNSPECIFIED),
+        )
+    }
+
+    /// `bind_ip` is `0.0.0.0` in production; tests use loopback.
+    pub fn with_bind_ip(
+        store: MobileStore,
+        host_key: Arc<HostKey>,
+        default_host_name: String,
+        events: Arc<dyn BridgeEvents>,
+        bind_ip: IpAddr,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            core: BridgeCore::new(host_key, store, default_host_name.clone(), events),
+            default_host_name,
+            bind_ip,
+            running: Mutex::new(None),
+            last_error: Mutex::new(None),
+            fault: None,
+        })
+    }
+
+    /// A bridge that can't run this boot; `status` reports `reason`.
+    pub fn faulted(
+        store: MobileStore,
+        default_host_name: String,
+        events: Arc<dyn BridgeEvents>,
+        reason: String,
+    ) -> Option<Arc<Self>> {
+        let placeholder = Arc::new(HostKey::generate().ok()?); // in memory only, never saved
+        Some(Arc::new(Self {
+            core: BridgeCore::new(placeholder, store, default_host_name.clone(), events),
+            default_host_name,
+            bind_ip: IpAddr::V4(Ipv4Addr::UNSPECIFIED),
+            running: Mutex::new(None),
+            last_error: Mutex::new(None),
+            fault: Some(reason),
+        }))
+    }
+
+    /// Clears `lastRecovery` once the user has seen it.
+    pub async fn dismiss_recovery(&self) -> Result<(), MobileError> {
+        self.store().set_last_recovery(None).await
+    }
+
+    pub fn core(&self) -> &Arc<BridgeCore> {
+        &self.core
+    }
+
+    pub fn host_key(&self) -> &Arc<HostKey> {
+        &self.core.host_key
+    }
+
+    pub fn store(&self) -> &MobileStore {
+        &self.core.store
+    }
+
+    /// Installs the mobile facade (`/v1/...` beyond `/v1/host`).
+    pub fn set_facade(&self, facade: Arc<dyn InnerApi>) {
+        *self.core.facade.write().unwrap() = Some(facade);
+    }
+
+    async fn settings_for(&self, user_id: &str) -> Result<MobileSettings, MobileError> {
+        Ok(self
+            .store()
+            .load_settings(user_id)
+            .await?
+            .unwrap_or_else(|| MobileSettings::defaults(self.default_host_name.clone())))
+    }
+
+    /// Starts the listener at boot for the user who left the bridge on.
+    pub async fn start_if_enabled(&self) {
+        match self.store().enabled_users().await {
+            Ok(users) => {
+                if users.len() > 1 {
+                    tracing::warn!(
+                        count = users.len(),
+                        "mobile bridge: enabled for several users; using the most recent"
+                    );
+                }
+                if let Some((user_id, settings)) = users.into_iter().next() {
+                    self.reconcile(&user_id, &settings).await;
+                }
+            }
+            Err(e) => tracing::error!(error = %e, "mobile bridge: could not read settings at startup"),
+        }
+    }
+
+    pub async fn status(&self, user_id: &str) -> Result<MobileStatus, MobileError> {
+        let settings = self.settings_for(user_id).await?;
+        Ok(self.status_from(user_id, &settings).await)
+    }
+
+    pub async fn update_settings(
+        &self,
+        user_id: &str,
+        patch: &MobileSettingsPatch,
+    ) -> Result<MobileStatus, MobileError> {
+        let mut settings = self.settings_for(user_id).await?;
+        settings.apply(patch)?;
+        self.store().save_settings(user_id, &settings).await?;
+        self.reconcile(user_id, &settings).await;
+        Ok(self.status_from(user_id, &settings).await)
+    }
+
+    /// Stops the listener, e.g. at shutdown.
+    pub async fn stop(&self) {
+        if let Some(running) = self.running.lock().await.take() {
+            running.handle.stop().await;
+        }
+    }
+
+    // ---- Pairing and devices (CONTRACT §3.4) -----------------------------------------------
+
+    pub async fn create_offer(&self, user_id: &str) -> Result<PairingOffer, MobileError> {
+        if let Some(fault) = &self.fault {
+            return Err(MobileError::Key(fault.clone()));
+        }
+        let settings = self.settings_for(user_id).await?;
+        let offer = self
+            .core
+            .pairing
+            .create_offer(user_id, aionui_common::now_ms())
+            .map_err(|_| MobileError::Key("could not create a pairing secret".into()))?;
+        let uri = pairing_uri(
+            &self.core.host_key,
+            &settings.host_name,
+            &offer,
+            &pairing_urls(&settings),
+        );
+        tracing::info!(user_id, "mobile bridge: pairing offer created");
+        Ok(PairingOffer {
+            offer_id: offer.offer_id,
+            uri,
+            expires_at: offer.expires_at,
+        })
+    }
+
+    pub fn offer(&self, user_id: &str, offer_id: &str) -> Option<OfferView> {
+        self.core.pairing.view(offer_id, user_id, aionui_common::now_ms())
+    }
+
+    /// Approves the pending request and stores the phone.
+    pub async fn approve(&self, user_id: &str, offer_id: &str) -> Result<String, AdminFailure> {
+        let device = self
+            .core
+            .pairing
+            .approve(offer_id, user_id, aionui_common::now_ms())
+            .map_err(admin_failure)?;
+        let confirm_key_sealed = match device.confirm_key {
+            Some(key) => Some(seal_confirm_key(self.core.host_key.data_key(), &key)?),
+            None => None,
+        };
+        self.store()
+            .insert_device(&DeviceRow {
+                device_id: device.device_id.clone(),
+                user_id: user_id.to_owned(),
+                device_pk: device.device_pk.to_vec(),
+                name: device.device_name,
+                platform: device.platform,
+                app_version: device.app_version,
+                confirm_mode: device.confirm_mode,
+                confirm_key_sealed,
+                require_confirm: true,
+                paired_at: aionui_common::now_ms(),
+                last_seen_at: None,
+                last_address: None,
+            })
+            .await?;
+        self.core.events.emit(
+            user_id,
+            "mobile.deviceChanged",
+            serde_json::json!({ "deviceId": device.device_id, "change": "paired" }),
+        );
+        tracing::info!(user_id, device_id = %device.device_id, "mobile bridge: phone paired");
+        Ok(device.device_id)
+    }
+
+    pub fn reject(&self, user_id: &str, offer_id: &str) -> Result<(), AdminFailure> {
+        self.core
+            .pairing
+            .reject(offer_id, user_id, aionui_common::now_ms())
+            .map_err(admin_failure)
+    }
+
+    pub async fn devices(&self, user_id: &str) -> Result<Vec<DeviceView>, MobileError> {
+        let rows = self.store().devices_for(user_id).await?;
+        Ok(rows
+            .into_iter()
+            .map(|d| DeviceView {
+                active_sessions: self.core.sessions.count_for(&d.device_id),
+                device_id: d.device_id,
+                name: d.name,
+                platform: d.platform,
+                app_version: d.app_version,
+                paired_at: d.paired_at,
+                last_seen_at: d.last_seen_at,
+                last_address: d.last_address,
+                require_confirm: d.require_confirm,
+                confirm_mode: d.confirm_mode,
+            })
+            .collect())
+    }
+
+    pub async fn update_device(
+        &self,
+        user_id: &str,
+        device_id: &str,
+        name: Option<&str>,
+        require_confirm: Option<bool>,
+    ) -> Result<(), AdminFailure> {
+        if !self
+            .store()
+            .update_device(user_id, device_id, name, require_confirm)
+            .await?
+        {
+            return Err(AdminFailure::NotFound);
+        }
+        self.core.events.emit(
+            user_id,
+            "mobile.deviceChanged",
+            serde_json::json!({ "deviceId": device_id, "change": "updated" }),
+        );
+        Ok(())
+    }
+
+    /// Revokes a phone: its row, its confirm key and every session go (A1).
+    pub async fn revoke(&self, user_id: &str, device_id: &str) -> Result<(), AdminFailure> {
+        if !self.store().revoke_device(user_id, device_id).await? {
+            return Err(AdminFailure::NotFound);
+        }
+        self.core.sessions.drop_device(device_id);
+        self.core.events.emit(
+            user_id,
+            "mobile.deviceChanged",
+            serde_json::json!({ "deviceId": device_id, "change": "revoked" }),
+        );
+        tracing::info!(user_id, device_id, "mobile bridge: phone revoked");
+        Ok(())
+    }
+
+    /// Makes the listener match `settings` for `user_id`.
+    async fn reconcile(&self, user_id: &str, settings: &MobileSettings) {
+        let mut running = self.running.lock().await;
+        if running.is_none() || matches!(&*running, Some(r) if r.user_id == user_id) {
+            *self.core.host_name.write().unwrap() = settings.host_name.clone();
+        }
+        let keep = matches!(&*running, Some(r) if settings.enabled && r.user_id == user_id && r.port == settings.port);
+        if keep {
+            return;
+        }
+        let other_user = matches!(&*running, Some(r) if r.user_id != user_id);
+        if other_user && !settings.enabled {
+            return; // someone else's bridge; this user switching off changes nothing
+        }
+        if let Some(old) = running.take() {
+            old.handle.stop().await;
+        }
+        *self.last_error.lock().await = None;
+        if !settings.enabled {
+            return;
+        }
+        if let Some(fault) = &self.fault {
+            *self.last_error.lock().await = Some(fault.clone());
+            return;
+        }
+        let router = listener::outer_router(self.core.clone());
+        match listener::start(self.bind_ip, settings.port, router).await {
+            Ok(handle) => {
+                *running = Some(Running {
+                    user_id: user_id.to_owned(),
+                    port: settings.port,
+                    handle,
+                });
+            }
+            Err(e) => {
+                tracing::error!(error = %e, port = settings.port, "mobile bridge: listener did not start");
+                *self.last_error.lock().await = Some(e.to_string());
+            }
+        }
+    }
+
+    async fn status_from(&self, user_id: &str, settings: &MobileSettings) -> MobileStatus {
+        let listening = matches!(&*self.running.lock().await, Some(r) if r.user_id == user_id);
+        MobileStatus {
+            enabled: settings.enabled,
+            port: settings.port,
+            urls: pairing_urls(settings),
+            host_id: self.core.host_key.host_id.clone(),
+            host_name: settings.host_name.clone(),
+            mdns: settings.mdns,
+            tasks_write: settings.tasks_write,
+            listening,
+            error: match &self.fault {
+                Some(fault) => Some(fault.clone()),
+                None => self.last_error.lock().await.clone(),
+            },
+            last_recovery: self.store().last_recovery().await.ok().flatten(),
+        }
+    }
+}
+
+/// Opens the bridge's state in `data_dir`, recovering from damage instead of
+/// failing. A bridge fault must never stop AionCore from starting:
+/// - a database that won't open is moved aside (`aiondx-bridge.db.corrupt-<ms>`)
+///   and a fresh one is created: the bridge comes up disabled, with no phones;
+/// - a host key that is present but won't decrypt or decode is moved aside and
+///   replaced; phones paired to the old identity can't work any more, so they are
+///   forgotten too;
+/// - a host key that can't be READ (locked by antivirus or a backup, permission
+///   denied) is left alone: the bridge is disabled for this boot, with the
+///   reason in its status.
+///
+/// Every recovery is recorded as `lastRecovery` in the status. `None` only if
+/// even a fresh database can't be created (e.g. the folder isn't writable).
+pub async fn open_in(
+    data_dir: &std::path::Path,
+    protector: &dyn crate::host_key::SecretProtector,
+    host_name: String,
+    events: Arc<dyn BridgeEvents>,
+) -> Option<Arc<MobileBridge>> {
+    let db_path = MobileStore::path_in(data_dir);
+    let mut recovery = None;
+    let store = match MobileStore::open(&db_path).await {
+        Ok(store) => store,
+        Err(error) => {
+            tracing::warn!(%error, "mobile bridge: its database did not open; starting with a fresh one");
+            let moved_to = quarantine(&db_path);
+            for suffix in ["-wal", "-shm"] {
+                quarantine(&std::path::PathBuf::from(format!("{}{suffix}", db_path.display())));
+            }
+            recovery = Some(Recovery {
+                kind: "database".into(),
+                at: aionui_common::now_ms(),
+                moved_to,
+            });
+            match MobileStore::open(&db_path).await {
+                Ok(store) => store,
+                Err(error) => {
+                    tracing::error!(%error, "mobile bridge disabled: a fresh database could not be created");
+                    return None;
+                }
+            }
+        }
+    };
+    let key_path = HostKey::path_in(data_dir);
+    let host_key = match HostKey::load_or_create(&key_path, protector) {
+        Ok(key) => key,
+        Err(MobileError::Io(error)) => {
+            let reason =
+                format!("The bridge's host key could not be read ({error}); the bridge is off until the next start");
+            tracing::error!(%error, "mobile bridge disabled for this boot: host.key unreadable, file kept");
+            if let Some(r) = &recovery {
+                let _ = store.set_last_recovery(Some(r)).await;
+            }
+            return MobileBridge::faulted(store, host_name, events, reason);
+        }
+        Err(error) => {
+            tracing::warn!(%error, "mobile bridge: host.key is damaged; creating a new identity, phones must pair again");
+            let moved_to = quarantine(&key_path);
+            match HostKey::load_or_create(&key_path, protector) {
+                Ok(key) => {
+                    if let Err(error) = store.clear_devices().await {
+                        tracing::error!(%error, "mobile bridge: could not forget phones of the old identity");
+                    }
+                    recovery = Some(Recovery {
+                        kind: "host_key".into(),
+                        at: aionui_common::now_ms(),
+                        moved_to,
+                    });
+                    key
+                }
+                Err(error) => {
+                    let reason = format!("A new host key could not be created ({error})");
+                    tracing::error!(%error, "mobile bridge disabled for this boot: no host key");
+                    return MobileBridge::faulted(store, host_name, events, reason);
+                }
+            }
+        }
+    };
+    if let Some(r) = &recovery {
+        if let Err(error) = store.set_last_recovery(Some(r)).await {
+            tracing::error!(%error, "mobile bridge: could not record the recovery");
+        }
+    }
+    Some(MobileBridge::new(store, Arc::new(host_key), host_name, events))
+}
+
+/// Moves a damaged file aside, keeping it for diagnosis. Returns where it went.
+fn quarantine(path: &std::path::Path) -> Option<String> {
+    if !path.exists() {
+        return None;
+    }
+    let aside = std::path::PathBuf::from(format!("{}.corrupt-{}", path.display(), aionui_common::now_ms()));
+    match std::fs::rename(path, &aside) {
+        Ok(()) => Some(aside.display().to_string()),
+        Err(error) => {
+            tracing::error!(%error, path = %path.display(), "mobile bridge: could not move a damaged file aside");
+            None
+        }
+    }
+}
+
+fn admin_failure(e: AdminError) -> AdminFailure {
+    match e {
+        AdminError::NotFound => AdminFailure::NotFound,
+        AdminError::NotReady => AdminFailure::NotReady,
+    }
+}
+
+const CONFIRM_KEY_AT_REST_AAD: &[u8] = b"aiondx/v1/confirm-key-at-rest";
+
+/// `nonce ‖ ciphertext` of a confirm key under the host's `dataKey`.
+pub(crate) fn seal_confirm_key(data_key: &[u8; 32], key: &[u8; 32]) -> Result<Vec<u8>, MobileError> {
+    let nonce = random_bytes::<24>()?;
+    let mut out = nonce.to_vec();
+    out.extend(crypto::seal(data_key, &nonce, key, CONFIRM_KEY_AT_REST_AAD));
+    Ok(out)
+}
+
+#[allow(dead_code)] // used by the confirm-proof check (phase 3)
+pub(crate) fn open_confirm_key(data_key: &[u8; 32], sealed: &[u8]) -> Option<[u8; 32]> {
+    if sealed.len() < 24 {
+        return None;
+    }
+    let plain = crypto::open(data_key, &sealed[..24], &sealed[24..], CONFIRM_KEY_AT_REST_AAD).ok()?;
+    plain.try_into().ok()
+}
+
+/// The base URLs that go into the pairing QR: this PC's primary LAN address,
+/// then the user's extra URLs. Phase 5 replaces the primary-address probe with
+/// a full interface enumeration.
+fn pairing_urls(settings: &MobileSettings) -> Vec<String> {
+    let mut urls = Vec::new();
+    if let Some(ip) = primary_lan_ip() {
+        urls.push(format!("http://{ip}:{}", settings.port));
+    }
+    for url in &settings.extra_urls {
+        if !urls.contains(url) {
+            urls.push(url.clone());
+        }
+    }
+    urls
+}
+
+/// The address the OS would use for outbound traffic. Connecting a UDP socket
+/// sends nothing; it only selects a route.
+fn primary_lan_ip() -> Option<IpAddr> {
+    let socket = UdpSocket::bind((Ipv4Addr::UNSPECIFIED, 0)).ok()?;
+    socket.connect((Ipv4Addr::new(192, 0, 2, 1), 9)).ok()?;
+    let ip = socket.local_addr().ok()?.ip();
+    crate::peer_filter::is_private_peer(ip)
+        .then_some(ip)
+        .filter(|ip| !ip.is_loopback())
+}
