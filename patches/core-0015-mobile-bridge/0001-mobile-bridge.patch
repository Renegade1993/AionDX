+/// Opens the mobile bridge's own database and host key, recovering from damage.
+/// A bridge fault only disables the bridge; it never stops AionCore from starting.
+async fn build_mobile_bridge(
+    data_dir: &std::path::Path,
+    event_bus: Arc<BroadcastEventBus>,
+) -> Option<Arc<aionui_mobile::MobileBridge>> {
+    let host_name = std::env::var("COMPUTERNAME")
+        .or_else(|_| std::env::var("HOSTNAME"))
+        .unwrap_or_else(|_| "AionDX".to_owned());
+    let events: Arc<dyn aionui_mobile::BridgeEvents> = Arc::new(MobileBridgeEvents(event_bus));
+    let protector = aionui_mobile::platform_protector();
+    aionui_mobile::service::open_in(data_dir, protector.as_ref(), host_name, events).await
+}
+
+/// Forwards the bridge's desktop notices (`mobile.pairingRequest`,
+/// `mobile.deviceChanged`) to the user's WebSocket connections.
+struct MobileBridgeEvents(Arc<BroadcastEventBus>);
+
+impl aionui_mobile::BridgeEvents for MobileBridgeEvents {
+    fn emit(&self, user_id: &str, name: &str, mut data: serde_json::Value) {
+        use aionui_realtime::EventBroadcaster;
+        if let Some(map) = data.as_object_mut() {
+            map.insert("user_id".to_owned(), serde_json::Value::String(user_id.to_owned()));
+        }
+        self.0.broadcast(aionui_api_types::WebSocketMessage::new(name, data));
+    }
+}
