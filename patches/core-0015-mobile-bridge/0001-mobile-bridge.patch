+use thiserror::Error;
+
+#[derive(Debug, Error)]
+pub enum MobileError {
+    #[error("mobile bridge storage error: {0}")]
+    Store(#[from] sqlx::Error),
+    #[error("mobile bridge migration error: {0}")]
+    Migrate(#[from] sqlx::migrate::MigrateError),
+    #[error("mobile bridge key error: {0}")]
+    Key(String),
+    #[error("mobile bridge listener error: {0}")]
+    Listener(String),
+    #[error("invalid mobile bridge setting: {0}")]
+    InvalidSetting(String),
+    #[error("mobile bridge I/O error: {0}")]
+    Io(#[from] std::io::Error),
+    #[error("mobile bridge serialization error: {0}")]
+    Json(#[from] serde_json::Error),
+}
diff --git a/crates/aionui-mobile/src/host_key.rs b/crates/aionui-mobile/src/host_key.rs
new file mode 100644
index 00000000..1538b4c9
--- /dev/null
+++ b/crates/aionui-mobile/src/host_key.rs
@@ -0,0 +1,283 @@
+//! The PC's long-term identity for the bridge (CONTRACT §3.1): the static
+//! X25519 key `S_h`, the random `hostId`, and `dataKey`, which seals per-device
+//! secrets. One file, `host.key`, sealed with the OS's per-user protection
+//! (DPAPI on Windows). Rotating it means a new `hostId`, so every phone pairs
+//! again.
+
+use std::path::{Path, PathBuf};
+
+use base64::Engine;
+use base64::engine::general_purpose::URL_SAFE_NO_PAD;
+use serde::{Deserialize, Serialize};
+use x25519_dalek::{PublicKey, StaticSecret};
+
+use crate::error::MobileError;
+
+/// Seals and unseals bytes at rest.
+pub trait SecretProtector: Send + Sync {
+    fn protect(&self, plain: &[u8]) -> Result<Vec<u8>, MobileError>;
+    fn unprotect(&self, sealed: &[u8]) -> Result<Vec<u8>, MobileError>;
+}
+
+/// The current Windows user's DPAPI key: only this user on this PC can unseal.
+#[cfg(windows)]
+pub struct DpapiProtector;
+
+#[cfg(windows)]
+impl SecretProtector for DpapiProtector {
+    fn protect(&self, plain: &[u8]) -> Result<Vec<u8>, MobileError> {
+        dpapi::run(plain, true)
+    }
+
+    fn unprotect(&self, sealed: &[u8]) -> Result<Vec<u8>, MobileError> {
+        dpapi::run(sealed, false)
+    }
+}
+
+#[cfg(windows)]
+mod dpapi {
+    use windows_sys::Win32::Foundation::{HLOCAL, LocalFree};
+    use windows_sys::Win32::Security::Cryptography::{
+        CRYPT_INTEGER_BLOB, CRYPTPROTECT_UI_FORBIDDEN, CryptProtectData, CryptUnprotectData,
+    };
+
+    use crate::error::MobileError;
+
+    pub(super) fn run(input: &[u8], protect: bool) -> Result<Vec<u8>, MobileError> {
+        let len = u32::try_from(input.len()).map_err(|_| MobileError::Key("secret too large".into()))?;
+        let data_in = CRYPT_INTEGER_BLOB {
+            cbData: len,
+            pbData: input.as_ptr() as *mut u8,
+        };
+        let mut data_out = CRYPT_INTEGER_BLOB {
+            cbData: 0,
+            pbData: std::ptr::null_mut(),
+        };
+        // SAFETY: every pointer is valid for the call; the output buffer is
+        // allocated by the OS and released with LocalFree below.
+        let ok = unsafe {
+            if protect {
+                CryptProtectData(
+                    &data_in,
+                    std::ptr::null(),
+                    std::ptr::null(),
+                    std::ptr::null(),
+                    std::ptr::null(),
+                    CRYPTPROTECT_UI_FORBIDDEN,
+                    &mut data_out,
+                )
+            } else {
+                CryptUnprotectData(
+                    &data_in,
+                    std::ptr::null_mut(),
+                    std::ptr::null(),
+                    std::ptr::null(),
+                    std::ptr::null(),
+                    CRYPTPROTECT_UI_FORBIDDEN,
+                    &mut data_out,
+                )
+            }
+        };
+        if ok == 0 || data_out.pbData.is_null() {
+            let op = if protect {
+                "CryptProtectData"
+            } else {
+                "CryptUnprotectData"
+            };
+            return Err(MobileError::Key(format!(
+                "{op} failed: {}",
+                std::io::Error::last_os_error()
+            )));
+        }
+        // SAFETY: the OS returned cbData valid bytes at pbData.
+        let out = unsafe { std::slice::from_raw_parts(data_out.pbData, data_out.cbData as usize).to_vec() };
+        // SAFETY: pbData was allocated by the OS for this call.
+        unsafe { LocalFree(data_out.pbData as HLOCAL) };
+        Ok(out)
+    }
+}
+
+/// Stores bytes as they are. Tests and non-Windows development only.
+pub struct UnprotectedForTests;
+
+impl SecretProtector for UnprotectedForTests {
+    fn protect(&self, plain: &[u8]) -> Result<Vec<u8>, MobileError> {
+        Ok(plain.to_vec())
+    }
+
+    fn unprotect(&self, sealed: &[u8]) -> Result<Vec<u8>, MobileError> {
+        Ok(sealed.to_vec())
+    }
+}
+
+/// The protector for this platform.
+pub fn platform_protector() -> Box<dyn SecretProtector> {
+    #[cfg(windows)]
+    {
+        Box::new(DpapiProtector)
+    }
+    #[cfg(not(windows))]
+    {
+        tracing::warn!("mobile bridge: no OS secret protection on this platform; host.key is stored unsealed");
+        Box::new(UnprotectedForTests)
+    }
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct HostKeyFile {
+    v: u8,
+    host_id: String,
+    s_h: String,
+    data_key: String,
+}
+
+pub struct HostKey {
+    pub host_id: String,
+    secret: StaticSecret,
+    pub public: PublicKey,
+    data_key: [u8; 32],
+}
+
+impl std::fmt::Debug for HostKey {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("HostKey")
+            .field("host_id", &self.host_id)
+            .finish_non_exhaustive()
+    }
+}
+
+impl HostKey {
+    pub fn path_in(data_dir: &Path) -> PathBuf {
+        data_dir.join("aiondx-mobile").join("host.key")
+    }
+
+    /// Loads `host.key`, creating it on first use.
+    pub fn load_or_create(path: &Path, protector: &dyn SecretProtector) -> Result<Self, MobileError> {
+        if path.exists() {
+            let sealed = std::fs::read(path)?;
+            let plain = protector.unprotect(&sealed)?;
+            let file: HostKeyFile = serde_json::from_slice(&plain)?;
+            return Self::from_file(file);
+        }
+        let key = Self::generate()?;
+        if let Some(dir) = path.parent() {
+            std::fs::create_dir_all(dir)?;
+        }
+        let plain = serde_json::to_vec(&key.to_file())?;
+        let sealed = protector.protect(&plain)?;
+        let tmp = path.with_extension("key.tmp");
+        std::fs::write(&tmp, sealed)?;
+        std::fs::rename(&tmp, path)?;
+        tracing::info!(host_id = %key.host_id, "mobile bridge: created host key");
+        Ok(key)
+    }
+
+    pub fn generate() -> Result<Self, MobileError> {
+        let host_id = URL_SAFE_NO_PAD.encode(random_bytes::<16>()?);
+        let secret = StaticSecret::from(random_bytes::<32>()?);
+        let public = PublicKey::from(&secret);
+        Ok(Self {
+            host_id,
+            secret,
+            public,
+            data_key: random_bytes::<32>()?,
+        })
+    }
+
+    /// X25519 with the host static key.
+    pub fn diffie_hellman(&self, peer: &PublicKey) -> [u8; 32] {
+        self.secret.diffie_hellman(peer).to_bytes()
+    }
+
+    pub fn data_key(&self) -> &[u8; 32] {
+        &self.data_key
+    }
+
+    fn to_file(&self) -> HostKeyFile {
+        HostKeyFile {
+            v: 1,
+            host_id: self.host_id.clone(),
+            s_h: URL_SAFE_NO_PAD.encode(self.secret.to_bytes()),
+            data_key: URL_SAFE_NO_PAD.encode(self.data_key),
+        }
+    }
+
+    fn from_file(file: HostKeyFile) -> Result<Self, MobileError> {
+        if file.v != 1 {
+            return Err(MobileError::Key(format!("unsupported host.key version {}", file.v)));
+        }
+        let secret = StaticSecret::from(decode_32(&file.s_h)?);
+        let public = PublicKey::from(&secret);
+        Ok(Self {
+            host_id: file.host_id,
+            secret,
+            public,
+            data_key: decode_32(&file.data_key)?,
+        })
+    }
+}
+
+pub(crate) fn random_bytes<const N: usize>() -> Result<[u8; N], MobileError> {
+    let mut buf = [0u8; N];
+    getrandom::getrandom(&mut buf).map_err(|e| MobileError::Key(format!("OS random source failed: {e}")))?;
+    Ok(buf)
+}
+
+fn decode_32(b64u: &str) -> Result<[u8; 32], MobileError> {
+    URL_SAFE_NO_PAD
+        .decode(b64u)
+        .ok()
+        .and_then(|bytes| <[u8; 32]>::try_from(bytes).ok())
+        .ok_or_else(|| MobileError::Key("host.key holds a malformed key".into()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn create_then_reload_gives_the_same_identity() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = HostKey::path_in(dir.path());
+        let first = HostKey::load_or_create(&path, &UnprotectedForTests).unwrap();
+        let again = HostKey::load_or_create(&path, &UnprotectedForTests).unwrap();
+        assert_eq!(first.host_id, again.host_id);
+        assert_eq!(first.public.as_bytes(), again.public.as_bytes());
+        assert_eq!(first.data_key(), again.data_key());
+        assert_eq!(URL_SAFE_NO_PAD.decode(&first.host_id).unwrap().len(), 16);
+    }
+
+    #[test]
+    fn a_corrupt_file_is_an_error_not_a_new_identity() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = HostKey::path_in(dir.path());
+        std::fs::create_dir_all(path.parent().unwrap()).unwrap();
+        std::fs::write(&path, b"not json").unwrap();
+        assert!(HostKey::load_or_create(&path, &UnprotectedForTests).is_err());
+    }
+
+    #[test]
+    fn debug_output_never_shows_secrets() {
+        let key = HostKey::generate().unwrap();
+        let shown = format!("{key:?}");
+        assert!(shown.contains(&key.host_id));
+        assert!(!shown.contains(&URL_SAFE_NO_PAD.encode(key.data_key())));
+    }
+
+    #[cfg(windows)]
+    #[test]
+    fn dpapi_round_trips_and_does_not_store_plaintext() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = HostKey::path_in(dir.path());
+        let first = HostKey::load_or_create(&path, &DpapiProtector).unwrap();
+        let on_disk = std::fs::read(&path).unwrap();
+        assert!(
+            !String::from_utf8_lossy(&on_disk).contains(&first.host_id),
+            "host.key must be sealed"
+        );
+        let again = HostKey::load_or_create(&path, &DpapiProtector).unwrap();
+        assert_eq!(first.host_id, again.host_id);
+        assert_eq!(first.public.as_bytes(), again.public.as_bytes());
+    }
+}
