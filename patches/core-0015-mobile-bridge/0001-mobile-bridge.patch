+//! Byte-for-byte check of protocol v1 against the shared test vectors
+//! (`vectors.json`, generated by AionDX's docs/mobile-bridge/vectors/gen-vectors.js;
+//! the phone's TypeScript suite runs against the same file).
+
+use aionui_mobile::crypto::*;
+use serde_json::Value;
+
+fn vectors() -> Value {
+    serde_json::from_str(include_str!("vectors.json")).unwrap()
+}
+
+fn h(v: &Value) -> Vec<u8> {
+    hex::decode(v.as_str().unwrap()).unwrap()
+}
+
+fn h32(v: &Value) -> [u8; 32] {
+    h(v).try_into().unwrap()
+}
+
+fn s(v: &Value) -> &str {
+    v.as_str().unwrap()
+}
+
+fn check_box(key: &[u8; 32], bx: &Value) {
+    let nonce: [u8; 24] = from_b64u(s(&bx["nonce"])).unwrap().try_into().unwrap();
+    let aad = h(&bx["aad"]);
+    let ct = from_b64u(s(&bx["ct"])).unwrap();
+    assert_eq!(seal(key, &nonce, s(&bx["plaintext"]).as_bytes(), &aad), ct, "seal");
+    assert_eq!(
+        open(key, &nonce, &ct, &aad).unwrap(),
+        s(&bx["plaintext"]).as_bytes(),
+        "open"
+    );
+}
+
+#[test]
+fn keys_derive_from_the_fixed_private_keys() {
+    let v = vectors();
+    for k in ["S_h", "S_c", "e_c", "e_h"] {
+        let key = &v["inputs"][k];
+        assert_eq!(x25519_public(&h32(&key["priv"])).to_vec(), h(&key["pub"]), "{k}");
+        assert_eq!(b64u(&h(&key["pub"])), s(&key["pubB64u"]), "{k}");
+    }
+}
+
+#[test]
+fn pairing_vectors() {
+    let v = vectors();
+    let i = &v["inputs"];
+    let p = &v["pairing"];
+    let (sh, sc) = (h32(&i["S_h"]["priv"]), h32(&i["S_c"]["priv"]));
+    let (sh_pub, sc_pub) = (h32(&i["S_h"]["pub"]), h32(&i["S_c"]["pub"]));
+    let dh = x25519(&sc, &sh_pub);
+    assert_eq!(dh, x25519(&sh, &sc_pub));
+    assert_eq!(dh, h32(&p["dh_Sc_Sh"]));
+    let k_pair = pairing_key(&dh, &h(&i["pairingSecret"]), &sh_pub, &sc_pub);
+    assert_eq!(k_pair, h32(&p["k_pair"]));
+    assert_eq!(short_auth_string(&k_pair), s(&p["sas"]));
+    let (host_id, device_id) = (s(&i["hostId"]), s(&i["deviceId"]));
+    assert_eq!(pair_req_aad(host_id, device_id), h(&p["request"]["aad"]));
+    assert_eq!(pair_res_aad(host_id, device_id), h(&p["response"]["aad"]));
+    check_box(&k_pair, &p["request"]);
+    check_box(&k_pair, &p["response"]);
+}
+
+#[test]
+fn handshake_and_rpc_vectors() {
+    let v = vectors();
+    let i = &v["inputs"];
+    let hs = &v["handshake"];
+    let (host_id, device_id) = (s(&i["hostId"]), s(&i["deviceId"]));
+    let (sh, sc, ec, eh) = (
+        h32(&i["S_h"]["priv"]),
+        h32(&i["S_c"]["priv"]),
+        h32(&i["e_c"]["priv"]),
+        h32(&i["e_h"]["priv"]),
+    );
+    let (sh_pub, sc_pub, ec_pub, eh_pub) = (
+        h32(&i["S_h"]["pub"]),
+        h32(&i["S_c"]["pub"]),
+        h32(&i["e_c"]["pub"]),
+        h32(&i["e_h"]["pub"]),
+    );
+
+    // The host derives everything from its own secrets plus the phone's public keys.
+    let d1 = x25519(&sh, &ec_pub);
+    let d2 = x25519(&sh, &sc_pub);
+    let d3 = x25519(&eh, &ec_pub);
+    let d4 = x25519(&eh, &sc_pub);
+    assert_eq!(d1, x25519(&ec, &sh_pub));
+    assert_eq!(d4, x25519(&sc, &eh_pub));
+    assert_eq!(d1, h32(&hs["dh_ec_Sh"]));
+    assert_eq!(d2, h32(&hs["dh_Sc_Sh"]));
+    assert_eq!(d3, h32(&hs["dh_ec_eh"]));
+    assert_eq!(d4, h32(&hs["dh_Sc_eh"]));
+
+    let k_init = handshake_init_key(&d1, &d2, device_id, &sc_pub, &sh_pub, &ec_pub);
+    assert_eq!(k_init, h32(&hs["k_init"]));
+    assert_eq!(handshake_init_aad(host_id, device_id, &ec_pub), h(&hs["init"]["aad"]));
+    check_box(&k_init, &hs["init"]);
+
+    let t = session_transcript(device_id, &sc_pub, &sh_pub, &ec_pub, &eh_pub);
+    assert_eq!(t, h32(&hs["transcript"]));
+    let keys = session_keys([&d1, &d2, &d3, &d4], &t);
+    assert_eq!(keys.c2s, h32(&hs["c2s"]));
+    assert_eq!(keys.s2c, h32(&hs["s2c"]));
+    assert_eq!(keys.sid.to_vec(), h(&hs["sid"]));
+    assert_eq!(b64u(&keys.sid), s(&hs["sidB64u"]));
+    check_box(&keys.s2c, &hs["response"]);
+
+    let rpc = &v["rpc"];
+    let seq = rpc["seq"].as_u64().unwrap();
+    assert_eq!(rpc_aad(false, &keys.sid, seq), h(&rpc["request"]["aad"]));
+    assert_eq!(rpc_aad(true, &keys.sid, seq), h(&rpc["response"]["aad"]));
+    check_box(&keys.c2s, &rpc["request"]);
+    check_box(&keys.s2c, &rpc["response"]);
+}
+
+#[test]
+fn revocation_vector() {
+    let v = vectors();
+    let i = &v["inputs"];
+    let r = &v["revocation"];
+    let (host_id, device_id) = (s(&i["hostId"]), s(&i["deviceId"]));
+    let ec_pub = h32(&i["e_c"]["pub"]);
+    let dh = x25519(&h32(&i["S_h"]["priv"]), &ec_pub);
+    assert_eq!(dh, h32(&r["dh_Sh_ec"]));
+    let k_rev = revocation_key(&dh, host_id, device_id, &ec_pub);
+    assert_eq!(k_rev, h32(&r["k_rev"]));
+    assert_eq!(revocation_aad(host_id, device_id, &ec_pub), h(&r["notice"]["aad"]));
+    check_box(&k_rev, &r["notice"]);
+}
+
+#[test]
+fn confirm_and_rekey_vectors() {
+    let v = vectors();
+    let sid: [u8; 16] = h(&v["handshake"]["sid"]).try_into().unwrap();
+    let confirm_key = h(&v["pairing"]["confirmKey"]);
+    for c in v["confirm"].as_array().unwrap() {
+        let body = if c["body"] == "(absent)" {
+            Value::Null
+        } else {
+            c["body"].clone()
+        };
+        let canon = jcs(&body).unwrap();
+        assert_eq!(canon, s(&c["jcs"]));
+        assert_eq!(sha256(&[canon.as_bytes()]).to_vec(), h(&c["bodySha256"]));
+        let input = confirm_mac_input(
+            &sid,
+            c["seq"].as_u64().unwrap(),
+            s(&c["method"]),
+            s(&c["path"]),
+            &canon,
+            s(&c["rid"]),
+        );
+        assert_eq!(input, h(&c["macInput"]));
+        assert_eq!(b64u(&hmac_sha256(&confirm_key, &input)), s(&c["confirm"]));
+    }
+    let rk = &v["rekey"];
+    let input = rekey_mac_input(&sid, s(&v["inputs"]["deviceId"]));
+    assert_eq!(input, h(&rk["macInput"]));
+    assert_eq!(b64u(&hmac_sha256(&h(&rk["rekeySecret"]), &input)), s(&rk["proof"]));
+}
