+/// Opens the mobile bridge's own database and host key. Failure only disables
+/// the bridge; it never stops AionCore from starting.
+async fn build_mobile_bridge(data_dir: &std::path::Path) -> Option<Arc<aionui_mobile::MobileBridge>> {
+    let store = match aionui_mobile::MobileStore::open(&aionui_mobile::MobileStore::path_in(data_dir)).await {
+        Ok(store) => store,
+        Err(error) => {
+            tracing::error!(%error, "mobile bridge disabled: its database did not open");
+            return None;
+        }
+    };
+    let protector = aionui_mobile::platform_protector();
+    let host_key =
+        match aionui_mobile::HostKey::load_or_create(&aionui_mobile::HostKey::path_in(data_dir), protector.as_ref()) {
+            Ok(key) => Arc::new(key),
+            Err(error) => {
+                tracing::error!(%error, "mobile bridge disabled: its host key could not be loaded");
+                return None;
+            }
+        };
+    let host_name = std::env::var("COMPUTERNAME")
+        .or_else(|_| std::env::var("HOSTNAME"))
+        .unwrap_or_else(|_| "AionDX".to_owned());
+    Some(aionui_mobile::MobileBridge::new(store, host_key, host_name))
+}
