+//! Sessions (CONTRACT §4.3–4.5, A3, A4): the handshake, the session table,
+//! and opening and sealing RPC envelopes. All state is in memory; a restart
+//! ends every session and phones simply handshake again.
+
+use std::collections::{BTreeSet, HashMap, VecDeque};
+use std::sync::Mutex;
+
+use crate::crypto::{self, SID_LEN};
+use crate::host_key::{HostKey, random_bytes};
+use crate::wire::{
+    HandshakeInitBody, HandshakeResponseBody, InnerResponse, PROTOCOL_VERSION, RpcEnvelope, SealedBox, is_fresh,
+};
+
+/// §11 #7: 12 h absolute, 30 min idle.
+pub const SESSION_TTL_MS: i64 = 12 * 60 * 60 * 1000;
+pub const IDLE_TIMEOUT_MS: i64 = 30 * 60 * 1000;
+pub const REPLAY_WINDOW: u64 = 256;
+pub const MAX_SESSIONS_PER_DEVICE: usize = 4;
+/// A3: how long a handshake `epk` is remembered.
+const EPK_MEMORY_MS: i64 = 5 * 60 * 1000;
+/// A4: how long a mutating request's `rid` is remembered per device.
+const RID_MEMORY_MS: i64 = 10 * 60 * 1000;
+
+/// What the handshake needs to know about a device.
+pub struct KnownDevice {
+    pub user_id: String,
+    pub device_pk: [u8; 32],
+}
+
+pub enum HandshakeOutcome {
+    Ok {
+        response: HandshakeResponseBody,
+        sid: [u8; SID_LEN],
+    },
+    /// The device isn't trusted: an authenticated notice for the phone (A1).
+    Revoked { notice: SealedBox },
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum HandshakeError {
+    UnsupportedVersion,
+    Malformed,
+    UnknownHost,
+    AuthFailed,
+    ClockSkew,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum RpcError {
+    UnsupportedVersion,
+    Malformed,
+    UnknownSession,
+    SessionExpired,
+    AuthFailed,
+    Replayed,
+}
+
+/// A verified RPC request, ready to dispatch.
+pub struct OpenedRpc {
+    pub sid: [u8; SID_LEN],
+    pub seq: u64,
+    pub user_id: String,
+    pub device_id: String,
+    pub plaintext: Vec<u8>,
+}
+
+/// The result of opening an envelope.
+pub enum Opened {
+    New(OpenedRpc),
+    /// An exact repeat of an envelope already answered (multi-URL failover): send this again.
+    Duplicate(RpcEnvelope),
+}
+
+struct Session {
+    device_id: String,
+    user_id: String,
+    c2s: [u8; 32],
+    s2c: [u8; 32],
+    created_at: i64,
+    expires_at: i64,
+    last_used: i64,
+    highest: Option<u64>,
+    seen: BTreeSet<u64>,
+    /// seq → (hash of the request envelope, the sealed response), within the window.
+    answered: HashMap<u64, ([u8; 32], RpcEnvelope)>,
+}
+
+impl Session {
+    fn accept(&mut self, seq: u64) -> bool {
+        if let Some(high) = self.highest
+            && seq + REPLAY_WINDOW <= high
+        {
+            return false;
+        }
+        if !self.seen.insert(seq) {
+            return false;
+        }
+        if self.highest.is_none_or(|h| seq > h) {
+            self.highest = Some(seq);
+            let floor = seq.saturating_sub(REPLAY_WINDOW - 1);
+            self.seen = self.seen.split_off(&floor);
+            self.answered.retain(|s, _| *s >= floor);
+        }
+        true
+    }
+}
+
+#[derive(Default)]
+pub struct SessionStore {
+    sessions: Mutex<HashMap<[u8; SID_LEN], Session>>,
+    epks: Mutex<VecDeque<([u8; 32], i64)>>,
+    rids: Mutex<HashMap<(String, String), (i64, InnerResponse)>>,
+}
+
+impl SessionStore {
+    /// The handshake (CONTRACT §4.3). `device` is `None` when the device is
+    /// not trusted; `revoked` tells a tombstone from a device never seen.
+    pub fn handshake(
+        &self,
+        host: &HostKey,
+        body: &HandshakeInitBody,
+        device: Option<&KnownDevice>,
+        revoked: bool,
+        now: i64,
+    ) -> Result<HandshakeOutcome, HandshakeError> {
+        if body.v != PROTOCOL_VERSION {
+            return Err(HandshakeError::UnsupportedVersion);
+        }
+        if body.host_id != host.host_id {
+            return Err(HandshakeError::UnknownHost);
+        }
+        let client_epk = crypto::key_from_b64u(&body.epk).map_err(|_| HandshakeError::Malformed)?;
+        let nonce = crypto::from_b64u(&body.nonce).map_err(|_| HandshakeError::Malformed)?;
+        let ct = crypto::from_b64u(&body.ct).map_err(|_| HandshakeError::Malformed)?;
+        let epk_pub = x25519_dalek::PublicKey::from(client_epk);
+        let dh_eph_static = host.diffie_hellman(&epk_pub);
+
+        let Some(device) = device else {
+            let reason = if revoked { "revoked" } else { "unknown" };
+            let k_rev = crypto::revocation_key(&dh_eph_static, &host.host_id, &body.device_id, &client_epk);
+            let aad = crypto::revocation_aad(&host.host_id, &body.device_id, &client_epk);
+            let plain = serde_json::json!({ "deviceId": body.device_id, "ts": now, "reason": reason }).to_string();
+            let nonce = random_bytes::<24>().map_err(|_| HandshakeError::Malformed)?;
+            let sealed = crypto::seal(&k_rev, &nonce, plain.as_bytes(), &aad);
+            return Ok(HandshakeOutcome::Revoked {
+                notice: SealedBox {
+                    nonce: crypto::b64u(&nonce),
+                    ct: crypto::b64u(&sealed),
+                },
+            });
+        };
+
+        let dh_static_static = host.diffie_hellman(&x25519_dalek::PublicKey::from(device.device_pk));
+        let k_init = crypto::handshake_init_key(
+            &dh_eph_static,
+            &dh_static_static,
+            &body.device_id,
+            &device.device_pk,
+            host.public.as_bytes(),
+            &client_epk,
+        );
+        let aad = crypto::handshake_init_aad(&host.host_id, &body.device_id, &client_epk);
+        let plain = crypto::open(&k_init, &nonce, &ct, &aad).map_err(|_| HandshakeError::AuthFailed)?;
+        let ts = serde_json::from_slice::<serde_json::Value>(&plain)
+            .ok()
+            .and_then(|v| v["ts"].as_i64())
+            .ok_or(HandshakeError::Malformed)?;
+        if !is_fresh(ts, now) {
+            return Err(HandshakeError::ClockSkew);
+        }
+        if !self.remember_epk(client_epk, now) {
+            return Err(HandshakeError::AuthFailed); // A3: a replayed handshake
+        }
+
+        let eh_secret = random_bytes::<32>().map_err(|_| HandshakeError::Malformed)?;
+        let host_epk = crypto::x25519_public(&eh_secret);
+        let d3 = crypto::x25519(&eh_secret, &client_epk);
+        let d4 = crypto::x25519(&eh_secret, &device.device_pk);
+        let transcript = crypto::session_transcript(
+            &body.device_id,
+            &device.device_pk,
+            host.public.as_bytes(),
+            &client_epk,
+            &host_epk,
+        );
+        let keys = crypto::session_keys([&dh_eph_static, &dh_static_static, &d3, &d4], &transcript);
+        let expires_at = now + SESSION_TTL_MS;
+        let payload = serde_json::json!({ "expiresAt": expires_at, "idleTimeoutMs": IDLE_TIMEOUT_MS }).to_string();
+        let res_nonce = random_bytes::<24>().map_err(|_| HandshakeError::Malformed)?;
+        let sealed = crypto::seal(&keys.s2c, &res_nonce, payload.as_bytes(), &transcript);
+
+        self.insert(
+            keys.sid,
+            Session {
+                device_id: body.device_id.clone(),
+                user_id: device.user_id.clone(),
+                c2s: keys.c2s,
+                s2c: keys.s2c,
+                created_at: now,
+                expires_at,
+                last_used: now,
+                highest: None,
+                seen: BTreeSet::new(),
+                answered: HashMap::new(),
+            },
+        );
+        Ok(HandshakeOutcome::Ok {
+            response: HandshakeResponseBody {
+                v: PROTOCOL_VERSION,
+                epk: crypto::b64u(&host_epk),
+                nonce: crypto::b64u(&res_nonce),
+                ct: crypto::b64u(&sealed),
+            },
+            sid: keys.sid,
+        })
+    }
+
+    fn remember_epk(&self, epk: [u8; 32], now: i64) -> bool {
+        let mut epks = self.epks.lock().unwrap();
+        while epks.front().is_some_and(|(_, at)| now - at > EPK_MEMORY_MS) {
+            epks.pop_front();
+        }
+        if epks.iter().any(|(e, _)| *e == epk) {
+            return false;
+        }
+        epks.push_back((epk, now));
+        true
+    }
+
+    fn insert(&self, sid: [u8; SID_LEN], session: Session) {
+        let mut sessions = self.sessions.lock().unwrap();
+        let mut mine: Vec<([u8; SID_LEN], i64)> = sessions
+            .iter()
+            .filter(|(_, s)| s.device_id == session.device_id)
+            .map(|(sid, s)| (*sid, s.created_at))
+            .collect();
+        mine.sort_by_key(|(_, created)| *created);
+        while mine.len() >= MAX_SESSIONS_PER_DEVICE {
+            let (oldest, _) = mine.remove(0);
+            sessions.remove(&oldest);
+        }
+        sessions.insert(sid, session);
+    }
+
+    /// Opens an envelope: session lookup, expiry, decryption, then the replay window.
+    pub fn open(&self, env: &RpcEnvelope, now: i64) -> Result<Opened, RpcError> {
+        if env.v != PROTOCOL_VERSION {
+            return Err(RpcError::UnsupportedVersion);
+        }
+        let sid: [u8; SID_LEN] = crypto::from_b64u(&env.sid)
+            .ok()
+            .and_then(|b| b.try_into().ok())
+            .ok_or(RpcError::Malformed)?;
+        let mut sessions = self.sessions.lock().unwrap();
+        let session = sessions.get_mut(&sid).ok_or(RpcError::UnknownSession)?;
+        if now >= session.expires_at || now - session.last_used > IDLE_TIMEOUT_MS {
+            sessions.remove(&sid);
+            return Err(RpcError::SessionExpired);
+        }
+        let env_hash = crypto::sha256(&[env.nonce.as_bytes(), b".", env.ct.as_bytes()]);
+        if let Some((hash, response)) = session.answered.get(&env.seq)
+            && *hash == env_hash
+        {
+            return Ok(Opened::Duplicate(response.clone()));
+        }
+        let nonce = crypto::from_b64u(&env.nonce).map_err(|_| RpcError::Malformed)?;
+        let ct = crypto::from_b64u(&env.ct).map_err(|_| RpcError::Malformed)?;
+        let plaintext = crypto::open(&session.c2s, &nonce, &ct, &crypto::rpc_aad(false, &sid, env.seq))
+            .map_err(|_| RpcError::AuthFailed)?;
+        if !session.accept(env.seq) {
+            return Err(RpcError::Replayed);
+        }
+        session.last_used = now;
+        Ok(Opened::New(OpenedRpc {
+            sid,
+            seq: env.seq,
+            user_id: session.user_id.clone(),
+            device_id: session.device_id.clone(),
+            plaintext,
+        }))
+    }
+
+    /// Seals the response and remembers it for an exact duplicate of `request`.
+    pub fn seal(&self, request: &RpcEnvelope, opened: &OpenedRpc, response: &InnerResponse) -> Option<RpcEnvelope> {
+        let mut sessions = self.sessions.lock().unwrap();
+        let session = sessions.get_mut(&opened.sid)?;
+        let nonce = random_bytes::<24>().ok()?;
+        let body = serde_json::to_vec(response).ok()?;
+        let ct = crypto::seal(
+            &session.s2c,
+            &nonce,
+            &body,
+            &crypto::rpc_aad(true, &opened.sid, opened.seq),
+        );
+        let envelope = RpcEnvelope {
+            v: PROTOCOL_VERSION,
+            sid: request.sid.clone(),
+            seq: opened.seq,
+            nonce: crypto::b64u(&nonce),
+            ct: crypto::b64u(&ct),
+        };
+        let env_hash = crypto::sha256(&[request.nonce.as_bytes(), b".", request.ct.as_bytes()]);
+        session.answered.insert(opened.seq, (env_hash, envelope.clone()));
+        Some(envelope)
+    }
+
+    /// A4: the first response to a mutating `rid` on this device, if any.
+    pub fn rid_response(&self, device_id: &str, rid: &str, now: i64) -> Option<InnerResponse> {
+        let mut rids = self.rids.lock().unwrap();
+        rids.retain(|_, (at, _)| now - *at <= RID_MEMORY_MS);
+        rids.get(&(device_id.to_owned(), rid.to_owned()))
+            .map(|(_, r)| r.clone())
+    }
+
+    pub fn remember_rid(&self, device_id: &str, rid: &str, response: &InnerResponse, now: i64) {
+        self.rids
+            .lock()
+            .unwrap()
+            .insert((device_id.to_owned(), rid.to_owned()), (now, response.clone()));
+    }
+
+    /// Ends every session of a device (on revoke).
+    pub fn drop_device(&self, device_id: &str) {
+        self.sessions.lock().unwrap().retain(|_, s| s.device_id != device_id);
+    }
+
+    pub fn count_for(&self, device_id: &str) -> usize {
+        self.sessions
+            .lock()
+            .unwrap()
+            .values()
+            .filter(|s| s.device_id == device_id)
+            .count()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn session(device: &str, created_at: i64) -> Session {
+        Session {
+            device_id: device.into(),
+            user_id: "u1".into(),
+            c2s: [1; 32],
+            s2c: [2; 32],
+            created_at,
+            expires_at: created_at + SESSION_TTL_MS,
+            last_used: created_at,
+            highest: None,
+            seen: BTreeSet::new(),
+            answered: HashMap::new(),
+        }
+    }
+
+    #[test]
+    fn replay_window_accepts_out_of_order_and_refuses_repeats_and_stale() {
+        let mut s = session("d", 0);
+        assert!(s.accept(5));
+        assert!(s.accept(3), "out of order within the window");
+        assert!(!s.accept(5), "a repeat");
+        assert!(!s.accept(3), "a repeat");
+        assert!(s.accept(300));
+        assert!(!s.accept(44), "300 - 256: outside the window");
+        assert!(s.accept(45), "the oldest seq still inside the window");
+        assert!(s.seen.iter().all(|seq| *seq >= 45), "old entries are pruned");
+    }
+
+    #[test]
+    fn at_most_four_sessions_per_device_oldest_evicted() {
+        let store = SessionStore::default();
+        for i in 0..5u8 {
+            store.insert([i; SID_LEN], session("d", i as i64));
+        }
+        store.insert([9; SID_LEN], session("other", 0));
+        assert_eq!(store.count_for("d"), MAX_SESSIONS_PER_DEVICE);
+        let sessions = store.sessions.lock().unwrap();
+        assert!(!sessions.contains_key(&[0; SID_LEN]), "the oldest went");
+        assert!(sessions.contains_key(&[4; SID_LEN]));
+        drop(sessions);
+        store.drop_device("d");
+        assert_eq!(store.count_for("d"), 0);
+        assert_eq!(store.count_for("other"), 1);
+    }
+
+    #[test]
+    fn rid_responses_are_kept_per_device_for_ten_minutes() {
+        let store = SessionStore::default();
+        let resp = InnerResponse::ok(serde_json::json!({ "messageId": "m1" }));
+        store.remember_rid("d1", "rid-1", &resp, 0);
+        assert!(store.rid_response("d1", "rid-1", 60_000).is_some());
+        assert!(store.rid_response("d2", "rid-1", 60_000).is_none(), "per device");
+        assert!(
+            store.rid_response("d1", "rid-1", RID_MEMORY_MS + 1).is_none(),
+            "forgotten after 10 min"
+        );
+    }
+
+    #[test]
+    fn epks_are_remembered_for_five_minutes() {
+        let store = SessionStore::default();
+        assert!(store.remember_epk([7; 32], 0));
+        assert!(!store.remember_epk([7; 32], 1000));
+        assert!(store.remember_epk([7; 32], EPK_MEMORY_MS + 1001));
+    }
+}
diff --git a/crates/aionui-mobile/src/settings.rs b/crates/aionui-mobile/src/settings.rs
new file mode 100644
index 00000000..fe2cbc5a
--- /dev/null
+++ b/crates/aionui-mobile/src/settings.rs
@@ -0,0 +1,176 @@
+//! Bridge settings (CONTRACT §3.4, §7). Stored per Core user in the bridge's own database.
+
+use serde::{Deserialize, Serialize};
+
+use crate::error::MobileError;
+
+/// Default LAN port (CONTRACT §7, decision §11 #6).
+pub const DEFAULT_PORT: u16 = 47734;
+const MAX_EXTRA_URLS: usize = 8;
+const MAX_HOST_NAME_CHARS: usize = 64;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct MobileSettings {
+    /// The LAN listener runs only while this is on. Off by default.
+    pub enabled: bool,
+    pub port: u16,
+    /// Shown on the phone; defaults to the PC's name.
+    pub host_name: String,
+    /// Extra base URLs put into the pairing QR, e.g. a Tailscale address.
+    pub extra_urls: Vec<String>,
+    /// Advertise `_aiondx._tcp` while enabled (§11 #6: on by default).
+    pub mdns: bool,
+    /// Task writes from the phone (§11 #4: on by default).
+    pub tasks_write: bool,
+}
+
+impl MobileSettings {
+    pub fn defaults(host_name: impl Into<String>) -> Self {
+        Self {
+            enabled: false,
+            port: DEFAULT_PORT,
+            host_name: host_name.into(),
+            extra_urls: Vec::new(),
+            mdns: true,
+            tasks_write: true,
+        }
+    }
+
+    /// Applies a partial update. On any invalid field nothing changes.
+    pub fn apply(&mut self, patch: &MobileSettingsPatch) -> Result<(), MobileError> {
+        let mut next = self.clone();
+        if let Some(enabled) = patch.enabled {
+            next.enabled = enabled;
+        }
+        if let Some(port) = patch.port {
+            if port < 1024 {
+                return Err(MobileError::InvalidSetting("port must be 1024 or higher".into()));
+            }
+            next.port = port;
+        }
+        if let Some(name) = &patch.host_name {
+            let name = name.trim();
+            if name.is_empty() || name.chars().count() > MAX_HOST_NAME_CHARS {
+                return Err(MobileError::InvalidSetting(format!(
+                    "hostName must be 1 to {MAX_HOST_NAME_CHARS} characters"
+                )));
+            }
+            next.host_name = name.to_owned();
+        }
+        if let Some(urls) = &patch.extra_urls {
+            if urls.len() > MAX_EXTRA_URLS {
+                return Err(MobileError::InvalidSetting(format!(
+                    "at most {MAX_EXTRA_URLS} extraUrls"
+                )));
+            }
+            next.extra_urls = urls
+                .iter()
+                .map(|url| validate_base_url(url))
+                .collect::<Result<_, _>>()?;
+        }
+        if let Some(mdns) = patch.mdns {
+            next.mdns = mdns;
+        }
+        if let Some(tasks_write) = patch.tasks_write {
+            next.tasks_write = tasks_write;
+        }
+        *self = next;
+        Ok(())
+    }
+}
+
+/// A partial update from `PUT /api/mobile/admin/settings`.
+#[derive(Debug, Clone, Default, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct MobileSettingsPatch {
+    pub enabled: Option<bool>,
+    pub port: Option<u16>,
+    pub host_name: Option<String>,
+    pub extra_urls: Option<Vec<String>>,
+    pub mdns: Option<bool>,
+    pub tasks_write: Option<bool>,
+}
+
+/// `http://host[:port]` or `https://...`, with no path, query or credentials.
+fn validate_base_url(raw: &str) -> Result<String, MobileError> {
+    let url = raw.trim().trim_end_matches('/');
+    let invalid = || MobileError::InvalidSetting(format!("extraUrls entry is not an http(s) base URL: {raw}"));
+    let rest = url
+        .strip_prefix("http://")
+        .or_else(|| url.strip_prefix("https://"))
+        .ok_or_else(invalid)?;
+    if rest.is_empty() || rest.contains(['/', '?', '#', '@', ' ']) {
+        return Err(invalid());
+    }
+    Ok(url.to_owned())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn defaults_follow_the_decisions_record() {
+        let s = MobileSettings::defaults("PC");
+        assert!(!s.enabled, "the bridge is off until the user enables it");
+        assert_eq!(s.port, 47734);
+        assert!(s.mdns);
+        assert!(s.tasks_write);
+    }
+
+    #[test]
+    fn patch_applies_only_given_fields() {
+        let mut s = MobileSettings::defaults("PC");
+        s.apply(&MobileSettingsPatch {
+            enabled: Some(true),
+            extra_urls: Some(vec!["http://100.64.1.2:47734/".into()]),
+            ..Default::default()
+        })
+        .unwrap();
+        assert!(s.enabled);
+        assert_eq!(s.extra_urls, vec!["http://100.64.1.2:47734".to_string()]);
+        assert_eq!(s.port, 47734);
+    }
+
+    #[test]
+    fn invalid_values_are_rejected_and_leave_settings_unchanged() {
+        let mut s = MobileSettings::defaults("PC");
+        let before = s.clone();
+        for patch in [
+            MobileSettingsPatch {
+                port: Some(80),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                host_name: Some("  ".into()),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                extra_urls: Some(vec!["ftp://x".into()]),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                extra_urls: Some(vec!["http://x/path".into()]),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                extra_urls: Some(vec!["http://u:p@x".into()]),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                enabled: Some(true),
+                port: Some(1),
+                ..Default::default()
+            },
+        ] {
+            assert!(matches!(s.apply(&patch), Err(MobileError::InvalidSetting(_))));
+            assert_eq!(s, before);
+        }
+    }
+
+    #[test]
+    fn unknown_fields_are_rejected() {
+        assert!(serde_json::from_str::<MobileSettingsPatch>(r#"{"enabled":true,"bogus":1}"#).is_err());
+    }
+}
diff --git a/crates/aionui-mobile/src/store.rs b/crates/aionui-mobile/src/store.rs
new file mode 100644
index 00000000..10adff66
--- /dev/null
+++ b/crates/aionui-mobile/src/store.rs
@@ -0,0 +1,382 @@
+//! The bridge's own SQLite database, `aiondx-bridge.db` next to the main database.
+//!
+//! Deliberately not a migration in `aionui-backend.db`: AionCore refuses to open
+//! a database that has a migration it does not know, so a shared migration would
+//! lock every core without the bridge out of the user's chats.
+
+use std::path::{Path, PathBuf};
+use std::str::FromStr;
+use std::time::Duration;
+
+use sqlx::SqlitePool;
+use sqlx::migrate::Migrator;
+use sqlx::sqlite::{SqliteConnectOptions, SqliteJournalMode, SqlitePoolOptions};
+
+use crate::error::MobileError;
+use crate::settings::MobileSettings;
+
+static MIGRATOR: Migrator = sqlx::migrate!("./migrations");
+
+#[derive(Clone, Debug)]
+pub struct MobileStore {
+    pool: SqlitePool,
+}
+
+impl MobileStore {
+    pub fn path_in(data_dir: &Path) -> PathBuf {
+        data_dir.join("aiondx-bridge.db")
+    }
+
+    pub async fn open(path: &Path) -> Result<Self, MobileError> {
+        let opts = SqliteConnectOptions::new()
+            .filename(path)
+            .create_if_missing(true)
+            .journal_mode(SqliteJournalMode::Wal)
+            .foreign_keys(true)
+            .busy_timeout(Duration::from_secs(5));
+        Self::connect(opts, 4).await
+    }
+
+    pub async fn open_memory() -> Result<Self, MobileError> {
+        let opts = SqliteConnectOptions::from_str("sqlite::memory:")?.foreign_keys(true);
+        // One connection: each in-memory connection would be a separate database.
+        Self::connect(opts, 1).await
+    }
+
+    async fn connect(opts: SqliteConnectOptions, max: u32) -> Result<Self, MobileError> {
+        let pool = SqlitePoolOptions::new().max_connections(max).connect_with(opts).await?;
+        MIGRATOR.run(&pool).await?;
+        Ok(Self { pool })
+    }
+
+    pub fn pool(&self) -> &SqlitePool {
+        &self.pool
+    }
+
+    pub async fn load_settings(&self, user_id: &str) -> Result<Option<MobileSettings>, MobileError> {
+        let row: Option<(String,)> = sqlx::query_as("SELECT settings_json FROM mobile_settings WHERE user_id = ?")
+            .bind(user_id)
+            .fetch_optional(&self.pool)
+            .await?;
+        row.map(|(json,)| serde_json::from_str(&json).map_err(MobileError::from))
+            .transpose()
+    }
+
+    pub async fn save_settings(&self, user_id: &str, settings: &MobileSettings) -> Result<(), MobileError> {
+        sqlx::query(
+            "INSERT INTO mobile_settings (user_id, settings_json, updated_at) VALUES (?, ?, ?) \
+             ON CONFLICT(user_id) DO UPDATE SET settings_json = excluded.settings_json, updated_at = excluded.updated_at",
+        )
+        .bind(user_id)
+        .bind(serde_json::to_string(settings)?)
+        .bind(aionui_common::now_ms())
+        .execute(&self.pool)
+        .await?;
+        Ok(())
+    }
+
+    /// Users whose bridge is switched on (normally zero or one).
+    pub async fn enabled_users(&self) -> Result<Vec<(String, MobileSettings)>, MobileError> {
+        let rows: Vec<(String, String)> =
+            sqlx::query_as("SELECT user_id, settings_json FROM mobile_settings ORDER BY updated_at DESC")
+                .fetch_all(&self.pool)
+                .await?;
+        let mut out = Vec::new();
+        for (user_id, json) in rows {
+            let settings: MobileSettings = serde_json::from_str(&json)?;
+            if settings.enabled {
+                out.push((user_id, settings));
+            }
+        }
+        Ok(out)
+    }
+
+    // ---- Paired devices (CONTRACT §3.1, §3.4) ---------------------------------------------
+
+    pub async fn insert_device(&self, device: &DeviceRow) -> Result<(), MobileError> {
+        sqlx::query(
+            "INSERT INTO mobile_devices (device_id, user_id, device_pk, name, platform, app_version, confirm_mode, \
+             confirm_key_sealed, require_confirm, paired_at, last_seen_at, last_address) \
+             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
+        )
+        .bind(&device.device_id)
+        .bind(&device.user_id)
+        .bind(&device.device_pk[..])
+        .bind(&device.name)
+        .bind(&device.platform)
+        .bind(&device.app_version)
+        .bind(&device.confirm_mode)
+        .bind(device.confirm_key_sealed.as_deref())
+        .bind(device.require_confirm)
+        .bind(device.paired_at)
+        .bind(device.last_seen_at)
+        .bind(device.last_address.as_deref())
+        .execute(&self.pool)
+        .await?;
+        sqlx::query("DELETE FROM mobile_device_tombstones WHERE device_id = ?")
+            .bind(&device.device_id)
+            .execute(&self.pool)
+            .await?;
+        Ok(())
+    }
+
+    pub async fn device(&self, device_id: &str) -> Result<Option<DeviceRow>, MobileError> {
+        let row = sqlx::query_as::<_, DeviceRow>("SELECT * FROM mobile_devices WHERE device_id = ?")
+            .bind(device_id)
+            .fetch_optional(&self.pool)
+            .await?;
+        Ok(row)
+    }
+
+    pub async fn devices_for(&self, user_id: &str) -> Result<Vec<DeviceRow>, MobileError> {
+        let rows = sqlx::query_as::<_, DeviceRow>("SELECT * FROM mobile_devices WHERE user_id = ? ORDER BY paired_at")
+            .bind(user_id)
+            .fetch_all(&self.pool)
+            .await?;
+        Ok(rows)
+    }
+
+    pub async fn touch_device(&self, device_id: &str, address: &str) -> Result<(), MobileError> {
+        sqlx::query("UPDATE mobile_devices SET last_seen_at = ?, last_address = ? WHERE device_id = ?")
+            .bind(aionui_common::now_ms())
+            .bind(address)
+            .bind(device_id)
+            .execute(&self.pool)
+            .await?;
+        Ok(())
+    }
+
+    /// Renames or changes `requireConfirm`. `Ok(false)` when the device isn't this user's.
+    pub async fn update_device(
+        &self,
+        user_id: &str,
+        device_id: &str,
+        name: Option<&str>,
+        require_confirm: Option<bool>,
+    ) -> Result<bool, MobileError> {
+        let done = sqlx::query(
+            "UPDATE mobile_devices SET name = COALESCE(?, name), require_confirm = COALESCE(?, require_confirm) \
+             WHERE device_id = ? AND user_id = ?",
+        )
+        .bind(name)
+        .bind(require_confirm)
+        .bind(device_id)
+        .bind(user_id)
+        .execute(&self.pool)
+        .await?;
+        Ok(done.rows_affected() == 1)
+    }
+
+    /// Replaces a device's confirm key and mode (the re-key flow, §5.3).
+    pub async fn set_confirm_key(
+        &self,
+        device_id: &str,
+        confirm_mode: &str,
+        sealed: Option<&[u8]>,
+    ) -> Result<(), MobileError> {
+        sqlx::query("UPDATE mobile_devices SET confirm_mode = ?, confirm_key_sealed = ? WHERE device_id = ?")
+            .bind(confirm_mode)
+            .bind(sealed)
+            .bind(device_id)
+            .execute(&self.pool)
+            .await?;
+        Ok(())
+    }
+
+    /// Revokes: deletes the row and its sealed confirm key, and leaves a
+    /// tombstone so a later handshake can say "revoked" rather than "unknown".
+    /// `Ok(false)` when the device isn't this user's.
+    pub async fn revoke_device(&self, user_id: &str, device_id: &str) -> Result<bool, MobileError> {
+        let mut tx = self.pool.begin().await?;
+        let done = sqlx::query("DELETE FROM mobile_devices WHERE device_id = ? AND user_id = ?")
+            .bind(device_id)
+            .bind(user_id)
+            .execute(&mut *tx)
+            .await?;
+        if done.rows_affected() == 1 {
+            sqlx::query(
+                "INSERT INTO mobile_device_tombstones (device_id, user_id, revoked_at) VALUES (?, ?, ?) \
+                 ON CONFLICT(device_id) DO UPDATE SET revoked_at = excluded.revoked_at",
+            )
+            .bind(device_id)
+            .bind(user_id)
+            .bind(aionui_common::now_ms())
+            .execute(&mut *tx)
+            .await?;
+        }
+        tx.commit().await?;
+        Ok(done.rows_affected() == 1)
+    }
+
+    pub async fn last_recovery(&self) -> Result<Option<Recovery>, MobileError> {
+        let row: Option<(String,)> = sqlx::query_as("SELECT value FROM mobile_meta WHERE key = 'last_recovery'")
+            .fetch_optional(&self.pool)
+            .await?;
+        Ok(row.and_then(|(json,)| serde_json::from_str(&json).ok()))
+    }
+
+    pub async fn set_last_recovery(&self, recovery: Option<&Recovery>) -> Result<(), MobileError> {
+        match recovery {
+            Some(r) => {
+                sqlx::query(
+                    "INSERT INTO mobile_meta (key, value) VALUES ('last_recovery', ?) \
+                     ON CONFLICT(key) DO UPDATE SET value = excluded.value",
+                )
+                .bind(serde_json::to_string(r)?)
+                .execute(&self.pool)
+                .await?;
+            }
+            None => {
+                sqlx::query("DELETE FROM mobile_meta WHERE key = 'last_recovery'")
+                    .execute(&self.pool)
+                    .await?;
+            }
+        }
+        Ok(())
+    }
+
+    /// Forgets every paired phone (used when the host identity had to be replaced).
+    pub async fn clear_devices(&self) -> Result<(), MobileError> {
+        sqlx::query("DELETE FROM mobile_devices").execute(&self.pool).await?;
+        Ok(())
+    }
+
+    pub async fn is_tombstoned(&self, device_id: &str) -> Result<bool, MobileError> {
+        let row: Option<(String,)> =
+            sqlx::query_as("SELECT device_id FROM mobile_device_tombstones WHERE device_id = ?")
+                .bind(device_id)
+                .fetch_optional(&self.pool)
+                .await?;
+        Ok(row.is_some())
+    }
+}
+
+/// The bridge recovered from damage; the settings page tells the user phones need re-pairing.
+#[derive(Debug, Clone, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Recovery {
+    /// `database` or `host_key`.
+    pub kind: String,
+    pub at: i64,
+    /// Where the damaged file was moved.
+    pub moved_to: Option<String>,
+}
+
+#[derive(Debug, Clone, sqlx::FromRow)]
+pub struct DeviceRow {
+    pub device_id: String,
+    pub user_id: String,
+    pub device_pk: Vec<u8>,
+    pub name: String,
+    pub platform: String,
+    pub app_version: String,
+    pub confirm_mode: String,
+    pub confirm_key_sealed: Option<Vec<u8>>,
+    pub require_confirm: bool,
+    pub paired_at: i64,
+    pub last_seen_at: Option<i64>,
+    pub last_address: Option<String>,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn device(id: &str, user: &str) -> DeviceRow {
+        DeviceRow {
+            device_id: id.into(),
+            user_id: user.into(),
+            device_pk: vec![1; 32],
+            name: "Phone".into(),
+            platform: "ios".into(),
+            app_version: "1.0.0".into(),
+            confirm_mode: "biometric".into(),
+            confirm_key_sealed: Some(vec![9; 56]),
+            require_confirm: true,
+            paired_at: 1,
+            last_seen_at: None,
+            last_address: None,
+        }
+    }
+
+    #[tokio::test]
+    async fn devices_insert_update_and_revoke_with_tombstone() {
+        let store = MobileStore::open_memory().await.unwrap();
+        store.insert_device(&device("d1", "u1")).await.unwrap();
+        assert_eq!(store.devices_for("u1").await.unwrap().len(), 1);
+        assert!(store.devices_for("u2").await.unwrap().is_empty());
+
+        assert!(
+            !store.update_device("u2", "d1", Some("x"), None).await.unwrap(),
+            "another user's device"
+        );
+        assert!(
+            store
+                .update_device("u1", "d1", Some("Pixel"), Some(false))
+                .await
+                .unwrap()
+        );
+        let d = store.device("d1").await.unwrap().unwrap();
+        assert_eq!(d.name, "Pixel");
+        assert!(!d.require_confirm);
+
+        assert!(
+            !store.revoke_device("u2", "d1").await.unwrap(),
+            "another user cannot revoke"
+        );
+        assert!(store.revoke_device("u1", "d1").await.unwrap());
+        assert!(store.device("d1").await.unwrap().is_none());
+        assert!(store.is_tombstoned("d1").await.unwrap());
+        assert!(!store.is_tombstoned("never-seen").await.unwrap());
+    }
+
+    #[tokio::test]
+    async fn settings_round_trip_per_user() {
+        let store = MobileStore::open_memory().await.unwrap();
+        assert!(store.load_settings("u1").await.unwrap().is_none());
+        let mut s = MobileSettings::defaults("PC");
+        s.enabled = true;
+        store.save_settings("u1", &s).await.unwrap();
+        store
+            .save_settings("u2", &MobileSettings::defaults("PC"))
+            .await
+            .unwrap();
+        assert_eq!(store.load_settings("u1").await.unwrap(), Some(s.clone()));
+        let enabled = store.enabled_users().await.unwrap();
+        assert_eq!(enabled.len(), 1);
+        assert_eq!(enabled[0].0, "u1");
+    }
+
+    #[tokio::test]
+    async fn file_database_is_created_and_reopened() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = MobileStore::path_in(dir.path());
+        {
+            let store = MobileStore::open(&path).await.unwrap();
+            store
+                .save_settings("u1", &MobileSettings::defaults("PC"))
+                .await
+                .unwrap();
+            store.pool().close().await;
+        }
+        let store = MobileStore::open(&path).await.unwrap();
+        assert!(store.load_settings("u1").await.unwrap().is_some());
+        // The bridge's tables are present; nothing is written to AionCore's own database.
+        let tables: Vec<(String,)> = sqlx::query_as(
+            "SELECT name FROM sqlite_master WHERE type = 'table' AND name LIKE 'mobile_%' ORDER BY name",
+        )
+        .fetch_all(store.pool())
+        .await
+        .unwrap();
+        let names: Vec<_> = tables.into_iter().map(|(n,)| n).collect();
+        assert_eq!(
+            names,
+            [
+                "mobile_device_tombstones",
+                "mobile_devices",
+                "mobile_meta",
+                "mobile_settings"
+            ]
+        );
+    }
+}
diff --git a/crates/aionui-mobile/src/wire.rs b/crates/aionui-mobile/src/wire.rs
new file mode 100644
index 00000000..9855cfc9
--- /dev/null
+++ b/crates/aionui-mobile/src/wire.rs
@@ -0,0 +1,130 @@
+//! Outer wire types of protocol v1 (CONTRACT §4). Plaintext JSON bodies;
+//! binary fields are base64url without padding.
+
+use serde::{Deserialize, Serialize};
+
+pub const PROTOCOL_VERSION: u8 = 1;
+/// ±2 minutes, the same window as the phone's `MAX_CLOCK_SKEW_MS`.
+pub const MAX_CLOCK_SKEW_MS: i64 = 2 * 60 * 1000;
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PairRequestBody {
+    pub v: u8,
+    pub host_id: String,
+    pub device_id: String,
+    pub device_pk: String,
+    pub nonce: String,
+    pub ct: String,
+}
+
+/// The sealed part of a pair request (§4.2).
+#[derive(Debug, Clone, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PairRequestPayload {
+    pub device_name: String,
+    pub platform: String,
+    pub app_version: String,
+    pub ts: i64,
+    #[serde(default = "default_confirm_mode")]
+    pub confirm_mode: String,
+    #[serde(default)]
+    pub wait: bool,
+}
+
+fn default_confirm_mode() -> String {
+    "none".into()
+}
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PairResponsePayload {
+    pub status: &'static str,
+    pub host_id: String,
+    pub host_name: String,
+    pub ts: i64,
+    pub req_ts: i64,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub confirm_key: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct SealedBox {
+    pub nonce: String,
+    pub ct: String,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct SealedResponse {
+    pub v: u8,
+    pub nonce: String,
+    pub ct: String,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct HandshakeInitBody {
+    pub v: u8,
+    pub host_id: String,
+    pub device_id: String,
+    pub epk: String,
+    pub nonce: String,
+    pub ct: String,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct HandshakeResponseBody {
+    pub v: u8,
+    pub epk: String,
+    pub nonce: String,
+    pub ct: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct RpcEnvelope {
+    pub v: u8,
+    pub sid: String,
+    pub seq: u64,
+    pub nonce: String,
+    pub ct: String,
+}
+
+/// The decrypted request inside an RPC envelope (§4.4).
+#[derive(Debug, Clone, Deserialize)]
+pub struct InnerRequest {
+    pub method: String,
+    pub path: String,
+    #[serde(default)]
+    pub body: Option<serde_json::Value>,
+    pub rid: String,
+    #[serde(default)]
+    pub confirm: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct InnerResponse {
+    pub status: u16,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub body: Option<serde_json::Value>,
+}
+
+impl InnerResponse {
+    pub fn ok(body: serde_json::Value) -> Self {
+        Self {
+            status: 200,
+            body: Some(body),
+        }
+    }
+
+    /// `{error: {code, message}}` (CONTRACT §6.0).
+    pub fn error(status: u16, code: &str, message: impl Into<String>) -> Self {
+        Self {
+            status,
+            body: Some(serde_json::json!({ "error": { "code": code, "message": message.into() } })),
+        }
+    }
+}
+
+pub fn is_fresh(ts: i64, now: i64) -> bool {
+    (now - ts).abs() <= MAX_CLOCK_SKEW_MS
+}
diff --git a/crates/aionui-mobile/tests/protocol_e2e.rs b/crates/aionui-mobile/tests/protocol_e2e.rs
new file mode 100644
index 00000000..4416ffed
--- /dev/null
+++ b/crates/aionui-mobile/tests/protocol_e2e.rs
@@ -0,0 +1,498 @@
+//! End to end over the real outer router: a phone implemented here from
+//! CONTRACT §4 alone pairs, handshakes, calls RPC, and gets revoked.
+
+use std::net::SocketAddr;
+use std::sync::Arc;
+
+use aionui_mobile::core::NoEvents;
+use aionui_mobile::crypto::*;
+use aionui_mobile::listener::outer_router;
+use aionui_mobile::{HostKey, MobileBridge, MobileStore};
+use axum::Router;
+use axum::body::Body;
+use axum::extract::ConnectInfo;
+use axum::http::{Request, StatusCode};
+use serde_json::{Value, json};
+use tower::ServiceExt;
+
+fn now() -> i64 {
+    aionui_common::now_ms()
+}
+
+fn rand32() -> [u8; 32] {
+    let mut b = [0u8; 32];
+    getrandom::getrandom(&mut b).unwrap();
+    b
+}
+
+fn rand24() -> [u8; 24] {
+    let mut b = [0u8; 24];
+    getrandom::getrandom(&mut b).unwrap();
+    b
+}
+
+async fn post(router: &Router, path: &str, body: &Value) -> (StatusCode, Value) {
+    let req = Request::post(path)
+        .header("content-type", "application/json")
+        .extension(ConnectInfo(SocketAddr::from(([192, 168, 1, 50], 50000))))
+        .body(Body::from(body.to_string()))
+        .unwrap();
+    let resp = router.clone().oneshot(req).await.unwrap();
+    let status = resp.status();
+    let bytes = axum::body::to_bytes(resp.into_body(), usize::MAX).await.unwrap();
+    (status, serde_json::from_slice(&bytes).unwrap_or(Value::Null))
+}
+
+struct Offer {
+    host_id: String,
+    host_pk: [u8; 32],
+    secret: Vec<u8>,
+    offer_id: String,
+}
+
+fn parse_uri(uri: &str) -> (String, [u8; 32], Vec<u8>) {
+    let query = uri.split_once('?').unwrap().1;
+    let get = |k: &str| {
+        query
+            .split('&')
+            .find_map(|kv| kv.strip_prefix(&format!("{k}=")))
+            .unwrap()
+            .to_owned()
+    };
+    (
+        get("id"),
+        key_from_b64u(&get("pk")).unwrap(),
+        from_b64u(&get("s")).unwrap(),
+    )
+}
+
+struct Phone {
+    secret: [u8; 32],
+    public: [u8; 32],
+    device_id: String,
+}
+
+impl Phone {
+    fn new(device_id: &str) -> Self {
+        let secret = rand32();
+        Self {
+            public: x25519_public(&secret),
+            secret,
+            device_id: device_id.into(),
+        }
+    }
+
+    fn pairing_key(&self, offer: &Offer) -> [u8; 32] {
+        pairing_key(
+            &x25519(&self.secret, &offer.host_pk),
+            &offer.secret,
+            &offer.host_pk,
+            &self.public,
+        )
+    }
+
+    fn pair_body(&self, offer: &Offer, wait: bool, ts: i64) -> Value {
+        let k = self.pairing_key(offer);
+        let payload = json!({
+            "deviceName": "Test Phone", "platform": "ios", "appVersion": "1.0.0",
+            "ts": ts, "confirmMode": "biometric", "wait": wait,
+        });
+        let nonce = rand24();
+        let ct = seal(
+            &k,
+            &nonce,
+            payload.to_string().as_bytes(),
+            &pair_req_aad(&offer.host_id, &self.device_id),
+        );
+        json!({ "v": 1, "hostId": offer.host_id, "deviceId": self.device_id,
+                "devicePk": b64u(&self.public), "nonce": b64u(&nonce), "ct": b64u(&ct) })
+    }
+
+    fn open_pair(&self, offer: &Offer, resp: &Value) -> Value {
+        let k = self.pairing_key(offer);
+        let plain = open(
+            &k,
+            &from_b64u(resp["nonce"].as_str().unwrap()).unwrap(),
+            &from_b64u(resp["ct"].as_str().unwrap()).unwrap(),
+            &pair_res_aad(&offer.host_id, &self.device_id),
+        )
+        .expect("the pair response opens with k_pair");
+        serde_json::from_slice(&plain).unwrap()
+    }
+}
+
+struct Session {
+    c2s: [u8; 32],
+    s2c: [u8; 32],
+    sid: [u8; 16],
+}
+
+struct Handshake {
+    e_secret: [u8; 32],
+    e_public: [u8; 32],
+    body: Value,
+}
+
+fn begin_handshake(phone: &Phone, host_id: &str, host_pk: &[u8; 32], ts: i64) -> Handshake {
+    let e_secret = rand32();
+    let e_public = x25519_public(&e_secret);
+    let k_init = handshake_init_key(
+        &x25519(&e_secret, host_pk),
+        &x25519(&phone.secret, host_pk),
+        &phone.device_id,
+        &phone.public,
+        host_pk,
+        &e_public,
+    );
+    let nonce = rand24();
+    let ct = seal(
+        &k_init,
+        &nonce,
+        json!({ "ts": ts }).to_string().as_bytes(),
+        &handshake_init_aad(host_id, &phone.device_id, &e_public),
+    );
+    let body = json!({ "v": 1, "hostId": host_id, "deviceId": phone.device_id, "epk": b64u(&e_public),
+                       "nonce": b64u(&nonce), "ct": b64u(&ct) });
+    Handshake {
+        e_secret,
+        e_public,
+        body,
+    }
+}
+
+fn finish_handshake(phone: &Phone, host_pk: &[u8; 32], hs: &Handshake, resp: &Value) -> (Session, Value) {
+    let host_epk = key_from_b64u(resp["epk"].as_str().unwrap()).unwrap();
+    let t = session_transcript(&phone.device_id, &phone.public, host_pk, &hs.e_public, &host_epk);
+    let keys = session_keys(
+        [
+            &x25519(&hs.e_secret, host_pk),
+            &x25519(&phone.secret, host_pk),
+            &x25519(&hs.e_secret, &host_epk),
+            &x25519(&phone.secret, &host_epk),
+        ],
+        &t,
+    );
+    let plain = open(
+        &keys.s2c,
+        &from_b64u(resp["nonce"].as_str().unwrap()).unwrap(),
+        &from_b64u(resp["ct"].as_str().unwrap()).unwrap(),
+        &t,
+    )
+    .expect("the handshake response authenticates the PC");
+    (
+        Session {
+            c2s: keys.c2s,
+            s2c: keys.s2c,
+            sid: keys.sid,
+        },
+        serde_json::from_slice(&plain).unwrap(),
+    )
+}
+
+fn envelope(s: &Session, seq: u64, inner: &Value) -> Value {
+    let nonce = rand24();
+    let ct = seal(
+        &s.c2s,
+        &nonce,
+        inner.to_string().as_bytes(),
+        &rpc_aad(false, &s.sid, seq),
+    );
+    json!({ "v": 1, "sid": b64u(&s.sid), "seq": seq, "nonce": b64u(&nonce), "ct": b64u(&ct) })
+}
+
+fn open_rpc(s: &Session, seq: u64, resp: &Value) -> Value {
+    assert_eq!(resp["seq"], seq);
+    assert_eq!(resp["sid"], b64u(&s.sid));
+    let plain = open(
+        &s.s2c,
+        &from_b64u(resp["nonce"].as_str().unwrap()).unwrap(),
+        &from_b64u(resp["ct"].as_str().unwrap()).unwrap(),
+        &rpc_aad(true, &s.sid, seq),
+    )
+    .expect("the rpc response opens with s2c");
+    serde_json::from_slice(&plain).unwrap()
+}
+
+async fn setup() -> (Arc<MobileBridge>, Router) {
+    let store = MobileStore::open_memory().await.unwrap();
+    let bridge = MobileBridge::new(
+        store,
+        Arc::new(HostKey::generate().unwrap()),
+        "Test PC".into(),
+        Arc::new(NoEvents),
+    );
+    let router = outer_router(bridge.core().clone());
+    (bridge, router)
+}
+
+async fn new_offer(bridge: &MobileBridge) -> Offer {
+    let o = bridge.create_offer("u1").await.unwrap();
+    let (host_id, host_pk, secret) = parse_uri(&o.uri);
+    Offer {
+        host_id,
+        host_pk,
+        secret,
+        offer_id: o.offer_id,
+    }
+}
+
+/// Pairs `phone` all the way to approved; returns the confirm key.
+async fn pair(bridge: &Arc<MobileBridge>, router: &Router, phone: &Phone) -> (Offer, Vec<u8>) {
+    let offer = new_offer(bridge).await;
+    let (status, resp) = post(router, "/api/mobile/v1/pair", &phone.pair_body(&offer, false, now())).await;
+    assert_eq!(status, StatusCode::OK, "{resp}");
+    let first = phone.open_pair(&offer, &resp);
+    assert_eq!(first["status"], "pending");
+
+    // The desktop shows the same six digits the phone computed.
+    let view = bridge.offer("u1", &offer.offer_id).unwrap();
+    assert_eq!(view.request.unwrap().sas, short_auth_string(&phone.pairing_key(&offer)));
+
+    // The phone long-polls; the user approves while it waits.
+    let ts = now();
+    let body = phone.pair_body(&offer, true, ts);
+    let r = router.clone();
+    let poll = tokio::spawn(async move { post(&r, "/api/mobile/v1/pair", &body).await });
+    tokio::time::sleep(std::time::Duration::from_millis(150)).await;
+    assert!(!poll.is_finished(), "a wait:true request is held while pending");
+    bridge.approve("u1", &offer.offer_id).await.unwrap();
+    let (status, resp) = poll.await.unwrap();
+    assert_eq!(status, StatusCode::OK);
+    let approved = phone.open_pair(&offer, &resp);
+    assert_eq!(approved["status"], "approved");
+    assert_eq!(approved["reqTs"], ts, "reqTs echoes the request being answered");
+    assert_eq!(approved["hostName"], "Test PC");
+    let confirm_key = from_b64u(approved["confirmKey"].as_str().unwrap()).unwrap();
+    assert_eq!(confirm_key.len(), 32);
+    (offer, confirm_key)
+}
+
+#[tokio::test]
+async fn pair_handshake_rpc_and_revoke() {
+    let (bridge, router) = setup().await;
+    let phone = Phone::new("dev-1");
+    let (offer, _confirm_key) = pair(&bridge, &router, &phone).await;
+    assert_eq!(bridge.devices("u1").await.unwrap()[0].confirm_mode, "biometric");
+
+    let hs = begin_handshake(&phone, &offer.host_id, &offer.host_pk, now());
+    let (status, resp) = post(&router, "/api/mobile/v1/session", &hs.body).await;
+    assert_eq!(status, StatusCode::OK, "{resp}");
+    let (session, payload) = finish_handshake(&phone, &offer.host_pk, &hs, &resp);
+    assert_eq!(payload["idleTimeoutMs"], 1_800_000);
+    assert!(payload["expiresAt"].as_i64().unwrap() > now() + 11 * 3600 * 1000);
+
+    // A3: the same handshake again is refused.
+    let (status, resp) = post(&router, "/api/mobile/v1/session", &hs.body).await;
+    assert_eq!(
+        (status, resp),
+        (StatusCode::UNAUTHORIZED, json!({ "error": "auth_failed" }))
+    );
+
+    // RPC: /v1/host.
+    let req = envelope(
+        &session,
+        1,
+        &json!({ "method": "GET", "path": "/v1/host", "rid": "r-1" }),
+    );
+    let (status, resp) = post(&router, "/api/mobile/v1/rpc", &req).await;
+    assert_eq!(status, StatusCode::OK);
+    let inner = open_rpc(&session, 1, &resp);
+    assert_eq!(inner["status"], 200);
+    assert_eq!(inner["body"]["hostId"], offer.host_id);
+    assert_eq!(inner["body"]["device"]["deviceId"], "dev-1");
+    assert_eq!(inner["body"]["device"]["requireConfirm"], true);
+    assert!(
+        inner["body"]["capabilities"]
+            .as_array()
+            .unwrap()
+            .contains(&json!("tasks.write"))
+    );
+
+    // §4.5: an exact duplicate gets the cached response; a re-sealed replay is refused.
+    let (status, again) = post(&router, "/api/mobile/v1/rpc", &req).await;
+    assert_eq!(status, StatusCode::OK);
+    assert_eq!(again, resp, "the cached sealed response, byte for byte");
+    let replay = envelope(
+        &session,
+        1,
+        &json!({ "method": "GET", "path": "/v1/host", "rid": "r-1b" }),
+    );
+    let (status, body) = post(&router, "/api/mobile/v1/rpc", &replay).await;
+    assert_eq!(
+        (status, body),
+        (StatusCode::BAD_REQUEST, json!({ "error": "replayed" }))
+    );
+
+    // Anything outside the allowlist.
+    let req = envelope(
+        &session,
+        2,
+        &json!({ "method": "POST", "path": "/api/teams", "rid": "r-2" }),
+    );
+    let (_, resp) = post(&router, "/api/mobile/v1/rpc", &req).await;
+    let inner = open_rpc(&session, 2, &resp);
+    assert_eq!(inner["status"], 404);
+    assert_eq!(inner["body"]["error"]["code"], "no_such_route");
+
+    // A tampered envelope does not open.
+    let mut bad = envelope(
+        &session,
+        3,
+        &json!({ "method": "GET", "path": "/v1/host", "rid": "r-3" }),
+    );
+    bad["seq"] = json!(4);
+    let (status, body) = post(&router, "/api/mobile/v1/rpc", &bad).await;
+    assert_eq!(
+        (status, body),
+        (StatusCode::UNAUTHORIZED, json!({ "error": "auth_failed" }))
+    );
+
+    // Revoke on the PC: the session dies, and the next handshake gets a verifiable notice.
+    bridge.revoke("u1", "dev-1").await.unwrap();
+    let req = envelope(
+        &session,
+        5,
+        &json!({ "method": "GET", "path": "/v1/host", "rid": "r-5" }),
+    );
+    let (status, body) = post(&router, "/api/mobile/v1/rpc", &req).await;
+    assert_eq!(
+        (status, body),
+        (StatusCode::UNAUTHORIZED, json!({ "error": "unknown_session" }))
+    );
+
+    let hs = begin_handshake(&phone, &offer.host_id, &offer.host_pk, now());
+    let (status, resp) = post(&router, "/api/mobile/v1/session", &hs.body).await;
+    assert_eq!(status, StatusCode::FORBIDDEN);
+    assert_eq!(resp["error"], "device_revoked");
+    let k_rev = revocation_key(
+        &x25519(&hs.e_secret, &offer.host_pk),
+        &offer.host_id,
+        "dev-1",
+        &hs.e_public,
+    );
+    let notice = open(
+        &k_rev,
+        &from_b64u(resp["notice"]["nonce"].as_str().unwrap()).unwrap(),
+        &from_b64u(resp["notice"]["ct"].as_str().unwrap()).unwrap(),
+        &revocation_aad(&offer.host_id, "dev-1", &hs.e_public),
+    )
+    .expect("the phone can verify the notice came from this PC");
+    let notice: Value = serde_json::from_slice(&notice).unwrap();
+    assert_eq!(notice["deviceId"], "dev-1");
+    assert_eq!(notice["reason"], "revoked");
+}
+
+#[tokio::test]
+async fn a_device_never_seen_gets_an_unknown_notice() {
+    let (bridge, router) = setup().await;
+    let offer = new_offer(&bridge).await;
+    let stranger = Phone::new("dev-x");
+    let hs = begin_handshake(&stranger, &offer.host_id, &offer.host_pk, now());
+    let (status, resp) = post(&router, "/api/mobile/v1/session", &hs.body).await;
+    assert_eq!(status, StatusCode::FORBIDDEN);
+    let k_rev = revocation_key(
+        &x25519(&hs.e_secret, &offer.host_pk),
+        &offer.host_id,
+        "dev-x",
+        &hs.e_public,
+    );
+    let notice = open(
+        &k_rev,
+        &from_b64u(resp["notice"]["nonce"].as_str().unwrap()).unwrap(),
+        &from_b64u(resp["notice"]["ct"].as_str().unwrap()).unwrap(),
+        &revocation_aad(&offer.host_id, "dev-x", &hs.e_public),
+    )
+    .unwrap();
+    assert_eq!(serde_json::from_slice::<Value>(&notice).unwrap()["reason"], "unknown");
+}
+
+#[tokio::test]
+async fn a_second_phone_on_the_same_qr_aborts_the_offer() {
+    let (bridge, router) = setup().await;
+    let offer = new_offer(&bridge).await;
+    let first = Phone::new("dev-1");
+    let thief = Phone::new("dev-2");
+    let (status, _) = post(&router, "/api/mobile/v1/pair", &first.pair_body(&offer, false, now())).await;
+    assert_eq!(status, StatusCode::OK);
+    let (status, body) = post(&router, "/api/mobile/v1/pair", &thief.pair_body(&offer, false, now())).await;
+    assert_eq!(
+        (status, body),
+        (StatusCode::CONFLICT, json!({ "error": "pairing_locked" }))
+    );
+    let (status, resp) = post(&router, "/api/mobile/v1/pair", &first.pair_body(&offer, false, now())).await;
+    assert_eq!(status, StatusCode::OK);
+    assert_eq!(first.open_pair(&offer, &resp)["status"], "aborted");
+    assert!(
+        bridge.approve("u1", &offer.offer_id).await.is_err(),
+        "an aborted offer cannot be approved"
+    );
+    assert!(bridge.devices("u1").await.unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn outer_errors_are_plaintext_codes() {
+    let (bridge, router) = setup().await;
+    let offer = new_offer(&bridge).await;
+    let phone = Phone::new("dev-1");
+
+    let mut wrong_host = phone.pair_body(&offer, false, now());
+    wrong_host["hostId"] = json!("someone-else");
+    let (status, body) = post(&router, "/api/mobile/v1/pair", &wrong_host).await;
+    assert_eq!(status, StatusCode::CONFLICT);
+    assert_eq!(body["error"], "unknown_host");
+    assert_eq!(body["hostId"], offer.host_id);
+
+    let (status, body) = post(
+        &router,
+        "/api/mobile/v1/pair",
+        &phone.pair_body(&offer, false, now() - 10 * 60 * 1000),
+    )
+    .await;
+    assert_eq!(status, StatusCode::BAD_REQUEST);
+    assert_eq!(body["error"], "clock_skew");
+    assert!(body["hostTime"].as_i64().is_some());
+
+    let mut bad_secret = Offer {
+        secret: vec![0; 32],
+        ..new_offer(&bridge).await
+    };
+    bad_secret.offer_id.clear();
+    let (status, body) = post(
+        &router,
+        "/api/mobile/v1/pair",
+        &phone.pair_body(&bad_secret, false, now()),
+    )
+    .await;
+    assert_eq!(
+        (status, body),
+        (StatusCode::UNAUTHORIZED, json!({ "error": "auth_failed" })),
+        "a request that never saw the QR"
+    );
+
+    let (status, body) = post(
+        &router,
+        "/api/mobile/v1/rpc",
+        &json!({ "v": 1, "sid": b64u(&[0u8; 16]), "seq": 1, "nonce": b64u(&[0u8; 24]), "ct": "AA" }),
+    )
+    .await;
+    assert_eq!(
+        (status, body),
+        (StatusCode::UNAUTHORIZED, json!({ "error": "unknown_session" }))
+    );
+    let (status, body) = post(&router, "/api/mobile/v1/rpc", &json!({ "nope": 1 })).await;
+    assert_eq!(
+        (status, body),
+        (StatusCode::BAD_REQUEST, json!({ "error": "malformed" }))
+    );
+}
+
+#[tokio::test]
+async fn a_rejected_offer_tells_the_phone() {
+    let (bridge, router) = setup().await;
+    let offer = new_offer(&bridge).await;
+    let phone = Phone::new("dev-1");
+    post(&router, "/api/mobile/v1/pair", &phone.pair_body(&offer, false, now())).await;
+    bridge.reject("u1", &offer.offer_id).unwrap();
+    let (_, resp) = post(&router, "/api/mobile/v1/pair", &phone.pair_body(&offer, true, now())).await;
+    assert_eq!(phone.open_pair(&offer, &resp)["status"], "rejected");
+}
