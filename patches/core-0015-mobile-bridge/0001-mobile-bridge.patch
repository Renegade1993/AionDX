index 00000000..6ed7d963
--- /dev/null
+++ b/crates/aionui-mobile/src/service.rs
@@ -0,0 +1,317 @@
+//! The bridge's lifecycle: settings, the host key, and whether the LAN
+//! listener runs. Business logic only; the HTTP surfaces live in
+//! `listener.rs` (LAN) and `admin_routes.rs` (desktop).
+
+use std::net::{IpAddr, Ipv4Addr, UdpSocket};
+use std::sync::Arc;
+
+use serde::Serialize;
+use tokio::sync::Mutex;
+
+use crate::error::MobileError;
+use crate::host_key::HostKey;
+use crate::listener::{self, ListenerHandle, OuterState};
+use crate::settings::{MobileSettings, MobileSettingsPatch};
+use crate::store::MobileStore;
+
+/// What the desktop's Settings > Mobile page shows (CONTRACT §3.4).
+#[derive(Debug, Clone, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct MobileStatus {
+    pub enabled: bool,
+    pub port: u16,
+    pub urls: Vec<String>,
+    pub host_id: String,
+    pub host_name: String,
+    pub mdns: bool,
+    pub tasks_write: bool,
+    pub listening: bool,
+    pub error: Option<String>,
+}
+
+struct Running {
+    user_id: String,
+    port: u16,
+    handle: ListenerHandle,
+}
+
+pub struct MobileBridge {
+    store: MobileStore,
+    host_key: Arc<HostKey>,
+    default_host_name: String,
+    bind_ip: IpAddr,
+    running: Mutex<Option<Running>>,
+    last_error: Mutex<Option<String>>,
+}
+
+impl MobileBridge {
+    pub fn new(store: MobileStore, host_key: Arc<HostKey>, default_host_name: String) -> Arc<Self> {
+        Self::with_bind_ip(store, host_key, default_host_name, IpAddr::V4(Ipv4Addr::UNSPECIFIED))
+    }
+
+    /// `bind_ip` is `0.0.0.0` in production; tests use loopback.
+    pub fn with_bind_ip(
+        store: MobileStore,
+        host_key: Arc<HostKey>,
+        default_host_name: String,
+        bind_ip: IpAddr,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            store,
+            host_key,
+            default_host_name,
+            bind_ip,
+            running: Mutex::new(None),
+            last_error: Mutex::new(None),
+        })
+    }
+
+    pub fn host_key(&self) -> &Arc<HostKey> {
+        &self.host_key
+    }
+
+    pub fn store(&self) -> &MobileStore {
+        &self.store
+    }
+
+    async fn settings_for(&self, user_id: &str) -> Result<MobileSettings, MobileError> {
+        Ok(self
+            .store
+            .load_settings(user_id)
+            .await?
+            .unwrap_or_else(|| MobileSettings::defaults(self.default_host_name.clone())))
+    }
+
+    /// Starts the listener at boot for the user who left the bridge on.
+    pub async fn start_if_enabled(&self) {
+        match self.store.enabled_users().await {
+            Ok(users) => {
+                if users.len() > 1 {
+                    tracing::warn!(
+                        count = users.len(),
+                        "mobile bridge: enabled for several users; using the most recent"
+                    );
+                }
+                if let Some((user_id, settings)) = users.into_iter().next() {
+                    self.reconcile(&user_id, &settings).await;
+                }
+            }
+            Err(e) => tracing::error!(error = %e, "mobile bridge: could not read settings at startup"),
+        }
+    }
+
+    pub async fn status(&self, user_id: &str) -> Result<MobileStatus, MobileError> {
+        let settings = self.settings_for(user_id).await?;
+        Ok(self.status_from(user_id, &settings).await)
+    }
+
+    pub async fn update_settings(
+        &self,
+        user_id: &str,
+        patch: &MobileSettingsPatch,
+    ) -> Result<MobileStatus, MobileError> {
+        let mut settings = self.settings_for(user_id).await?;
+        settings.apply(patch)?;
+        self.store.save_settings(user_id, &settings).await?;
+        self.reconcile(user_id, &settings).await;
+        Ok(self.status_from(user_id, &settings).await)
+    }
+
+    /// Stops the listener, e.g. at shutdown.
+    pub async fn stop(&self) {
+        if let Some(running) = self.running.lock().await.take() {
+            running.handle.stop().await;
+        }
+    }
+
+    /// Makes the listener match `settings` for `user_id`.
+    async fn reconcile(&self, user_id: &str, settings: &MobileSettings) {
+        let mut running = self.running.lock().await;
+        let keep = matches!(&*running, Some(r) if settings.enabled && r.user_id == user_id && r.port == settings.port);
+        if keep {
+            return;
+        }
+        let other_user = matches!(&*running, Some(r) if r.user_id != user_id);
+        if other_user && !settings.enabled {
+            return; // someone else's bridge; this user switching off changes nothing
+        }
+        if let Some(old) = running.take() {
+            old.handle.stop().await;
+        }
+        *self.last_error.lock().await = None;
+        if !settings.enabled {
+            return;
+        }
+        let router = listener::outer_router(OuterState {
+            host_id: Arc::from(self.host_key.host_id.as_str()),
+        });
+        match listener::start(self.bind_ip, settings.port, router).await {
+            Ok(handle) => {
+                *running = Some(Running {
+                    user_id: user_id.to_owned(),
+                    port: settings.port,
+                    handle,
+                });
+            }
+            Err(e) => {
+                tracing::error!(error = %e, port = settings.port, "mobile bridge: listener did not start");
+                *self.last_error.lock().await = Some(e.to_string());
+            }
+        }
+    }
+
+    async fn status_from(&self, user_id: &str, settings: &MobileSettings) -> MobileStatus {
+        let listening = matches!(&*self.running.lock().await, Some(r) if r.user_id == user_id);
+        MobileStatus {
+            enabled: settings.enabled,
+            port: settings.port,
+            urls: pairing_urls(settings),
+            host_id: self.host_key.host_id.clone(),
+            host_name: settings.host_name.clone(),
+            mdns: settings.mdns,
+            tasks_write: settings.tasks_write,
+            listening,
+            error: self.last_error.lock().await.clone(),
+        }
+    }
+}
+
+/// The base URLs that go into the pairing QR: this PC's primary LAN address,
+/// then the user's extra URLs. Phase 5 replaces the primary-address probe with
+/// a full interface enumeration.
+fn pairing_urls(settings: &MobileSettings) -> Vec<String> {
+    let mut urls = Vec::new();
+    if let Some(ip) = primary_lan_ip() {
+        urls.push(format!("http://{ip}:{}", settings.port));
+    }
+    for url in &settings.extra_urls {
+        if !urls.contains(url) {
+            urls.push(url.clone());
+        }
+    }
+    urls
+}
+
+/// The address the OS would use for outbound traffic. Connecting a UDP socket
+/// sends nothing; it only selects a route.
+fn primary_lan_ip() -> Option<IpAddr> {
+    let socket = UdpSocket::bind((Ipv4Addr::UNSPECIFIED, 0)).ok()?;
+    socket.connect((Ipv4Addr::new(192, 0, 2, 1), 9)).ok()?;
+    let ip = socket.local_addr().ok()?.ip();
+    crate::peer_filter::is_private_peer(ip)
+        .then_some(ip)
+        .filter(|ip| !ip.is_loopback())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    async fn bridge() -> Arc<MobileBridge> {
+        let store = MobileStore::open_memory().await.unwrap();
+        let key = Arc::new(HostKey::generate().unwrap());
+        MobileBridge::with_bind_ip(store, key, "Test PC".into(), IpAddr::V4(Ipv4Addr::LOCALHOST))
+    }
+
+    fn free_port() -> u16 {
+        std::net::TcpListener::bind("127.0.0.1:0")
+            .unwrap()
+            .local_addr()
+            .unwrap()
+            .port()
+    }
+
+    #[tokio::test]
+    async fn off_by_default_and_not_listening() {
+        let b = bridge().await;
+        let status = b.status("u1").await.unwrap();
+        assert!(!status.enabled);
+        assert!(!status.listening);
+        assert_eq!(status.port, 47734);
+        assert_eq!(status.host_name, "Test PC");
+        assert!(status.tasks_write);
+    }
+
+    #[tokio::test]
+    async fn enabling_starts_the_listener_and_disabling_stops_it() {
+        let b = bridge().await;
+        let port = free_port();
+        let on = b
+            .update_settings(
+                "u1",
+                &MobileSettingsPatch {
+                    enabled: Some(true),
+                    port: Some(port),
+                    ..Default::default()
+                },
+            )
+            .await
+            .unwrap();
+        assert!(on.listening, "{on:?}");
+        assert!(tokio::net::TcpStream::connect(("127.0.0.1", port)).await.is_ok());
+
+        let off = b
+            .update_settings(
+                "u1",
+                &MobileSettingsPatch {
+                    enabled: Some(false),
+                    ..Default::default()
+                },
+            )
+            .await
+            .unwrap();
+        assert!(!off.listening);
+        assert!(tokio::net::TcpStream::connect(("127.0.0.1", port)).await.is_err());
+    }
+
+    #[tokio::test]
+    async fn a_taken_port_is_reported_in_status() {
+        let b = bridge().await;
+        let taken = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let port = taken.local_addr().unwrap().port();
+        let status = b
+            .update_settings(
+                "u1",
+                &MobileSettingsPatch {
+                    enabled: Some(true),
+                    port: Some(port),
+                    ..Default::default()
+                },
+            )
+            .await
+            .unwrap();
+        assert!(status.enabled);
+        assert!(!status.listening);
+        assert!(status.error.unwrap().contains(&port.to_string()));
+    }
+
+    #[tokio::test]
+    async fn start_if_enabled_restores_the_listener() {
+        let b = bridge().await;
+        let port = free_port();
+        let mut s = MobileSettings::defaults("Test PC");
+        s.enabled = true;
+        s.port = port;
+        b.store().save_settings("u1", &s).await.unwrap();
+        b.start_if_enabled().await;
+        assert!(b.status("u1").await.unwrap().listening);
+        b.stop().await;
+        assert!(!b.status("u1").await.unwrap().listening);
+    }
+
+    #[tokio::test]
+    async fn extra_urls_follow_the_primary_address() {
+        let b = bridge().await;
+        let status = b
+            .update_settings(
+                "u1",
+                &MobileSettingsPatch {
+                    extra_urls: Some(vec!["http://100.64.0.9:47734".into()]),
+                    ..Default::default()
+                },
+            )
+            .await
+            .unwrap();
+        assert_eq!(status.urls.last().unwrap(), "http://100.64.0.9:47734");
+    }
+}
diff --git a/crates/aionui-mobile/src/settings.rs b/crates/aionui-mobile/src/settings.rs
new file mode 100644
index 00000000..fe2cbc5a
--- /dev/null
+++ b/crates/aionui-mobile/src/settings.rs
@@ -0,0 +1,176 @@
+//! Bridge settings (CONTRACT §3.4, §7). Stored per Core user in the bridge's own database.
+
+use serde::{Deserialize, Serialize};
+
+use crate::error::MobileError;
+
+/// Default LAN port (CONTRACT §7, decision §11 #6).
+pub const DEFAULT_PORT: u16 = 47734;
+const MAX_EXTRA_URLS: usize = 8;
+const MAX_HOST_NAME_CHARS: usize = 64;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct MobileSettings {
+    /// The LAN listener runs only while this is on. Off by default.
+    pub enabled: bool,
+    pub port: u16,
+    /// Shown on the phone; defaults to the PC's name.
+    pub host_name: String,
+    /// Extra base URLs put into the pairing QR, e.g. a Tailscale address.
+    pub extra_urls: Vec<String>,
+    /// Advertise `_aiondx._tcp` while enabled (§11 #6: on by default).
+    pub mdns: bool,
+    /// Task writes from the phone (§11 #4: on by default).
+    pub tasks_write: bool,
+}
+
+impl MobileSettings {
+    pub fn defaults(host_name: impl Into<String>) -> Self {
+        Self {
+            enabled: false,
+            port: DEFAULT_PORT,
+            host_name: host_name.into(),
+            extra_urls: Vec::new(),
+            mdns: true,
+            tasks_write: true,
+        }
+    }
+
+    /// Applies a partial update. On any invalid field nothing changes.
+    pub fn apply(&mut self, patch: &MobileSettingsPatch) -> Result<(), MobileError> {
+        let mut next = self.clone();
+        if let Some(enabled) = patch.enabled {
+            next.enabled = enabled;
+        }
+        if let Some(port) = patch.port {
+            if port < 1024 {
+                return Err(MobileError::InvalidSetting("port must be 1024 or higher".into()));
+            }
+            next.port = port;
+        }
+        if let Some(name) = &patch.host_name {
+            let name = name.trim();
+            if name.is_empty() || name.chars().count() > MAX_HOST_NAME_CHARS {
+                return Err(MobileError::InvalidSetting(format!(
+                    "hostName must be 1 to {MAX_HOST_NAME_CHARS} characters"
+                )));
+            }
+            next.host_name = name.to_owned();
+        }
+        if let Some(urls) = &patch.extra_urls {
+            if urls.len() > MAX_EXTRA_URLS {
+                return Err(MobileError::InvalidSetting(format!(
+                    "at most {MAX_EXTRA_URLS} extraUrls"
+                )));
+            }
+            next.extra_urls = urls
+                .iter()
+                .map(|url| validate_base_url(url))
+                .collect::<Result<_, _>>()?;
+        }
+        if let Some(mdns) = patch.mdns {
+            next.mdns = mdns;
+        }
+        if let Some(tasks_write) = patch.tasks_write {
+            next.tasks_write = tasks_write;
+        }
+        *self = next;
+        Ok(())
+    }
+}
+
+/// A partial update from `PUT /api/mobile/admin/settings`.
+#[derive(Debug, Clone, Default, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct MobileSettingsPatch {
+    pub enabled: Option<bool>,
+    pub port: Option<u16>,
+    pub host_name: Option<String>,
+    pub extra_urls: Option<Vec<String>>,
+    pub mdns: Option<bool>,
+    pub tasks_write: Option<bool>,
+}
+
+/// `http://host[:port]` or `https://...`, with no path, query or credentials.
+fn validate_base_url(raw: &str) -> Result<String, MobileError> {
+    let url = raw.trim().trim_end_matches('/');
+    let invalid = || MobileError::InvalidSetting(format!("extraUrls entry is not an http(s) base URL: {raw}"));
+    let rest = url
+        .strip_prefix("http://")
+        .or_else(|| url.strip_prefix("https://"))
+        .ok_or_else(invalid)?;
+    if rest.is_empty() || rest.contains(['/', '?', '#', '@', ' ']) {
+        return Err(invalid());
+    }
+    Ok(url.to_owned())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn defaults_follow_the_decisions_record() {
+        let s = MobileSettings::defaults("PC");
+        assert!(!s.enabled, "the bridge is off until the user enables it");
+        assert_eq!(s.port, 47734);
+        assert!(s.mdns);
+        assert!(s.tasks_write);
+    }
+
+    #[test]
+    fn patch_applies_only_given_fields() {
+        let mut s = MobileSettings::defaults("PC");
+        s.apply(&MobileSettingsPatch {
+            enabled: Some(true),
+            extra_urls: Some(vec!["http://100.64.1.2:47734/".into()]),
+            ..Default::default()
+        })
+        .unwrap();
+        assert!(s.enabled);
+        assert_eq!(s.extra_urls, vec!["http://100.64.1.2:47734".to_string()]);
+        assert_eq!(s.port, 47734);
+    }
+
+    #[test]
+    fn invalid_values_are_rejected_and_leave_settings_unchanged() {
+        let mut s = MobileSettings::defaults("PC");
+        let before = s.clone();
+        for patch in [
+            MobileSettingsPatch {
+                port: Some(80),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                host_name: Some("  ".into()),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                extra_urls: Some(vec!["ftp://x".into()]),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                extra_urls: Some(vec!["http://x/path".into()]),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                extra_urls: Some(vec!["http://u:p@x".into()]),
+                ..Default::default()
+            },
+            MobileSettingsPatch {
+                enabled: Some(true),
+                port: Some(1),
+                ..Default::default()
+            },
+        ] {
+            assert!(matches!(s.apply(&patch), Err(MobileError::InvalidSetting(_))));
+            assert_eq!(s, before);
+        }
+    }
+
+    #[test]
+    fn unknown_fields_are_rejected() {
+        assert!(serde_json::from_str::<MobileSettingsPatch>(r#"{"enabled":true,"bogus":1}"#).is_err());
+    }
+}
diff --git a/crates/aionui-mobile/src/store.rs b/crates/aionui-mobile/src/store.rs
new file mode 100644
index 00000000..816dfa99
--- /dev/null
+++ b/crates/aionui-mobile/src/store.rs
@@ -0,0 +1,140 @@
+//! The bridge's own SQLite database, `mobile-bridge.db` in the data dir.
+//!
+//! Deliberately not a migration in `aionui-backend.db`: AionCore refuses to open
+//! a database that has a migration it does not know, so a shared migration would
+//! lock every core without the bridge out of the user's chats.
+
+use std::path::{Path, PathBuf};
+use std::str::FromStr;
+use std::time::Duration;
+
+use sqlx::SqlitePool;
+use sqlx::migrate::Migrator;
+use sqlx::sqlite::{SqliteConnectOptions, SqliteJournalMode, SqlitePoolOptions};
+
+use crate::error::MobileError;
+use crate::settings::MobileSettings;
+
+static MIGRATOR: Migrator = sqlx::migrate!("./migrations");
+
+#[derive(Clone, Debug)]
+pub struct MobileStore {
+    pool: SqlitePool,
+}
+
+impl MobileStore {
+    pub fn path_in(data_dir: &Path) -> PathBuf {
+        data_dir.join("mobile-bridge.db")
+    }
+
+    pub async fn open(path: &Path) -> Result<Self, MobileError> {
+        let opts = SqliteConnectOptions::new()
+            .filename(path)
+            .create_if_missing(true)
+            .journal_mode(SqliteJournalMode::Wal)
+            .foreign_keys(true)
+            .busy_timeout(Duration::from_secs(5));
+        Self::connect(opts, 4).await
+    }
+
+    pub async fn open_memory() -> Result<Self, MobileError> {
+        let opts = SqliteConnectOptions::from_str("sqlite::memory:")?.foreign_keys(true);
+        // One connection: each in-memory connection would be a separate database.
+        Self::connect(opts, 1).await
+    }
+
+    async fn connect(opts: SqliteConnectOptions, max: u32) -> Result<Self, MobileError> {
+        let pool = SqlitePoolOptions::new().max_connections(max).connect_with(opts).await?;
+        MIGRATOR.run(&pool).await?;
+        Ok(Self { pool })
+    }
+
+    pub fn pool(&self) -> &SqlitePool {
+        &self.pool
+    }
+
+    pub async fn load_settings(&self, user_id: &str) -> Result<Option<MobileSettings>, MobileError> {
+        let row: Option<(String,)> = sqlx::query_as("SELECT settings_json FROM mobile_settings WHERE user_id = ?")
+            .bind(user_id)
+            .fetch_optional(&self.pool)
+            .await?;
+        row.map(|(json,)| serde_json::from_str(&json).map_err(MobileError::from))
+            .transpose()
+    }
+
+    pub async fn save_settings(&self, user_id: &str, settings: &MobileSettings) -> Result<(), MobileError> {
+        sqlx::query(
+            "INSERT INTO mobile_settings (user_id, settings_json, updated_at) VALUES (?, ?, ?) \
+             ON CONFLICT(user_id) DO UPDATE SET settings_json = excluded.settings_json, updated_at = excluded.updated_at",
+        )
+        .bind(user_id)
+        .bind(serde_json::to_string(settings)?)
+        .bind(aionui_common::now_ms())
+        .execute(&self.pool)
+        .await?;
+        Ok(())
+    }
+
+    /// Users whose bridge is switched on (normally zero or one).
+    pub async fn enabled_users(&self) -> Result<Vec<(String, MobileSettings)>, MobileError> {
+        let rows: Vec<(String, String)> =
+            sqlx::query_as("SELECT user_id, settings_json FROM mobile_settings ORDER BY updated_at DESC")
+                .fetch_all(&self.pool)
+                .await?;
+        let mut out = Vec::new();
+        for (user_id, json) in rows {
+            let settings: MobileSettings = serde_json::from_str(&json)?;
+            if settings.enabled {
+                out.push((user_id, settings));
+            }
+        }
+        Ok(out)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn settings_round_trip_per_user() {
+        let store = MobileStore::open_memory().await.unwrap();
+        assert!(store.load_settings("u1").await.unwrap().is_none());
+        let mut s = MobileSettings::defaults("PC");
+        s.enabled = true;
+        store.save_settings("u1", &s).await.unwrap();
+        store
+            .save_settings("u2", &MobileSettings::defaults("PC"))
+            .await
+            .unwrap();
+        assert_eq!(store.load_settings("u1").await.unwrap(), Some(s.clone()));
+        let enabled = store.enabled_users().await.unwrap();
+        assert_eq!(enabled.len(), 1);
+        assert_eq!(enabled[0].0, "u1");
+    }
+
+    #[tokio::test]
+    async fn file_database_is_created_and_reopened() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = MobileStore::path_in(dir.path());
+        {
+            let store = MobileStore::open(&path).await.unwrap();
+            store
+                .save_settings("u1", &MobileSettings::defaults("PC"))
+                .await
+                .unwrap();
+            store.pool().close().await;
+        }
+        let store = MobileStore::open(&path).await.unwrap();
+        assert!(store.load_settings("u1").await.unwrap().is_some());
+        // The bridge's tables are present; nothing is written to AionCore's own database.
+        let tables: Vec<(String,)> = sqlx::query_as(
+            "SELECT name FROM sqlite_master WHERE type = 'table' AND name LIKE 'mobile_%' ORDER BY name",
+        )
+        .fetch_all(store.pool())
+        .await
+        .unwrap();
+        let names: Vec<_> = tables.into_iter().map(|(n,)| n).collect();
+        assert_eq!(names, ["mobile_device_tombstones", "mobile_devices", "mobile_settings"]);
+    }
+}
