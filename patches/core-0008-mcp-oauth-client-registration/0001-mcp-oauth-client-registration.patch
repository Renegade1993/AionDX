+// ---------------------------------------------------------------------------
+// Client id kept with a stored token
+// ---------------------------------------------------------------------------
+
+/// The `token_type` to store for a login made with `client_id`: plain `bearer` for the default
+/// client (what older versions stored), `bearer;client_id=<id>` for a registered one.
+fn token_type_for(client_id: &str) -> String {
+    if client_id == DEFAULT_CLIENT_ID {
+        "bearer".to_string()
+    } else {
+        format!("bearer{CLIENT_ID_MARK}{client_id}")
+    }
+}
+
+/// The client id a stored `token_type` was saved with; `DEFAULT_CLIENT_ID` for a token saved
+/// before client registration existed.
+fn client_id_of(token_type: &str) -> String {
+    token_type
+        .split_once(CLIENT_ID_MARK)
+        .map(|(_, id)| id)
+        .filter(|id| !id.is_empty())
+        .unwrap_or(DEFAULT_CLIENT_ID)
+        .to_string()
+}
