+    /// Register AionCore as a public client with the authorization server (RFC 7591) and return
+    /// the client id it issued, for the given loopback redirect address.
+    async fn register_client(&self, registration_endpoint: &str, redirect_url: &str) -> Result<String, McpError> {
+        let body = serde_json::json!({
+            "client_name": CLIENT_NAME,
+            "redirect_uris": [redirect_url],
+            "grant_types": ["authorization_code", "refresh_token"],
+            "response_types": ["code"],
+            "token_endpoint_auth_method": "none",
+        });
+
+        let resp = self
+            .http_client
+            .post(registration_endpoint)
+            .timeout(REGISTRATION_TIMEOUT)
+            .json(&body)
+            .send()
+            .await
+            .map_err(|e| McpError::OAuth(format!("Client registration request failed: {e}")))?;
+
+        if !resp.status().is_success() {
+            return Err(McpError::OAuth(format!(
+                "Client registration endpoint returned {}",
+                resp.status()
+            )));
+        }
+
+        let registered: ClientRegistrationResponse = resp
+            .json()
+            .await
+            .map_err(|e| McpError::OAuth(format!("Failed to parse client registration response: {e}")))?;
+
+        if registered.client_id.is_empty() {
+            return Err(McpError::OAuth(
+                "Client registration returned an empty client_id".to_string(),
+            ));
+        }
+        Ok(registered.client_id)
+    }
