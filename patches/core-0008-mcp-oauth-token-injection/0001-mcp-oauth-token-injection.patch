+/// Merge a stored OAuth bearer token into a URL-based transport's headers.
+///
+/// `McpOAuthService::login` persists an access token to the DB but nothing
+/// ever reads it back onto an outgoing request — every connection test (and
+/// every real agent session, see `aionui-ai-agent::mcp_resolve`) only sends
+/// the static headers saved on the server record. That left the OAuth flow
+/// cosmetic: "Login successful" would fire, then the immediate re-test the
+/// UI runs afterward would still get a 401 and flip the server back to
+/// "needs auth" — both states visible at once. This attaches the token so
+/// the test (and whatever it reports) reflects the server's real auth state.
+/// Does nothing if the server config already sets its own `Authorization`
+/// header, or if no token is stored for the URL.
+async fn apply_stored_oauth_token(
+    oauth_service: &McpOAuthService,
+    user_id: &str,
+    transport: McpServerTransport,
+) -> McpServerTransport {
+    match transport {
+        McpServerTransport::Http { url, headers } => {
+            let headers = merge_oauth_header(oauth_service, user_id, &url, headers).await;
+            McpServerTransport::Http { url, headers }
+        }
+        McpServerTransport::Sse { url, headers } => {
+            let headers = merge_oauth_header(oauth_service, user_id, &url, headers).await;
+            McpServerTransport::Sse { url, headers }
+        }
+        stdio @ McpServerTransport::Stdio { .. } => stdio,
+    }
+}
+
+async fn merge_oauth_header(
+    oauth_service: &McpOAuthService,
+    user_id: &str,
+    url: &str,
+    mut headers: HashMap<String, String>,
+) -> HashMap<String, String> {
+    if headers.keys().any(|k| k.eq_ignore_ascii_case("authorization")) {
+        return headers;
+    }
+
+    match oauth_service.get_token(user_id, url).await {
+        Ok(Some(token)) => {
+            headers.insert("Authorization".to_string(), format!("Bearer {token}"));
+        }
+        Ok(None) => {}
+        Err(e) => warn!(url, error = %e, "Failed to look up stored OAuth token for MCP server"),
+    }
+
+    headers
+}
