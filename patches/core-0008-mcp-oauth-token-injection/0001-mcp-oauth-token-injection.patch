+#[cfg(test)]
+mod oauth_token_merge_tests {
+    use super::*;
+    use aionui_db::models::OAuthTokenRow;
+    use aionui_db::{DbError, UpsertOAuthTokenParams};
+
+    const TEST_USER_ID: &str = "user-1";
+    const TEST_URL: &str = "https://mcp.higgsfield.ai/mcp";
+
+    /// Reports a fixed stored token for `TEST_URL`, mirroring the shape of a
+    /// real `IOAuthTokenRepository::get_by_url` hit after a successful login.
+    struct StoredTokenRepo;
+
+    #[async_trait::async_trait]
+    impl aionui_db::IOAuthTokenRepository for StoredTokenRepo {
+        async fn get_by_url(&self, _user_id: &str, server_url: &str) -> Result<Option<OAuthTokenRow>, DbError> {
+            if server_url == TEST_URL {
+                Ok(Some(OAuthTokenRow {
+                    user_id: TEST_USER_ID.to_string(),
+                    server_url: TEST_URL.to_string(),
+                    access_token: "fresh_access_token".to_string(),
+                    refresh_token: None,
+                    token_type: "bearer".to_string(),
+                    expires_at: None,
+                    created_at: 0,
+                    updated_at: 0,
+                }))
+            } else {
+                Ok(None)
+            }
+        }
+
+        async fn upsert(&self, _params: UpsertOAuthTokenParams<'_>) -> Result<OAuthTokenRow, DbError> {
+            unimplemented!("not exercised by these tests")
+        }
+
+        async fn delete(&self, _user_id: &str, _server_url: &str) -> Result<(), DbError> {
+            unimplemented!("not exercised by these tests")
+        }
+
+        async fn list_authenticated_urls(&self, _user_id: &str) -> Result<Vec<String>, DbError> {
+            unimplemented!("not exercised by these tests")
+        }
+    }
+
+    fn oauth_service_with_stored_token() -> McpOAuthService {
+        McpOAuthService::new(std::sync::Arc::new(StoredTokenRepo), reqwest::Client::new())
+    }
+
+    #[tokio::test]
+    async fn http_transport_gets_stored_token_as_bearer_header() {
+        let svc = oauth_service_with_stored_token();
+        let transport = McpServerTransport::Http {
+            url: TEST_URL.to_string(),
+            headers: HashMap::new(),
+        };
+
+        let result = apply_stored_oauth_token(&svc, TEST_USER_ID, transport).await;
+
+        match result {
+            McpServerTransport::Http { headers, .. } => {
+                assert_eq!(headers.get("Authorization").map(String::as_str), Some("Bearer fresh_access_token"));
+            }
+            _ => panic!("expected Http"),
+        }
+    }
+
+    #[tokio::test]
+    async fn sse_transport_gets_stored_token_as_bearer_header() {
+        let svc = oauth_service_with_stored_token();
+        let transport = McpServerTransport::Sse {
+            url: TEST_URL.to_string(),
+            headers: HashMap::new(),
+        };
+
+        let result = apply_stored_oauth_token(&svc, TEST_USER_ID, transport).await;
+
+        match result {
+            McpServerTransport::Sse { headers, .. } => {
+                assert_eq!(headers.get("Authorization").map(String::as_str), Some("Bearer fresh_access_token"));
+            }
+            _ => panic!("expected Sse"),
+        }
+    }
+
+    #[tokio::test]
+    async fn no_stored_token_leaves_headers_untouched() {
+        let svc = oauth_service_with_stored_token();
+        let transport = McpServerTransport::Http {
+            url: "https://other.example.com/mcp".to_string(),
+            headers: HashMap::new(),
+        };
+
+        let result = apply_stored_oauth_token(&svc, TEST_USER_ID, transport).await;
+
+        match result {
+            McpServerTransport::Http { headers, .. } => assert!(headers.is_empty()),
+            _ => panic!("expected Http"),
+        }
+    }
+
+    #[tokio::test]
+    async fn existing_authorization_header_is_not_overwritten() {
+        let svc = oauth_service_with_stored_token();
+        let mut headers = HashMap::new();
+        headers.insert("Authorization".to_string(), "Bearer manually-configured".to_string());
+        let transport = McpServerTransport::Http {
+            url: TEST_URL.to_string(),
+            headers,
+        };
+
+        let result = apply_stored_oauth_token(&svc, TEST_USER_ID, transport).await;
+
+        match result {
+            McpServerTransport::Http { headers, .. } => {
+                assert_eq!(headers.get("Authorization").map(String::as_str), Some("Bearer manually-configured"));
+            }
+            _ => panic!("expected Http"),
+        }
+    }
+
+    #[tokio::test]
+    async fn stdio_transport_is_passed_through_unchanged() {
+        let svc = oauth_service_with_stored_token();
+        let transport = McpServerTransport::Stdio {
+            command: "npx".to_string(),
+            args: vec![],
+            env: HashMap::new(),
+        };
+
+        let result = apply_stored_oauth_token(&svc, TEST_USER_ID, transport.clone()).await;
+
+        assert_eq!(result, transport);
+    }
+}
