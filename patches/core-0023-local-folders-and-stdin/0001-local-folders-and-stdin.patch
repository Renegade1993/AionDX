diff --git a/crates/aionui-app/src/commands/stdin_text.rs b/crates/aionui-app/src/commands/stdin_text.rs
new file mode 100644
index 00000000..7bf2379f
--- /dev/null
+++ b/crates/aionui-app/src/commands/stdin_text.rs
@@ -0,0 +1,67 @@
+//! AionDX: JSON on stdin from any Windows shell.
+//!
+//! Windows PowerShell 5.1 puts a UTF-8 byte-order mark (sometimes two) in front of what it pipes to a
+//! program, even with `$OutputEncoding` set to UTF-8 without one (measured November 19th, 2026), and a
+//! UTF-16 pipe is possible too. serde_json refuses both, so `'{...}' | aioncore diagnose ...` failed with
+//! "invalid JSON payload on stdin" in the shell agents on Windows use when Git Bash is missing. This reads
+//! the bytes, decodes UTF-16 when it starts with its mark, and drops every leading mark.
+
+use std::io::{self, Read};
+
+/// Read all of stdin as text into `out` (as `read_to_string` would), tolerating the marks above.
+pub(crate) fn read_stdin_text(out: &mut String) -> io::Result<usize> {
+    let mut bytes = Vec::new();
+    io::stdin().read_to_end(&mut bytes)?;
+    let text = decode(&bytes)?;
+    out.push_str(&text);
+    Ok(text.len())
+}
+
+pub(crate) fn decode(bytes: &[u8]) -> io::Result<String> {
+    let text = if bytes.starts_with(&[0xFF, 0xFE]) || bytes.starts_with(&[0xFE, 0xFF]) {
+        let le = bytes[0] == 0xFF;
+        let units: Vec<u16> = bytes[2..]
+            .chunks(2)
+            .filter(|c| c.len() == 2)
+            .map(|c| if le { u16::from_le_bytes([c[0], c[1]]) } else { u16::from_be_bytes([c[0], c[1]]) })
+            .collect();
+        String::from_utf16(&units).map_err(|_| io::Error::new(io::ErrorKind::InvalidData, "stdin is not valid UTF-16"))?
+    } else {
+        String::from_utf8(bytes.to_vec()).map_err(|_| io::Error::new(io::ErrorKind::InvalidData, "stdin is not valid UTF-8"))?
+    };
+    Ok(text.trim_start_matches('\u{feff}').to_owned())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::decode;
+
+    #[test]
+    fn plain_utf8_is_unchanged() {
+        assert_eq!(decode(b"{\"a\":1}\r\n").unwrap(), "{\"a\":1}\r\n");
+    }
+
+    #[test]
+    fn powershell_byte_order_marks_are_dropped() {
+        // what Windows PowerShell 5.1 pipes: one mark, or two when $OutputEncoding is UTF8 (with mark)
+        assert_eq!(decode(b"\xef\xbb\xbf{\"conversation_id\":\"x\"}\r\n").unwrap(), "{\"conversation_id\":\"x\"}\r\n");
+        assert_eq!(decode(b"\xef\xbb\xbf\xef\xbb\xbf{\"a\":1}").unwrap(), "{\"a\":1}");
+        let v: serde_json::Value = serde_json::from_str(&decode(b"\xef\xbb\xbf{\"a\":1}\r\n").unwrap()).unwrap();
+        assert_eq!(v["a"], 1);
+    }
+
+    #[test]
+    fn utf16_with_its_mark_is_decoded() {
+        let mut le = vec![0xFF, 0xFE];
+        for u in "{\"a\":\"é\"}".encode_utf16() { le.extend_from_slice(&u.to_le_bytes()); }
+        assert_eq!(decode(&le).unwrap(), "{\"a\":\"é\"}");
+        let mut be = vec![0xFE, 0xFF];
+        for u in "{\"a\":2}".encode_utf16() { be.extend_from_slice(&u.to_be_bytes()); }
+        assert_eq!(decode(&be).unwrap(), "{\"a\":2}");
+    }
+
+    #[test]
+    fn bytes_that_are_not_text_are_an_error() {
+        assert!(decode(&[0xC3, 0x28]).is_err());
+    }
+}
