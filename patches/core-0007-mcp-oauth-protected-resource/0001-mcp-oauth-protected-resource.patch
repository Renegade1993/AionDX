+// ---------------------------------------------------------------------------
+// RFC 9728 protected-resource metadata URL
+// ---------------------------------------------------------------------------
+
+/// Build the RFC 9728 protected-resource-metadata URL for an MCP resource URL.
+///
+/// Per RFC 9728 §3.1, the `.well-known` path component is inserted between the
+/// authority and the resource's own path — not appended after it. For
+/// `https://mcp.example.com/mcp` that is
+/// `https://mcp.example.com/.well-known/oauth-protected-resource/mcp`, not
+/// `https://mcp.example.com/mcp/.well-known/oauth-protected-resource`.
+fn protected_resource_metadata_url(resource_url: &str) -> Option<String> {
+    let mut url = reqwest::Url::parse(resource_url).ok()?;
+    let path = url.path().trim_start_matches('/');
+    let new_path = if path.is_empty() {
+        "/.well-known/oauth-protected-resource".to_string()
+    } else {
+        format!("/.well-known/oauth-protected-resource/{path}")
+    };
+    url.set_path(&new_path);
+    url.set_query(None);
+    url.set_fragment(None);
+    Some(url.to_string())
+}
