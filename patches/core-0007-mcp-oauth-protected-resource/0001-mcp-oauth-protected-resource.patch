+    #[test]
+    fn protected_resource_metadata_url_inserts_well_known_before_path() {
+        assert_eq!(
+            protected_resource_metadata_url("https://mcp.higgsfield.ai/mcp").unwrap(),
+            "https://mcp.higgsfield.ai/.well-known/oauth-protected-resource/mcp"
+        );
