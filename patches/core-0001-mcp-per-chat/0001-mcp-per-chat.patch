+/// Trim ids, drop empty ones and keep the first occurrence of each, in order.
+fn dedup_mcp_server_ids(ids: Vec<String>) -> Vec<String> {
+    let mut seen = HashSet::new();
+    ids.into_iter()
+        .map(|id| id.trim().to_owned())
+        .filter(|id| !id.is_empty() && seen.insert(id.clone()))
+        .collect()
+}
+
+/// Write the four MCP snapshot fields the way `create()` stores them, plus the
+/// `mcp_selection` marker for an explicit selection (removed on `inherit`).
+fn write_mcp_snapshot_into_extra(
+    extra: &mut serde_json::Value,
+    snapshot: &McpRuntimeSnapshot,
+    explicit_ids: Option<&[String]>,
+) -> Result<(), ConversationError> {
+    let encode = |value: Result<serde_json::Value, serde_json::Error>| {
+        value.map_err(|e| ConversationError::internal(format!("Failed to serialize MCP snapshot: {e}")))
+    };
+    let mcp_server_ids = encode(serde_json::to_value(&snapshot.mcp_server_ids))?;
+    let mcp_servers = encode(serde_json::to_value(&snapshot.mcp_servers))?;
+    let mcp_statuses = encode(serde_json::to_value(&snapshot.mcp_statuses))?;
+    let session_mcp_servers = encode(serde_json::to_value(&snapshot.session_mcp_servers))?;
+    let Some(obj) = extra.as_object_mut() else {
+        return Err(ConversationError::internal("conversation extra is not a JSON object"));
+    };
+    obj.insert("mcp_server_ids".to_owned(), mcp_server_ids);
+    obj.insert("mcp_servers".to_owned(), mcp_servers);
+    obj.insert("mcp_statuses".to_owned(), mcp_statuses);
+    // Written even when empty: this replaces the whole selection, so a builtin
+    // server dropped from it must not survive from the old list.
+    obj.insert("session_mcp_servers".to_owned(), session_mcp_servers);
+    match explicit_ids {
+        Some(ids) => {
+            obj.insert(
+                CONVERSATION_MCP_SELECTION_KEY.to_owned(),
+                serde_json::json!({ "source": "conversation", "server_ids": ids }),
+            );
+        }
+        None => {
+            obj.remove(CONVERSATION_MCP_SELECTION_KEY);
+        }
+    }
+    Ok(())
+}
