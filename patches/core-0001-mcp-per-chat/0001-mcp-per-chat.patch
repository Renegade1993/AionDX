+/// The mock task manager plus a real in-memory MCP catalog for `user_1`:
+/// `alpha` and `beta` are user servers, `img` is a builtin one. None is
+/// globally enabled, so a new assistant-less conversation starts with no MCP.
+async fn make_service_with_mcp_catalog(
+    task_mgr: Arc<MockTaskManager>,
+) -> (
+    ConversationService,
+    Arc<MockBroadcaster>,
+    Arc<MockRepo>,
+    Arc<dyn IMcpServerRepository>,
+    Vec<McpServerRow>,
+) {
+    let (svc, broadcaster, repo) = make_service_with_mock_task_manager(task_mgr);
+    let db = init_database_memory().await.unwrap();
+    seed_test_user(db.pool(), "user_1").await;
+    let mcp_repo: Arc<dyn IMcpServerRepository> = Arc::new(SqliteMcpServerRepository::new(db.pool().clone()));
+    let mut rows = Vec::new();
+    for (name, builtin) in [("alpha", false), ("beta", false), ("img", true)] {
+        let row = mcp_repo
+            .create(CreateMcpServerParams {
+                user_id: "user_1",
+                name,
+                description: None,
+                enabled: false,
+                transport_type: "http",
+                transport_config: r#"{"url":"http://127.0.0.1:9/mcp"}"#,
+                tools: None,
+                original_json: None,
+                builtin,
+            })
+            .await
+            .unwrap();
+        rows.push(row);
+    }
+    svc.with_mcp_server_repo(mcp_repo.clone());
+    (svc, broadcaster, repo, mcp_repo, rows)
+}
