+        let raw = serde_json::to_value(&payload).unwrap();
+        assert_eq!(raw["runtime_action"], "next_start");
+        assert!(raw.get("team_id").is_none());
+        let back: ConversationMcpChanged = serde_json::from_value(raw).unwrap();
+        assert_eq!(back, payload);
+    }
