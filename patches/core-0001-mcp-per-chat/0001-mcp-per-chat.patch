+/// Map one MCP provisioning report to the API's live status for that server.
+/// claude's `needs-auth` arrives as `Degraded` with the reason "mcp server '<name>'
+/// needs auth"; codex's `cancelled` and failed OAuth logins arrive as `Degraded`
+/// with codex's own error text.
+fn mcp_live_status(name: &str, phase: &aionui_session::ProvisioningPhase) -> aionui_api_types::McpServerLiveStatus {
+    use aionui_api_types::McpServerLiveState;
+    use aionui_session::ProvisioningPhase;
+    let reason = |text: &String| Some(text.clone()).filter(|text| !text.is_empty());
+    let (status, error) = match phase {
+        ProvisioningPhase::Injecting | ProvisioningPhase::ToolsWaiting => (McpServerLiveState::Pending, None),
+        ProvisioningPhase::ToolsReady => (McpServerLiveState::Connected, None),
+        ProvisioningPhase::Degraded { reason: text } => (McpServerLiveState::Degraded, reason(text)),
+        ProvisioningPhase::LoadFailed { reason: text } => (McpServerLiveState::Failed, reason(text)),
+    };
+    aionui_api_types::McpServerLiveStatus {
+        name: name.to_owned(),
+        status,
+        error,
+    }
+}
+
+/// Insert or replace one server's live status, matched by name. `true` when the
+/// list changed.
+fn upsert_mcp_live_status(
+    servers: &mut Vec<aionui_api_types::McpServerLiveStatus>,
+    status: aionui_api_types::McpServerLiveStatus,
+) -> bool {
+    match servers.iter().position(|existing| existing.name == status.name) {
+        Some(index) if servers[index] == status => false,
+        Some(index) => {
+            servers[index] = status;
+            true
+        }
+        None => {
+            servers.push(status);
+            true
+        }
+    }
+}
+
+/// Push a conversation's live MCP status to the UI as
+/// `conversation.mcpStatusChanged`, carrying every server reported so far. Keyed
+/// by `user_id` like every other conversation event, so the WebSocket layer
+/// routes it to the owner's connections.
+fn broadcast_mcp_status_frame(
+    bus: &dyn EventBroadcaster,
+    conversation_id: &str,
+    user_id: &str,
+    mcp_servers: Vec<aionui_api_types::McpServerLiveStatus>,
+) {
+    let payload = aionui_api_types::ConversationMcpStatusChangedPayload {
+        user_id: user_id.to_owned(),
+        conversation_id: conversation_id.to_owned(),
+        mcp_servers,
+    };
+    match serde_json::to_value(&payload) {
+        Ok(value) => bus.broadcast(aionui_api_types::WebSocketMessage::new(
+            aionui_api_types::CONVERSATION_MCP_STATUS_CHANGED_EVENT,
+            value,
+        )),
+        Err(err) => tracing::warn!(conversation_id, error = %err, "mcp status broadcast: serialize failed"),
+    }
+}
