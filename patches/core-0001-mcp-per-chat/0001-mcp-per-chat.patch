+    #[test]
+    fn deserialize_update_mcp_request_accepts_the_creation_field_names() {
+        let req: UpdateConversationMcpRequest = serde_json::from_value(json!({ "server_ids": ["mcp-a"] })).unwrap();
+        assert_eq!(req.server_ids, Some(vec!["mcp-a".to_owned()]));
+        assert!(!req.inherit);
+
+        let req: UpdateConversationMcpRequest =
+            serde_json::from_value(json!({ "selected_mcp_server_ids": ["mcp-b"] })).unwrap();
+        assert_eq!(req.server_ids, Some(vec!["mcp-b".to_owned()]));
+
+        let req: UpdateConversationMcpRequest = serde_json::from_value(json!({ "mcp_ids": [] })).unwrap();
+        assert_eq!(req.server_ids, Some(Vec::new()), "an empty list selects no server");
+
+        let req: UpdateConversationMcpRequest = serde_json::from_value(json!({ "inherit": true })).unwrap();
+        assert!(req.server_ids.is_none());
+        assert!(req.inherit);
+    }
+
+    #[test]
+    fn conversation_mcp_selection_fingerprint_matches_the_assistant_fingerprint() {
+        let extra = json!({
+            "mcp_selection": { "source": "conversation", "server_ids": ["mcp-b", "mcp-a", "mcp-b"] }
+        });
+        assert_eq!(
+            conversation_mcp_selection_fingerprint(&extra),
+            Some(crate::assistant_mcp_binding_fingerprint(&[
+                "mcp-a".to_owned(),
+                "mcp-b".to_owned()
+            ]))
+        );
+        assert_eq!(
+            conversation_mcp_selection_fingerprint(&json!({ "mcp_server_ids": ["mcp-a"] })),
+            None,
+            "a conversation without its own selection follows its assistant"
+        );
+    }
+
+    #[test]
+    fn runtime_summary_mcp_fields_are_additive() {
+        let summary = ConversationRuntimeSummary {
+            state: ConversationRuntimeStateKind::Idle,
+            can_send_message: true,
+            has_task: true,
+            task_status: None,
+            is_processing: false,
+            pending_confirmations: 0,
+            turn_id: None,
+            supports_midturn_delivery: true,
+            mcp_servers: None,
+            mcp_restart_pending: false,
+        };
+        let raw = serde_json::to_value(&summary).unwrap();
+        assert!(raw.get("mcp_servers").is_none(), "absent live status is omitted");
+        assert!(raw.get("mcp_restart_pending").is_none(), "false is omitted");
+
+        let live = ConversationRuntimeSummary {
+            mcp_servers: Some(vec![McpServerLiveStatus {
+                name: "airtable".into(),
+                status: McpServerLiveState::Degraded,
+                error: Some("mcp server 'airtable' needs auth".into()),
+            }]),
+            mcp_restart_pending: true,
+            ..summary.clone()
+        };
+        let raw = serde_json::to_value(&live).unwrap();
+        assert_eq!(
+            raw["mcp_servers"][0],
+            json!({ "name": "airtable", "status": "degraded", "error": "mcp server 'airtable' needs auth" })
+        );
+        assert_eq!(raw["mcp_restart_pending"], true);
+        let back: ConversationRuntimeSummary = serde_json::from_value(raw).unwrap();
+        assert_eq!(back, live);
+
+        let older: ConversationRuntimeSummary = serde_json::from_value(json!({
+            "state": "idle",
+            "can_send_message": true,
+            "has_task": false,
+            "task_status": null,
+            "is_processing": false,
+            "pending_confirmations": 0,
+            "turn_id": null
+        }))
+        .unwrap();
+        assert!(older.mcp_servers.is_none());
+        assert!(!older.mcp_restart_pending);
+    }
+
