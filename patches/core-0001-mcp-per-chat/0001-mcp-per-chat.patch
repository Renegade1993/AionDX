+    let turn = svc.runtime_state().try_claim_turn(&conv.id, "turn-running").unwrap();
+    let task_mgr_dyn: Arc<dyn IWorkerTaskManager> = task_mgr.clone();
+
+    let first = svc
+        .update_mcp_selection(
+            "user_1",
+            &conv.id,
+            mcp_ids_request(&[rows[0].id.as_str()]),
+            &task_mgr_dyn,
+        )
+        .await
+        .unwrap();
+    assert_eq!(first.runtime_action, ConversationMcpRuntimeAction::Deferred);
+    assert!(
+        first
+            .conversation
+            .runtime
+            .as_ref()
+            .is_some_and(|runtime| runtime.mcp_restart_pending),
+        "the pending restart is visible on the conversation"
+    );
+    // A second change while the turn still runs rides the same pending restart.
+    let second = svc
+        .update_mcp_selection(
+            "user_1",
+            &conv.id,
+            mcp_ids_request(&[rows[1].id.as_str()]),
+            &task_mgr_dyn,
+        )
+        .await
+        .unwrap();
+    assert_eq!(second.runtime_action, ConversationMcpRuntimeAction::Deferred);
+    assert_eq!(task_mgr.kill_count(), 0, "a running turn is never cut off");
+
+    drop(turn);
+    tokio::time::timeout(Duration::from_secs(2), async {
+        while task_mgr.kill_count() == 0 || svc.runtime_state().is_restarting(&conv.id) {
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("the deferred restart runs once the turn ends");
+    assert_eq!(
+        task_mgr.kill_records(),
+        vec![(conv.id.clone(), Some(AgentKillReason::RuntimeRestart))],
+        "one restart covers both changes"
+    );
+    assert!(!svc.runtime_state().has_pending_mcp_restart(&conv.id));
+    assert!(task_mgr.get_task(&conv.id).is_some(), "the runtime was rebuilt");
+}
