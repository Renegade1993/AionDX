+#[tokio::test]
+async fn update_mcp_selection_hands_a_team_member_to_the_team_runtime() {
+    async fn create_team_member(svc: &ConversationService) -> ConversationResponse {
+        let req: CreateConversationRequest = serde_json::from_value(json!({
+            "type": "acp",
+            "extra": { "workspace": ensure_test_workspace_path(), "teamId": "team-1" }
+        }))
+        .unwrap();
+        svc.create("user_1", req).await.unwrap()
+    }
+
+    let task_mgr = Arc::new(MockTaskManager::new());
+    let (svc, broadcaster, repo, _mcp_repo, rows) = make_service_with_mcp_catalog(task_mgr.clone()).await;
+    let task_mgr_dyn: Arc<dyn IWorkerTaskManager> = task_mgr.clone();
+
+    // A member created from an assistant: the team re-resolves that assistant's
+    // members, and the adapter makes this conversation's own selection win.
+    let member = create_team_member(&svc).await;
+    repo.upsert_assistant_snapshot(
+        "user_1",
+        &UpsertConversationAssistantSnapshotParams {
+            conversation_id: &member.id,
+            assistant_definition_id: "def-reviewer",
+            assistant_id: "reviewer",
+            assistant_source: "user",
+            agent_id: "claude",
+            rules_content: "",
+            default_model_mode: "auto",
+            resolved_model_id: None,
+            default_permission_mode: "auto",
+            resolved_permission_value: None,
+            default_thought_level_mode: "auto",
+            resolved_thought_level_value: None,
+            default_skills_mode: "auto",
+            resolved_skill_ids: "[]",
+            resolved_disabled_builtin_skill_ids: "[]",
+            default_mcps_mode: "auto",
+            resolved_mcp_ids: "[]",
+        },
+    )
+    .await
+    .unwrap();
+    task_mgr.insert_agent(&member.id, AgentInstance::Mock(Arc::new(MockAgent::new(&member.id))));
+    broadcaster.take_events();
+
+    let response = svc
+        .update_mcp_selection(
+            "user_1",
+            &member.id,
+            mcp_ids_request(&[rows[0].id.as_str()]),
+            &task_mgr_dyn,
+        )
+        .await
+        .unwrap();
+
+    assert_eq!(response.runtime_action, ConversationMcpRuntimeAction::Team);
+    assert_eq!(task_mgr.kill_count(), 0, "the team runtime owns a member's restart");
+    let events = broadcaster.take_events();
+    let binding = events
+        .iter()
+        .find(|event| event.name == "assistant.mcpBindingChanged")
+        .expect("the member's assistant is announced to the team runtime");
+    assert_eq!(binding.data["assistant_id"], "reviewer");
+    assert_eq!(binding.data["user_id"], "user_1");
+    let changed = events
+        .iter()
+        .find(|event| event.name == "conversation.mcpChanged")
+        .expect("conversation.mcpChanged is broadcast");
+    assert_eq!(changed.data["team_id"], "team-1");
+    assert_eq!(changed.data["runtime_action"], "team");
+
+    // A member without an assistant gets no team refresh; its next attach reads it.
+    let bare = create_team_member(&svc).await;
+    broadcaster.take_events();
+    let response = svc
+        .update_mcp_selection(
+            "user_1",
+            &bare.id,
+            mcp_ids_request(&[rows[0].id.as_str()]),
+            &task_mgr_dyn,
+        )
+        .await
+        .unwrap();
+    assert_eq!(response.runtime_action, ConversationMcpRuntimeAction::NextStart);
+    assert!(
+        !broadcaster
+            .take_events()
+            .iter()
+            .any(|event| event.name == "assistant.mcpBindingChanged")
+    );
+}
