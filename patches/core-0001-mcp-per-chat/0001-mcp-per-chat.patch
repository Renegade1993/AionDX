+    }
+
+    /// Restart the runtime with the new MCP selection once its agent is idle.
+    /// At most one waiter per conversation: a later change rides the same
+    /// restart, which reads the newest snapshot.
+    fn schedule_deferred_mcp_restart(
+        &self,
+        user_id: &str,
+        conversation_id: &str,
+        source: Option<ConversationSource>,
+        task_manager: &Arc<dyn IWorkerTaskManager>,
+    ) {
+        if !self.runtime_state.mark_pending_mcp_restart(conversation_id) {
+            debug!(
+                conversation_id,
+                "MCP runtime restart already pending; it loads the newest selection"
+            );
+            return;
+        }
+        info!(
+            conversation_id,
+            "MCP selection saved; runtime restart deferred until the agent is idle"
+        );
+        let service = self.clone();
+        let user_id = user_id.to_owned();
+        let conversation_id = conversation_id.to_owned();
+        let task_manager = Arc::clone(task_manager);
+        tokio::spawn(async move {
+            service
+                .run_deferred_mcp_restart(&user_id, &conversation_id, source, &task_manager)
+                .await;
+        });
+    }
+
+    /// Body of a deferred MCP restart. Waits until no turn is claimed and no
+    /// restart is in flight, then takes the restart gate the same atomic way as
+    /// the immediate path. An agent still busy without a claimed turn
+    /// (background tasks) is polled. Gives up when the runtime is gone (the
+    /// next start loads the selection) or the conversation is being deleted or
+    /// the app is shutting down.
+    async fn run_deferred_mcp_restart(
+        &self,
+        user_id: &str,
+        conversation_id: &str,
+        source: Option<ConversationSource>,
+        task_manager: &Arc<dyn IWorkerTaskManager>,
+    ) {
+        loop {
+            self.runtime_state.wait_until_idle(conversation_id).await;
+            let busy = match task_manager.get_task(conversation_id) {
+                None => {
+                    debug!(
+                        conversation_id,
+                        "deferred MCP restart dropped: no runtime left to restart"
+                    );
+                    self.runtime_state.clear_pending_mcp_restart(conversation_id);
+                    return;
+                }
+                Some(agent) => agent_has_work_in_flight(&agent),
+            };
+            if busy {
+                tokio::time::sleep(DEFERRED_MCP_RESTART_POLL).await;
+                continue;
+            }
+            match self.runtime_state.try_begin_idle_restart(conversation_id) {
+                Ok(true) => {
+                    self.runtime_state.clear_pending_mcp_restart(conversation_id);
+                    match self
+                        .rebuild_runtime_for_mcp(user_id, conversation_id, task_manager)
+                        .await
+                    {
+                        Ok(()) => info!(conversation_id, "Deferred MCP runtime restart finished"),
+                        Err(error) => warn!(
+                            conversation_id,
+                            error = %ErrorChain(&error),
+                            "deferred MCP runtime restart failed; the next start loads the selection"
+                        ),
+                    }
+                    // The open conversation re-reads its runtime from this.
+                    self.broadcast_list_changed(user_id, conversation_id, "updated", source.as_ref());
+                    return;
+                }
+                // A new turn or another restart won the race: wait for it too.
+                Ok(false) | Err(ConversationError::RuntimeRestarting { .. }) => continue,
+                Err(error) => {
+                    debug!(conversation_id, error = %error, "deferred MCP restart dropped");
+                    self.runtime_state.clear_pending_mcp_restart(conversation_id);
+                    return;
+                }
+            }
+        }
+    }
+
+    /// Announce a replaced MCP selection to the UI and to agents watching the bus.
+    fn publish_conversation_mcp_changed(&self, payload: &ConversationMcpChanged) {
+        match serde_json::to_value(payload) {
+            Ok(value) => self
+                .broadcaster
+                .broadcast(WebSocketMessage::new(CONVERSATION_MCP_CHANGED_EVENT, value)),
+            Err(error) => warn!(
+                conversation_id = %payload.conversation_id,
+                error = %error,
+                "failed to encode conversation MCP change event"
+            ),
+        }
+    }
+}
