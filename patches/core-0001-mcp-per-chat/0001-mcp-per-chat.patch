+/// `extra` key that marks a conversation as owning its MCP selection. Written
+/// only by `PUT /api/conversations/{id}/mcp`, as
+/// `{ "source": "conversation", "server_ids": [...] }`. While it is present a
+/// team member keeps this selection across re-attach and assistant binding
+/// changes instead of being reset to its assistant's binding.
+pub const CONVERSATION_MCP_SELECTION_KEY: &str = "mcp_selection";
+
+/// WebSocket event broadcast after `PUT /api/conversations/{id}/mcp` replaced a
+/// conversation's MCP selection. Payload: [`ConversationMcpChanged`].
+pub const CONVERSATION_MCP_CHANGED_EVENT: &str = "conversation.mcpChanged";
+
+/// WebSocket event broadcast when a running agent reports a change in the live
+/// state of one of its MCP servers. Payload: [`ConversationMcpStatusChangedPayload`].
+pub const CONVERSATION_MCP_STATUS_CHANGED_EVENT: &str = "conversation.mcpStatusChanged";
+
+/// Fingerprint of the MCP selection a conversation owns (see
+/// [`CONVERSATION_MCP_SELECTION_KEY`]), or `None` when the conversation follows
+/// its assistant binding. Uses the assistant binding fingerprint, so the same
+/// set of ids never restarts a team member twice.
+pub fn conversation_mcp_selection_fingerprint(extra: &serde_json::Value) -> Option<String> {
+    let ids = extra
+        .get(CONVERSATION_MCP_SELECTION_KEY)?
+        .get("server_ids")?
+        .as_array()?
+        .iter()
+        .filter_map(|id| id.as_str().map(str::to_owned))
+        .collect::<Vec<_>>();
+    Some(crate::assistant_mcp_binding_fingerprint(&ids))
+}
+
+/// Body for `PUT /api/conversations/{id}/mcp`: replace a conversation's MCP
+/// selection after creation. Send exactly one of the two fields.
+#[derive(Debug, Clone, Default, Deserialize, PartialEq, Eq)]
+pub struct UpdateConversationMcpRequest {
+    /// MCP server row ids from `GET /api/mcp/servers`, builtin rows included:
+    /// the ids creation takes in `extra.selected_mcp_server_ids` or
+    /// `assistant.conversation_overrides.mcp_ids`. `[]` selects no server.
+    #[serde(default, alias = "selected_mcp_server_ids", alias = "mcp_ids")]
+    pub server_ids: Option<Vec<String>>,
+    /// `true` drops the conversation's own selection and picks again the way
+    /// creation does without one: the assistant's MCP binding, else every
+    /// enabled server. A team member without an assistant gets none.
+    #[serde(default)]
+    pub inherit: bool,
+}
+
+/// What happened to the agent runtime after a conversation's MCP selection
+/// changed.
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum ConversationMcpRuntimeAction {
+    /// No agent was running. The next session start loads the new selection.
+    NextStart,
+    /// The idle agent was restarted with the new selection.
+    Restarted,
+    /// The agent was working. It restarts with the new selection once idle.
+    Deferred,
+    /// Team member with an assistant. The team runtime restarts it now when
+    /// idle, after its current work otherwise, or at its next attach when
+    /// dormant. (A team member without an assistant reports `next_start`.)
+    Team,
+}
+
+/// Response for `PUT /api/conversations/{id}/mcp`.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct UpdateConversationMcpResponse {
+    /// The conversation as `GET /api/conversations/{id}` returns it after the change.
+    pub conversation: ConversationResponse,
+    pub runtime_action: ConversationMcpRuntimeAction,
+}
+
+/// Payload of [`CONVERSATION_MCP_CHANGED_EVENT`].
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct ConversationMcpChanged {
+    pub user_id: String,
+    pub conversation_id: String,
+    /// Set when the conversation belongs to a team member.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub team_id: Option<String>,
+    /// The frozen user-row ids (`extra.mcp_server_ids`).
+    pub mcp_server_ids: Vec<String>,
+    /// Display names of every selected server (`extra.mcp_servers`).
+    pub mcp_servers: Vec<String>,
+    pub runtime_action: ConversationMcpRuntimeAction,
+}
+
+/// Live state of one MCP server inside a running agent session, as the agent
+/// itself reported it.
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum McpServerLiveState {
+    /// Still starting (claude `pending`, codex `starting`).
+    Pending,
+    /// Connected and its tools are available (claude `connected`, codex `ready`).
+    Connected,
+    /// Up but unusable as configured: claude `needs-auth`, codex `cancelled`, or
+    /// a failed codex OAuth login. `error` says which.
+    Degraded,
+    /// Did not start or connect (claude and codex `failed`).
+    Failed,
+}
+
+/// One MCP server's live status, as listed in `runtime.mcp_servers`.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct McpServerLiveStatus {
+    pub name: String,
+    pub status: McpServerLiveState,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub error: Option<String>,
+}
+
+/// Payload of [`CONVERSATION_MCP_STATUS_CHANGED_EVENT`].
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct ConversationMcpStatusChangedPayload {
+    pub user_id: String,
+    pub conversation_id: String,
+    /// Every server the agent has reported so far, including the one that changed.
+    pub mcp_servers: Vec<McpServerLiveStatus>,
+}
