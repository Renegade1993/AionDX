+// ── AionDX core-0019: human-only routes refuse the runtime-token channel ──
+
+fn human_only_app(jwt_service: Arc<JwtService>, user_repo: Arc<dyn IUserRepository>) -> Router {
+    let state = AuthState {
+        jwt_service,
+        user_repo,
+        identity_mode: AuthIdentityMode::UserSession,
+        runtime_token_verifier: conv1_verifier(),
+    };
+    let echo = |body: String| async move { body };
+    Router::new()
+        .route(
+            "/api/conversations/{id}/confirmations/{call}/confirm",
+            axum::routing::post(echo),
+        )
+        .route("/api/conversations/{id}", axum::routing::patch(echo))
+        .route("/api/settings", axum::routing::patch(echo))
+        .route("/api/channel/pairings/approve", axum::routing::post(echo))
+        .route("/api/providers", axum::routing::post(echo))
+        .route_layer(middleware::from_fn_with_state(state, auth_middleware))
+}
+
+fn agent_call(method: &str, path: &str, body: &str) -> Request<Body> {
+    Request::builder()
+        .method(method)
+        .uri(path)
+        .header("x-aionui-runtime-token", "tok-1")
+        .header("x-aionui-user-id", "system_default_user")
+        .header("x-aionui-conversation-id", "conv-1")
+        .header(header::CONTENT_TYPE, "application/json")
+        .body(Body::from(body.to_owned()))
+        .unwrap()
+}
+
+#[tokio::test]
+async fn an_agent_cannot_call_a_human_only_route_but_the_user_can() {
+    let jwt_service = Arc::new(JwtService::new("middleware_test_secret".into()));
+    let token = jwt_service.sign("system_default_user", "system_default_user").unwrap();
+    let db = init_database_memory().await.unwrap();
+    let repo = Arc::new(SqliteUserRepository::new(db.pool().clone())) as Arc<dyn IUserRepository>;
+    let app = human_only_app(jwt_service, repo);
+
+    for (method, path, body) in [
+        (
+            "POST",
+            "/api/conversations/conv-1/confirmations/call-1/confirm",
+            r#"{"msg_id":"m","data":"allow"}"#,
+        ),
+        (
+            "PATCH",
+            "/api/conversations/conv-1",
+            r#"{"extra":{"session_mode":"bypassPermissions"}}"#,
+        ),
+        ("PATCH", "/api/settings", r#"{"cross_session_message_enabled":true}"#),
+        ("POST", "/api/channel/pairings/approve", r#"{"code":"1234"}"#),
+    ] {
+        let resp = app.clone().oneshot(agent_call(method, path, body)).await.unwrap();
+        assert_eq!(resp.status(), StatusCode::FORBIDDEN, "{method} {path}");
+        let json = json_body(resp).await;
+        assert_eq!(json["code"], "HUMAN_ONLY_ROUTE", "{method} {path}: {json}");
+    }
+
+    // The user's own session still answers the prompt.
+    let resp = app
+        .clone()
+        .oneshot(
+            Request::post("/api/conversations/conv-1/confirmations/call-1/confirm")
+                .header(header::AUTHORIZATION, format!("Bearer {token}"))
+                .body(Body::from("{}"))
+                .unwrap(),
+        )
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), StatusCode::OK);
+}
