+/// AionDX core-0019 (D-4): an agent's read of the client settings never includes the protected keys (the voice
+/// config, which holds the ElevenLabs API key). The rest of the response is passed on as it was.
+async fn strip_protected_keys(response: Response) -> Result<Response, ApiError> {
+    let (mut parts, body) = response.into_parts();
+    let bytes = axum::body::to_bytes(body, 16 * 1024 * 1024)
+        .await
+        .map_err(|_| ApiError::Internal("Settings response too large".into()))?;
+    let Ok(mut json) = serde_json::from_slice::<serde_json::Value>(&bytes) else {
+        return Ok(Response::from_parts(parts, axum::body::Body::from(bytes)));
+    };
+    if !crate::human_only::strip_protected_client_keys(&mut json) {
+        return Ok(Response::from_parts(parts, axum::body::Body::from(bytes)));
+    }
+    let out = serde_json::to_vec(&json).map_err(|_| ApiError::Internal("Settings response".into()))?;
+    parts.headers.remove(axum::http::header::CONTENT_LENGTH);
+    Ok(Response::from_parts(parts, axum::body::Body::from(out)))
+}
+
+/// AionDX core-0019: `403 HUMAN_ONLY_ROUTE` for a runtime-token call to a human-only route (`human_only.rs`). The body
+/// is read only for the two routes whose refusal depends on it, and is put back unchanged.
+async fn refuse_human_only(request: Request, conversation_id: &str) -> Result<Request, ApiError> {
+    let method = request.method().clone();
+    let path = request.uri().path().to_owned();
+    let (request, body) = if crate::human_only::needs_body(&method, &path) {
+        let (parts, body) = request.into_parts();
+        let bytes = axum::body::to_bytes(body, 4 * 1024 * 1024)
+            .await
+            .map_err(|_| ApiError::BadRequest("Request body too large".into()))?;
+        let parsed = serde_json::from_slice::<serde_json::Value>(&bytes).ok();
+        (Request::from_parts(parts, axum::body::Body::from(bytes)), parsed)
+    } else {
+        (request, None)
+    };
+    if let Some(what) = crate::human_only::refusal(&method, &path, body.as_ref()) {
+        tracing::warn!(%method, path, conversation_id, what, "refused an agent call to a human-only route");
+        return Err(ApiError::coded(
+            StatusCode::FORBIDDEN,
+            "HUMAN_ONLY_ROUTE",
+            format!("Only the user can do this ({what}); an agent's runtime token can't."),
+            None,
+        ));
+    }
+    Ok(request)
 }
 
