+//! AionDX core-0019: routes only a human may call (docs/sage/CONTRACT.md §7, SG-0).
+//!
+//! Every agent subprocess holds a conversation runtime token that authenticates as the full user, so an agent could
+//! call any route the desktop calls: answer its own permission prompt, switch its own chat to bypass mode, turn on
+//! cross-session messaging, change a password, approve a bot pairing. Those routes now refuse the runtime-token
+//! channel with `403 HUMAN_ONLY_ROUTE`. The user's own clients (a session, or local mode) are unaffected, and so is the
+//! mobile bridge, which calls the services directly.
+//!
+//! Routes that agent tools legitimately use stay open (the `aioncore config` CLI behind the aiondx-config skill, the
+//! loop tool, the identity and usage patches). Where such a route also carries a human-only field, only that field is
+//! refused: `cross_session_message_enabled` in `PATCH /api/settings`, and the permission-mode keys in
+//! `PATCH /api/conversations/{id}`'s `extra`.
+
+use axum::http::Method;
+use serde_json::Value;
+
+/// The keys of a conversation's `extra` that hold its permission mode: what the Claude stream proxy and the agents
+/// read as "bypass permissions" (core `session_agent.rs` `current_mode_id`, the `session_mode` runtime context).
+const MODE_KEYS: &[&str] = &["session_mode", "current_mode_id"];
+
+/// Settings fields only a human may change.
+const HUMAN_ONLY_SETTINGS: &[&str] = &["cross_session_message_enabled"];
+
+/// Why a runtime-token call is refused, or `None` when it may proceed. `body` is the parsed JSON body, given only
+/// for the routes `needs_body` names.
+pub fn refusal(method: &Method, path: &str, body: Option<&Value>) -> Option<&'static str> {
+    let path = path.split('?').next().unwrap_or_default();
+    let segs: Vec<&str> = path.trim_matches('/').split('/').collect();
+    match (method, segs.as_slice()) {
+        // answering a permission card or a question
+        (&Method::POST, ["api", "conversations", _, "confirmations", _, "confirm"]) => {
+            Some("answering a permission prompt")
+        }
+        (&Method::POST, ["api", "conversations", _, "asks", _, "answer"]) => Some("answering a question card"),
+        // the permission mode, which decides what is asked at all
+        (&Method::PUT, ["api", "conversations", _, "config-options", _]) => Some("changing a chat's session options"),
+        (&Method::PUT, ["api", "teams", _, "conversations", _, "config-options", _]) => {
+            Some("changing a team chat's session options")
+        }
+        (&Method::POST, ["api", "teams", _, "session-mode"]) => Some("changing a team's permission mode"),
+        (&Method::PATCH, ["api", "conversations", _]) => {
+            let extra = body.and_then(|b| b.get("extra")).and_then(Value::as_object)?;
+            MODE_KEYS
+                .iter()
+                .any(|k| extra.contains_key(*k))
+                .then_some("changing a chat's permission mode")
+        }
+        (&Method::PATCH, ["api", "settings"]) => {
+            let b = body.and_then(Value::as_object)?;
+            HUMAN_ONLY_SETTINGS
+                .iter()
+                .any(|k| b.contains_key(*k))
+                .then_some("changing cross-session messaging")
+        }
+        // the user's credentials
+        (&Method::POST, ["api", "auth", "change-password"]) => Some("changing the password"),
+        (
+            &Method::POST,
+            [
+                "api",
+                "webui",
+                "change-password" | "change-username" | "reset-password" | "generate-qr-token",
+            ],
+        ) => Some("changing the web login"),
+        // letting someone outside in: messaging-platform bots and their users
+        (&Method::POST, ["api", "channel", "pairings", "approve" | "reject"]) => Some("deciding a bot pairing"),
+        (&Method::POST, ["api", "channel", "users", "revoke"]) => Some("revoking a bot user"),
+        (&Method::POST, ["api", "channel", "plugins", "enable" | "disable"]) => Some("switching a bot on or off"),
+        // what an extension may do
+        (&Method::POST, ["api", "extensions", "permissions" | "risk-level"]) => {
+            Some("granting an extension permissions")
+        }
+        _ => None,
+    }
+}
+
+/// Routes whose refusal depends on the body (the rest are decided by method and path alone).
+pub fn needs_body(method: &Method, path: &str) -> bool {
+    let path = path.split('?').next().unwrap_or_default();
+    let segs: Vec<&str> = path.trim_matches('/').split('/').collect();
+    matches!(
+        (method, segs.as_slice()),
+        (&Method::PATCH, ["api", "conversations", _]) | (&Method::PATCH, ["api", "settings"])
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn refused(method: Method, path: &str, body: Option<Value>) -> bool {
+        refusal(&method, path, body.as_ref()).is_some()
+    }
+
+    #[test]
+    fn prompts_and_modes_are_human_only() {
+        assert!(refused(
+            Method::POST,
+            "/api/conversations/c1/confirmations/call-1/confirm",
+            None
+        ));
+        assert!(refused(Method::POST, "/api/conversations/c1/asks/req-1/answer", None));
+        assert!(refused(Method::PUT, "/api/conversations/c1/config-options/mode", None));
+        assert!(
+            refused(Method::PUT, "/api/conversations/c1/config-options/model", None),
+            "the whole route"
+        );
+        assert!(refused(
+            Method::PUT,
+            "/api/teams/t1/conversations/c1/config-options/mode",
+            None
+        ));
+        assert!(refused(Method::POST, "/api/teams/t1/session-mode", None));
+        // reading the cards stays open
+        assert!(!refused(Method::GET, "/api/conversations/c1/confirmations", None));
+    }
+
+    #[test]
+    fn a_conversation_patch_is_refused_only_for_mode_keys() {
+        let path = "/api/conversations/c1";
+        assert!(needs_body(&Method::PATCH, path));
+        assert!(
+            !refused(Method::PATCH, path, Some(json!({ "name": "Renamed" }))),
+            "the config CLI's rename"
+        );
+        assert!(!refused(
+            Method::PATCH,
+            path,
+            Some(json!({ "extra": { "workspace": "C:/w" } }))
+        ));
+        assert!(refused(
+            Method::PATCH,
+            path,
+            Some(json!({ "extra": { "session_mode": "bypassPermissions" } }))
+        ));
+        assert!(refused(
+            Method::PATCH,
+            path,
+            Some(json!({ "name": "x", "extra": { "current_mode_id": "yolo" } }))
+        ));
+        assert!(!refused(Method::PATCH, path, None), "no JSON body: nothing to refuse");
+    }
+
+    #[test]
+    fn settings_are_refused_only_for_cross_session() {
+        assert!(needs_body(&Method::PATCH, "/api/settings"));
+        assert!(!refused(
+            Method::PATCH,
+            "/api/settings",
+            Some(json!({ "language": "en" }))
+        ));
+        assert!(refused(
+            Method::PATCH,
+            "/api/settings",
+            Some(json!({ "cross_session_message_enabled": true }))
+        ));
+        assert!(refused(
+            Method::PATCH,
+            "/api/settings",
+            Some(json!({ "language": "en", "cross_session_message_enabled": false }))
+        ));
+        // client settings stay open (the identity, usage and loop patches write them)
+        assert!(!refused(
+            Method::PUT,
+            "/api/settings/client",
+            Some(json!({ "theme.activeId": "x" }))
+        ));
+    }
+
+    #[test]
+    fn credentials_bots_and_extension_grants_are_human_only() {
+        for (m, p) in [
+            (Method::POST, "/api/auth/change-password"),
+            (Method::POST, "/api/webui/change-password"),
+            (Method::POST, "/api/webui/change-username"),
+            (Method::POST, "/api/webui/reset-password"),
+            (Method::POST, "/api/webui/generate-qr-token"),
+            (Method::POST, "/api/channel/pairings/approve"),
+            (Method::POST, "/api/channel/pairings/reject"),
+            (Method::POST, "/api/channel/users/revoke"),
+            (Method::POST, "/api/channel/plugins/enable"),
+            (Method::POST, "/api/channel/plugins/disable"),
+            (Method::POST, "/api/extensions/permissions"),
+            (Method::POST, "/api/extensions/risk-level"),
+        ] {
+            assert!(refused(m.clone(), p, None), "{m} {p}");
+        }
+    }
+
+    #[test]
+    fn agent_tools_keep_their_routes() {
+        // aioncore config (aiondx-config), the loop tool's MCP row, identity themes, usage records, cron, sends
+        for (m, p) in [
+            (Method::POST, "/api/providers"),
+            (Method::PUT, "/api/providers/p1"),
+            (Method::POST, "/api/mcp/servers"),
+            (Method::POST, "/api/mcp/servers/m1/toggle"),
+            (Method::PUT, "/api/settings/client"),
+            (Method::POST, "/api/assistants"),
+            (Method::POST, "/api/cron/jobs"),
+            (Method::POST, "/api/skills/import"),
+            (Method::POST, "/api/conversations/c1/messages"),
+            (Method::POST, "/api/runtime/team-tools/call"),
+            (Method::POST, "/api/runtime/session-messages/send"),
+            (Method::POST, "/api/teams/t1/agents/s1/messages"),
+        ] {
+            assert!(!refused(m.clone(), p, None), "{m} {p}");
+        }
+    }
+}
