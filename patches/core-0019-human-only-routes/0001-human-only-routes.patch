+// ── AionDX core-0019 (D-4): agents can neither read nor write the voice config (the ElevenLabs key) ──
+
+fn client_settings_app(jwt_service: Arc<JwtService>, user_repo: Arc<dyn IUserRepository>) -> Router {
+    let state = AuthState {
+        jwt_service,
+        user_repo,
+        identity_mode: AuthIdentityMode::UserSession,
+        runtime_token_verifier: conv1_verifier(),
+    };
+    // the real handler's shape: {"success": true, "data": {key: value}}, all keys or the ?keys= ones
+    let read = |axum::extract::RawQuery(q): axum::extract::RawQuery| async move {
+        let all = serde_json::json!({
+            "aiondx.voice.config": { "apiKey": "sk-eleven-secret", "voiceId": "v1" },
+            "theme.activeId": "dark"
+        });
+        let data = match q.as_deref().and_then(|q| q.strip_prefix("keys=")) {
+            Some(keys) => serde_json::Value::Object(
+                all.as_object()
+                    .unwrap()
+                    .iter()
+                    .filter(|(k, _)| keys.split(',').any(|w| w == k.as_str()))
+                    .map(|(k, v)| (k.clone(), v.clone()))
+                    .collect(),
+            ),
+            None => all,
+        };
+        axum::Json(serde_json::json!({ "success": true, "data": data }))
+    };
+    Router::new()
+        .route(
+            "/api/settings/client",
+            get(read).put(|body: String| async move { body }),
+        )
+        .route_layer(middleware::from_fn_with_state(state, auth_middleware))
+}
+
+#[tokio::test]
+async fn an_agent_never_sees_or_sets_the_voice_config_but_the_user_does() {
+    let jwt_service = Arc::new(JwtService::new("middleware_test_secret".into()));
+    let token = jwt_service.sign("system_default_user", "system_default_user").unwrap();
+    let db = init_database_memory().await.unwrap();
+    let repo = Arc::new(SqliteUserRepository::new(db.pool().clone())) as Arc<dyn IUserRepository>;
+    let app = client_settings_app(jwt_service, repo);
+
+    // the config CLI's read-all: everything except the voice config
+    let resp = app
+        .clone()
+        .oneshot(agent_call("GET", "/api/settings/client", ""))
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), StatusCode::OK);
+    let json = json_body(resp).await;
+    assert_eq!(json["data"]["theme.activeId"], "dark");
+    assert!(json["data"].get("aiondx.voice.config").is_none(), "{json}");
+    assert!(!json.to_string().contains("sk-eleven-secret"));
+
+    // a direct read of the key: absent
+    let resp = app
+        .clone()
+        .oneshot(agent_call("GET", "/api/settings/client?keys=aiondx.voice.config", ""))
+        .await
+        .unwrap();
+    let json = json_body(resp).await;
+    assert_eq!(json["data"], serde_json::json!({}), "{json}");
+
+    // a write of the key: refused; other keys: fine
+    let resp = app
+        .clone()
+        .oneshot(agent_call(
+            "PUT",
+            "/api/settings/client",
+            r#"{"aiondx.voice.config":{"apiKey":"attacker"}}"#,
+        ))
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), StatusCode::FORBIDDEN);
+    assert_eq!(json_body(resp).await["code"], "HUMAN_ONLY_ROUTE");
+    let resp = app
+        .clone()
+        .oneshot(agent_call(
+            "PUT",
+            "/api/settings/client",
+            r#"{"theme.activeId":"light"}"#,
+        ))
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), StatusCode::OK);
+
+    // the user's session (the voice UI): reads and writes it
+    let resp = app
+        .clone()
+        .oneshot(
+            Request::get("/api/settings/client?keys=aiondx.voice.config")
+                .header(header::AUTHORIZATION, format!("Bearer {token}"))
+                .body(Body::empty())
+                .unwrap(),
+        )
+        .await
+        .unwrap();
+    assert_eq!(
+        json_body(resp).await["data"]["aiondx.voice.config"]["apiKey"],
+        "sk-eleven-secret"
+    );
+    let resp = app
+        .oneshot(
+            Request::put("/api/settings/client")
+                .header(header::AUTHORIZATION, format!("Bearer {token}"))
+                .body(Body::from(r#"{"aiondx.voice.config":{"apiKey":"new"}}"#))
+                .unwrap(),
+        )
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), StatusCode::OK);
+}
