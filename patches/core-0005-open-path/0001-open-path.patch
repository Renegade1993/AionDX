+
+    #[test]
+    fn program_files_are_found_by_extension() {
+        assert!(is_program_file(Path::new("C:\\x\\Install Game (test build).exe")));
+        assert!(is_program_file(Path::new("setup.MSI")));
+        assert!(!is_program_file(Path::new("notes.txt")));
+        assert!(!is_program_file(Path::new("folder")));
