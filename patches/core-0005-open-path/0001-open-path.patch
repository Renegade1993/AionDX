+/// AionDX core-0005: a path as a person or an agent writes it, made into one Windows can open.
+fn clean_user_path(raw: &str) -> String {
+    let mut s = raw.trim().trim_matches('"').to_owned();
+    if cfg!(windows) {
+        s = s.replace('/', "\\");
+        if let Some(rest) = s.strip_prefix("\\\\?\\UNC\\") {
+            s = format!("\\\\{rest}");
+        } else if let Some(rest) = s.strip_prefix("\\\\?\\") {
+            s = rest.to_owned();
+        }
+        let b = s.as_bytes();
+        if b.len() >= 3 && b[0] == b'\\' && b[1].is_ascii_alphabetic() && b[2] == b':' {
+            s.remove(0);
+        }
+    }
+    s
+}
+
+/// AionDX core-0005: files that run when opened. A link to one shows it in its folder instead of starting it.
+fn is_program_file(path: &Path) -> bool {
+    const PROGRAMS: &[&str] = &[
+        "exe", "msi", "msix", "msp", "appx", "bat", "cmd", "com", "scr", "ps1", "vbs", "vbe", "js", "jse", "wsf", "hta", "lnk",
+        "reg", "jar", "cpl",
+    ];
+    path.extension()
+        .and_then(|e| e.to_str())
+        .map(|e| PROGRAMS.contains(&e.to_ascii_lowercase().as_str()))
+        .unwrap_or(false)
+}
+
+/// AionDX core-0005: Explorer is given the argument text exactly as Explorer wants it (`/select,"path"`); a path with a space or a
+/// "!" in it must not be re-quoted by the argument builder.
+#[cfg(windows)]
+#[allow(clippy::disallowed_types)]
+fn spawn_explorer(raw_args: &str) -> Result<(), ShellError> {
+    use std::os::windows::process::CommandExt;
+    const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+    std::process::Command::new("explorer.exe")
+        .creation_flags(CREATE_NO_WINDOW)
+        .raw_arg(raw_args)
+        .spawn()
+        .map(|_| ())
+        .map_err(|e| ShellError::CommandFailed(format!("explorer: {e}")))
+}
+
+#[cfg(windows)]
+fn open_folder_here(path: &Path) -> Result<(), ShellError> {
+    spawn_explorer(&format!("\"{}\"", path.to_string_lossy()))
+}
+
+#[cfg(windows)]
+fn reveal_here(path: &Path) -> Result<(), ShellError> {
+    spawn_explorer(&format!("/select,\"{}\"", path.to_string_lossy()))
+}
+
+#[cfg(not(windows))]
+fn open_folder_here(path: &Path) -> Result<(), ShellError> {
+    open::that_detached(path).map_err(|e| ShellError::CommandFailed(format!("open: {e}")))
+}
+
+#[cfg(not(windows))]
+fn reveal_here(path: &Path) -> Result<(), ShellError> {
+    let parent = path.parent().unwrap_or(path);
+    open::that_detached(parent).map_err(|e| ShellError::CommandFailed(format!("open: {e}")))
+}
