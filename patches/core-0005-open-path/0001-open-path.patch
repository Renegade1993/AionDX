+    /// AionDX core-0005: open a path the way a person clicking a link to it means it. A folder opens in Explorer; a program or
+    /// installer is shown selected in its folder (it is not run unless `action` is "run"); anything else opens in its own program;
+    /// "reveal" shows any file selected in its folder. The path may use either slash, a `\\?\` prefix, or a leading slash before
+    /// the drive letter, and may hold spaces, "!" and anything else a Windows name can. Answers what was done.
+    pub async fn open_path(&self, raw: &str, action: &str) -> Result<&'static str, ShellError> {
+        let cleaned = clean_user_path(raw);
+        let path = Path::new(&cleaned);
+        let meta = std::fs::metadata(path).map_err(|_| ShellError::FileNotFound(raw.to_owned()))?;
+        if meta.is_dir() {
+            open_folder_here(path)?;
+            return Ok("opened_folder");
+        }
+        let reveal = action == "reveal" || (action != "run" && is_program_file(path));
+        if reveal {
+            reveal_here(path)?;
+            return Ok("revealed");
+        }
+        self.opener.open_detached(&path.to_string_lossy())?;
+        Ok(if action == "run" { "ran" } else { "opened" })
+    }
