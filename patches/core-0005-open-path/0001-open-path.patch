+/// AionDX core-0005: what a link to a path should do (see `ShellService::open_path`).
+#[derive(Debug, Clone, serde::Deserialize)]
+struct OpenPathRequest {
+    path: String,
+    #[serde(default)]
+    action: Option<String>,
+}
+
+async fn open_path(
+    State(state): State<ShellRouterState>,
+    body: Result<Json<OpenPathRequest>, axum::extract::rejection::JsonRejection>,
+) -> Result<Json<ApiResponse<serde_json::Value>>, ApiError> {
+    let Json(req) = body.map_err(ApiError::from)?;
+    let did = state
+        .shell_service
+        .open_path(&req.path, req.action.as_deref().unwrap_or("auto"))
+        .await?;
+    Ok(Json(ApiResponse::ok(serde_json::json!({ "did": did }))))
+}
