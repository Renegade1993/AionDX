+    #[cfg(windows)]
+    #[test]
+    fn user_paths_are_cleaned_for_windows() {
+        assert_eq!(clean_user_path("C:/Work/Game/! Outbound/"), "C:\\Work\\Game\\! Outbound\\");
+        assert_eq!(clean_user_path("/C:/a b/c"), "C:\\a b\\c");
+        assert_eq!(clean_user_path("\\\\?\\C:\\a"), "C:\\a");
+        assert_eq!(clean_user_path("\\\\?\\UNC\\srv\\share"), "\\\\srv\\share");
+        assert_eq!(clean_user_path("  \"C:\\a\"  "), "C:\\a");
+    }
+}
