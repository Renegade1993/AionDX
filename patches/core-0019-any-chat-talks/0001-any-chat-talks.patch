+        .map_err(to_api_error)?;
+    let block = state
+        .service
+        .sessions_block(&user.id, &current, &request.ids)
+        .await
+        .map_err(to_api_error)?;
+    Ok(Json(ApiResponse::ok(SessionsBlockResponse { block })))
+}
