+/// AionDX core-0019: the `[[AION_SESSIONS]]` block for chats picked with @@ or @@@ in a team chat's box. AionUi's team send routes carry
+/// no references, so AionDX's page asks for the block here and sends it with the message. Built by the same code as a solo chat's
+/// send boundary, so the agent reads the same block either way.
+async fn sessions_block(
+    State(state): State<SessionMessageRouterState>,
+    Extension(user): Extension<CurrentUser>,
+    Json(request): Json<SessionsBlockRequest>,
+) -> Result<Json<ApiResponse<SessionsBlockResponse>>, aionui_common::ApiError> {
+    let current = request.current_conversation_id.clone().unwrap_or_default();
+    state
