+    // AionDX core-0025: a team goes back to plain chats with nothing deleted, and a plain chat becomes a team's lead in place.
+    #[tokio::test]
+    async fn dissolve_then_make_a_team_from_the_former_lead_in_place() {
+        let (svc, _repo, _task_manager, conv_repo) = setup_with_factory_metadata_team_repo_and_conversation_repo();
+        let created = svc
+            .create_team("user-test", single_agent_team_request("Round Trip"))
+            .await
+            .unwrap();
+        let lead_conv = created
+            .assistants
+            .iter()
+            .find(|a| a.role == "lead")
+            .map(|a| a.conversation_id.clone())
+            .expect("a lead");
+        assert_eq!(conv_repo.get_extra(&lead_conv).unwrap()["teamId"], created.id.as_str());
+
+        let out = svc.dissolve_team("user-test", &created.id).await.unwrap();
+        assert_eq!(out.members.len(), 1);
+        assert_eq!(out.members[0].conversation_id, lead_conv);
+        let extra = conv_repo.get_extra(&lead_conv).expect("the conversation is kept");
+        assert!(extra["teamId"].is_null(), "the team marker is gone: {extra}");
+        assert!(svc.get_team("user-test", &created.id).await.is_err(), "the team row is gone");
+
+        let other = svc
+            .create_team_from_conversation(
+                "user-other",
+                CreateTeamFromConversationRequest { conversation_id: lead_conv.clone(), name: "Not yours".into(), lead_name: None },
+            )
+            .await;
+        assert!(other.is_err(), "another user's chat is refused");
+
+        let made = svc
+            .create_team_from_conversation(
+                "user-test",
+                CreateTeamFromConversationRequest { conversation_id: lead_conv.clone(), name: "Again".into(), lead_name: Some("Boss".into()) },
+            )
+            .await
+            .unwrap();
+        assert_eq!(made.name, "Again");
+        assert_eq!(made.assistants.len(), 1);
+        assert_eq!(made.assistants[0].conversation_id, lead_conv, "the same chat leads");
+        assert_eq!(made.assistants[0].role, "lead");
+        let extra = conv_repo.get_extra(&lead_conv).unwrap();
+        assert_eq!(extra["teamId"], made.id.as_str());
+        assert_eq!(extra["role"], "lead");
+
+        let twice = svc
+            .create_team_from_conversation(
+                "user-test",
+                CreateTeamFromConversationRequest { conversation_id: lead_conv.clone(), name: "Twice".into(), lead_name: None },
+            )
+            .await;
+        assert!(twice.is_err(), "a chat already in a team is refused");
+    }
