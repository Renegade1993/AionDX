+    /// AionDX core-0025: an existing solo conversation becomes the lead of a new team, in place: same conversation id,
+    /// history, folder, agent and model. Its `extra` gets the team markers a new lead's has (teamId, slot_id, role);
+    /// nothing else in it changes. The agent process, if running, is stopped so its next start comes up with the team
+    /// tools (they are given at launch); its Claude session is resumed as on any restart. Members are added afterwards.
+    pub async fn create_team_from_conversation(
+        &self,
+        user_id: &str,
+        req: CreateTeamFromConversationRequest,
+    ) -> Result<TeamResponse, TeamError> {
+        let conversation_id = req.conversation_id.trim().to_owned();
+        let name = req.name.trim().to_owned();
+        if conversation_id.is_empty() {
+            return Err(TeamError::InvalidRequest("conversation_id is required".into()));
+        }
+        if name.is_empty() {
+            return Err(TeamError::InvalidRequest("a team name is required".into()));
+        }
+        let (conv_name, extra) = self
+            .conversation_port
+            .conversation_name_and_extra(user_id, &conversation_id)
+            .await?
+            .ok_or_else(|| TeamError::InvalidRequest(format!("conversation {conversation_id} was not found")))?;
+        if extra
+            .get("teamId")
+            .and_then(serde_json::Value::as_str)
+            .is_some_and(|v| !v.trim().is_empty())
+        {
+            return Err(TeamError::InvalidRequest("that conversation already belongs to a team".into()));
+        }
+        let field = |k: &str| {
+            extra
+                .get(k)
+                .and_then(serde_json::Value::as_str)
+                .map(str::trim)
+                .filter(|v| !v.is_empty())
+                .map(str::to_owned)
+        };
+        let backend = field("backend").ok_or_else(|| {
+            TeamError::InvalidRequest("that conversation has no agent backend, so it cannot lead a team".into())
+        })?;
+        let workspace = field("workspace").ok_or_else(|| {
+            TeamError::InvalidRequest("that conversation has no working folder, so it cannot lead a team".into())
+        })?;
+        let model = field("current_model_id").unwrap_or_default();
+        let assistant_id = match self.conversation_port.conversation_assistant_id(&conversation_id).await {
+            Ok(Some(id)) => Some(id),
+            _ => field("assistant_id").or_else(|| field("agent_id")),
+        };
+        let lead_name = req
+            .lead_name
+            .as_deref()
+            .map(str::trim)
+            .filter(|v| !v.is_empty())
+            .map(str::to_owned)
+            .unwrap_or_else(|| if conv_name.trim().is_empty() { "Lead".to_owned() } else { conv_name.trim().to_owned() });
+
+        let team_id = generate_id();
+        let slot_id = generate_id();
+        let now = now_ms();
+        let lead = TeamAgent {
+            slot_id: slot_id.clone(),
+            name: lead_name,
+            role: TeammateRole::Lead,
+            conversation_id: conversation_id.clone(),
+            backend,
+            model,
+            assistant_id,
+            status: None,
+            conversation_type: None,
+            cli_path: None,
+        };
+        // Mark the conversation first: a team row whose lead is not marked would be refused by the runtime.
+        self.conversation_port
+            .patch_runtime_config(
+                &conversation_id,
+                serde_json::json!({ "teamId": team_id, "slot_id": slot_id, "role": TeammateRole::Lead.to_string() }),
+            )
+            .await?;
+        let agents = vec![lead];
+        let (project_id, folder_id) = self.resolve_binding_best_effort(user_id, &workspace).await;
+        let row = TeamRow {
+            id: team_id.clone(),
+            user_id: user_id.to_owned(),
+            name: name.clone(),
+            workspace: workspace.clone(),
+            workspace_mode: "shared".into(),
+            agents: serde_json::to_string(&agents)?,
+            lead_agent_id: Some(slot_id.clone()),
+            session_mode: None,
+            agents_version: "1.0.1".into(),
+            created_at: now,
+            updated_at: now,
+            project_id,
+            folder_id,
+        };
+        if let Err(e) = self.repo.create_team(&row).await {
+            let _ = self
+                .conversation_port
+                .patch_runtime_config(&conversation_id, serde_json::json!({ "teamId": null, "slot_id": null, "role": null }))
+                .await;
+            return Err(e.into());
+        }
+        // The running process (if any) has no team tools: end it, so the next message starts it as the lead.
+        let _ = tokio::time::timeout(
+            std::time::Duration::from_secs(3),
+            self.task_manager.kill_and_wait(&conversation_id, Some(AgentKillReason::RuntimeRestart)),
+        )
+        .await;
+        let team = Team {
+            id: team_id,
+            name,
+            workspace,
+            agents,
+            lead_agent_id: Some(slot_id),
+            created_at: now,
+            updated_at: now,
+        };
+        info!(team_id = %team.id, conversation_id = %conversation_id, "Team created from a conversation (core-0025)");
+        self.broadcast_team_created(user_id, &team.id, &team.name);
+        self.build_team_response(user_id, &team).await
+    }
+
+    /// AionDX core-0025: a team goes back to plain conversations. Its runtime and every member's process stop; each
+    /// member's conversation (the lead's too) keeps its id, history and folder and loses only the team markers; the
+    /// team's mailbox, tasks and row go. Nothing is deleted from any conversation. Archiving is the caller's choice.
+    pub async fn dissolve_team(&self, user_id: &str, team_id: &str) -> Result<DissolveTeamResponse, TeamError> {
+        let team = self.load_owned_team(user_id, team_id).await?;
+        self.stop_team_runtime_and_agents(team_id, &team, AgentKillReason::TeamDeleted)
+            .await;
+        let mut members = Vec::with_capacity(team.agents.len());
+        for agent in &team.agents {
+            self.conversation_port
+                .patch_runtime_config(
+                    &agent.conversation_id,
+                    serde_json::json!({ "teamId": null, "slot_id": null, "role": null }),
+                )
+                .await?;
+            members.push(DissolvedTeamMember {
+                slot_id: agent.slot_id.clone(),
+                name: agent.name.clone(),
+                role: agent.role.to_string(),
+                conversation_id: agent.conversation_id.clone(),
+            });
+        }
+        self.repo.delete_mailbox_by_team(user_id, team_id).await?;
+        self.repo.delete_tasks_by_team(user_id, team_id).await?;
+        self.repo.delete_team(user_id, team_id).await?;
+        self.remove_team_order_row(user_id, team_id).await;
+        self.add_agent_locks.remove(team_id);
+        info!(team_id = %team_id, members = members.len(), "Team dissolved into plain conversations (core-0025)");
+        self.broadcast_team_removed(user_id, team_id);
+        Ok(DissolveTeamResponse { team_id: team_id.to_owned(), members })
+    }
