+/// Longest question or reply preview an anchor carries (UTF-16 units, as the page counts them).
+const ANCHOR_PREVIEW_MAX_LEN: usize = 120;
+
+/// One tick of the chat's anchor rail: a user turn, with a short preview of the question and of the first reply.
+#[derive(Debug, Clone, PartialEq, Eq, serde::Serialize)]
+pub struct ConversationAnchor {
+    pub message_id: String,
+    pub msg_id: Option<String>,
+    pub question: String,
+    pub answer: String,
+}
+
+/// Body of `GET /api/conversations/:id/anchors`.
+#[derive(Debug, Clone, serde::Serialize)]
+pub struct ConversationAnchorsResponse {
+    pub items: Vec<ConversationAnchor>,
+}
+
+/// A visible text message reduced to what the rail needs.
+struct AnchorSource {
+    id: String,
+    msg_id: Option<String>,
+    from_user: bool,
+    preview: String,
+}
+
+/// The text of a message, whitespace collapsed and cut to the preview length. `None` for anything that is not a
+/// text message with words in it. Same rules as the page's `normalizeText` and `truncate`.
+fn anchor_preview(content: &str) -> Option<String> {
+    let value: serde_json::Value = serde_json::from_str(content).ok()?;
+    let text = value.get("content")?.as_str()?;
+    let normalized = text.split_whitespace().collect::<Vec<_>>().join(" ");
+    if normalized.is_empty() {
+        return None;
+    }
+    let total: usize = normalized.chars().map(char::len_utf16).sum();
+    if total <= ANCHOR_PREVIEW_MAX_LEN {
+        return Some(normalized);
+    }
+    let mut out = String::new();
+    let mut used = 0usize;
+    for ch in normalized.chars() {
+        let width = ch.len_utf16();
+        if used + width > ANCHOR_PREVIEW_MAX_LEN - 1 {
+            break;
+        }
+        out.push(ch);
+        used += width;
+    }
+    out.push('…');
+    Some(out)
+}
+
+/// Turns, oldest first: each user message starts one, and the first reply after it is its answer.
+fn fold_anchors(sources: impl IntoIterator<Item = AnchorSource>) -> Vec<ConversationAnchor> {
+    let mut anchors: Vec<ConversationAnchor> = Vec::new();
+    let mut current: Option<ConversationAnchor> = None;
+    for source in sources {
+        if source.from_user {
+            if let Some(done) = current.take() {
+                anchors.push(done);
+            }
+            current = Some(ConversationAnchor {
+                message_id: source.id,
+                msg_id: source.msg_id,
+                question: source.preview,
+                answer: String::new(),
+            });
+        } else if let Some(open) = current.as_mut()
+            && open.answer.is_empty()
+        {
+            open.answer = source.preview;
+        }
+    }
+    if let Some(done) = current {
+        anchors.push(done);
+    }
+    anchors
+}
+
+impl ConversationService {
+    /// The anchors of a conversation's whole history in one answer.
+    ///
+    /// The chat page's side rail needs one tick per user turn, however long the chat is. It used to get them by
+    /// downloading every message in pages of 200 (177 requests, 48 MB, for a chat of 35,000 messages) and
+    /// reading the turns out in the browser. This walks the same pages inside AionCore and returns only the
+    /// previews, a few hundred KB.
+    pub async fn list_anchors(
+        &self,
+        user_id: &str,
+        conversation_id: &str,
+    ) -> Result<ConversationAnchorsResponse, ConversationError> {
+        self.conversation_repo
+            .get(user_id, conversation_id)
+            .await?
+            .ok_or_else(|| ConversationError::NotFound {
+                id: conversation_id.to_owned(),
+            })?;
+
+        // Pages arrive newest first; each one is oldest first inside.
+        let mut pages: Vec<Vec<AnchorSource>> = Vec::new();
+        let mut direction = MessagePageDirection::InitialLatest;
+        loop {
+            let page = self
+                .conversation_repo
+                .list_messages_page(
+                    user_id,
+                    conversation_id,
+                    &MessagePageParams {
+                        limit: MAX_MESSAGE_PAGE_LIMIT,
+                        direction,
+                    },
+                )
+                .await?;
+            let oldest = page.items.first().map(MessagePageCursor::from);
+            let sources = page
+                .items
+                .iter()
+                .filter(|row| !row.hidden && row.r#type == "text")
+                .filter_map(|row| {
+                    let from_user = match row.position.as_deref() {
+                        Some("right") => true,
+                        Some("left") => false,
+                        _ => return None,
+                    };
+                    Some(AnchorSource {
+                        id: row.id.clone(),
+                        msg_id: row.msg_id.clone(),
+                        from_user,
+                        preview: anchor_preview(&row.content)?,
+                    })
+                })
+                .collect::<Vec<_>>();
+            pages.push(sources);
+            match (page.has_more_before, oldest) {
+                (true, Some(cursor)) => direction = MessagePageDirection::Before { cursor },
+                _ => break,
+            }
+        }
+
+        let items = fold_anchors(pages.into_iter().rev().flatten());
+        Ok(ConversationAnchorsResponse { items })
+    }
+}
