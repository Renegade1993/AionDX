+#[cfg(test)]
+mod anchor_tests {
+    use super::*;
+
+    fn source(id: &str, from_user: bool, text: &str) -> AnchorSource {
+        AnchorSource {
+            id: id.to_owned(),
+            msg_id: Some(format!("m-{id}")),
+            from_user,
+            preview: text.to_owned(),
+        }
+    }
+
+    #[test]
+    fn preview_collapses_whitespace_and_skips_empty_or_non_text() {
+        assert_eq!(
+            anchor_preview(r#"{"content":"  hello \n\n  there\tworld "}"#).as_deref(),
+            Some("hello there world")
+        );
+        assert_eq!(anchor_preview(r#"{"content":"  \n "}"#), None);
+        assert_eq!(anchor_preview(r#"{"content":42}"#), None);
+        assert_eq!(anchor_preview(r#"{"other":"x"}"#), None);
+        assert_eq!(anchor_preview("not json"), None);
+    }
+
+    #[test]
+    fn preview_is_cut_at_120_units_with_an_ellipsis() {
+        let long = "a".repeat(300);
+        let out = anchor_preview(&format!(r#"{{"content":"{long}"}}"#)).unwrap();
+        assert_eq!(out.chars().count(), 120);
+        assert!(out.ends_with('…'));
+        assert_eq!(&out[..119], "a".repeat(119));
+        let exact = "b".repeat(120);
+        assert_eq!(anchor_preview(&format!(r#"{{"content":"{exact}"}}"#)).unwrap(), exact);
+    }
+
+    #[test]
+    fn preview_counts_utf16_units_like_the_page() {
+        // 119 two-unit characters would be 238 units: the cut lands after 59 of them (118 units) and the ellipsis.
+        let wide = "😀".repeat(119);
+        let out = anchor_preview(&format!(r#"{{"content":"{wide}"}}"#)).unwrap();
+        assert_eq!(out.chars().filter(|c| *c == '😀').count(), 59);
+        assert!(out.ends_with('…'));
+    }
+
+    #[test]
+    fn each_user_message_starts_a_turn_and_the_first_reply_is_its_answer() {
+        let anchors = fold_anchors(vec![
+            source("a", false, "reply before any question"),
+            source("u1", true, "first question"),
+            source("r1", false, "first reply"),
+            source("r2", false, "second reply of the same turn"),
+            source("u2", true, "second question"),
+            source("u3", true, "third question, no reply yet"),
+        ]);
+        let got: Vec<(&str, &str, &str)> = anchors
+            .iter()
+            .map(|a| (a.message_id.as_str(), a.question.as_str(), a.answer.as_str()))
+            .collect();
+        assert_eq!(
+            got,
+            vec![
+                ("u1", "first question", "first reply"),
+                ("u2", "second question", ""),
+                ("u3", "third question, no reply yet", ""),
+            ]
+        );
+        assert_eq!(anchors[0].msg_id.as_deref(), Some("m-u1"));
+    }
+
+    #[test]
+    fn no_user_message_means_no_anchor() {
+        assert!(fold_anchors(vec![source("a", false, "only a reply")]).is_empty());
+        assert!(fold_anchors(Vec::new()).is_empty());
+    }
+}
