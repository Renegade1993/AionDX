+// ============================================================
+// AionDX core-0014: AuthChannel marks how a request authenticated
+// ============================================================
+
+fn channel_echo_app(
+    jwt_service: Arc<JwtService>,
+    user_repo: Arc<dyn IUserRepository>,
+    runtime_token_verifier: Option<Arc<dyn IRuntimeTokenVerifier>>,
+) -> Router {
+    let state = AuthState {
+        jwt_service,
+        user_repo,
+        identity_mode: AuthIdentityMode::UserSession,
+        runtime_token_verifier,
+    };
+    Router::new()
+        .route(
+            "/whoami",
+            get(|channel: axum::Extension<AuthChannel>| async move { format!("{:?}", channel.0) }),
+        )
+        .route_layer(middleware::from_fn_with_state(state, auth_middleware))
+}
+
+fn conv1_verifier() -> Option<Arc<dyn IRuntimeTokenVerifier>> {
+    Some(Arc::new(MatchVerifier {
+        token: "tok-1",
+        user_id: "system_default_user",
+        conversation_id: "conv-1",
+    }))
+}
