@@ -0,0 +1,295 @@
+#![allow(clippy::disallowed_types)] // HTTP middleware: maps to ApiError at the boundary
+
+//! AionDX core-0014: lead-only team lifecycle routes over HTTP.
+//!
+//! The MCP tools behind spawn, shutdown, interrupt, rename and clear-context
+//! are lead-only, but their HTTP twins checked only that the user owns the
+//! team. Every agent subprocess holds a conversation-runtime token that
+//! authenticates as the full user, so a non-lead teammate could call those
+//! routes directly and skip the rule. This layer closes that: a caller on the
+//! runtime-token channel may use a lifecycle route only when its conversation
+//! is the lead of that same team. The user's own clients (a session, or local
+//! mode) are not affected.
+
+use std::sync::Arc;
+
+use async_trait::async_trait;
+use axum::extract::{Request, State};
+use axum::http::Method;
+use axum::middleware::Next;
+use axum::response::Response;
+
+use aionui_auth::{AuthChannel, CurrentUser};
+use aionui_common::ApiError;
+
+use crate::error::TeamError;
+use crate::service::TeamSessionService;
+use crate::types::TeammateRole;
+
+/// Resolves which team slot a runtime-token conversation belongs to.
+#[async_trait]
+pub trait LifecycleAuthority: Send + Sync {
+    /// `(team_id, role)` of the conversation's slot, or `None` when the
+    /// conversation is not a team member of this user.
+    async fn caller_slot(&self, user_id: &str, conversation_id: &str) -> Option<(String, TeammateRole)>;
+}
+
+#[async_trait]
+impl LifecycleAuthority for TeamSessionService {
+    async fn caller_slot(&self, user_id: &str, conversation_id: &str) -> Option<(String, TeammateRole)> {
+        let resolved = self.resolve_team_tool_context(user_id, conversation_id).await.ok()?;
+        resolved.context.map(|ctx| (ctx.team_id, ctx.caller_role))
+    }
+}
+
+/// The team id a lifecycle route acts on, or `None` for any other route.
+pub(crate) fn lifecycle_target<'a>(method: &Method, path: &'a str) -> Option<&'a str> {
+    let rest = path.strip_prefix("/api/teams/")?;
+    let mut parts = rest.split('/');
+    let team_id = parts.next().filter(|id| !id.is_empty())?;
+    let tail: Vec<&str> = parts.collect();
+    let lifecycle = matches!(
+        (method, tail.as_slice()),
+        (&Method::DELETE, [])
+            | (&Method::PATCH, ["name"])
+            | (&Method::POST, ["agents"])
+            | (&Method::DELETE, ["agents", _])
+            | (&Method::POST, ["agents", _, "replace"])
+            | (&Method::PATCH, ["agents", _, "name"])
+            | (&Method::POST, ["agents", _, "interrupt"])
+            | (&Method::POST, ["agents", _, "context", "reset"])
+            | (&Method::DELETE, ["session"])
+    );
+    lifecycle.then_some(team_id)
+}
+
+/// Whether a runtime-token caller resolved to `slot` may act on `team_id`.
+pub(crate) fn runtime_caller_allowed(slot: Option<&(String, TeammateRole)>, team_id: &str) -> bool {
+    matches!(slot, Some((caller_team, TeammateRole::Lead)) if caller_team == team_id)
+}
+
+pub async fn lifecycle_guard(
+    State(authority): State<Arc<dyn LifecycleAuthority>>,
+    request: Request,
+    next: Next,
+) -> Result<Response, ApiError> {
+    let Some(AuthChannel::RuntimeToken { conversation_id }) = request.extensions().get::<AuthChannel>().cloned() else {
+        return Ok(next.run(request).await);
+    };
+    let Some(team_id) = lifecycle_target(request.method(), request.uri().path()).map(str::to_owned) else {
+        return Ok(next.run(request).await);
+    };
+    let user_id = request
+        .extensions()
+        .get::<CurrentUser>()
+        .map(|user| user.id.clone())
+        .ok_or_else(|| ApiError::Unauthorized("Authentication required".into()))?;
+    let slot = authority.caller_slot(&user_id, &conversation_id).await;
+    if !runtime_caller_allowed(slot.as_ref(), &team_id) {
+        tracing::warn!(
+            team_id,
+            conversation_id,
+            "lifecycle route refused for a non-lead runtime token"
+        );
+        return Err(TeamError::LeaderOnly("Only the team lead can do this from an agent runtime".into()).into());
+    }
+    Ok(next.run(request).await)
+}
+
+#[cfg(test)]
+mod tests {
