+    }
+
+    fn runtime() -> AuthChannel {
+        AuthChannel::RuntimeToken {
+            conversation_id: "conv-1".into(),
+        }
+    }
+
+    #[test]
+    fn lifecycle_target_matches_only_lifecycle_routes() {
+        let yes = [
+            (Method::DELETE, "/api/teams/t1"),
+            (Method::PATCH, "/api/teams/t1/name"),
+            (Method::POST, "/api/teams/t1/agents"),
+            (Method::DELETE, "/api/teams/t1/agents/s1"),
+            (Method::POST, "/api/teams/t1/agents/s1/replace"),
