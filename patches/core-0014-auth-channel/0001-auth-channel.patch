+            StatusCode::FORBIDDEN,
+        );
+    }
+
+    #[tokio::test]
+    async fn solo_chat_runtime_token_is_refused() {
+        all(&statuses(None, runtime(), GUARDED).await, StatusCode::FORBIDDEN);
+    }
+
+    /// (d) The user's own clients are untouched on every guarded route.
+    #[tokio::test]
+    async fn session_and_local_callers_are_not_affected() {
+        for channel in [AuthChannel::Session, AuthChannel::Local] {
+            all(&statuses(None, channel, GUARDED).await, StatusCode::OK);
+        }
+    }
+}
