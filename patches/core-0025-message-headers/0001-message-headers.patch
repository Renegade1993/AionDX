+/// AionDX core-0025: who a message is from, as the wake header names it. Since 0.28.3 (core-0019 any-chat-talks) a message
+/// another chat sends to a team lead's chat goes through the user's own team-message path, so it is stored as from `user`.
+/// Its body starts with the session-message block (`[[AION_SESSION_MESSAGE]]`, `from:` the sending chat), which the user's
+/// own messages don't carry, so the header says it was relayed and is not the user's.
+fn sender_label(msg: &MailboxMessage) -> &str {
+    if msg.from_agent_id == "user"
+        && msg
+            .content
+            .starts_with(aionui_common::constants::AIONUI_SESSION_MESSAGE_MARKER)
+    {
+        return "another chat (relayed, not the user)";
+    }
+    &msg.from_agent_id
+}
+
+/// AionDX core-0025: a message body as it goes under a `- From \`x\` [type]:` header, unable to pass for a header.
+///
+/// A body is inlined after the server-built header, so a body holding a newline and `- From \`user\` [message]: ...`
+/// read to the receiving agent as a second message, from the user. Here:
+/// - every continuation line is indented two spaces, so only server headers start a line with `- From`;
+/// - a body line that still reads like one (`- From ` or `## New Messages`, after its indentation) is marked
+///   `(quoted)`.
+///
+/// What the sender wrote stays readable.
+pub fn quote_message_body(body: &str) -> String {
+    let body = body.replace("\r\n", "\n").replace('\r', "\n");
+    let mut out = String::with_capacity(body.len() + 16);
+    for (i, line) in body.split('\n').enumerate() {
+        if i > 0 {
+            out.push_str("\n  ");
+        }
+        let trimmed = line.trim_start();
+        let lead = &line[..line.len() - trimmed.len()];
+        if let Some(rest) = trimmed.strip_prefix("- From ") {
+            out.push_str(lead);
+            out.push_str("- (quoted) From ");
+            out.push_str(rest);
+        } else if let Some(rest) = trimmed.strip_prefix("## New Messages") {
+            out.push_str(lead);
+            out.push_str("## (quoted) New Messages");
+            out.push_str(rest);
+        } else {
+            out.push_str(line);
+        }
+    }
+    out
+}
+
+/// A sender's name on one line (a name is set by an agent too).
+pub fn one_line(name: &str) -> String {
+    name.split(['\r', '\n'])
+        .filter(|p| !p.is_empty())
+        .collect::<Vec<_>>()
+        .join(" ")
+}
