+/// Merge a stored OAuth bearer token into a URL-based transport's headers,
+/// in place. `Stdio` is left untouched (OAuth tokens are meaningless for a
+/// local process). Delegates to `McpOAuthService::merge_bearer_token` so the
+/// merge rule (skip if an `Authorization` header is already set, no-op on a
+/// missing token or a failed lookup) lives in one place shared with the
+/// `/api/mcp/test-connection` route's own token injection.
+async fn apply_oauth_token(oauth_service: &McpOAuthService, user_id: &str, transport: &mut SessionMcpTransport) {
+    match transport {
+        SessionMcpTransport::Http { url, headers }
+        | SessionMcpTransport::Sse { url, headers }
+        | SessionMcpTransport::StreamableHttp { url, headers } => {
+            oauth_service.merge_bearer_token(user_id, url, headers).await;
+        }
+        SessionMcpTransport::Stdio { .. } => {}
+    }
