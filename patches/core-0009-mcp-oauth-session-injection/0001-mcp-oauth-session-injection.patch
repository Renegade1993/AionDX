+    /// Merge a stored OAuth bearer token into `headers`, in place.
+    ///
+    /// No-op if `headers` already carries an `Authorization` key
+    /// (case-insensitive — an explicit server-configured header always wins),
+    /// if no token is stored for `url` (`Ok(None)`), or if the lookup itself
+    /// fails (logged at `warn`, treated as no-op so a transient DB issue
+    /// degrades to "unauthenticated" rather than failing the caller).
+    ///
+    /// Shared by every call site that attaches a stored token to an
+    /// outbound MCP request's headers (the connection-test route and the
+    /// real agent-session MCP resolver) so the merge rule lives in one place.
+    pub async fn merge_bearer_token(&self, user_id: &str, url: &str, headers: &mut HashMap<String, String>) {
+        if headers.keys().any(|k| k.eq_ignore_ascii_case("authorization")) {
+            return;
+        }
+        match self.get_token(user_id, url).await {
+            Ok(Some(token)) => {
+                headers.insert("Authorization".to_string(), format!("Bearer {token}"));
+            }
+            Ok(None) => {}
+            Err(e) => warn!(url, error = %e, "Failed to look up stored OAuth token for MCP server"),
+        }
+    }
+
     // -----------------------------------------------------------------------
     // Internal helpers
     // -----------------------------------------------------------------------
